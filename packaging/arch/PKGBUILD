# Maintainer: (fill in before submitting to the AUR)
#
# Prebuilt-binary package: wraps the linux-x86_64/linux-arm64 release tarball from
# https://github.com/lolgab/scalino/releases (same as install.sh). No JVM or build step; the
# binaries in the tarball are already native.
#
# pkgver/source/sha256sums_* are regenerated by build/10-update-package-metadata.sh after every
# tagged release; don't hand-edit them.
pkgname=scalino-bin
pkgver=0.0.30
pkgrel=1
pkgdesc="Scala 3 toolchain that compiles straight to native binaries -- no JVM at any step"
arch=('x86_64' 'aarch64')
url="https://github.com/lolgab/scalino"
license=('Apache-2.0')
depends=('clang')
optdepends=('nodejs: run Scala.js programs (`scalino run --js`)')
provides=('scalino')
conflicts=('scalino')

source_x86_64=("https://github.com/lolgab/scalino/releases/download/v$pkgver/scalino-v$pkgver-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/lolgab/scalino/releases/download/v$pkgver/scalino-v$pkgver-linux-arm64.tar.gz")
sha256sums_x86_64=('80b5d7b3d13d549966386f642c10cb84ef59b903675b860d3812ffc7a1874dc9')
sha256sums_aarch64=('088cacd4c6d83fd079458e47089f9015c97b70364823f5ca34ed84f6c7923383')

package() {
  case "$CARCH" in
    x86_64)  _target=x86_64 ;;
    aarch64) _target=arm64 ;;
  esac
  _srcdir="$srcdir/scalino-v$pkgver-linux-$_target"

  install -dm755 "$pkgdir/usr/lib/scalino"
  cp -a "$_srcdir/." "$pkgdir/usr/lib/scalino/"
  rm -f "$pkgdir/usr/lib/scalino/LICENSE" "$pkgdir/usr/lib/scalino/NOTICE"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/scalino/scalino "$pkgdir/usr/bin/scalino"
  ln -s /usr/lib/scalino/scalino-lsp "$pkgdir/usr/bin/scalino-lsp"
  ln -s /usr/lib/scalino/scalino-cs "$pkgdir/usr/bin/scalino-cs"

  install -Dm644 "$_srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_srcdir/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"

  # Completions pre-generated by build/07-build-scalino.sh and shipped in the tarball, installed
  # at each shell's standard system-wide path.
  install -Dm644 "$_srcdir/completions/scalino.bash" "$pkgdir/usr/share/bash-completion/completions/scalino"
  install -Dm644 "$_srcdir/completions/_scalino" "$pkgdir/usr/share/zsh/site-functions/_scalino"
  install -Dm644 "$_srcdir/completions/scalino.fish" "$pkgdir/usr/share/fish/vendor_completions.d/scalino.fish"
}
