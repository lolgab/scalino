{
  description = "scalino -- a Scala 3 toolchain that compiles straight to native binaries (no JVM at any step)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
  };

  # Wraps the prebuilt release tarball (same one install.sh fetches) rather
  # than rebuilding from source: scalino's own build (build/all.sh) needs
  # vendored/patched scala3+scala-native checkouts, which is a much bigger
  # undertaking to model as a Nix derivation than relinking an
  # already-built, already-relocatable dist/.
  #
  # sources.json (version + per-target sha256) is regenerated by
  # build/10-update-package-metadata.sh after every tagged release -- don't
  # hand-edit it.
  outputs = { self, nixpkgs, flake-utils }:
    flake-utils.lib.eachSystem [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ] (system:
      let
        pkgs = nixpkgs.legacyPackages.${system};
        sources = builtins.fromJSON (builtins.readFile ./sources.json);
        target = {
          x86_64-linux = "linux-x86_64";
          aarch64-linux = "linux-arm64";
          x86_64-darwin = "macos-x86_64";
          aarch64-darwin = "macos-arm64";
        }.${system};
        src = sources.${target};
        # scalino-lsp's go-to-definition into scala-library/scala3-library
        # looks for <jar>-sources.jar next to the stdlib jars in dist/lib. The
        # CLI would normally download them on first `setup-ide`, but a store
        # path is read-only, so they are fetched (and hash-pinned) here.
        stdlibSources = pkgs.lib.mapAttrsToList
          (name: v: {
            inherit name;
            jar = pkgs.fetchurl {
              url = "https://repo1.maven.org/maven2/org/scala-lang/${name}/${sources.scalaVersion}/${name}-${sources.scalaVersion}-sources.jar";
              sha256 = v.sha256;
            };
          })
          sources.stdlibSources;
      in
      {
        packages.default = pkgs.stdenv.mkDerivation {
          pname = "scalino";
          version = sources.version;

          src = pkgs.fetchurl {
            url = "https://github.com/lolgab/scalino/releases/download/v${sources.version}/scalino-v${sources.version}-${target}.tar.gz";
            sha256 = src.sha256;
          };

          nativeBuildInputs = [ pkgs.makeWrapper ] ++ pkgs.lib.optionals pkgs.stdenv.isLinux [ pkgs.autoPatchelfHook ];
          # Linux: scala-native binaries are ordinary dynamically-linked ELF
          # executables (glibc + libc/libm/libpthread), just not built against
          # Nix's own glibc -- autoPatchelfHook rewrites their interpreter/rpath
          # instead of needing a static build. macOS: the Mach-O binaries only
          # link system libraries (libSystem, libz), so nothing to patch.
          buildInputs = pkgs.lib.optionals pkgs.stdenv.isLinux (with pkgs; [ stdenv.cc.cc.lib zlib zstd ]);

          dontConfigure = true;
          dontBuild = true;

          installPhase = ''
            runHook preInstall
            mkdir -p "$out/lib/scalino" "$out/bin"
            cp -a . "$out/lib/scalino/"
            ln -s "$out/lib/scalino/scalino" "$out/bin/scalino"
            ln -s "$out/lib/scalino/scalino-lsp" "$out/bin/scalino-lsp"
            ln -s "$out/lib/scalino/scalino-cs" "$out/bin/scalino-cs"

            ${pkgs.lib.concatMapStringsSep "\n" (s: ''
              cp ${s.jar} "$out/lib/scalino/lib/${s.name}-${sources.scalaVersion}-sources.jar"
            '') stdlibSources}

            # Pre-generated by build/07-build-scalino.sh (see
            # cli/ScalinoCli.scala's `completions` subcommand) and shipped
            # in the tarball -- installed at each shell's own standard
            # lookup path under $out/share, same as any other Nix package.
            mkdir -p "$out/share/bash-completion/completions" \
                     "$out/share/zsh/site-functions" \
                     "$out/share/fish/vendor_completions.d"
            cp "$out/lib/scalino/completions/scalino.bash" "$out/share/bash-completion/completions/scalino"
            cp "$out/lib/scalino/completions/_scalino" "$out/share/zsh/site-functions/_scalino"
            cp "$out/lib/scalino/completions/scalino.fish" "$out/share/fish/vendor_completions.d/scalino.fish"
            runHook postInstall
          '';

          # nodejs runs Scala.js programs (`scalino run --js`, `scalino test`).
          # clang and llvm-info is a hard runtime dependency (scala-native always links
          # through it, even for a zero-dependency Hello World) -- wrap the
          # binaries so it's on PATH without polluting the caller's own env (suffix: a clang
          # the caller already provides wins, which cross builds rely on, see
          # mkScalinoSysroot).
          postFixup = ''
            wrapProgram "$out/bin/scalino" --suffix PATH : ${pkgs.lib.makeBinPath [ pkgs.clang pkgs.llvmPackages.llvm.dev pkgs.nodejs ]}
            wrapProgram "$out/bin/scalino-lsp" --suffix PATH : ${pkgs.lib.makeBinPath [ pkgs.clang pkgs.llvmPackages.llvm.dev ]}
          '';

          meta = with pkgs.lib; {
            description = "Scala 3 toolchain that compiles straight to native binaries -- no JVM at any step";
            homepage = "https://github.com/lolgab/scalino";
            license = licenses.asl20;
            platforms = [ "x86_64-linux" "aarch64-linux" "x86_64-darwin" "aarch64-darwin" ];
            mainProgram = "scalino";
          };
        };

        apps.default = flake-utils.lib.mkApp { drv = self.packages.${system}.default; };

        # Building *with* scalino inside the Nix sandbox (no network).
        #
        # Nix forbids network access during a build, except in fixed-output
        # derivations (the output hash is declared up front). So dependencies
        # follow the usual lockfile -> one fixed-output fetch per artifact ->
        # offline build scheme (same as importCargoLock for Rust):
        #
        #   1. in your project:  scalino lock .     # writes scalino.lock.json
        #   2. commit scalino.lock.json
        #   3. in your flake:    scalino.lib.${system}.mkScalinoApp { ... }
        #
        # mkScalinoCache turns the lock into a coursier-layout cache dir (one
        # pkgs.fetchurl per jar, linked at its cache-relative path); mkScalinoApp
        # builds with SCALINO_CACHE pointing there and SCALINO_OFFLINE=1.
        lib = rec {
          # withSources also fetches the -sources.jar files `scalino lock`
          # recorded; they land next to their classes jars, which is where
          # scalino-lsp looks (go-to-definition into library code).
          mkScalinoCache = { lockFile, withSources ? false }:
            let
              lock = builtins.fromJSON (builtins.readFile lockFile);
              all = pkgs.lib.concatMap
                (s: s.artifacts ++ pkgs.lib.optionals withSources (s.sources or [ ]))
                (pkgs.lib.attrValues lock.sets);
              remote = builtins.filter (a: !(a.local or false)) all;
              # dependency sets overlap; one entry per cache path
              unique = pkgs.lib.attrValues (pkgs.lib.listToAttrs (map (a: { name = a.path; value = a; }) remote));
            in
            if builtins.length remote != builtins.length all
            then throw "scalino.lock.json has machine-local (file: repository) artifacts, which Nix cannot fetch -- publish them to a real repository"
            else pkgs.linkFarm "scalino-deps-cache" (map
              (a: {
                name = a.path;
                path = pkgs.fetchurl { inherit (a) url sha256; };
              })
              unique);

          # ---- cross-compilation -------------------------------------------
          #
          # `nativeTargetTriples` builds with scalino's own sysroots (the same
          # ones `scalino sysroot build` assembles) instead of the build
          # machine's system libraries -- also when the triple is the build
          # machine's own, so the result doesn't depend on the builder. The
          # compiler is always the *build* platform's scalino: nothing runs
          # under QEMU or on a remote builder of the target's architecture.
          #
          # A sysroot is made in two steps so the sandbox stays offline:
          #   1. mkScalinoSysrootSources: fixed-output derivation holding the
          #      upstream archives (.deb/.apk/tarballs) `sysroot build` downloads.
          #      scalino checks each against a sha256 pinned in its versions.env;
          #      the hash here only covers the whole directory, and lives in
          #      sysroot-sources.json (regenerated by
          #      build/12-update-nix-sysroot-hashes.sh after each release).
          #   2. mkScalinoSysroot: runs `scalino sysroot build` offline on them.
          sysrootHashes = builtins.fromJSON (builtins.readFile ./sysroot-sources.json);

          # Every addon `scalino sysroot build --with` knows. The sources
          # derivation fetches all of them (the hash must not depend on the
          # app); mkScalinoSysroot only installs the ones an app asks for.
          allSysrootAddons = [ "openssl" "idn2" "s2n" "curl" ];

          # clang + llvm-ar compile the s2n/curl addons for the *target*. The
          # usual wrapped clang injects the builder's glibc headers, and
          # clangNoLibc passes -nostdlibinc (hiding the sysroot's too), so use
          # the unwrapped clang with the resource dir (builtin headers) spelled
          # out. lld links cross targets.
          targetClang = pkgs.symlinkJoin {
            name = "scalino-target-clang";
            paths = map
              (n: pkgs.writeShellScriptBin n ''
                exec ${pkgs.llvmPackages.clang-unwrapped}/bin/${n} -resource-dir "$(${pkgs.llvmPackages.clangNoLibc}/bin/clang -print-resource-dir)" "$@"
              '')
              [ "clang" "clang++" ];
          };
          sysrootTools = with pkgs; [ gnutar gzip xz zstd lld targetClang llvm ];

          mkScalinoSysrootSources = triple:
            let hash = sysrootHashes.${triple} or (throw "scalino: no sysroot-sources.json entry for ${triple}"); in
            pkgs.stdenvNoCC.mkDerivation {
              name = "scalino-sysroot-sources-${triple}";
              nativeBuildInputs = [ self.packages.${system}.default pkgs.curl ] ++ sysrootTools;
              outputHashMode = "recursive";
              outputHashAlgo = "sha256";
              outputHash = hash;
              SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
              buildCommand = ''
                export HOME="$TMPDIR"
                export SCALINO_SYSROOT_DIR="$TMPDIR/sysroots"
                export SCALINO_SYSROOT_SOURCES="$out"
                scalino sysroot build ${triple} ${pkgs.lib.concatMapStringsSep " " (l: "--with ${l}") allSysrootAddons}
                # a sysroot build leaves only the downloads in $out; make sure
                # no half-finished one is part of the hash
                find "$out" -name '*.part' -delete
              '';
            };

          # $out/<triple> and $out/addons/<lib>/<triple>: the layout
          # SCALINO_SYSROOT_DIR points at.
          mkScalinoSysroot = { triple, addons ? [ ] }:
            pkgs.runCommand "scalino-sysroot-${triple}"
              { nativeBuildInputs = [ self.packages.${system}.default ] ++ sysrootTools; }
              ''
                export HOME="$TMPDIR"
                export SCALINO_SYSROOT_DIR="$out"
                export SCALINO_SYSROOT_SOURCES="${mkScalinoSysrootSources triple}"
                mkdir -p "$out"
                scalino sysroot build ${triple} ${pkgs.lib.concatMapStringsSep " " (l: "--with ${l}") addons}
              '';

          # Two modes, kept apart on purpose:
          #
          # * no nativeTargetTriples: a host build against the system's
          #   libraries -- buildInputs / pkgConfig as usual.
          # * nativeTargetTriples = [ "aarch64-unknown-linux-musl" ... ]: one
          #   binary per triple against scalino's sysroots (see above), from
          #   any builder. buildInputs, nativeBuildInputs C libs and
          #   pkgConfig make no sense there (they are the builder's) and are
          #   rejected. Output: $out/bin/<pname> for a single triple,
          #   $out/bin/<pname>-<triple> for several.
          #   Prefer *-linux-musl: static, runs anywhere. *-linux-gnu is
          #   dynamic against glibc 2.31 and needs patchelf on NixOS.
          mkScalinoApp =
            { pname
            , version ? "0.0.0"
            , src
            , lockFile ? src + "/scalino.lock.json"
            , sources ? [ "." ]
            , extraArgs ? [ ]  # e.g. [ "--native-mode" "release-fast" ]
            # C libraries the native code links against. They must be real
            # derivation inputs so Nix puts their headers/libs (and .pc files)
            # in the build sandbox.
            , buildInputs ? [ ]
            , nativeBuildInputs ? [ ]
            # pkg-config modules (e.g. [ "gtk4" ]): scalino runs
            # `pkg-config --cflags/--libs` on them at build time and passes the
            # result to clang, so no -I/-L flags need computing in Nix.
            , pkgConfig ? [ ]
            # see "cross-compilation" above
            , nativeTargetTriples ? [ ]
            # static C libraries from scalino's addons (`scalino sysroot build
            # --with`): the ones the classpath links through @link, e.g.
            # [ "openssl" ] for scala-native-crypto/fs2/http4s, "idn2", "s2n",
            # "curl". Scalino would install them on first use; offline that
            # has to be spelled out.
            , sysrootAddons ? [ ]
            }:
            let
              cross = nativeTargetTriples != [ ];
              sysroots = pkgs.symlinkJoin {
                name = "scalino-sysroots";
                paths = map (triple: mkScalinoSysroot { inherit triple; addons = sysrootAddons; }) nativeTargetTriples;
              };
              crossArgs = [ "--native-target-triple" (pkgs.lib.concatStringsSep "," nativeTargetTriples) ]
                ++ pkgs.lib.concatMap (t: [ "--native-sysroot" "${t}=${sysroots}/${t}" ]) nativeTargetTriples;
              hostArgs = pkgs.lib.concatMap (m: [ "--native-pkg-config" m ]) pkgConfig;
              # a host build (no triples) and a single-triple cross build both produce `app`
              binaries = if !cross || builtins.length nativeTargetTriples == 1
                then [ { from = "app"; to = pname; } ]
                else map (t: { from = "app-${t}"; to = "${pname}-${t}"; }) nativeTargetTriples;
            in
            if cross && (buildInputs != [ ] || pkgConfig != [ ])
            then throw "mkScalinoApp ${pname}: buildInputs/pkgConfig are the builder's libraries and cannot be used with nativeTargetTriples (scalino's sysroots are linked instead); drop one or the other"
            else if !cross && sysrootAddons != [ ]
            then throw "mkScalinoApp ${pname}: sysrootAddons only applies with nativeTargetTriples"
            else
            pkgs.stdenv.mkDerivation {
              inherit pname version src buildInputs;
              nativeBuildInputs = [ self.packages.${system}.default ]
                ++ pkgs.lib.optional (pkgConfig != [ ]) pkgs.pkg-config
                # cross compiles with the unwrapped clang (see targetClang) and
                # links with lld; a host build keeps using the system toolchain
                ++ pkgs.lib.optionals cross [ targetClang pkgs.lld ]
                ++ nativeBuildInputs;
              env = {
                SCALINO_CACHE = "${mkScalinoCache { inherit lockFile; }}";
                SCALINO_OFFLINE = "1";
              } // pkgs.lib.optionalAttrs cross {
                # addons are looked up under the sysroot root
                SCALINO_SYSROOT_DIR = "${sysroots}";
              };
              dontConfigure = true;
              buildPhase = ''
                runHook preBuild
                export HOME="$TMPDIR"
                scalino package ${pkgs.lib.escapeShellArgs sources} --offline -o app ${pkgs.lib.escapeShellArgs ((if cross then crossArgs else hostArgs) ++ extraArgs)}
                runHook postBuild
              '';
              installPhase = ''
                runHook preInstall
                ${pkgs.lib.concatMapStringsSep "\n" (b: ''install -Dm755 ${pkgs.lib.escapeShellArg b.from} "$out/bin/"${pkgs.lib.escapeShellArg b.to}'') binaries}
                runHook postInstall
              '';
            };

          # `nix develop` shell for editing: scalino plus a cache that includes
          # sources jars, so `scalino setup-ide .` (-> .scalino-build/
          # scalino-lsp.json) and scalino-lsp work with no network. The cache
          # is a read-only store path and SCALINO_OFFLINE=1, so after changing
          # dependencies re-lock with a writable cache:
          #   SCALINO_OFFLINE=0 SCALINO_CACHE= scalino lock .
          # then let Nix rebuild the shell from the new lockfile.
          mkScalinoDevShell = { lockFile, packages ? [ ], buildInputs ? [ ], pkgConfig ? [ ] }:
            pkgs.mkShell {
              inherit buildInputs;
              packages = [ self.packages.${system}.default ]
                ++ pkgs.lib.optional (pkgConfig != [ ]) pkgs.pkg-config
                ++ packages;
              env = {
                SCALINO_CACHE = "${mkScalinoCache { inherit lockFile; withSources = true; }}";
                SCALINO_OFFLINE = "1";
              };
            };
        };
      });
}
