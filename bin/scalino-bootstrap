#!/usr/bin/env bash
# scalino-bootstrap: the Scala Native Compiler CLI. No JVM required -- scalino-dotc and
# scalino-linkdriver are both standalone binaries.
#
# Usage: scalino-bootstrap build <Main.scala> [<More.scala> ...] -o <output>
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="$ROOT/dist"

for f in "$DIST/scalino-dotc" "$DIST/scalino-linkdriver" "$DIST/java.base.jar" \
         "$DIST/compiler.cp" "$DIST/nativelibs.cp" "$DIST/nscplugin.jar.txt"; do
  [[ -e "$f" ]] || { echo "scalino-bootstrap: missing $f -- run build/all.sh first" >&2; exit 1; }
done

cmd="${1:-}"
[[ "$cmd" == "build" ]] || { echo "usage: scalino-bootstrap build <Main.scala> [more.scala...] -o <output>" >&2; exit 1; }
shift

sources=()
out=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    *) sources+=("$1"); shift ;;
  esac
done
[[ -n "$out" ]] || { echo "scalino-bootstrap: -o <output> is required" >&2; exit 1; }
[[ ${#sources[@]} -gt 0 ]] || { echo "scalino-bootstrap: no source files given" >&2; exit 1; }

# The entry-point object name doubles as scala-native's mainClass. Assumes a single top-level
# `object Foo` with a `def main`.
main_class="$(basename "${sources[0]}" .scala)"

# A persistent project-local cache dir (like scala-cli's .scala-build), not a throwaway mktemp:
# scala-native's Build.buildCachedAwait (src/LinkDriver.scala) skips recompiling dependency .c
# files whose .o is still valid (cached under $work/link/native/dependencies/); a fresh tmpdir
# every run discarded it and recompiled the whole C runtime.
work="$PWD/.scalino-bootstrap-build/$main_class"
mkdir -p "$work"

# the manifests hold dist-relative paths (build/06-package.sh); resolve to absolute.
resolve_cp() { echo "$DIST/${1//:/:$DIST/}"; }

compile_cp="$(resolve_cp "$(cat "$DIST/compiler.cp")"):$(resolve_cp "$(cat "$DIST/nativelibs.cp")")"
plugin_jar="$DIST/$(cat "$DIST/nscplugin.jar.txt")"

mkdir -p "$work/classes"
"$DIST/scalino-dotc" \
  -javabootclasspath "$DIST/java.base.jar" \
  -classpath "$compile_cp" \
  -Xplugin:"$plugin_jar" -Xplugin-require:scalanative \
  -Yretain-trees \
  -Xearly-tasty-output "$work/classes" \
  -d "$work/classes" \
  "${sources[@]}"

link_cp="$work/classes:$(resolve_cp "$(cat "$DIST/nativelibs.cp")")"
"$DIST/scalino-linkdriver" "$link_cp" "$work/link" "$main_class" \
  "$(command -v clang)" "$(command -v clang++)"

cp "$work/link/$main_class" "$out" 2>/dev/null || cp "$work/link/$(echo "$main_class" | tr '[:upper:]' '[:lower:]')" "$out"
chmod +x "$out"
echo "scalino-bootstrap: wrote $out"
