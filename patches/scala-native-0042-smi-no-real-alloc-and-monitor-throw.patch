+  /** Rewrites `new java.lang.Integer(5)` (and the other 8 SMI-eligible box
+   *  types, see `nir.Type.Smi`) from a real `Classalloc` + constructor `Call`
+   *  into the same zero-allocation `Op.Box` autoboxing already uses on
+   *  64-bit targets - so these 9 types can never be allocated through `new`
+   *  either, not just through implicit boxing. `Op.Box`'s own reach handling
+   *  (below, in `reachOp`) needs no special-casing for this: it already
+   *  reaches correctly for every ordinary autobox site today, and an
+   *  `Op.Box` introduced here is indistinguishable from one the frontend
+   *  emitted directly.
+   *
+   *  Runs as part of `preprocessDefn` - right here, on the raw NIR loaded
+   *  from the classpath, before `reachDefine` walks these same instructions
+   *  to compute reachability, is the only point in the whole pipeline where
+   *  the `Classalloc`+`Call` pattern this rewrite matches is guaranteed to
+   *  still look like what the frontend produced. `Interflow` (the
+   *  optimizer, which runs later, over already-reachability-checked NIR)
+   *  routinely inlines these one-line constructors (`this._rawValue = v`)
+   *  away entirely, replacing the `Call` with a direct field store - so
+   *  this can't be a separate pass over the linked result, and it can't be
+   *  done at the `nscplugin` frontend either, since javalib/nativelib/the
+   *  Scala standard library aren't necessarily compiled by this project's
+   *  own patched compiler (an unpatched/vanilla one may bootstrap them).
+   */
+  /** Constructor of one of the 9 SMI-eligible box types, keyed by its NIR
+   *  global, mapped to the box type it constructs.
+   */
+  private lazy val SmiBoxCtors: Map[nir.Global, nir.Type] =
+    nir.Type.Smi.discriminantOfBox.keys.map { boxTy =>
+      val nir.Type.Ref(name, _, _) = boxTy: @unchecked
+      val ctor = name.member(nir.Sig.Ctor(Seq(nir.Type.unbox(boxTy))))
+      ctor -> boxTy
+    }.toMap
+
+  private def rewriteSmiAllocs(defn: nir.Defn.Define): nir.Defn.Define = {
+    val pending = mutable.Map.empty[nir.Local, nir.Type]
+    val out = Vector.newBuilder[nir.Inst]
+    out.sizeHint(defn.insts.size)
+    var changed = false
+
+    defn.insts.foreach {
+      case nir.Inst.Let(n, nir.Op.Classalloc(clsName, None), _)
+          if nir.Type.Smi.isEligibleBoxType(nir.Type.Ref(clsName)) =>
+        // Dropped, not appended - the matching Call case below emits the
+        // real replacement (an Op.Box `Let` bound to this same local) once
+        // it's found.
+        pending(n) = nir.Type.Ref(clsName)
+        changed = true
+
+      case inst @ nir.Inst.Let(
+            _,
+            nir.Op.Call(_, nir.Val.Global(ctorGlobal, _), Seq(nir.Val.Local(recv, _), arg)),
+            unwind
+          ) if SmiBoxCtors.get(ctorGlobal).exists(pending.get(recv).contains) =>
+        val boxTy = pending.remove(recv).get
+        out += nir.Inst.Let(recv, nir.Op.Box(boxTy, arg), unwind)(inst.pos, inst.scopeId)
+
+      case inst =>
+        out += inst
+    }
+
+    if (!changed) defn
+    else {
+      // Correctness net: every deferred Classalloc is expected to be
+      // resolved by exactly one matching constructor Call. If one is still
+      // pending here, this `new X(...)` didn't have the shape every
+      // compiler's frontend is known to always emit (e.g. the receiver
+      // escaped before its constructor ran) - fail loud rather than
+      // silently miscompile a box object that never got initialized.
+      if (pending.nonEmpty) {
+        util.unsupported(
+          s"SMI box allocation in ${defn.name} never reached its " +
+            s"constructor call: ${pending.keys.mkString(", ")}"
+        )
+      }
+      defn.copy(insts = out.result())(defn.pos)
+    }
+  }
