+/** Rewrites `new java.lang.Integer(5)` (and the other 8 SMI-eligible box
+ *  types, see `nir.Type.Smi`) from a real `Classalloc` + constructor `Call`
+ *  into the same zero-allocation `Op.Box` autoboxing already uses on 64-bit
+ *  targets - so these 9 types can never be allocated through `new` either,
+ *  not just through implicit boxing.
+ *
+ *  Lives here, in `ScalaNative.scala` (rather than its own file under
+ *  `linker`, which is architecturally where it belongs), because this
+ *  project's own `build/04a-patch-tools.sh` splices an explicit whitelist
+ *  of source files into the prebuilt `tools` jar rather than recompiling
+ *  the whole module - a new file silently never gets compiled in unless
+ *  that list is also updated. `ScalaNative.scala` is already on it.
+ *
+ *  Applied by `ScalaNative.link`, right after linking (`Reach`), on the
+ *  raw, unoptimized NIR every compiler (this project's own patched
+ *  `nscplugin`, or an unpatched/vanilla one used to bootstrap javalib/
+ *  nativelib/the Scala standard library) emits for `new X(v)`: `Classalloc`
+ *  immediately followed by a `Call` to `X`'s constructor with the alloc'd
+ *  receiver and `v`. That Classalloc+Call adjacency is a *frontend*
+ *  invariant, not one this rewrite can rely on later in the pipeline -
+ *  `Interflow` (the optimizer) routinely inlines these one-line
+ *  constructors (`this._rawValue = v`) away entirely, replacing the `Call`
+ *  with a direct field store before `Lower` (which used to host this
+ *  rewrite, in an earlier version of this patch) ever sees it. Rewriting
+ *  here, before `Interflow` runs, is the only point where the pattern is
+ *  guaranteed to still look like what the frontend produced.
+ */
+private[scalanative] object SmiAllocRewrite {
+
+  /** Constructor of one of the 9 SMI-eligible box types, keyed by its NIR
+   *  global, mapped to the box type it constructs.
+   */
+  private val ctors: Map[nir.Global, nir.Type] =
+    nir.Type.Smi.discriminantOfBox.keys.map { boxTy =>
+      val nir.Type.Ref(name, _, _) = boxTy: @unchecked
+      val ctor = name.member(nir.Sig.Ctor(Seq(nir.Type.unbox(boxTy))))
+      ctor -> boxTy
+    }.toMap
+
+  def apply(defns: collection.Seq[nir.Defn]): collection.Seq[nir.Defn] =
+    defns.map {
+      case defn: nir.Defn.Define =>
+        nir.Defn.Define(
+          defn.attrs,
+          defn.name,
+          defn.ty,
+          rewrite(defn.name, defn.insts),
+          defn.debugInfo
+        )(defn.pos)
+      case other => other
+    }
+
+  private def rewrite(
+      defnName: nir.Global,
+      insts: Seq[nir.Inst]
+  ): Seq[nir.Inst] = {
+    // Classalloc locals (of this Defn only) deferred so far, waiting to be
+    // resolved by their matching constructor Call.
+    val pending = mutable.Map.empty[nir.Local, nir.Type]
+    val out = Vector.newBuilder[nir.Inst]
+    out.sizeHint(insts.size)
+
+    insts.foreach {
+      case nir.Inst.Let(n, nir.Op.Classalloc(clsName, None), _)
+          if nir.Type.Smi.isEligibleBoxType(nir.Type.Ref(clsName)) =>
+        // Dropped, not appended - the matching Call case below emits the
+        // real replacement (an Op.Box `Let` bound to this same local) once
+        // it's found.
+        pending(n) = nir.Type.Ref(clsName)
+
+      case inst @ nir.Inst.Let(
+            _,
+            nir.Op.Call(_, nir.Val.Global(ctorGlobal, _), Seq(nir.Val.Local(recv, _), arg)),
+            unwind
+          ) if ctors.get(ctorGlobal).exists(pending.get(recv).contains) =>
+        val boxTy = pending.remove(recv).get
+        out += nir.Inst.Let(recv, nir.Op.Box(boxTy, arg), unwind)(inst.pos, inst.scopeId)
+
+      case inst =>
+        out += inst
+    }
+
+    // Correctness net: every deferred Classalloc is expected to be resolved
+    // by exactly one matching constructor Call. If one is still pending
+    // here, this `new X(...)` didn't have the shape every compiler's
+    // frontend is known to always emit (e.g. the receiver escaped before
+    // its constructor ran) - fail loud rather than silently miscompile a
+    // box object that never got initialized.
+    if (pending.nonEmpty) {
+      util.unsupported(
+        s"SMI box allocation in $defnName never reached its constructor " +
+          s"call: ${pending.keys.mkString(", ")}"
+      )
+    }
+
+    out.result()
+  }
+}
