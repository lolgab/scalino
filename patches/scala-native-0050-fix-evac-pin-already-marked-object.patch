+static inline bool EvacTrace_enabled(void) {
+    if (!evacTraceEnabledChecked) {
+        evacTraceFilePath = getenv("SCALANATIVE_EVAC_TRACE_FILE");
+        const char *valueStr = getenv("SCALANATIVE_EVAC_TRACE_VALUE");
