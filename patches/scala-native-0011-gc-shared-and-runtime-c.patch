diff --git a/nativelib/src/main/resources/scala-native/thread_slots.c b/nativelib/src/main/resources/scala-native/thread_slots.c
new file mode 100644
index 00000000..a7334b47
--- /dev/null
+++ b/nativelib/src/main/resources/scala-native/thread_slots.c
@@ -0,0 +1,45 @@
+// Owner ids of the thin locks with compact object headers, see
+// scala.scalanative.runtime.monitor.BasicMonitor.getThreadId.
+//
+// Kept in C on purpose: the lock path can run while a Scala module is being
+// initialized (waiting for it takes the lock of its class), so it can't depend
+// on loading any Scala module, nor on state kept in a Scala object.
+#include <stdatomic.h>
+
+// The owner field of the compact lock word has 10 bits. The last id is never
+// leased, it marks the threads without a slot (see LockWord.ThreadIdMax).
+#define SLOTLESS 1023
+
+// Index 0 is unused
+static atomic_int slots[SLOTLESS];
+
+// Slot of the current thread, 0 until its first lock
+static _Thread_local int threadSlot = 0;
+
+static int acquire(void) {
+    for (int i = 1; i < SLOTLESS; i++) {
+        int expected = 0;
+        if (atomic_compare_exchange_strong(&slots[i], &expected, 1))
+            return i;
+    }
+    return SLOTLESS;
+}
+
+// Slot of the current thread, leased on first use
+int scalanative_monitor_thread_slot(void) {
+    int slot = threadSlot;
+    if (slot == 0) {
+        slot = acquire();
+        threadSlot = slot;
+    }
+    return slot;
+}
+
+// Gives back the slot of the current thread when it terminates, if it still
+// takes locks afterwards it does as a slotless thread
+void scalanative_monitor_release_thread_slot(void) {
+    int slot = threadSlot;
+    threadSlot = SLOTLESS;
+    if (slot > 0 && slot < SLOTLESS)
+        atomic_store_explicit(&slots[slot], 0, memory_order_release);
+}
