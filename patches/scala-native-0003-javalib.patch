diff --git a/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipFileSystem.scala b/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipFileSystem.scala
new file mode 100644
index 00000000..1587013d
--- /dev/null
+++ b/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipFileSystem.scala
@@ -0,0 +1,153 @@
+package scala.scalanative.nio.fs.zip
+
+import java.io.{ByteArrayOutputStream, File}
+import java.lang.Iterable
+import java.nio.file.attribute.UserPrincipalLookupService
+import java.nio.file.spi.FileSystemProvider
+import java.nio.file.{
+  FileStore, FileSystem, NoSuchFileException, Path, PathMatcher,
+  PathMatcherImpl, WatchService
+}
+import java.util.zip.{ZipEntry, ZipFile}
+import java.{util => ju}
+
+import scala.collection.mutable
+
+/** A read-only view of a single jar/zip file as a [[FileSystem]], backed by
+ *  [[java.util.zip.ZipFile]] (already a real, tested Scala Native javalib
+ *  port -- see ZipFileSystemProvider for why this makes the rest of the
+ *  provider small). Directory entries need not be physically present in the
+ *  archive (most real-world jars omit them); every intermediate directory
+ *  implied by a file entry's path is synthesized from that entry's name.
+ */
+final class ZipFileSystem private[zip] (
+    fsProvider: FileSystemProvider,
+    private[zip] val jarPath: String
+) extends FileSystem {
+  private val zipFile = new ZipFile(new File(jarPath))
+
+  @volatile private var closed = false
+
+  // Directory entry names (no leading/trailing "/", "" = archive root) to
+  // their direct children's simple names, sorted for deterministic listing.
+  private val childrenIndex: Map[String, Vector[String]] = {
+    val children =
+      mutable.Map.empty[String, mutable.LinkedHashSet[String]]
+
+    def addChild(parent: String, simpleName: String): Unit =
+      children
+        .getOrElseUpdate(parent, mutable.LinkedHashSet.empty[String])
+        .add(simpleName)
+
+    def registerDirsOf(name: String): Unit = {
+      var idx = name.indexOf('/')
+      while (idx >= 0) {
+        val dir = name.substring(0, idx)
+        val dirSlash = dir.lastIndexOf('/')
+        val dirParent = if (dirSlash < 0) "" else dir.substring(0, dirSlash)
+        val dirSimple = if (dirSlash < 0) dir else dir.substring(dirSlash + 1)
+        addChild(dirParent, dirSimple)
+        idx = name.indexOf('/', idx + 1)
+      }
+    }
+
+    val en = zipFile.entries()
+    while (en.hasMoreElements()) {
+      val raw = en.nextElement().getName()
+      val name = if (raw.endsWith("/")) raw.substring(0, raw.length - 1) else raw
+      if (name.nonEmpty) {
+        val slash = name.lastIndexOf('/')
+        val parent = if (slash < 0) "" else name.substring(0, slash)
+        val simple = if (slash < 0) name else name.substring(slash + 1)
+        addChild(parent, simple)
+        registerDirsOf(name)
+      }
+    }
+
+    children.view.mapValues(_.toVector.sorted).toMap
+  }
+
+  private[zip] def isDir(normalizedEntryPath: String): Boolean =
+    normalizedEntryPath.isEmpty || childrenIndex.contains(normalizedEntryPath)
+
+  private[zip] def exists(normalizedEntryPath: String): Boolean =
+    isDir(normalizedEntryPath) ||
+      zipFile.getEntry(normalizedEntryPath) != null
+
+  private[zip] def entryOf(normalizedEntryPath: String): ZipEntry =
+    zipFile.getEntry(normalizedEntryPath)
+
+  private[zip] def childrenOf(dir: String): Vector[String] =
+    childrenIndex.getOrElse(dir, Vector.empty)
+
+  private[zip] def readEntryBytes(normalizedEntryPath: String): Array[Byte] = {
+    val entry = entryOf(normalizedEntryPath)
+    if (entry == null)
+      throw new NoSuchFileException(normalizedEntryPath)
+    val in = zipFile.getInputStream(entry)
+    try {
+      val initialSize = Math.max(32L, entry.getSize()).min(Int.MaxValue).toInt
+      val out = new ByteArrayOutputStream(initialSize)
+      val buf = new Array[Byte](8192)
+      var n = in.read(buf)
+      while (n != -1) {
+        out.write(buf, 0, n)
+        n = in.read(buf)
+      }
+      out.toByteArray()
+    } finally in.close()
+  }
+
+  override def provider(): FileSystemProvider = fsProvider
+
+  override def close(): Unit =
+    if (!closed) {
+      closed = true
+      zipFile.close()
+      ZipFileSystemProvider.unregister(this)
+    }
+
+  override def getFileStores(): Iterable[FileStore] =
+    new ju.LinkedList[FileStore]()
+
+  override def getUserPrincipalLookupService(): UserPrincipalLookupService =
+    throw new UnsupportedOperationException()
+
+  override def getPath(first: String, more: Array[String]): Path = {
+    if (more.length == 0) new ZipPath(this, first)
+    else {
+      val sb = new StringBuilder(first)
+      more.foreach { element =>
+        if (element.length > 0) {
+          if (sb.length() > 0) sb.append('/')
+          sb.append(element)
+        }
+      }
+      new ZipPath(this, sb.toString())
+    }
+  }
+
+  override def getPathMatcher(syntaxAndPattern: String): PathMatcher =
+    PathMatcherImpl(syntaxAndPattern)
+
+  override def getRootDirectories(): Iterable[Path] = {
+    val list = new ju.LinkedList[Path]()
+    list.add(new ZipPath(this, "/"))
+    list
+  }
+
+  override def getSeparator(): String = "/"
+
+  override def isOpen(): Boolean = !closed
+
+  override def isReadOnly(): Boolean = true
+
+  override def newWatchService(): WatchService =
+    throw new UnsupportedOperationException()
+
+  override def supportedFileAttributeViews(): ju.Set[String] = {
+    val set = new ju.HashSet[String]()
+    set.add("basic")
+    set
+  }
+}
diff --git a/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipFileSystemProvider.scala b/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipFileSystemProvider.scala
new file mode 100644
index 00000000..b4404057
--- /dev/null
+++ b/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipFileSystemProvider.scala
@@ -0,0 +1,392 @@
+package scala.scalanative.nio.fs.zip
+
+import java.io.File
+import java.net.URI
+import java.nio.ByteBuffer
+import java.nio.channels.{
+  ClosedChannelException, NonWritableChannelException, SeekableByteChannel
+}
+import java.nio.file._
+import java.nio.file.attribute._
+import java.nio.file.spi.FileSystemProvider
+import java.util.concurrent.ConcurrentHashMap
+import java.util.{Map => JMap, Set => JSet}
+
+/** Minimal, read-only "jar:" FileSystemProvider.
+ *
+ *  Scope, deliberately: enough to make `java.nio.file.FileSystems.newFileSystem
+ *  (URI("jar:file:/x.jar"), _)` / `Files.walk` / `Files.readAllBytes` work
+ *  against a jar's entries -- the exact surface `scala.scalanative.io.
+ *  VirtualDirectory.jar` (see util/src/main/scala/scala/scalanative/io/
+ *  VirtualDirectory.scala) needs, and the gap scala-native's own `tools`
+ *  project comment and linker (ClassLoader.fromDisk -> VirtualDirectory$.jar)
+ *  hit as `ProviderNotFoundException`. Not implemented: writing into a jar,
+ *  symbolic links, `getPath(URI)` beyond the plain "jar:file:...!/entry" form.
+ *  Reading is delegated entirely to `java.util.zip.ZipFile`, which is a real,
+ *  tested Scala Native javalib port already -- this class is just NIO
+ *  plumbing (Path/FileSystem/Provider) around it.
+ */
+class ZipFileSystemProvider extends FileSystemProvider {
+  import ZipFileSystemProvider._
+
+  override def getScheme(): String = "jar"
+
+  override def newFileSystem(uri: URI, env: JMap[String, _]): FileSystem = {
+    // Deliberately does NOT enforce real zipfs's usual "one filesystem per
+    // path, second open throws FileSystemAlreadyExistsException" rule.
+    // scala-native's own linker (VirtualDirectory.jar, opened for the whole
+    // link's duration to read .nir classpath entries) and its native-library
+    // unpacker (NativeLib/IO.unzip, opened per compile) can both legitimately
+    // want the SAME physical jar open at once -- e.g. a nativelib jar is both
+    // a classpath entry and a bundle of C sources to unpack. Since this
+    // provider is read-only (no writes to conflict), each open is just an
+    // independent `java.util.zip.ZipFile` (its own RandomAccessFile handle)
+    // over the same bytes -- safe to allow concurrently, unlike a writable
+    // zipfs where JDK's exclusivity rule actually prevents real corruption.
+    val jarPath = jarPathOf(uri)
+    val fs = new ZipFileSystem(this, jarPath)
+    registry.put(keyOf(jarPath), fs)
+    fs
+  }
+
+  override def getFileSystem(uri: URI): FileSystem = {
+    // Best-effort only: returns whichever open filesystem for this path was
+    // last created (or registered again on close-of-an-older-one, see
+    // `unregister`), not "the" filesystem -- there may be several
+    // simultaneously open. Only relied on by `getPath`, not by any real
+    // caller in this codebase (VirtualDirectory.jar/IO.unzip both work
+    // entirely off the FileSystem `newFileSystem` itself returns).
+    val jarPath = jarPathOf(uri)
+    registry.get(keyOf(jarPath)) match {
+      case null => throw new FileSystemNotFoundException(jarPath)
+      case fs   => fs
+    }
+  }
+
+  override def getPath(uri: URI): Path = {
+    val jarPath = jarPathOf(uri)
+    val entry = entryPathOf(uri)
+    val fs = getFileSystem(uri).asInstanceOf[ZipFileSystem]
+    fs.getPath(entry, Array.empty)
+  }
+
+  override def newFileSystem(path: Path, env: JMap[String, _]): FileSystem =
+    newFileSystem(URI.create(s"jar:${path.toUri()}"), env)
+
+  override def newByteChannel(
+      path: Path,
+      options: JSet[_ <: OpenOption],
+      attrs: Array[FileAttribute[_]]
+  ): SeekableByteChannel = {
+    val writeRequested = {
+      val it = options.iterator()
+      var found = false
+      while (it.hasNext() && !found) {
+        it.next() match {
+          case StandardOpenOption.WRITE | StandardOpenOption.APPEND |
+              StandardOpenOption.CREATE | StandardOpenOption.CREATE_NEW |
+              StandardOpenOption.DELETE_ON_CLOSE =>
+            found = true
+          case _ => ()
+        }
+      }
+      found
+    }
+    if (writeRequested) throw new ReadOnlyFileSystemException()
+
+    val zp = asZipPath(path)
+    val norm = zp.normalizedEntryPath
+    if (zp.zfs.isDir(norm))
+      throw new java.io.IOException(s"Is a directory: $path")
+    if (!zp.zfs.exists(norm)) throw new NoSuchFileException(path.toString())
+
+    new InMemoryByteChannel(zp.zfs.readEntryBytes(norm))
+  }
+
+  override def newDirectoryStream(
+      dir: Path,
+      filter: DirectoryStream.Filter[_ >: Path]
+  ): DirectoryStream[Path] = {
+    val zp = asZipPath(dir)
+    val norm = zp.normalizedEntryPath
+    if (!zp.zfs.isDir(norm)) throw new NotDirectoryException(dir.toString())
+
+    val children = new java.util.ArrayList[Path]()
+    zp.zfs.childrenOf(norm).foreach(name => children.add(zp.resolveChild(name)))
+    new DirectoryStreamImpl[Path](children.stream(), filter)
+  }
+
+  override def createDirectory(
+      dir: Path,
+      attrs: Array[FileAttribute[_]]
+  ): Unit = throw new ReadOnlyFileSystemException()
+
+  override def delete(path: Path): Unit =
+    throw new ReadOnlyFileSystemException()
+
+  override def copy(source: Path, target: Path, options: Array[CopyOption]): Unit =
+    throw new ReadOnlyFileSystemException()
+
+  override def move(source: Path, target: Path, options: Array[CopyOption]): Unit =
+    throw new ReadOnlyFileSystemException()
+
+  override def isSameFile(path: Path, path2: Path): Boolean =
+    (path, path2) match {
+      case (a: ZipPath, b: ZipPath) =>
+        a.zfs == b.zfs && a.normalizedEntryPath == b.normalizedEntryPath
+      case _ => false
+    }
+
+  override def isHidden(path: Path): Boolean = {
+    val zp = asZipPath(path)
+    val name = zp.getFileName()
+    name != null && name.toString.startsWith(".")
+  }
+
+  override def checkAccess(path: Path, modes: Array[AccessMode]): Unit = {
+    val zp = asZipPath(path)
+    val norm = zp.normalizedEntryPath
+    if (!zp.zfs.exists(norm)) throw new NoSuchFileException(path.toString())
+    if (modes.contains(AccessMode.WRITE) || modes.contains(AccessMode.EXECUTE))
+      throw new AccessDeniedException(path.toString())
+  }
+
+  override def getFileAttributeView[V <: FileAttributeView](
+      path: Path,
+      tpe: Class[V],
+      options: Array[LinkOption]
+  ): V = {
+    val zp = asZipPath(path)
+    if (tpe == classOf[BasicFileAttributeView]) {
+      val view = new BasicFileAttributeView {
+        override def name(): String = "basic"
+        override def readAttributes(): BasicFileAttributes =
+          attributesOf(zp)
+        override def setTimes(
+            lastModifiedTime: FileTime,
+            lastAccessTime: FileTime,
+            createTime: FileTime
+        ): Unit = throw new ReadOnlyFileSystemException()
+        // The FileAttributeView default routes getAttribute()/asMap through
+        // an empty map -- Files.getAttribute("basic:size", ...) (which
+        // Files.size()/readAllBytes() depend on) goes through exactly this,
+        // not readAttributes(), so it must be overridden too.
+        override def asMap: JMap[String, Object] = attributesMapOf(zp)
+      }
+      view.asInstanceOf[V]
+    } else if (tpe == classOf[PosixFileAttributeView]) {
+      // Files.copy() (used by IO.unzip's copyRecursive, in turn used to
+      // unpack native-library jars for the C compile step) unconditionally
+      // reads PosixFileAttributes on non-Windows -- returning null here (as
+      // an unsupported view) surfaces as a bare NullPointerException deep in
+      // Files.readAttributes, not a clean UnsupportedOperationException, so
+      // this must be a real, if synthetic (jar entries have no real POSIX
+      // metadata), PosixFileAttributeView.
+      val view = new PosixFileAttributeView {
+        override def name(): String = "posix"
+        override def readAttributes(): PosixFileAttributes =
+          posixAttributesOf(zp)
+        override def setTimes(
+            lastModifiedTime: FileTime,
+            lastAccessTime: FileTime,
+            createTime: FileTime
+        ): Unit = throw new ReadOnlyFileSystemException()
+        override def setPermissions(
+            perms: JSet[PosixFilePermission]
+        ): Unit = throw new ReadOnlyFileSystemException()
+        override def setGroup(group: GroupPrincipal): Unit =
+          throw new ReadOnlyFileSystemException()
+        override def getOwner(): UserPrincipal = syntheticPrincipal
+        override def setOwner(owner: UserPrincipal): Unit =
+          throw new ReadOnlyFileSystemException()
+        override def asMap: JMap[String, Object] = attributesMapOf(zp)
+      }
+      view.asInstanceOf[V]
+    } else null.asInstanceOf[V]
+  }
+
+  override def readAttributes[A <: BasicFileAttributes](
+      path: Path,
+      tpe: Class[A],
+      options: Array[LinkOption]
+  ): A = {
+    val zp = asZipPath(path)
+    if (tpe == classOf[BasicFileAttributes]) attributesOf(zp).asInstanceOf[A]
+    else if (tpe == classOf[PosixFileAttributes])
+      posixAttributesOf(zp).asInstanceOf[A]
+    else throw new UnsupportedOperationException(tpe.getName())
+  }
+
+  override def readAttributes(
+      path: Path,
+      attributes: String,
+      options: Array[LinkOption]
+  ): JMap[String, Object] = attributesMapOf(asZipPath(path))
+
+  private def attributesMapOf(zp: ZipPath): JMap[String, Object] = {
+    val attrs = attributesOf(zp)
+    val map = new java.util.HashMap[String, Object]()
+    map.put("isDirectory", Boolean.box(attrs.isDirectory()))
+    map.put("isRegularFile", Boolean.box(attrs.isRegularFile()))
+    map.put("isSymbolicLink", Boolean.box(attrs.isSymbolicLink()))
+    map.put("isOther", Boolean.box(attrs.isOther()))
+    map.put("size", Long.box(attrs.size()))
+    map.put("lastModifiedTime", attrs.lastModifiedTime())
+    map.put("lastAccessTime", attrs.lastAccessTime())
+    map.put("creationTime", attrs.creationTime())
+    map.put("fileKey", attrs.fileKey())
+    map
+  }
+
+  override def setAttribute(
+      path: Path,
+      attribute: String,
+      value: Object,
+      options: Array[LinkOption]
+  ): Unit = throw new ReadOnlyFileSystemException()
+
+  private def attributesOf(zp: ZipPath): BasicFileAttributes = {
+    val norm = zp.normalizedEntryPath
+    val zfs = zp.zfs
+    if (!zfs.exists(norm)) throw new NoSuchFileException(zp.toString())
+    val isDir = zfs.isDir(norm)
+    val entry = zfs.entryOf(norm)
+    val mtime = FileTime.fromMillis(if (entry != null) entry.getTime() else 0L)
+    val entrySize = if (isDir || entry == null) 0L else entry.getSize()
+
+    new BasicFileAttributes {
+      override def creationTime(): FileTime = mtime
+      override def fileKey(): Object = norm
+      override def isDirectory(): Boolean = isDir
+      override def isOther(): Boolean = false
+      override def isRegularFile(): Boolean = !isDir
+      override def isSymbolicLink(): Boolean = false
+      override def lastAccessTime(): FileTime = mtime
+      override def lastModifiedTime(): FileTime = mtime
+      override def size(): Long = entrySize
+    }
+  }
+
+  private def posixAttributesOf(zp: ZipPath): PosixFileAttributes = {
+    val norm = zp.normalizedEntryPath
+    val zfs = zp.zfs
+    if (!zfs.exists(norm)) throw new NoSuchFileException(zp.toString())
+    val isDir = zfs.isDir(norm)
+    val entry = zfs.entryOf(norm)
+    val mtime = FileTime.fromMillis(if (entry != null) entry.getTime() else 0L)
+    val entrySize = if (isDir || entry == null) 0L else entry.getSize()
+    // Jar entries carry no real POSIX metadata -- a fixed, read-only mode
+    // (world-readable, +x on directories for traversal) is enough for
+    // IO.unzip's copyRecursive to extract entries correctly; nothing in this
+    // provider's real callers inspects permissions beyond that.
+    val perms = PosixFilePermissions.fromString(
+      if (isDir) "r-xr-xr-x" else "r--r--r--"
+    )
+
+    new PosixFileAttributes {
+      override def creationTime(): FileTime = mtime
+      override def fileKey(): Object = norm
+      override def isDirectory(): Boolean = isDir
+      override def isOther(): Boolean = false
+      override def isRegularFile(): Boolean = !isDir
+      override def isSymbolicLink(): Boolean = false
+      override def lastAccessTime(): FileTime = mtime
+      override def lastModifiedTime(): FileTime = mtime
+      override def size(): Long = entrySize
+      override def group(): GroupPrincipal = syntheticPrincipal
+      override def owner(): UserPrincipal = syntheticPrincipal
+      override def permissions(): JSet[PosixFilePermission] = perms
+    }
+  }
+
+  private val syntheticPrincipal: UserPrincipal & GroupPrincipal =
+    new UserPrincipal with GroupPrincipal {
+      override def getName(): String = "nobody"
+    }
+
+  private def asZipPath(path: Path): ZipPath = path match {
+    case zp: ZipPath => zp
+    case _           => throw new ProviderMismatchException()
+  }
+}
+
+object ZipFileSystemProvider {
+  private val registry = new ConcurrentHashMap[String, ZipFileSystem]()
+
+  private[zip] def unregister(fs: ZipFileSystem): Unit =
+    registry.remove(keyOf(fs.jarPath), fs)
+
+  /** Extract the underlying jar's local file path from a "jar:file:...[!/entry]"
+   *  URI. Deliberately string-based rather than relying on java.net.URI's
+   *  opaque-vs-hierarchical parsing of the nested "file:" URI, which
+   *  "jar:file:/x.jar" (single leading slash, no authority) sits right at the
+   *  edge of.
+   */
+  private def jarPathOf(uri: URI): String = {
+    val s = uri.toString
+    if (!s.startsWith("jar:"))
+      throw new IllegalArgumentException(s"Not a jar: URI: $uri")
+    val rest = s.substring(4)
+    val bang = rest.indexOf("!/")
+    val fileUriStr = if (bang >= 0) rest.substring(0, bang) else rest
+    if (!fileUriStr.startsWith("file:"))
+      throw new IllegalArgumentException(s"Unsupported nested scheme: $uri")
+    new File(new URI(fileUriStr)).getPath()
+  }
+
+  private def entryPathOf(uri: URI): String = {
+    val s = uri.toString
+    val bang = s.indexOf("!/")
+    if (bang < 0) "/" else s.substring(bang + 1)
+  }
+
+  private def keyOf(jarPath: String): String =
+    new File(jarPath).getAbsolutePath()
+
+  /** A fully in-memory, read-only SeekableByteChannel over a jar entry's
+   *  decompressed bytes. `java.util.zip.ZipFile#getInputStream` is not
+   *  seekable, and archive entries read by this provider (compiled .nir/
+   *  .class files) are small, so eager, whole-entry buffering keeps this
+   *  provider simple instead of layering a seek emulation atop Inflater.
+   */
+  private final class InMemoryByteChannel(data: Array[Byte])
+      extends SeekableByteChannel {
+    private var pos: Int = 0
+    private var open: Boolean = true
+
+    override def isOpen(): Boolean = open
+    override def close(): Unit = open = false
+
+    private def ensureOpen(): Unit =
+      if (!open) throw new ClosedChannelException()
+
+    override def read(dst: ByteBuffer): Int = {
+      ensureOpen()
+      if (pos >= data.length) -1
+      else {
+        val n = math.min(dst.remaining(), data.length - pos)
+        dst.put(data, pos, n)
+        pos += n
+        n
+      }
+    }
+
+    override def write(src: ByteBuffer): Int =
+      throw new NonWritableChannelException()
+
+    override def position(): Long = { ensureOpen(); pos.toLong }
+
+    override def position(newPosition: Long): SeekableByteChannel = {
+      ensureOpen()
+      if (newPosition < 0 || newPosition > Int.MaxValue)
+        throw new IllegalArgumentException(newPosition.toString)
+      pos = newPosition.toInt
+      this
+    }
+
+    override def size(): Long = { ensureOpen(); data.length.toLong }
+
+    override def truncate(size: Long): SeekableByteChannel =
+      throw new NonWritableChannelException()
+  }
+}
diff --git a/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipPath.scala b/javalib/src/main/scala/scala/scalanative/nio/fs/zip/ZipPath.scala
