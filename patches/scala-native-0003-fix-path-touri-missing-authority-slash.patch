diff --git a/javalib/src/main/scala/scala/scalanative/nio/fs/unix/UnixPath.scala b/javalib/src/main/scala/scala/scalanative/nio/fs/unix/UnixPath.scala
index 0d10479..29e427e 100644
--- a/javalib/src/main/scala/scala/scalanative/nio/fs/unix/UnixPath.scala
+++ b/javalib/src/main/scala/scala/scalanative/nio/fs/unix/UnixPath.scala
@@ -64,7 +64,12 @@ class UnixPath(private val fs: UnixFileSystem, rawPath: String) extends Path {
     new URI(
       scheme = "file",
       userInfo = null,
-      host = null,
+      // Empty string, not null: URI's authority component (and thus the
+      // "//" that precedes it) is only emitted when host/userInfo/port are
+      // non-default -- host = null means "no authority at all", producing
+      // "file:/abs/path" instead of the standard "file:///abs/path" real
+      // JDK's Path#toUri() always returns for a local file with no host.
+      host = "",
       port = -1,
       path = toFile().getAbsolutePath(),
       query = null,
