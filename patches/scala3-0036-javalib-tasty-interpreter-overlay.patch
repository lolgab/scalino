+package dotty.tools.dotc
+package quoted
+
+import java.nio.charset.Charset
+import java.util.Locale
+
+/** Calls on values the interpreter represents by their real host object:
+ *  `String` and the boxed primitives. These classes have no body to interpret
+ *  (they are `java.lang` natives; even in javalib, `String` is a thin wrapper
+ *  over a char array), so every public method is reachable here by name and
+ *  runtime argument types, rather than one hand-picked overload at a time.
+ *
+ *  Arguments arrive as boxed values; an `int`/`char` parameter may be given
+ *  either a `Character` or an `Integer` (a `Char` argument widened at the call
+ *  site), which `int`/`str` normalise.
+ */
+object HostValueCalls:
+  private def int(o: Object): Int = o match
+    case i: Integer => i.intValue
+    case c: Character => c.charValue.toInt
+    case b: java.lang.Byte => b.intValue
+    case s: java.lang.Short => s.intValue
+  private def bool(o: Object): Boolean = o.asInstanceOf[java.lang.Boolean].booleanValue
+  private def isInt(o: Object): Boolean = o.isInstanceOf[Integer] || o.isInstanceOf[Character] || o.isInstanceOf[java.lang.Byte] || o.isInstanceOf[java.lang.Short]
+  private def cs(o: Object): CharSequence = o.asInstanceOf[CharSequence]
+  private def box(b: Boolean): Object = java.lang.Boolean.valueOf(b)
+  private def box(i: Int): Object = Integer.valueOf(i)
+
+  def string(s: String, name: String, args: List[Object]): Option[Object] =
+    (name, args) match
+      case ("length", Nil) => Some(box(s.length))
+      case ("isEmpty", Nil) => Some(box(s.isEmpty))
+      case ("isBlank", Nil) => Some(box(s.isBlank))
+      case ("charAt", i :: Nil) => Some(Character.valueOf(s.charAt(int(i))))
+      case ("codePointAt", i :: Nil) => Some(box(s.codePointAt(int(i))))
+      case ("codePointBefore", i :: Nil) => Some(box(s.codePointBefore(int(i))))
+      case ("codePointCount", a :: b :: Nil) => Some(box(s.codePointCount(int(a), int(b))))
+      case ("offsetByCodePoints", a :: b :: Nil) => Some(box(s.offsetByCodePoints(int(a), int(b))))
+      case ("hashCode", Nil) => Some(box(s.hashCode))
+      case ("equals", o :: Nil) => Some(box(s == o))
+      case ("toString", Nil) => Some(s)
+      case ("intern", Nil) => Some(s.intern)
+      case ("compareTo", (o: String) :: Nil) => Some(box(s.compareTo(o)))
+      case ("compareToIgnoreCase", (o: String) :: Nil) => Some(box(s.compareToIgnoreCase(o)))
+      case ("equalsIgnoreCase", o :: Nil) => Some(box(o match { case o: String => s.equalsIgnoreCase(o); case _ => false }))
+      case ("contentEquals", o :: Nil) => Some(box(s.contentEquals(cs(o))))
+      case ("contains", o :: Nil) => Some(box(s.contains(cs(o))))
+      case ("startsWith", (p: String) :: Nil) => Some(box(s.startsWith(p)))
+      case ("startsWith", (p: String) :: i :: Nil) => Some(box(s.startsWith(p, int(i))))
+      case ("endsWith", (p: String) :: Nil) => Some(box(s.endsWith(p)))
+      case ("matches", (re: String) :: Nil) => Some(box(s.matches(re)))
+      case ("regionMatches", a :: (o: String) :: b :: c :: Nil) if isInt(a) => Some(box(s.regionMatches(int(a), o, int(b), int(c))))
+      case ("regionMatches", ic :: a :: (o: String) :: b :: c :: Nil) => Some(box(s.regionMatches(bool(ic), int(a), o, int(b), int(c))))
+      case ("indexOf", (x: String) :: Nil) => Some(box(s.indexOf(x)))
+      case ("indexOf", (x: String) :: from :: Nil) => Some(box(s.indexOf(x, int(from))))
+      case ("indexOf", x :: Nil) if isInt(x) => Some(box(s.indexOf(int(x))))
+      case ("indexOf", x :: from :: Nil) if isInt(x) => Some(box(s.indexOf(int(x), int(from))))
+      case ("lastIndexOf", (x: String) :: Nil) => Some(box(s.lastIndexOf(x)))
+      case ("lastIndexOf", (x: String) :: from :: Nil) => Some(box(s.lastIndexOf(x, int(from))))
+      case ("lastIndexOf", x :: Nil) if isInt(x) => Some(box(s.lastIndexOf(int(x))))
+      case ("lastIndexOf", x :: from :: Nil) if isInt(x) => Some(box(s.lastIndexOf(int(x), int(from))))
+      case ("substring", a :: Nil) => Some(s.substring(int(a)))
+      case ("substring", a :: b :: Nil) => Some(s.substring(int(a), int(b)))
+      case ("subSequence", a :: b :: Nil) => Some(s.subSequence(int(a), int(b)))
+      case ("concat", (o: String) :: Nil) => Some(s.concat(o))
+      case ("replace", a :: b :: Nil) if isInt(a) && isInt(b) => Some(s.replace(int(a).toChar, int(b).toChar))
+      case ("replace", a :: b :: Nil) => Some(s.replace(cs(a), cs(b)))
+      case ("replaceAll", (a: String) :: (b: String) :: Nil) => Some(s.replaceAll(a, b))
+      case ("replaceFirst", (a: String) :: (b: String) :: Nil) => Some(s.replaceFirst(a, b))
+      // `split` yields a real `Array[String]` (see the note in `Interpreter`'s `String` rows).
+      case ("split", (re: String) :: Nil) => Some(s.split(re))
+      case ("split", (re: String) :: limit :: Nil) => Some(s.split(re, int(limit)))
+      case ("toLowerCase", Nil) => Some(s.toLowerCase)
+      case ("toLowerCase", (l: Locale) :: Nil) => Some(s.toLowerCase(l))
+      case ("toUpperCase", Nil) => Some(s.toUpperCase)
+      case ("toUpperCase", (l: Locale) :: Nil) => Some(s.toUpperCase(l))
+      case ("trim", Nil) => Some(s.trim)
+      case ("strip", Nil) => Some(s.strip)
+      case ("stripLeading", Nil) => Some(s.stripLeading)
+      case ("stripTrailing", Nil) => Some(s.stripTrailing)
+      case ("stripIndent", Nil) => Some(s.stripIndent)
+      case ("translateEscapes", Nil) => Some(s.translateEscapes)
+      case ("indent", n :: Nil) => Some(s.indent(int(n)))
+      case ("repeat", n :: Nil) => Some(s.repeat(int(n)))
+      case ("toCharArray", Nil) => Some(s.toCharArray)
+      case ("getBytes", Nil) => Some(s.getBytes)
+      case ("getBytes", (c: Charset) :: Nil) => Some(s.getBytes(c))
+      case ("getBytes", (c: String) :: Nil) => Some(s.getBytes(c))
+      case ("chars", Nil) => Some(s.chars)
+      case ("codePoints", Nil) => Some(s.codePoints)
+      case ("lines", Nil) => Some(s.lines)
+      case _ => None
+
+  /** The interpreter represents every `Array[T]` as an `Array[Object]` of boxes
+   *  (see `interpretNew`); a real host `byte[]`/`char[]` is rebuilt from it.
+   *  `elem` is the declared element type of the parameter (`"Byte"`/`"Char"`).
+   */
+  private def realArray(a: Object, elem: String): Object = a match
+    case arr: Array[Object] if elem == "Byte" => Array.tabulate(arr.length)(i => arr(i).asInstanceOf[Number].byteValue)
+    case arr: Array[Object] if elem == "Char" => Array.tabulate(arr.length)(i => arr(i).asInstanceOf[Character].charValue)
+    case other => other
+
+  /** `new String(...)`; `elem` is the element type name of the constructor's array parameter, if any. */
+  def newString(args0: List[Object], elem: String): Option[Object] =
+    val args = args0.map(realArray(_, elem))
+    args match
+      case Nil => Some("")
+      case (s: String) :: Nil => Some(new String(s))
+      case (b: Array[Byte]) :: Nil => Some(new String(b))
+      case (b: Array[Byte]) :: (c: Charset) :: Nil => Some(new String(b, c))
+      case (b: Array[Byte]) :: (c: String) :: Nil => Some(new String(b, c))
+      case (b: Array[Byte]) :: off :: len :: Nil => Some(new String(b, int(off), int(len)))
+      case (b: Array[Byte]) :: off :: len :: (c: Charset) :: Nil => Some(new String(b, int(off), int(len), c))
+      case (b: Array[Byte]) :: off :: len :: (c: String) :: Nil => Some(new String(b, int(off), int(len), c))
+      case (c: Array[Char]) :: Nil => Some(new String(c))
+      case (c: Array[Char]) :: off :: len :: Nil => Some(new String(c, int(off), int(len)))
+      case (sb: java.lang.StringBuilder) :: Nil => Some(new String(sb))
+      case (sb: java.lang.StringBuffer) :: Nil => Some(new String(sb))
+      case _ => None
+
+  /** `x.toByte`/`toShort`/`toChar`/`toInt`/`toLong`/`toFloat`/`toDouble` on any boxed numeric or `Char`. */
+  def numericConversion(x: Object, name: String): Option[Object] =
+    val n: Number | Null = x match
+      case n: Number => n
+      case c: Character => Integer.valueOf(c.charValue.toInt)
+      case _ => null
+    if n == null then None
+    else name match
+      case "toByte" => Some(java.lang.Byte.valueOf(n.byteValue))
+      case "toShort" => Some(java.lang.Short.valueOf(n.shortValue))
+      case "toChar" => Some(Character.valueOf(n.intValue.toChar))
+      case "toInt" => Some(Integer.valueOf(n.intValue))
+      case "toLong" => Some(java.lang.Long.valueOf(n.longValue))
+      case "toFloat" => Some(java.lang.Float.valueOf(n.floatValue))
+      case "toDouble" => Some(java.lang.Double.valueOf(n.doubleValue))
+      case _ => None
