+import dotty.tools.io.AbstractFile
+
+/** Method bodies for JDK classes, read from scala-native's javalib TASTy.
+ *
+ *  The compiler sees `java.util.StringJoiner` as a Java-defined class (from
+ *  the JDK stub), which has no tree to interpret. scala-native's javalib,
+ *  however, implements it in Scala, and its `.tasty` files (`javalib-tasty.jar`,
+ *  `build/01b-build-patched-javalib.sh`) carry every method body.
+ *
+ *  Those files define classes under the *same names* as the JDK ones, so
+ *  they cannot be loaded the usual way (the new symbols would replace the
+ *  JDK ones in their package scope, changing how the rest of the
+ *  compilation sees them). Instead each file is unpickled "detached"
+ *  (`DottyUnpickler#enterDetached`): fresh "shadow" symbols that are never
+ *  entered anywhere, and that refer to each other (and to javalib-only
+ *  helper classes) rather than to the JDK versions. A Java-defined member is
+ *  mapped to its shadow definition by (owning class, name, erased parameter
+ *  types).
+ *
+ *  Loading is two-staged. *Entering* a file (creating its shadow symbols)
+ *  happens as soon as another javalib file refers to it. *Indexing* it
+ *  (reading its trees) only happens when a body from it is needed, so a
+ *  class that is merely mentioned costs one name-table read.
+ *
+ *  The `java.lang` core classes (`String`, boxes, `Throwable`, ...) are never
+ *  shadowed: the interpreter represents them by real host objects.
+ */
+final class JavalibOverlay(root: AbstractFile):
+  import JavalibOverlay.*
+
+  /** Entered files by top-level class full name. */
+  private val units = mutable.Map.empty[String, DottyUnpickler]
+  private val noFile = mutable.Set.empty[String]
+  private val indexed = mutable.Set.empty[String]
+  /** Top-level shadow class/module symbols -> the file (full name) defining them. */
+  private val unitOfTop = java.util.IdentityHashMap[Symbol, String]()
+  /** Definition tree of every indexed shadow member/class symbol. */
+  private val treeOf = java.util.IdentityHashMap[Symbol, Tree]()
+  private val byKey = mutable.Map.empty[Key, List[Symbol]]
+  /** Top-level shadow definitions of every entered file, by (package class, name). */
+  private val tops = mutable.Map.empty[(Symbol, Name), Symbol]
+
+  private def topLevelOf(sym: Symbol)(using Context): Symbol =
+    var c = sym
+    while c.exists && c.maybeOwner.exists && !c.owner.is(PackageClass) do c = c.owner
+    c
+
+  def isShadow(sym: Symbol)(using Context): Boolean =
+    sym.exists && (treeOf.containsKey(sym) || unitOfTop.containsKey(topLevelOf(sym)))
+
+  /** The shadow definition tree for `sym`: `sym` itself when it already is a
+   *  shadow symbol, otherwise the same-named member of the javalib class
+   *  standing in for `sym`'s Java-defined owner. `EmptyTree` if there is none.
+   */
+  def treeFor(sym: Symbol)(using Context): Tree =
+    if !sym.exists then EmptyTree
+    else
+      val direct = treeOf.get(sym)
+      if direct != null then direct
+      else
+        val fileOfShadow = unitOfTop.get(topLevelOf(sym))
+        if fileOfShadow != null then
+          index(fileOfShadow)
+          Option(treeOf.get(sym)).getOrElse(EmptyTree)
+        else if sym.is(JavaDefined) && !sym.isClass && sym.maybeOwner.exists then
+          topLevelName(sym.owner).foreach(name => if enter(name) then index(name))
+          byKey.getOrElse(keyOf(sym), Nil) match
+            case shadow :: _ => treeOf.get(shadow)
+            case Nil => EmptyTree
+        else EmptyTree
+
+  private def topLevelName(cls: Symbol)(using Context): Option[String] =
+    val c = topLevelOf(cls)
+    if c.exists && c.maybeOwner.exists then
+      Some((c.owner.fullName.toString + "." + c.name.stripModuleClassSuffix.toString).stripPrefix("<empty>."))
+    else None
+
+  /** Creates the shadow symbols of top-level class `name`'s file, if javalib has one. */
+  private def enter(name: String)(using Context): Boolean =
+    if units.contains(name) then true
+    else if noFile.contains(name) || !name.startsWith("java.") || isHostNative(name) then false
+    else
+      val file = find(name.replace('.', '/') + ".tasty")
+      if file == null then
+        noFile += name
+        false
+      else
+        try
+          val unpickler = new DottyUnpickler(file, file.toByteArray, isBestEffortTasty = false)
+          units(name) = unpickler
+          val sctx = ctx.withSource(NoSource)
+          unpickler.enterDetached(tops, loadByRef)(using sctx)
+          // remember which symbols belong to this file
+          val dot = name.lastIndexOf('.')
+          val pkg = requiredPackage(name.substring(0, dot)).moduleClass
+          val simple = name.substring(dot + 1)
+          for n <- List(typeName(simple), typeName(simple + "$")) do
+            tops.get((pkg, n)).foreach(s => unitOfTop.put(s, name))
+          true
+        catch case e: Exception if !e.isInstanceOf[java.nio.file.NoSuchFileException] =>
+          units -= name
+          noFile += name
+          if System.getenv("SCALINO_INTERP_DEBUG") != null then
+            Console.err.println(s"[javalib-overlay] failed to read $name: $e")
+          false
+
+  /** Reads and indexes the trees of an entered file. */
+  private def index(name: String)(using Context): Unit =
+    if !indexed.contains(name) then
+      indexed += name
+      units.get(name).foreach { unpickler =>
+        try
+          val sctx = ctx.withSource(NoSource)
+          unpickler.rootTrees(using sctx).foreach(indexTree(_)(using sctx))
+        catch case e: Exception =>
+          if System.getenv("SCALINO_INTERP_DEBUG") != null then
+            Console.err.println(s"[javalib-overlay] failed to index $name: $e")
+      }
+
+  /** A qualified reference, inside javalib TASTy, to top-level `name` of
+   *  package class `pkg`: enter the file defining it, if javalib has one.
+   */
+  private def loadByRef(pkg: Symbol, name: Name, ctx0: Context): Unit =
+    given Context = ctx0
+    // javalib names its `java.lang` classes that are special to the compiler
+    // `_String`, `_Enum`, ... (scala-native's nscplugin maps them back): those
+    // stand for the JDK classes.
+    if pkg == defn.JavaLangPackageVal.moduleClass && name.toString.startsWith("_") && !name.toString.startsWith("__") then
+      val real = name.toString.drop(1)
+      val jdk = pkg.info.decl(if name.isTypeName then typeName(real) else termName(real)).symbol
+      if jdk.exists then tops((pkg, name)) = jdk
+    else
+      val base = name.stripModuleClassSuffix.toString
+      val full = if pkg.isEmptyPackage then base else pkg.fullName.toString + "." + base
+      enter(full)
+
+  /** `lookupPathUnchecked` is unsupported on the root of a zip archive; walk it by iteration. */
+  private def find(path: String): AbstractFile | Null =
+    var cur: AbstractFile | Null = root
+    val parts = path.split('/')
+    var i = 0
+    while cur != null && i < parts.length do
+      cur = cur.iterator.find(_.name == parts(i)).orNull
+      i += 1
+    cur
+
+  private def indexTree(tree: Tree)(using Context): Unit = tree match
+    case PackageDef(_, stats) => stats.foreach(indexTree)
+    case td: TypeDef if td.rhs.isInstanceOf[Template] =>
+      val tmpl = td.rhs.asInstanceOf[Template]
+      treeOf.put(td.symbol, td)
+      (tmpl.constr :: tmpl.body).foreach(indexTree)
+    case m @ (_: DefDef | _: ValDef) =>
+      treeOf.put(m.symbol, m)
+      val key = keyOf(m.symbol)
+      byKey(key) = byKey.getOrElse(key, Nil) :+ m.symbol
+    case _ =>
+
+object JavalibOverlay:
+  /** Classes the interpreter represents by real host objects (or throws as
+   *  real host exceptions), so javalib's own implementation of them must not
+   *  replace the JDK symbols: everything in `java.lang` itself (`String`,
+   *  boxes, `StringBuilder`, `Math`, `Throwable` and its subclasses, ...).
+   */
+  private def isHostNative(topLevelName: String): Boolean =
+    topLevelName.startsWith("java.lang.") && topLevelName.indexOf('.', "java.lang.".length) < 0
+
+  /** (owner full name without module `$`, owner is module class, member name, erased parameter types) */
+  private type Key = (String, Boolean, String, String)
+
+  private def keyOf(sym: Symbol)(using Context): Key =
+    val owner = sym.owner
+    val sig = if sym.is(Method) then sym.signature.paramsSig.mkString(",") else ""
+    (owner.fullName.toString.replace("$", ""), owner.is(ModuleClass), sym.name.toString, sig)
+
+  /** The overlay over javalib's TASTy, as given by `-Xmacro-settings:javalibTasty=<jar or dir>`
+   *  (`cli/ScalinoCli.scala`'s `javalibTastyOptions`). Not a classpath entry:
+   *  dotc would then load javalib's classes in place of the JDK ones.
+   */
+  def fromSettings()(using Context): Option[JavalibOverlay] =
+    cache match
+      case (base, overlay) if base eq ctx.base => overlay
+      case _ =>
+        val overlay = create()
+        cache = (ctx.base, overlay)
+        overlay
+
+  // Symbols belong to one `ContextBase` (one compiler run / LSP session).
+  private var cache: (ContextBase, Option[JavalibOverlay]) | Null = null
+
+  private def create()(using Context): Option[JavalibOverlay] =
+    ctx.settings.XmacroSettings.value.collectFirst { case s if s.startsWith("javalibTasty=") => s.stripPrefix("javalibTasty=") }.flatMap { path =>
+      // a jar (zip) or a directory
+      Option(AbstractFile.getDirectory(dotty.tools.io.File(path))).map(new JavalibOverlay(_))
+    }
