index 00000000..c5e84939
--- /dev/null
+++ b/compiler/src/dotty/tools/dotc/ScalinoLineReader.scala
@@ -0,0 +1,469 @@
+package dotty.tools
+package dotc
+
+import java.io.{InputStream, OutputStream}
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.{Files, Path}
+import scala.collection.mutable
+
+/** The REPL's line editor (`ScalinoRepl`): what JLine does for the stock REPL, which has no Scala
+ *  Native build. A multi-line buffer edited in place, syntax highlighting as you type, history
+ *  (saved across sessions), tab completion and bracketed paste.
+ *
+ *  The terminal goes into non-canonical, no-echo mode through `stty` on `/dev/tty` (the compiler's
+ *  sources also build on the JVM, so no termios binding), only while a line is being read: the
+ *  program's own input and Ctrl-C (which ends the session, there is no evaluation thread to
+ *  interrupt) behave as without the editor.
+ *
+ *  Enter submits the input when it parses as complete and starts a new line otherwise; Alt-Enter
+ *  always starts a new line. Up/Down move between lines of the input, and through the history
+ *  from its first/last line.
+ *
+ *  @param isIncomplete does the input end inside an unfinished construct
+ *  @param highlight    the input with ANSI colors (same visible characters)
+ *  @param complete     candidates at the cursor: where the completed word starts, and the labels
+ */
+final class ScalinoLineReader(
+    historyFile: Option[Path],
+    isIncomplete: String => Boolean,
+    highlight: String => String,
+    complete: (String, Int) => (Int, List[String])):
+
+  import ScalinoLineReader.*
+
+  private val in: InputStream = System.in
+  private val out: OutputStream = System.out
+
+  private val history = mutable.ArrayBuffer.empty[String]
+  loadHistory()
+
+  private var savedMode: String | Null = null
+  /** Terminal columns, read when a line starts. */
+  private var width = 80
+
+  /** Edited text, the cursor in it (a char index) and how far below the prompt's first row the
+   *  terminal cursor is. */
+  private val buf = new java.lang.StringBuilder
+  private var cursor = 0
+  private var cursorRow = 0
+  private var prompt = ""
+  private var promptLen = 0
+  private var contPrompt = ""
+
+  /** The terminal's width in columns (80 when it can't be read). */
+  def columns: Int = width
+
+  /** Can this terminal be put into the mode the editor needs. */
+  def init(): Boolean =
+    savedMode = stty("-g").orNull
+    savedMode != null
+
+  /** Reads one input; None at end of input (Ctrl-D on an empty line). */
+  def readLine(prompt: String, contPrompt: String): Option[String] =
+    this.prompt = prompt
+    this.promptLen = visibleLength(prompt)
+    this.contPrompt = contPrompt
+    stty("size").foreach { s =>
+      s.split(' ') match
+        case Array(_, c) => c.toIntOption.filter(_ > 10).foreach(width = _)
+        case _ =>
+    }
+    stty("-icanon -echo -isig -ixon -iexten min 1 time 0")
+    write("\u001b[?2004h") // bracketed paste
+    buf.setLength(0)
+    cursor = 0
+    cursorRow = 0
+    historyIndex = history.length
+    pendingInput = ""
+    try loop()
+    finally
+      write("\u001b[?2004l")
+      restore()
+
+  /** The terminal's own mode back (also on exit). */
+  def restore(): Unit =
+    val m = savedMode
+    if m != null then stty(m)
+
+  // --- history ---
+
+  private var historyIndex = 0
+  /** The input being written when history navigation started. */
+  private var pendingInput = ""
+
+  private def loadHistory(): Unit =
+    historyFile.foreach { f =>
+      try
+        if Files.isRegularFile(f) then
+          val text = new String(Files.readAllBytes(f), UTF_8)
+          text.split("\n").iterator.filter(_.nonEmpty).foreach(l => history += unescape(l))
+      catch case _: Exception => ()
+    }
+
+  private def addHistory(entry: String): Unit =
+    if entry.trim.nonEmpty && history.lastOption.forall(_ != entry) then
+      history += entry
+      historyFile.foreach { f =>
+        try
+          Option(f.getParent).foreach(Files.createDirectories(_))
+          // trimmed to the last MaxHistory entries now and then
+          if history.length > MaxHistory + MaxHistory / 10 then
+            history.remove(0, history.length - MaxHistory)
+            Files.write(f, history.map(escape(_) + "\n").mkString.getBytes(UTF_8))
+          else
+            Files.write(f, (escape(entry) + "\n").getBytes(UTF_8),
+              java.nio.file.StandardOpenOption.CREATE, java.nio.file.StandardOpenOption.APPEND)
+        catch case _: Exception => ()
+      }
+
+  private def showHistory(i: Int): Unit =
+    if historyIndex == history.length then pendingInput = buf.toString
+    historyIndex = i
+    buf.setLength(0)
+    buf.append(if i == history.length then pendingInput else history(i))
+    cursor = buf.length
+
+  // --- input ---
+
+  /** One key press: a character (`Key.Ch`), pasted text, or a named key. */
+  private enum Key:
+    case Ch(c: Int)
+    case Paste(text: String)
+    case Enter, AltEnter, Tab, Backspace, Delete, Left, Right, Up, Down, Home, End,
+      WordLeft, WordRight, KillWordBack, KillWordForward, Eof, Ignore
+
+  private def readByte(): Int = in.read()
+
+  /** A UTF-8 encoded code point whose first byte is `b0`. */
+  private def readUtf8(b0: Int): Int =
+    val extra = if b0 >= 0xf0 then 3 else if b0 >= 0xe0 then 2 else if b0 >= 0xc0 then 1 else 0
+    var cp = if extra == 3 then b0 & 0x07 else if extra == 2 then b0 & 0x0f else if extra == 1 then b0 & 0x1f else b0
+    var i = 0
+    while i < extra do
+      val b = readByte()
+      if b < 0 then return cp
+      cp = (cp << 6) | (b & 0x3f)
+      i += 1
+    cp
+
+  private def readKey(): Key =
+    val b = readByte()
+    b match
+      case -1 => Key.Eof
+      case 27 => readEscape()
+      case 13 | 10 => Key.Enter
+      case 9 => Key.Tab
+      case 127 | 8 => Key.Backspace
+      case c if c < 32 => Key.Ch(c) // control keys, handled by `loop`
+      case c if c < 128 => Key.Ch(c)
+      case c => Key.Ch(readUtf8(c))
+
+  /** The rest of an escape sequence (CSI `ESC [ params final`, SS3 `ESC O x`, or Alt+key). */
+  private def readEscape(): Key =
+    readByte() match
+      case '[' =>
+        val params = new java.lang.StringBuilder
+        var c = readByte()
+        while c >= 0x30 && c <= 0x3f do
+          params.append(c.toChar)
+          c = readByte()
+        val p = params.toString
+        (c.toChar, p) match
+          case ('A', _) => Key.Up
+          case ('B', _) => Key.Down
+          case ('C', p) => if p.endsWith(";5") || p.endsWith(";3") then Key.WordRight else Key.Right
+          case ('D', p) => if p.endsWith(";5") || p.endsWith(";3") then Key.WordLeft else Key.Left
+          case ('H', _) => Key.Home
+          case ('F', _) => Key.End
+          case ('~', "1" | "7") => Key.Home
+          case ('~', "4" | "8") => Key.End
+          case ('~', "3") => Key.Delete
+          case ('~', "200") => Key.Paste(readPaste())
+          case _ => Key.Ignore
+      case 'O' =>
+        readByte() match
+          case 'H' => Key.Home
+          case 'F' => Key.End
+          case 'A' => Key.Up
+          case 'B' => Key.Down
+          case 'C' => Key.Right
+          case 'D' => Key.Left
+          case _ => Key.Ignore
+      case 13 | 10 => Key.AltEnter
+      case 'b' => Key.WordLeft
+      case 'f' => Key.WordRight
+      case 'd' => Key.KillWordForward
+      case 127 | 8 => Key.KillWordBack
+      case _ => Key.Ignore
+
+  /** Pasted text, up to the closing `ESC [ 201 ~`. */
+  private def readPaste(): String =
+    val bytes = new java.io.ByteArrayOutputStream
+    val end = "\u001b[201~".getBytes(UTF_8)
+    var matched = 0
+    var done = false
+    while !done do
+      val b = readByte()
+      if b < 0 then done = true
+      else if b == end(matched) then
+        matched += 1
+        if matched == end.length then done = true
+      else
+        bytes.write(end, 0, matched)
+        matched = 0
+        if b == end(0) then matched = 1 else bytes.write(b)
+    new String(bytes.toByteArray, UTF_8).replace("\r\n", "\n").replace('\r', '\n').replace("\t", "  ")
+
+  // --- editing ---
+
+  private def insert(s: String): Unit =
+    buf.insert(cursor, s)
+    cursor += s.length
+
+  private def lineStart(at: Int): Int =
+    val i = buf.lastIndexOf("\n", at - 1)
+    if i < 0 then 0 else i + 1
+  private def lineEnd(at: Int): Int =
+    val i = buf.indexOf("\n", at)
+    if i < 0 then buf.length else i
+
+  private def isWordChar(c: Char) = c.isLetterOrDigit || c == '_'
+  private def wordLeft(at: Int): Int =
+    var i = at
+    while i > 0 && !isWordChar(buf.charAt(i - 1)) do i -= 1
+    while i > 0 && isWordChar(buf.charAt(i - 1)) do i -= 1
+    i
+  private def wordRight(at: Int): Int =
+    var i = at
+    while i < buf.length && !isWordChar(buf.charAt(i)) do i += 1
+    while i < buf.length && isWordChar(buf.charAt(i)) do i += 1
+    i
+
+  /** Moves the cursor one line up (-1) or down (1) in the input, keeping its column; false when
+   *  there is no such line. */
+  private def moveLine(dir: Int): Boolean =
+    val start = lineStart(cursor)
+    val col = cursor - start
+    if dir < 0 then
+      if start == 0 then false
+      else
+        val prevStart = lineStart(start - 1)
+        cursor = math.min(prevStart + col, start - 1)
+        true
+    else
+      val end = lineEnd(cursor)
+      if end == buf.length then false
+      else
+        val nextStart = end + 1
+        cursor = math.min(nextStart + col, lineEnd(nextStart))
+        true
+
+  private def loop(): Option[String] =
+    refresh()
+    var result: Option[Option[String]] = None
+    while result.isEmpty do
+      readKey() match
+        case Key.Eof => result = Some(None)
+        case Key.Enter =>
+          val text = buf.toString
+          // Enter on an empty last line submits whatever is there (a parse error is reported
+          // then), as two empty lines do in the stock REPL
+          val onEmptyLastLine = lineEnd(cursor) == buf.length && buf.substring(lineStart(cursor)).trim.isEmpty && text.contains('\n')
+          if text.trim.isEmpty || text.trim.startsWith(":") || onEmptyLastLine || !isIncomplete(text) then
+            cursor = buf.length
+            refresh()
+            write("\r\n")
+            addHistory(text)
+            result = Some(Some(text))
+          else
+            // a new line, indented like the current one
+            val start = lineStart(cursor)
+            var i = start
+            while i < buf.length && buf.charAt(i) == ' ' do i += 1
+            insert("\n" + " " * (i - start))
+        case Key.AltEnter => insert("\n")
+        case Key.Tab => completeAtCursor()
+        case Key.Backspace =>
+          if cursor > 0 then
+            buf.deleteCharAt(cursor - 1)
+            cursor -= 1
+        case Key.Delete =>
+          if cursor < buf.length then buf.deleteCharAt(cursor)
+        case Key.Left => if cursor > 0 then cursor -= 1
+        case Key.Right => if cursor < buf.length then cursor += 1
+        case Key.Up =>
+          if !moveLine(-1) && historyIndex > 0 then showHistory(historyIndex - 1)
+        case Key.Down =>
+          if !moveLine(1) && historyIndex < history.length then showHistory(historyIndex + 1)
+        case Key.Home => cursor = lineStart(cursor)
+        case Key.End => cursor = lineEnd(cursor)
+        case Key.WordLeft => cursor = wordLeft(cursor)
+        case Key.WordRight => cursor = wordRight(cursor)
+        case Key.KillWordBack =>
+          val from = wordLeft(cursor)
+          buf.delete(from, cursor)
+          cursor = from
+        case Key.KillWordForward => buf.delete(cursor, wordRight(cursor))
+        case Key.Paste(text) => insert(text)
+        case Key.Ignore =>
+        case Key.Ch(c) =>
+          c match
+            case 1 => cursor = lineStart(cursor) // ^A
+            case 2 => if cursor > 0 then cursor -= 1 // ^B
+            case 3 => // ^C: drop the input
+              cursor = buf.length
+              refresh()
+              write("^C\r\n")
+              result = Some(Some(""))
+            case 4 => // ^D
+              if buf.length == 0 then
+                write("\r\n")
+                result = Some(None)
+              else if cursor < buf.length then buf.deleteCharAt(cursor)
+            case 5 => cursor = lineEnd(cursor) // ^E
+            case 6 => if cursor < buf.length then cursor += 1 // ^F
+            case 11 => // ^K
+              val end = lineEnd(cursor)
+              if end == cursor && end < buf.length then buf.deleteCharAt(cursor) // joins lines
+              else buf.delete(cursor, end)
+            case 12 => // ^L
+              write("\u001b[H\u001b[2J")
+              cursorRow = 0
+            case 14 => if !moveLine(1) && historyIndex < history.length then showHistory(historyIndex + 1) // ^N
+            case 16 => if !moveLine(-1) && historyIndex > 0 then showHistory(historyIndex - 1) // ^P
+            case 21 => // ^U
+              val start = lineStart(cursor)
+              buf.delete(start, cursor)
+              cursor = start
+            case 23 => // ^W
+              val from = wordLeft(cursor)
+              buf.delete(from, cursor)
+              cursor = from
+            case c if c < 32 =>
+            case c => insert(new String(Character.toChars(c)))
+      if result.isEmpty then refresh()
+    result.get
+
+  private def completeAtCursor(): Unit =
+    val text = buf.toString
+    val (start0, candidates0) =
+      try complete(text, cursor)
+      catch case _: Throwable => (cursor, Nil)
+    val start = math.max(0, math.min(start0, cursor))
+    val typed = text.substring(start, cursor)
+    val candidates = candidates0.distinct.filter(_.startsWith(typed)).sorted
+    if candidates.nonEmpty then
+      val prefix = candidates.reduce((a, b) => a.zip(b).takeWhile(_ == _).map(_._1).mkString)
+      if candidates.length == 1 || prefix.length > typed.length then
+        buf.replace(start, cursor, if candidates.length == 1 then candidates.head else prefix)
+        cursor = start + (if candidates.length == 1 then candidates.head.length else prefix.length)
+      else
+        // list them under the input, then draw the input again below
+        val saved = cursor
+        cursor = buf.length
+        refresh()
+        val colWidth = candidates.map(_.length).max + 2
+        val perRow = math.max(1, width / colWidth)
+        val sb = new StringBuilder("\r\n")
+        candidates.grouped(perRow).foreach { row =>
+          sb.append(row.map(c => c + " " * (colWidth - c.length)).mkString.stripTrailing).append("\r\n")
+        }
+        write(sb.toString)
+        cursorRow = 0
+        cursor = saved
+
+  // --- display ---
+
+  /** Redraws the prompt and the input, and puts the terminal cursor at `cursor`. */
+  private def refresh(): Unit =
+    val sb = new StringBuilder
+    sb.append('\r')
+    if cursorRow > 0 then sb.append(s"\u001b[${cursorRow}A")
+    sb.append("\u001b[J")
+    val text = buf.toString
+    val plainLines = text.split("\n", -1)
+    val colored = coloredLines(text, plainLines.length)
+    var row = 0 // first row of the current line
+    var endRow = 0
+    var targetRow = 0
+    var targetCol = 0
+    var offset = 0
+    for i <- plainLines.indices do
+      val line = plainLines(i)
+      if i > 0 then sb.append("\r\n")
+      sb.append(if i == 0 then prompt else contPrompt)
+      sb.append(colored(i))
+      val len = promptLen + line.length
+      if cursor >= offset && cursor <= offset + line.length then
+        val pos = promptLen + cursor - offset
+        targetRow = row + pos / width
+        targetCol = pos % width
+      val rows = if len == 0 then 1 else (len + width - 1) / width
+      endRow = row + rows - 1
+      row += rows
+      offset += line.length + 1
+    if targetRow > endRow then // at the very end of a line that fills its last row
+      sb.append("\r\n")
+      endRow = targetRow
+    sb.append('\r')
+    if endRow > targetRow then sb.append(s"\u001b[${endRow - targetRow}A")
+    if targetCol > 0 then sb.append(s"\u001b[${targetCol}C")
+    cursorRow = targetRow
+    write(sb.toString)
+
+  /** `text` highlighted, split into its lines; a color that spans a line break (a multi-line
+   *  string or comment) is started again on the next line. */
+  private def coloredLines(text: String, n: Int): Array[String] =
+    val hl =
+      try highlight(text)
+      catch case _: Throwable => text
+    val lines = hl.split("\n", -1)
+    if lines.length != n then text.split("\n", -1)
+    else
+      var active = ""
+      lines.map { line =>
+        val withColor = active + line + (if active.nonEmpty || line.contains('\u001b') then Reset else "")
+        val m = Sgr.findAllIn(line).toList
+        m.lastOption.foreach(last => active = if last == Reset || last == "\u001b[0m" then "" else last)
+        withColor
+      }
+
+  private def write(s: String): Unit =
+    out.write(s.getBytes(UTF_8))
+    out.flush()
+
+object ScalinoLineReader:
+  private val MaxHistory = 1000
+  private val Reset = "\u001b[0m"
+  private val Sgr = "\u001b\\[[0-9;]*m".r
+
+  def visibleLength(s: String): Int = Sgr.replaceAllIn(s, "").length
+
+  /** History entries are one per line: newlines and backslashes escaped. */
+  private def escape(s: String): String = s.replace("\\", "\\\\").replace("\n", "\\n")
+  private def unescape(s: String): String =
+    val sb = new StringBuilder
+    var i = 0
+    while i < s.length do
+      val c = s.charAt(i)
+      if c == '\\' && i + 1 < s.length then
+        sb.append(if s.charAt(i + 1) == 'n' then '\n' else s.charAt(i + 1))
+        i += 2
+      else
+        sb.append(c)
+        i += 1
+    sb.toString
+
+  /** `stty <args> < /dev/tty`: its output, None when it fails. */
+  private def stty(args: String): Option[String] =
+    try
+      val p = new ProcessBuilder("/bin/sh", "-c", s"stty $args < /dev/tty").redirectErrorStream(true).start()
+      val bytes = new java.io.ByteArrayOutputStream
+      val is = p.getInputStream
+      val chunk = new Array[Byte](256)
+      var n = is.read(chunk)
+      while n >= 0 do
+        bytes.write(chunk, 0, n)
+        n = is.read(chunk)
+      if p.waitFor() == 0 then Some(new String(bytes.toByteArray, UTF_8).trim) else None
+    catch case _: Exception => None
