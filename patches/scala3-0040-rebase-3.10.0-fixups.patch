+        // (`case object BeanAware extends TransformedNamesComparison`): the
+        // parent's instance carries nothing the module needs, and handing it
+        // back as the module's value would lose the object's own members
+        // (every call would then dispatch on the abstract parent).
+        case Some(parentTree)
+            if (parentTree match { case Block(Nil, e) => e; case t => t }) match
+              case Call(superFn, superArgss) =>
+                superFn.symbol.isConstructor && superFn.symbol.owner.is(Abstract) && superArgss.flatten.forall(_.isEmpty)
+              case _ => false =>
