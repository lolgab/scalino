+        // Runs one class's superclass-constructor call (found in its own
+        // `Template.parents`) and stashes the evaluated args under the
+        // parent's param names, then does the same for the parent itself.
+        def bindSuperCtorFields(cls: Symbol, env0: Env, depth: Int): Unit =
+          val superCall = moduleSuperCtorCall(cls)
+          if debugEnabled then
+            Console.err.println(s"[anonSuperCtor] cls=$cls superCall=${superCall.map(_.show)}")
+          superCall.foreach { parent =>
+            val (leadingStats, callTree) = parent match
+              case Block(stats, expr) => (stats, expr)
+              case other => (Nil, other)
+            leadingStats.foreach(interpretTree(_)(using env0))
+            callTree match
+              case Call(superFn, superArgss) if superFn.symbol.isConstructor =>
+                // `paramSymss` includes the class's own type-parameter list
+                // too (e.g. `[A]` on `Defer[A]`'s constructor) -- `superArgss`
+                // (from `Call`, whose `TypeApply` case discards type args
+                // entirely, see `Call0`) only ever has TERM argument lists,
+                // so keep only the term param symbols to line the two up.
+                val superParams = superFn.symbol.denot.paramSymss.flatten.filter(_.isTerm)
+                val superRawArgs = superArgss.flatten
+                val superBound = bindNonErased(superParams, superRawArgs)(using env0)
+                if debugEnabled then
+                  Console.err.println(s"[anonSuperCtor] superParams=$superParams superRawArgs=$superRawArgs superBound=$superBound")
+                superBound.foreach((p, v) => instance.fields.getOrElseUpdate(p.name.toString, v))
+                val parentCls = superFn.symbol.owner
+                if depth < 16 && ancestorExposesParamFields then
+                  if parentCls.isClass && !parentCls.is(JavaDefined) && parentCls != defn.ObjectClass then
+                    bindSuperCtorFields(parentCls, superBound.foldLeft(env0)((e, pv) => e.updated(pv._1, pv._2)), depth + 1)
+              case _ =>
+                if debugEnabled then
+                  Console.err.println(s"[anonSuperCtor] callTree did not match Call-with-constructor: ${callTree.getClass} ${callTree.show}")
+          }
+        if fn.owner.isAnonymousClass || ancestorExposesParamFields then
+          bindSuperCtorFields(fn.owner, withParams, 0)
+        instance
+      case _ if rawArgs.forall(_.isEmpty) =>
+        // No retained constructor body and nothing to bind anyway (typeclass
+        // "evidence" instances like `new PrimitiveFromExpr[T]()`): the value
+        // itself is inert as far as our intrinsics are concerned (none of
+        // them inspect a FromExpr/ToExpr instance's identity, only the real
+        // Quotes/Expr values passed alongside it) -- see docs/findings.md.
+        ModuleValue(fn.owner)
+      case _ => notInterpretable(fn)
+
+  /** Finds the `Template` for class `target` inside `-Yretain-trees`'s
+   *  whole-compilation-unit `rootTree` (shared/cached per source file, not
+   *  per symbol -- `rootTree` on any symbol from the same file returns the
+   *  same tree, so callers must search it for the symbol they want).
+   *
+   *  Recurses into method/val bodies (`Block`s, `DefDef`/`ValDef` rhs'es),
+   *  not just nested class-body members -- needed to find `target` when
+   *  it's a synthetic anonymous class declared LOCALLY inside some
+   *  method's body (e.g. cats' own `Eval.defer`: `new Eval.Defer[A](() =>
+   *  a) {}` desugars to a local `final class $anon() extends
+   *  Eval.Defer[A](...) {}` inside `defer`'s own method body, not a
+   *  class-body member anywhere) -- the original, member-only traversal
+   *  here always returned `None` for those (confirmed via
+   *  `SCALINO_INTERP_DEBUG`: every anonymous-class super-ctor lookup came back
+   *  empty across a real macro-heavy test run). Anonymous-class callers
+   *  gate this by `isAnonymousClass` first (see `interpretNewFromTree`),
+   *  so this broader traversal only ever runs for that narrow case, not
+   *  for every construction (the previous, reverted broader fix here --
+   *  see `interpretNewFromTree`'s own note -- ran unconditionally instead).
+   */
+  private def findTemplate(tree: Tree, target: Symbol): Option[Template] = tree match
+    case PackageDef(_, stats) => stats.iterator.map(findTemplate(_, target)).collectFirst { case Some(t) => t }
+    case td: TypeDef if td.symbol == target =>
+      td.rhs match
+        case t: Template => Some(t)
+        case _ => None
+    case td: TypeDef =>
+      td.rhs match
+        case t: Template => findTemplate(t, target)
+        case _ => None
+    case t: Template =>
+      t.body.iterator.map(findTemplate(_, target)).collectFirst { case Some(x) => x }
+    case vd: ValOrDefDef => findTemplate(vd.rhs, target)
+    case Block(stats, expr) => (stats.iterator ++ Iterator.single(expr)).map(findTemplate(_, target)).collectFirst { case Some(t) => t }
+    case _ => None
+
+  /** `object Foo extends Foo(a, b, ...)` (a common "default instance"
+   *  pattern for config-like case classes, e.g. jsoniter-scala's
+   *  `CodecMakerConfig`): the real field values live in this super
+   *  constructor call, in the module class's own `Template.parents` -- NOT
+   *  in `Symbol.defTree` for the module, its module class, or even its
+   *  primary constructor (all empty; `-Yretain-trees` doesn't populate
+   *  `defTree` for a class's template/parents, only for method/val bodies).
+   *  `ClassSymbol#rootTree` is the one accessor that still exposes it.
+   */
+  /** A parent that's a constructor call, possibly `Block`-wrapped (when its
+   *  args need helper locals computed first, e.g. an implicit conversion
+   *  applied to one of them -- jsoniter-scala's `CodecMakerConfig` default
+   *  instance has exactly this shape). Excludes a bare `java.lang.Object`
+   *  super call: essentially *every* class's `parents.head` is one (the
+   *  implicit default superclass whenever nothing else is extended, e.g.
+   *  `object View extends IterableFactory[View]`, whose only *class* parent
+   *  is `Object`), and it carries no data worth special-casing -- if it were
+   *  matched here, `moduleSuperCtorCall` would interpret it as the module's
+   *  own value, discarding the module's real identity for a bare `new
+   *  Object()` (observed: broke `View.from(...)` dispatch, since the
+   *  receiver silently became an empty `Object` instead of `ModuleValue(View)`).
+   */
+  private def constructorCallParent(t: Tree)(using Context): Boolean = t match
+    case Block(_, expr) => constructorCallParent(expr)
+    case Call(fn, _) => fn.symbol.isConstructor && fn.symbol.owner != defn.ObjectClass
+    case _ => false
+
+  private def moduleSuperCtorCall(moduleClass: Symbol)(using Context): Option[Tree] =
+    // `ClassSymbol#rootTree` only ever returns a real tree for a TOP-LEVEL
+    // class (its own doc comment says so outright; a `TreeProvider` is only
+    // ever wired up for those during TASTy loading) -- for a synthetic LOCAL
+    // anonymous class (declared inside some method body, e.g. cats' own
+    // `Eval.defer`: `new Eval.Defer[A](() => a) {}`) it's unconditionally
+    // `EmptyTree`, confirmed via `SCALINO_INTERP_DEBUG` (every anonymous-class
+    // lookup came back `root.isEmpty=true`, so `findTemplate` never even
+    // got a tree to search). `topLevelClass` walks up to the nearest real
+    // top-level class/module (here, `object Eval`) instead, whose OWN
+    // `rootTree` genuinely is populated -- `findTemplate`'s own `Block`/
+    // `ValOrDefDef` recursion (see its doc) then finds the local class's
+    // `TypeDef` inside that. A no-op for the original module-class use case
+    // (already top-level, so `topLevelClass` returns the same symbol).
+    val root = moduleClass.topLevelClass.asClass.rootTree
+    if debugEnabled then
+      Console.err.println(s"[moduleSuperCtorCall] cls=$moduleClass topLevelClass=${moduleClass.topLevelClass} root.isEmpty=${root.isEmpty} root.getClass=${root.getClass.getSimpleName}")
+    if root.isEmpty then None
+    else
+      val found = findTemplate(root, moduleClass)
+      if debugEnabled then
+        Console.err.println(s"[moduleSuperCtorCall] findTemplate found=${found.isDefined}")
+      found.flatMap(_.parents.find(constructorCallParent))
+
+  /** Generalizes the `CodecMakerConfig`/`moduleSuperCtorCall` trick above to
+   *  *any* def/val: `Symbol.defTree` is only ever populated for symbols
+   *  compiled in the current run (see `Symbols.scala`'s `retainsDefTree`) --
+   *  it is NEVER filled in by cross-module TASTy unpickling, no matter what
+   *  flags the *dependency* was compiled with. But ordinary TASTy already
+   *  pickles full method/val bodies regardless of `-Yretain-trees`, and
+   *  `ClassfileLoader`/`TastyLoader` (`SymbolLoaders.scala`) wire a lazy
+   *  `TreeProvider` onto every top-level class/module loaded from the
+   *  classpath whenever *this* run passes `-Yretain-trees` (or
+   *  `-from-tasty`) -- `mayLoadTreesFromTasty` -- independent of the
+   *  dependency's own compile flags. So for any external symbol we can walk
+   *  up to its enclosing top-level class, force that unpickling via
+   *  `rootTreeContaining`, and search the whole compilation-unit tree for
+   *  the matching member -- no need to special-case a growing list of
+   *  individual stdlib/dependency methods one at a time.
+   */
+  /** A reference to a synthesized `given Type[X]` evidence for a quote
+   *  type-pattern's bound type variable (e.g. `ft$given1` in
+   *  `genNullValue[ft](...)(ft$given1, x$6)`, from `case '[ft] => ...`):
+   *  the `QuotePatterns` phase (which would normally synthesize this val's
+   *  real body) hasn't run yet on this retained tree, so its own
+   *  `defTree`/`InlineProxy` fallback has nothing to interpret. But a
+   *  `Type[X]` instance and a raw `TypeRepr` are the same value in this
+   *  interpreter's model (see `TypeReprMethods`/`TreeMethods.asType`), and
+   *  `X`'s own symbol is already bound (to that same raw `Type`) by the
+   *  `QuotePattern` match above -- so just look that binding up again by
+   *  `X`'s symbol instead of needing a real initializer tree at all.
+   */
+  private def quotedTypeGivenValue(sym: Symbol)(using Env): Option[Object] =
+    sym.info match
+      case AppliedType(tycon, (arg: Type) :: Nil) if tycon.typeSymbol == defn.QuotedTypeClass =>
+        env.get(arg.typeSymbol)
+      case _ => None
+
+  /** `Trait$$super$method` (e.g. `scala$collection$SeqOps$$super$sizeCompare`):
+   *  the JVM-level accessor Scala's own compiler generates for a qualified
+   *  `super[Trait].method(...)` call, since trait super-calls need explicit
+   *  disambiguation at the bytecode level. It's compiler-synthesized (no
+   *  retained source, ever) but always means the same thing: whatever
+   *  `method` implementation the class linearization would reach by
+   *  looking *past* `Trait` -- exactly `SymDenotation#superSymbolIn`.
+   *  Using ordinary virtual dispatch (`overridingSymbol`) here instead
+   *  would find the *same* override the super-call exists to skip past,
+   *  causing infinite recursion the first time such an override calls its
+   *  own super-accessor.
+   */
+  /** The receiver's real dotc class symbol, for virtual dispatch (choosing
+   *  the most-derived override of a statically-resolved `fn`) -- covers our
+   *  own `InterpretedInstance`/`ModuleValue` wrappers directly, and a fixed,
+   *  small set of real stdlib collection types a macro's interpreted code
+   *  may build directly as real host objects (via `interpretCollectionFactory`
+   *  or a real library method like `SeqOps#zipAll` returning a real
+   *  `View.ZipAll`). `isInstanceOf` against this fixed set is a compile-time
+   *  type test against classes this file already statically depends on --
+   *  not reflection (no `getClass`, no name-based lookup).
+   */
+  private def receiverConcreteClass(receiver: Object)(using Context): Symbol = receiver match
+    case inst: InterpretedInstance => inst.cls
+    case ModuleValue(moduleClass) => moduleClass
+    case _: List[Object @unchecked] => defn.ListClass
+    case _: Vector[Object @unchecked] => requiredClass("scala.collection.immutable.Vector")
+    case _: mutable.ArrayBuffer[Object @unchecked] => requiredClass("scala.collection.mutable.ArrayBuffer")
+    case _: mutable.HashSet[Object @unchecked] => requiredClass("scala.collection.mutable.HashSet")
+    case _: scala.collection.immutable.Set[Object @unchecked] => requiredClass("scala.collection.immutable.Set")
+    case _: scala.collection.immutable.Seq[Object @unchecked] => defn.SeqClass
+    case _ => NoSymbol
+
+  /** Extracts `arity` sub-values from a value known to have that many
+   *  fields/elements -- a real host `Product` (e.g. a real tuple, or any
+   *  other genuine Scala tuple/case-class value already flowing through as
+   *  a real object) reads off its own `productElement`s directly; one of
+   *  our own `InterpretedInstance`s (a user case class built via
+   *  `interpretNewFromTree`, which does NOT implement the real
+   *  `scala.Product` interface) reads its case-accessor fields in declared
+   *  order instead (same lookup the `InterpretedInstance` `productElement`
+   *  intrinsic, below, already uses). Shared between `matchPattern`'s
+   *  generic case-class `UnApply` support and any other real-tuple-shaped
+   *  extraction (e.g. `Map(k -> v, ...)` construction).
+   */
+  private def productElements(v: Object, arity: Int)(using Context): Option[List[Object]] = v match
+    case p: Product if p.productArity == arity =>
+      Some((0 until arity).map(i => p.productElement(i).asInstanceOf[Object]).toList)
+    case inst: InterpretedInstance if inst.cls.isClass =>
+      val caseFields = inst.cls.asClass.classDenot.paramAccessors.filter(_.is(CaseAccessor))
+      if caseFields.size == arity then Some(caseFields.map(f => inst.fields(f.name.toString))) else None
+    case _ => None
+
+  /** A `(k, v)` pair, tolerating a `k -> v` built as our own
+   *  `InterpretedInstance` instead of a real `scala.Tuple2` (see
+   *  `productElements`) -- used wherever real stdlib source (interpreted,
+   *  not a JDK-native leaf) hands back a "pair" that a JDK-native/host
+   *  collection-building intrinsic then needs as a real tuple, e.g.
+   *  `Map(...)`'s own construction below. Falls back to the original
+   *  direct cast (same crash it always would have) if the value is
+   *  genuinely neither shape.
+   */
+  private def asObjectPair(v: Object)(using Context): (Object, Object) =
+    productElements(v, 2) match
+      case Some(List(a, b)) => (a, b)
+      case _ => v.asInstanceOf[(Object, Object)]
+
+  private def superAccessorTarget(fn: Symbol, concreteCls: Symbol)(using Context): Option[Symbol] =
+    val marker = "$$super$"
+    val nameStr = fn.name.toString
+    if !nameStr.contains(marker) then None
+    else
+      val realName = nameStr.substring(nameStr.lastIndexOf(marker) + marker.length).toTermName
+      val ownerMember = fn.owner.info.member(realName).suchThat(m => m.is(Method) && m.signature == fn.signature).symbol
+      // `superSymbolIn`'s own precondition ("`this.owner` is in the base
+      // class sequence of `base`") isn't always true here -- when it isn't,
+      // its `dropWhile(owner != _)` silently consumes the *whole* list
+      // instead of finding it, and the following `.tail` throws on the
+      // empty result. Check it explicitly and fall back (to the ordinary
+      // `overridingSymbol`/linearization-scan path in the caller) instead
+      // of crashing.
+      if !ownerMember.exists || !concreteCls.asClass.baseClasses.contains(ownerMember.owner) then None
+      else
+        val target = ownerMember.superSymbolIn(concreteCls.asClass)
+        if target.exists then Some(target) else None
