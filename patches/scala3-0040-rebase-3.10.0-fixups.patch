+  /** Searches a whole-compilation-unit tree (from `rootTreeContaining`) for
+   *  the `DefDef`/`ValDef` defining `target`, descending through packages,
+   *  nested classes/objects (`Template.constr` for the primary constructor,
+   *  then `Template.body` for everything else), and blocks.
+   */
+  private def findDefTree(tree: Tree, target: Symbol): Option[Tree] = tree match
+    case (_: DefDef | _: ValDef) if tree.symbol == target => Some(tree)
+    case PackageDef(_, stats) => stats.iterator.map(findDefTree(_, target)).collectFirst { case Some(t) => t }
+    case td: TypeDef =>
+      td.rhs match
+        case t: Template =>
+          if t.constr.symbol == target then Some(t.constr)
+          else t.body.iterator.map(findDefTree(_, target)).collectFirst { case Some(t) => t }
+        case _ => None
+    case Block(stats, expr) => (stats :+ expr).iterator.map(findDefTree(_, target)).collectFirst { case Some(t) => t }
+    case _ => None
