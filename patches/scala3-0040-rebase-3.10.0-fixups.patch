+  private def isBareFunctionValue(v: Object): Boolean = v match
+    // A real `Seq`/`Set`/`Map` IS a `Function1`, but a collection, not a bare closure.
+    case _: scala.collection.Iterable[?] => false
+    case _: Function0[?] | _: Function1[?, ?] | _: Function2[?, ?, ?] => true
+    case _ => false
