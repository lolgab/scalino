+  /** Field accessors of the `quotes.reflect` tree `*Methods` traits, as in
+   *  `QuotesImpl` (`tpd` node fields, `Option` for the optional ones).
+   *  `None` when `owner`/`name` isn't one of these or `args` isn't a matching
+   *  tree.
+   */
+  private def treeAccessor(owner: String, name: String, args: List[Object]): Option[Object] =
+    def mkName(n: Name): String = n.toString
+    (owner, name, args) match
+      case ("ApplyMethods", "fun", (t: Apply) :: Nil) => Some(t.fun)
+      case ("ApplyMethods", "args", (t: Apply) :: Nil) => Some(t.args)
+      case ("TypeApplyMethods", "fun", (t: TypeApply) :: Nil) => Some(t.fun)
+      case ("TypeApplyMethods", "args", (t: TypeApply) :: Nil) => Some(t.args)
+      case ("SelectMethods", "qualifier", (t: Select) :: Nil) => Some(t.qualifier)
+      case ("SelectMethods", "name", (t: Select) :: Nil) => Some(mkName(t.name))
+      case ("IdentMethods", "name", (t: Ident) :: Nil) => Some(mkName(t.name))
+      case ("LiteralMethods", "constant", (t: Literal) :: Nil) => Some(t.const)
+      case ("TypedMethods", "expr", (t: Typed) :: Nil) => Some(t.expr)
+      case ("TypedMethods", "tpt", (t: Typed) :: Nil) => Some(t.tpt)
+      case ("BlockMethods", "statements", (t: Block) :: Nil) => Some(t.stats)
+      case ("BlockMethods", "expr", (t: Block) :: Nil) => Some(t.expr)
+      case ("InlinedMethods", "call", (t: Inlined) :: Nil) => Some(if t.call.isEmpty then None else Some(t.call))
+      case ("InlinedMethods", "bindings", (t: Inlined) :: Nil) => Some(t.bindings)
+      case ("InlinedMethods", "body", (t: Inlined) :: Nil) => Some(t.expansion)
+      case ("IfMethods", "cond", (t: If) :: Nil) => Some(t.cond)
+      case ("IfMethods", "thenp", (t: If) :: Nil) => Some(t.thenp)
+      case ("IfMethods", "elsep", (t: If) :: Nil) => Some(t.elsep)
+      case ("IfMethods", "isInline", (t: If) :: Nil) => Some(Boolean.box(t.isInline))
+      case ("MatchMethods", "scrutinee", (t: Match) :: Nil) => Some(t.selector)
+      case ("MatchMethods", "cases", (t: Match) :: Nil) => Some(t.cases)
+      case ("MatchMethods", "isInline", (t: Match) :: Nil) => Some(Boolean.box(t.isInline))
+      case ("NamedArgMethods", "name", (t: NamedArg) :: Nil) => Some(mkName(t.name))
+      case ("NamedArgMethods", "value", (t: NamedArg) :: Nil) => Some(t.arg)
+      case ("AssignMethods", "lhs", (t: Assign) :: Nil) => Some(t.lhs)
+      case ("AssignMethods", "rhs", (t: Assign) :: Nil) => Some(t.rhs)
+      case ("NewMethods", "tpt", (t: New) :: Nil) => Some(t.tpt)
+      case ("ReturnMethods", "expr", (t: Return) :: Nil) => Some(t.expr)
+      case ("ReturnMethods", "from", (t: Return) :: Nil) => Some(t.from.symbol)
+      case ("WhileMethods", "cond", (t: WhileDo) :: Nil) => Some(t.cond)
+      case ("WhileMethods", "body", (t: WhileDo) :: Nil) => Some(t.body)
+      case ("TryMethods", "body", (t: Try) :: Nil) => Some(t.expr)
+      case ("TryMethods", "cases", (t: Try) :: Nil) => Some(t.cases)
+      case ("TryMethods", "finalizer", (t: Try) :: Nil) => Some(if t.finalizer.isEmpty then None else Some(t.finalizer))
+      case ("RepeatedMethods", "elems", (t: SeqLiteral) :: Nil) => Some(t.elems)
+      case ("RepeatedMethods", "elemtpt", (t: SeqLiteral) :: Nil) => Some(t.elemtpt)
+      case ("TypeProjectionMethods", "qualifier", (t: Select) :: Nil) => Some(t.qualifier)
+      case ("TypeProjectionMethods", "name", (t: Select) :: Nil) => Some(mkName(t.name))
+      case ("TypeIdentMethods", "name", (t: Ident) :: Nil) => Some(mkName(t.name))
+      case ("TypeSelectMethods", "qualifier", (t: Select) :: Nil) => Some(t.qualifier)
+      case ("TypeSelectMethods", "name", (t: Select) :: Nil) => Some(mkName(t.name))
+      case ("SingletonMethods", "ref", (t: SingletonTypeTree) :: Nil) => Some(t.ref)
+      case ("RefinedMethods", "tpt", (t: RefinedTypeTree) :: Nil) => Some(t.tpt)
+      case ("RefinedMethods", "refinements", (t: RefinedTypeTree) :: Nil) => Some(t.refinements)
+      case ("AppliedMethods", "tpt", (t: AppliedTypeTree) :: Nil) => Some(t.tpt)
+      case ("AppliedMethods", "args", (t: AppliedTypeTree) :: Nil) => Some(t.args)
+      case ("AnnotatedMethods", "arg", (t: Annotated) :: Nil) => Some(t.arg)
+      case ("AnnotatedMethods", "annotation", (t: Annotated) :: Nil) => Some(t.annot)
+      case _ => None
