+  private def hasJavalibToString(receiver: Object)(using Context): Boolean = receiver match
+    case inst: InterpretedInstance if javalibOverlay.exists(_.isShadow(inst.cls)) =>
+      val m = inst.cls.info.member(nme.toString_).suchThat(_.is(Method)).symbol
+      m.exists && m.owner != defn.ObjectClass && !resolveExternalDefTree(m).isEmpty
