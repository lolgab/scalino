+  private def matchQuoteBodyTree(pat: Tree, scrutTree: Tree, scope: scala.quoted.runtime.impl.Scope, bindingSyms: Set[Symbol], termAliases: Map[Symbol, Symbol] = Map.empty)(using env: Env): Option[Env] =
+    if debugMatchEnabled then
+      Console.err.println(s"[matchQuoteBodyTree] pat=${pat.getClass.getSimpleName}(${pat.show}) scrutTree=${scrutTree.getClass.getSimpleName}(${scrutTree.show})")
