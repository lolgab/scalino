+      val f = java.io.File(entry)
+      try
+        if f.isDirectory then
+          val sf = java.io.File(f, resource)
+          if sf.isFile then
+            val src = scala.io.Source.fromFile(sf, "UTF-8")
+            try parse(src.getLines()) finally src.close()
+          else Nil
+        else if f.isFile then
+          val zf = new java.util.zip.ZipFile(f)
+          try
+            Option(zf.getEntry(resource)).toList.flatMap { e =>
+              val src = scala.io.Source.fromInputStream(zf.getInputStream(e), "UTF-8")
+              try parse(src.getLines()) finally src.close()
+            }
+          finally zf.close()
