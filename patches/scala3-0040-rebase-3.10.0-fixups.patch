+  /** Local classes met while interpreting blocks, by (possibly re-owned) class symbol. */
+  private val localClassTrees = mutable.Map.empty[Symbol, TypeDef]
+
+  /** Bodies of JDK classes from scala-native's javalib TASTy, see `JavalibOverlay`. */
+  private lazy val javalibOverlay: Option[JavalibOverlay] = JavalibOverlay.fromSettings()
