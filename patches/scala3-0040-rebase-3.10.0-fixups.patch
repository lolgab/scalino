+        case o if o == defn.BoxedShortModule.moduleClass => Some(defn.ShortType)
+        case o if o == defn.BoxedCharModule.moduleClass => Some(defn.CharType)
+        case o if o == defn.BoxedIntModule.moduleClass => Some(defn.IntType)
+        case o if o == defn.BoxedLongModule.moduleClass => Some(defn.LongType)
+        case o if o == defn.BoxedFloatModule.moduleClass => Some(defn.FloatType)
