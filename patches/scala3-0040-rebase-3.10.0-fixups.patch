+    val ctx1 = ctx.fresh.setFreshGADTBounds.addMode(Mode.GadtConstraintInference)
+    if holeSyms.nonEmpty then ctx1.gadtState.addToConstraint(holeSyms)(using ctx1)
+    inContext(ctx1) {
+      val matches = scrutType.widenTermRefExpr <:< patType
+      if debugMatchEnabled then
+        Console.err.println(s"[matchStructuralTypePattern] patType=${patType.show} scrutType=${scrutType.show} holes=${holeSyms.mkString(",")} matches=$matches")
