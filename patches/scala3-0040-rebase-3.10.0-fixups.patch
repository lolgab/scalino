+  /** `quotes.reflect.*Module#apply`/`#copy` for the tree and TypeRepr
+   *  constructors not covered by a dedicated case in `interpretQuotesApi`;
+   *  each mirrors the matching definition in `QuotesImpl` (positions
+   *  default to the macro expansion's, as `withDefaultPos` does there).
+   */
+  private def moduleConstructor(owner: String, name: String, args: List[Object]): Option[Object] =
+    import dotty.tools.dotc.core.{Types => T}
+    import dotty.tools.dotc.ast.untpd
+    def trees(o: Object): List[Tree] = asObjectList(o).asInstanceOf[List[Tree]]
+    def types(o: Object): List[Type] = asObjectList(o).asInstanceOf[List[Type]]
+    def opt(o: Object): Option[Object] = o.asInstanceOf[Option[Object]]
+    def optTree(o: Object): Tree = opt(o) match { case Some(t: Tree) => t; case _ => tpd.EmptyTree }
+    def optIdent(o: Object): untpd.Ident = opt(o) match { case Some(n: String) => untpd.Ident(n.toTypeName); case _ => untpd.EmptyTypeIdent }
+    def pos0[X <: Tree](t: X): X = t.withSpan(pos.span).asInstanceOf[X]
+    (owner, name, args) match
+      case ("PackageClauseModule", "apply", (pid: Tree) :: stats :: Nil) => Some(pos0(tpd.PackageDef(pid.asInstanceOf[tpd.RefTree], trees(stats))))
+      case ("PackageClauseModule", "copy", (orig: Tree) :: (pid: Tree) :: stats :: Nil) => Some(tpd.cpy.PackageDef(orig)(pid.asInstanceOf[tpd.RefTree], trees(stats)))
+      case ("ImportModule", "apply", (expr: Tree) :: sels :: Nil) => Some(pos0(tpd.Import(expr, asObjectList(sels).asInstanceOf[List[untpd.ImportSelector]])))
+      case ("ImportModule", "copy", (orig: Tree) :: (expr: Tree) :: sels :: Nil) => Some(tpd.cpy.Import(orig)(expr, asObjectList(sels).asInstanceOf[List[untpd.ImportSelector]]))
+      case ("TypeDefModule", "apply", (sym: Symbol) :: Nil) => Some(pos0(tpd.TypeDef(sym.asType)))
+      case ("TypeDefModule", "copy", (orig: Tree) :: (n: String) :: (rhs: Tree) :: Nil) => Some(tpd.cpy.TypeDef(orig)(n.toTypeName, rhs))
+      case ("ThisModule", "apply", (cls: Symbol) :: Nil) => Some(pos0(tpd.This(cls.asClass)))
+      case ("ThisModule", "copy", (orig: Tree) :: q :: Nil) =>
+        Some(tpd.cpy.This(orig)(opt(q) match { case Some(n: String) => untpd.Ident(n.toTypeName); case _ => untpd.EmptyTypeIdent }))
+      case ("NamedArgModule", "apply", (n: String) :: (arg: Tree) :: Nil) => Some(pos0(tpd.NamedArg(n.toTermName, arg)))
+      case ("NamedArgModule", "copy", (orig: Tree) :: (n: String) :: (arg: Tree) :: Nil) => Some(tpd.cpy.NamedArg(orig)(n.toTermName, arg))
+      case ("SuperModule", "apply", (qual: Tree) :: mix :: Nil) => Some(pos0(tpd.Super(qual, optIdent(mix), NoSymbol)))
+      case ("SuperModule", "copy", (orig: Tree) :: (qual: Tree) :: mix :: Nil) => Some(tpd.cpy.Super(orig)(qual, optIdent(mix)))
+      case ("TypedOrTestModule", "apply", (expr: Tree) :: (tpt: Tree) :: Nil) => Some(pos0(tpd.Typed(expr, tpt)))
+      case ("TypedOrTestModule", "copy", (orig: Tree) :: (expr: Tree) :: (tpt: Tree) :: Nil) => Some(tpd.cpy.Typed(orig)(expr, tpt))
+      case ("ClosureModule", "apply", (meth: Tree) :: tpe :: Nil) =>
+        Some(pos0(tpd.Closure(Nil, meth, opt(tpe) match { case Some(t: Type) => tpd.TypeTree(t); case _ => tpd.EmptyTree })))
+      case ("ClosureModule", "copy", (orig: Tree) :: (meth: Tree) :: tpe :: Nil) =>
+        Some(tpd.cpy.Closure(orig)(Nil, meth, opt(tpe) match { case Some(t: Type) => tpd.TypeTree(t); case _ => tpd.EmptyTree }))
+      case ("SummonFromModule", "apply", cases :: Nil) => Some(pos0(tpd.Match(tpd.EmptyTree, asObjectList(cases).asInstanceOf[List[CaseDef]])))
+      case ("TryModule", "apply", (expr: Tree) :: cases :: fin :: Nil) =>
+        Some(pos0(tpd.Try(expr, asObjectList(cases).asInstanceOf[List[CaseDef]], optTree(fin))))
+      case ("TryModule", "copy", (orig: Tree) :: (expr: Tree) :: cases :: fin :: Nil) =>
+        Some(tpd.cpy.Try(orig)(expr, asObjectList(cases).asInstanceOf[List[CaseDef]], optTree(fin)))
+      case ("ReturnModule", "apply", (expr: Tree) :: (from: Symbol) :: Nil) => Some(pos0(tpd.Return(expr, from)))
+      case ("ReturnModule", "copy", (orig: Tree) :: (expr: Tree) :: (from: Symbol) :: Nil) => Some(tpd.cpy.Return(orig)(expr, tpd.ref(from)))
+      case ("InlinedModule", "apply", call :: bindings :: (expansion: Tree) :: Nil) =>
+        Some(pos0(tpd.Inlined(optTree(call), asObjectList(bindings).asInstanceOf[List[tpd.MemberDef]], expansion)))
+      case ("InlinedModule", "copy", (orig: Inlined) :: call :: bindings :: (expansion: Tree) :: Nil) =>
+        Some(tpd.cpy.Inlined(orig)(optTree(call), asObjectList(bindings).asInstanceOf[List[tpd.MemberDef]], expansion))
+      case ("SelectOuterModule", "apply", (qual: Tree) :: (n: String) :: (levels: Integer) :: Nil) =>
+        Some(pos0(tpd.Select(qual, dotty.tools.dotc.core.NameKinds.OuterSelectName(n.toTermName, levels.intValue))))
+      case ("SelectOuterModule", "copy", (orig: Tree) :: (qual: Tree) :: (n: String) :: (levels: Integer) :: Nil) =>
+        Some(tpd.cpy.Select(orig)(qual, dotty.tools.dotc.core.NameKinds.OuterSelectName(n.toTermName, levels.intValue)))
+      case ("WhileModule", "apply", (cond: Tree) :: (body: Tree) :: Nil) => Some(pos0(tpd.WhileDo(cond, body)))
+      case ("WhileModule", "copy", (orig: Tree) :: (cond: Tree) :: (body: Tree) :: Nil) => Some(tpd.cpy.WhileDo(orig)(cond, body))
+      case ("TypeIdentModule", "apply", (sym: Symbol) :: Nil) =>
+        assert(sym.isType, s"Expected a type symbol, but got $sym")
+        Some(pos0(tpd.ref(sym)))
+      case ("TypeIdentModule", "copy", (orig: Tree) :: (n: String) :: Nil) => Some(tpd.cpy.Ident(orig)(n.toTypeName))
+      case ("TypeSelectModule" | "TypeProjectionModule", "apply", (qual: Tree) :: (n: String) :: Nil) => Some(pos0(tpd.Select(qual, n.toTypeName)))
+      case ("TypeSelectModule" | "TypeProjectionModule", "copy", (orig: Tree) :: (qual: Tree) :: (n: String) :: Nil) => Some(tpd.cpy.Select(orig)(qual, n.toTypeName))
+      case ("SingletonModule", "apply", (ref: Tree) :: Nil) => Some(pos0(tpd.SingletonTypeTree(ref)))
+      case ("SingletonModule", "copy", (orig: Tree) :: (ref: Tree) :: Nil) => Some(tpd.cpy.SingletonTypeTree(orig)(ref))
+      case ("RefinedModule", "apply", (tpt: Tree) :: refs :: (cls: Symbol) :: Nil) => Some(pos0(tpd.RefinedTypeTree(tpt, trees(refs), cls.asClass)))
+      case ("RefinedModule", "copy", (orig: Tree) :: (tpt: Tree) :: refs :: Nil) => Some(tpd.cpy.RefinedTypeTree(orig)(tpt, trees(refs)))
+      case ("AppliedModule", "apply", (tpt: Tree) :: targs :: Nil) => Some(pos0(tpd.AppliedTypeTree(tpt, trees(targs))))
+      case ("AppliedModule", "copy", (orig: Tree) :: (tpt: Tree) :: targs :: Nil) => Some(tpd.cpy.AppliedTypeTree(orig)(tpt, trees(targs)))
+      case ("AnnotatedModule", "apply", (arg: Tree) :: (annot: Tree) :: Nil) => Some(pos0(tpd.Annotated(arg, annot)))
+      case ("AnnotatedModule", "copy", (orig: Tree) :: (arg: Tree) :: (annot: Tree) :: Nil) => Some(tpd.cpy.Annotated(orig)(arg, annot))
+      case ("MatchTypeTreeModule", "apply", bound :: (sel: Tree) :: cases :: Nil) => Some(pos0(tpd.MatchTypeTree(optTree(bound), sel, asObjectList(cases).asInstanceOf[List[CaseDef]])))
+      case ("MatchTypeTreeModule", "copy", (orig: Tree) :: bound :: (sel: Tree) :: cases :: Nil) =>
+        Some(tpd.cpy.MatchTypeTree(orig)(optTree(bound), sel, asObjectList(cases).asInstanceOf[List[CaseDef]]))
+      case ("ByNameModule", "apply", (res: Tree) :: Nil) => Some(pos0(tpd.ByNameTypeTree(res)))
+      case ("ByNameModule", "copy", (orig: Tree) :: (res: Tree) :: Nil) => Some(tpd.cpy.ByNameTypeTree(orig)(res))
+      case ("LambdaTypeTreeModule", "apply", tparams :: (body: Tree) :: Nil) => Some(pos0(tpd.LambdaTypeTree(asObjectList(tparams).asInstanceOf[List[TypeDef]], body)))
+      case ("LambdaTypeTreeModule", "copy", (orig: Tree) :: tparams :: (body: Tree) :: Nil) =>
+        Some(tpd.cpy.LambdaTypeTree(orig)(asObjectList(tparams).asInstanceOf[List[TypeDef]], body))
+      case ("TypeBlockModule", "apply", aliases :: (tpt: Tree) :: Nil) => Some(pos0(tpd.Block(trees(aliases), tpt)))
+      case ("TypeBlockModule", "copy", (orig: Tree) :: aliases :: (tpt: Tree) :: Nil) => Some(tpd.cpy.Block(orig)(trees(aliases), tpt))
+      case ("TypeBoundsTreeModule", "apply", (lo: Tree) :: (hi: Tree) :: Nil) => Some(pos0(tpd.TypeBoundsTree(lo, hi)))
+      case ("TypeBoundsTreeModule", "copy", (orig: Tree) :: (lo: Tree) :: (hi: Tree) :: Nil) => Some(tpd.cpy.TypeBoundsTree(orig)(lo, hi, tpd.EmptyTree))
+      case ("WildcardTypeTreeModule", "apply", (tpe: Type) :: Nil) => Some(pos0(tpd.Underscore(tpe)))
+      case ("TypeCaseDefModule", "apply", (pat: Tree) :: (rhs: Tree) :: Nil) => Some(tpd.CaseDef(pat, tpd.EmptyTree, rhs))
+      case ("TypeCaseDefModule", "copy", (orig: Tree) :: (pat: Tree) :: (rhs: Tree) :: Nil) => Some(tpd.cpy.CaseDef(orig)(pat, tpd.EmptyTree, rhs))
+      case ("UnapplyModule", "apply", (fun: Tree) :: impls :: pats :: Nil) => Some(pos0(tpd.UnApply(fun, trees(impls), trees(pats), defn.NothingType)))
+      case ("UnapplyModule", "copy", (orig: Tree) :: (fun: Tree) :: impls :: pats :: Nil) => Some(pos0(tpd.cpy.UnApply(orig)(fun, trees(impls), trees(pats))))
+      case ("AlternativesModule", "apply", pats :: Nil) => Some(pos0(tpd.Alternative(trees(pats))))
+      case ("AlternativesModule", "copy", (orig: Tree) :: pats :: Nil) => Some(tpd.cpy.Alternative(orig)(trees(pats)))
+      case ("TermParamClauseModule" | "TypeParamClauseModule", "apply", params :: Nil) => Some(asObjectList(params))
+      case ("SimpleSelectorModule", "apply", (n: String) :: Nil) => Some(pos0(untpd.ImportSelector(untpd.Ident(n.toTermName))))
+      case ("RenameSelectorModule", "apply", (from: String) :: (to: String) :: Nil) => Some(pos0(untpd.ImportSelector(untpd.Ident(from.toTermName), untpd.Ident(to.toTermName))))
+      case ("OmitSelectorModule", "apply", (n: String) :: Nil) => Some(pos0(untpd.ImportSelector(untpd.Ident(n.toTermName), untpd.Ident(nme.WILDCARD))))
+      case ("GivenSelectorModule", "apply", bound :: Nil) =>
+        Some(pos0(untpd.ImportSelector(untpd.Ident(nme.EMPTY), bound = opt(bound) match { case Some(t: Tree) => untpd.TypedSplice(t); case _ => untpd.EmptyTree })))
+      // TypeRepr constructors
+      case ("ConstantTypeModule", "apply", (c: Constant) :: Nil) => Some(T.ConstantType(c))
+      case ("TermRefModule", "apply", (qual: Type) :: (n: String) :: Nil) => Some(T.TermRef(qual, n.toTermName))
+      case ("SuperTypeModule", "apply", (th: Type) :: (su: Type) :: Nil) => Some(T.SuperType(th, su))
+      case ("RefinementModule", "apply", (parent: Type) :: (n: String) :: (info: Type) :: Nil) =>
+        Some(T.RefinedType(parent, if info.isInstanceOf[T.TypeBounds] then n.toTypeName else n.toTermName, info))
+      case ("AppliedTypeModule", "apply", (tycon: Type) :: targs :: Nil) => Some(T.AppliedType(tycon, types(targs)))
+      case ("AnnotatedTypeModule", "apply", (underlying: Type) :: (annot: Tree) :: Nil) =>
+        Some(T.AnnotatedType(underlying, dotty.tools.dotc.core.Annotations.Annotation(annot)))
+      case ("AndTypeModule", "apply", (l: Type) :: (r: Type) :: Nil) => Some(T.AndType(l, r))
+      case ("OrTypeModule", "apply", (l: Type) :: (r: Type) :: Nil) => Some(T.OrType(l, r, soft = false))
+      case ("MatchTypeModule", "apply", (bound: Type) :: (scrut: Type) :: cases :: Nil) => Some(T.MatchType(bound, scrut, types(cases)))
+      case ("ByNameTypeModule", "apply", (u: Type) :: Nil) => Some(T.ExprType(u))
+      case ("RecursiveTypeModule", "apply", (f: Function1[Object, Object] @unchecked) :: Nil) =>
+        Some(T.RecType(rt => f(rt).asInstanceOf[Type]))
+      case ("PolyTypeModule", "apply", names :: (bounds: Function1[Object, Object] @unchecked) :: (res: Function1[Object, Object] @unchecked) :: Nil) =>
+        Some(T.PolyType(asObjectList(names).map(_.toString.toTypeName))(pt => asObjectList(bounds(pt)).asInstanceOf[List[T.TypeBounds]], pt => res(pt).asInstanceOf[Type]))
+      case ("TypeLambdaModule", "apply", names :: (bounds: Function1[Object, Object] @unchecked) :: (res: Function1[Object, Object] @unchecked) :: Nil) =>
+        Some(T.HKTypeLambda(asObjectList(names).map(_.toString.toTypeName))(tl => asObjectList(bounds(tl)).asInstanceOf[List[T.TypeBounds]], tl => res(tl).asInstanceOf[Type]))
+      case ("MatchCaseModule", "apply", (pat: Type) :: (rhs: Type) :: Nil) => Some(T.AppliedType(defn.MatchCaseClass.typeRef, List(pat, rhs)))
+      case ("FlexibleTypeModule", "apply", (tp: Type) :: Nil) => Some(T.FlexibleType(tp))
+      case _ => None
+
