+      // see docs/findings.md "Blocker 2"). The only real caller observed is
+      // `scala.runtime.ClassValueCompat`'s JDK-version feature probe
+      // (`Class.forName("java.lang.ClassValue", ...)` guarded by its own
+      // `catch case _: ClassNotFoundException`), where "not found" is
+      // always a sound, if pessimistic, answer -- it just selects that
+      // class's own plain `WeakHashMap`-backed fallback implementation.
+      case "forName" if ownerStripped == "Class" && fn.owner.is(JavaDefined) =>
+        val name = args.headOption.collect { case s: String => s }.getOrElse("")
+        // Exception: a Scala standard-library module class (`scala.Some$`,
+        // ...), which jsoniter-scala's compile-time config evaluator
+        // (`NameMapper`'s JVM-reflection path, e.g. for
+        // `withDiscriminatorFieldName(Some("type"))`) looks up by name to
+        // call `apply` on. Those are already loaded in this very process.
+        if name.startsWith("scala.") && name.endsWith("$") then
+          try Some(Class.forName(name))
+          catch case _: ClassNotFoundException | _: LinkageError => throw new ClassNotFoundException(name)
+        else throw new ClassNotFoundException(name)
+      case name if ownerStripped == "Math" =>
+        args.map {
+          case i: Integer => i.intValue
+          case l: java.lang.Long => l.longValue
+          case d: java.lang.Double => d.doubleValue
+          case f: java.lang.Float => f.floatValue
+        } match
+          case List(a: Int, b: Int) if name == "max" => Some(Int.box(math.max(a, b)))
+          case List(a: Int, b: Int) if name == "min" => Some(Int.box(math.min(a, b)))
+          case List(a: Long, b: Long) if name == "max" => Some(java.lang.Long.valueOf(math.max(a, b)))
+          case List(a: Long, b: Long) if name == "min" => Some(java.lang.Long.valueOf(math.min(a, b)))
+          case List(a: Double) if name == "abs" => Some(java.lang.Double.valueOf(math.abs(a)))
+          case List(a: Int) if name == "abs" => Some(Int.box(math.abs(a)))
+          case _ => None
+
+      // `Predef`'s implicit `RichInt`/`RichLong`/etc wrapper conversions
+      // (`0.until(n)` desugars to `intWrapper(0).until(n)`): identity is
+      // enough since our `Int`/`Long` values are already boxed and the
+      // actual range-building ops are separate intrinsics on that same
+      // boxed value (see `interpretStdlibIntrinsic`).
+      case ("intWrapper" | "longWrapper" | "byteWrapper" | "shortWrapper" | "charWrapper" | "doubleWrapper" | "floatWrapper") =>
+        args.headOption
+
+      case "apply" if ownerName == "TypeBoundsModule" =>
+        args match
+          case (lo: Type) :: (hi: Type) :: Nil => Some(TypeBounds(lo, hi))
+          case _ => None
+      case "empty" if ownerName == "TypeBoundsModule" =>
+        Some(TypeBounds.empty)
+      case "upper" if ownerName == "TypeBoundsModule" =>
+        args.headOption.collect { case hi: Type => TypeBounds.upper(hi) }
+      case "lower" if ownerName == "TypeBoundsModule" =>
+        args.headOption.collect { case lo: Type => TypeBounds.lower(lo) }
+      case "low" if ownerName == "TypeBoundsMethods" =>
+        args.headOption.collect { case b: TypeBounds => b.lo.stripLazyRef }
+      case "hi" if ownerName == "TypeBoundsMethods" =>
+        args.headOption.collect { case b: TypeBounds => b.hi.stripLazyRef }
+
+      // `TermModule#betaReduce(term)`: real QuotesImpl (QuotesImpl.scala:
+      // 434-449) reduces `((x1, ..., xn) => body)(v1, ..., vn)`-shaped
+      // applications via dotc's own REAL `dotty.tools.dotc.transform.
+      // BetaReduce` utility -- called directly, same as any other
+      // dotc-internal API this file already calls straight (not part of
+      // the Quotes stub surface at all, a genuine compiler-internal
+      // transform living in this same binary). Needed by macro libraries
+      // that build a lambda application via `Expr.betaReduce` rather than
+      // relying on the backend to inline it later (e.g. utest's own
+      // `Tracer.traceOneWithCode`/`Tracer.apply`, `scli test`, see
+      // docs/findings.md).
+      case "betaReduce" if ownerName == "TermModule" =>
+        args.headOption.collect { case t: Tree =>
+          val reduced = new tpd.TreeMap {
+            override def transform(tree: Tree)(using Context): Tree = tree match
+              case tpd.Block(Nil, _) | tpd.Inlined(_, Nil, _) => super.transform(tree)
+              case tpd.Apply(sel @ tpd.Select(expr, nme), args2) =>
+                val t2 = tpd.cpy.Apply(tree)(tpd.cpy.Select(sel)(transform(expr), nme), args2)
+                dotty.tools.dotc.transform.BetaReduce(t2).withSpan(tree.span)
+              case tpd.Apply(ta @ tpd.TypeApply(sel @ tpd.Select(expr: Apply, nme), tpts), args2) =>
+                val t2 = tpd.cpy.Apply(tree)(tpd.cpy.TypeApply(ta)(tpd.cpy.Select(sel)(transform(expr), nme), tpts), args2)
+                dotty.tools.dotc.transform.BetaReduce(t2).withSpan(tree.span)
+              case _ => dotty.tools.dotc.transform.BetaReduce(tree).withSpan(tree.span)
+          }.transform(t)
+          if reduced == t then None else Some(reduced)
+        }
+
+      case "apply" if ownerName == "MethodTypeModule" =>
+        args match
+          case (paramNames: List[String @unchecked]) :: (paramInfosExp: Function1[Object, Object] @unchecked) :: (resultTypeExp: Function1[Object, Object] @unchecked) :: Nil =>
+            Some(MethodType(paramNames.map(_.toTermName))(
+              mt => paramInfosExp(mt.asInstanceOf[Object]).asInstanceOf[List[Type]],
+              mt => resultTypeExp(mt.asInstanceOf[Object]).asInstanceOf[Type]))
+          case _ => None
+
+      // `quotes.reflect.XxxModule#copy(original)(...)`: real QuotesImpl
+      // implements essentially all of these as a thin `tpd.cpy.Xxx(original)(...)`
+      // (dotc's own tree-copier, preserving span/type from `original` while
+      // substituting the given children) -- needed by the real default
+      // `TreeMap#transformTerm`/etc (`Quotes.scala`'s own library source,
+      // itself real interpretable Scala, calling BACK into these `copy`
+      // module methods for every tree shape it doesn't special-case), which
+      // any macro's own `new TreeMap { override def transformXxx = ... }`
+      // (calling `super.transformXxx` for every shape it doesn't override
+      // itself) exercises broadly -- e.g. utest's own `Tracer.tracingMap`
+      // (`scli test`, see docs/findings.md). Curated over the common TERM
+      // shapes as exercised; `TypeTree`-shape copies
+      // (`TypeSelect`/`Annotated`/etc) aren't covered yet.
+      case "copy" if ownerName == "SelectModule" =>
+        args match
+          case (original: Tree) :: (qual: Tree) :: (name: String) :: Nil => Some(tpd.cpy.Select(original)(qual, name.toTermName))
+          case _ => None
+      case "copy" if ownerName == "IdentModule" =>
+        args match
+          case (original: Tree) :: (name: String) :: Nil => Some(tpd.cpy.Ident(original)(name.toTermName))
+          case _ => None
+      case "copy" if ownerName == "SuperModule" =>
+        args match
+          case (original: Tree) :: (qual: Tree) :: (mixOpt: Option[String @unchecked]) :: Nil =>
+            Some(tpd.cpy.Super(original)(qual, mixOpt.map(x => dotty.tools.dotc.ast.untpd.Ident(x.toTypeName)).getOrElse(dotty.tools.dotc.ast.untpd.EmptyTypeIdent)))
+          case _ => None
+      case "copy" if ownerName == "ApplyModule" =>
+        args match
+          case (original: Tree) :: (fn2: Tree) :: (as: List[Tree @unchecked]) :: Nil => Some(tpd.cpy.Apply(original)(fn2, as))
+          case _ => None
+      case "copy" if ownerName == "TypeApplyModule" =>
+        args match
+          case (original: Tree) :: (fn2: Tree) :: (as: List[Tree @unchecked]) :: Nil => Some(tpd.cpy.TypeApply(original)(fn2, as))
+          case _ => None
+      case "copy" if ownerName == "LiteralModule" =>
+        args match
+          case (original: Tree) :: (c: dotty.tools.dotc.core.Constants.Constant) :: Nil => Some(tpd.cpy.Literal(original)(c))
+          case _ => None
+      case "copy" if ownerName == "NewModule" =>
+        args match
+          case (original: Tree) :: (tpt: Tree) :: Nil => Some(tpd.cpy.New(original)(tpt))
+          case _ => None
+      case "copy" if ownerName == "TypedModule" || ownerName == "TypedOrTestModule" =>
+        args match
+          case (original: Tree) :: (expr: Tree) :: (tpt: Tree) :: Nil => Some(tpd.cpy.Typed(original)(expr, tpt))
+          case _ => None
+      case "copy" if ownerName == "NamedArgModule" =>
+        args match
+          case (original: Tree) :: (name: String) :: (arg: Tree) :: Nil => Some(tpd.cpy.NamedArg(original)(name.toTermName, arg))
+          case _ => None
+      case "copy" if ownerName == "AssignModule" =>
+        args match
+          case (original: Tree) :: (lhs: Tree) :: (rhs: Tree) :: Nil => Some(tpd.cpy.Assign(original)(lhs, rhs))
+          case _ => None
+      case "copy" if ownerName == "BlockModule" =>
+        args match
+          case (original: Tree) :: (stats: List[Tree @unchecked]) :: (expr: Tree) :: Nil => Some(tpd.cpy.Block(original)(stats, expr))
+          case _ => None
+      case "copy" if ownerName == "IfModule" =>
+        args match
+          case (original: Tree) :: (cond: Tree) :: (thenp: Tree) :: (elsep: Tree) :: Nil => Some(tpd.cpy.If(original)(cond, thenp, elsep))
+          case _ => None
+      case "copy" if ownerName == "MatchModule" =>
+        args match
+          case (original: Tree) :: (sel: Tree) :: (cases: List[CaseDef @unchecked]) :: Nil => Some(tpd.cpy.Match(original)(sel, cases))
+          case _ => None
+      case "copy" if ownerName == "ClosureModule" =>
+        args match
+          case (original: Tree) :: (meth: Tree) :: (tpeOpt: Option[Type @unchecked]) :: Nil =>
+            Some(tpd.cpy.Closure(original)(Nil, meth, tpeOpt.map(tpd.TypeTree(_)).getOrElse(tpd.EmptyTree)))
+          case _ => None
+      case "copy" if ownerName == "SummonFromModule" =>
+        args match
+          case (original: Tree) :: (cases: List[CaseDef @unchecked]) :: Nil => Some(tpd.cpy.Match(original)(tpd.EmptyTree, cases))
+          case _ => None
+      case "copy" if ownerName == "ReturnModule" =>
+        args match
+          case (original: Tree) :: (expr: Tree) :: (from: Symbol) :: Nil => Some(tpd.cpy.Return(original)(expr, tpd.ref(from)))
+          case _ => None
+      case "copy" if ownerName == "TryModule" =>
+        args match
+          case (original: Tree) :: (expr: Tree) :: (cases: List[CaseDef @unchecked]) :: (finalizerOpt: Option[Tree @unchecked]) :: Nil =>
+            Some(tpd.cpy.Try(original)(expr, cases, finalizerOpt.getOrElse(tpd.EmptyTree)))
+          case _ => None
+      case "copy" if ownerName == "WhileModule" =>
+        args match
+          case (original: Tree) :: (cond: Tree) :: (body: Tree) :: Nil => Some(tpd.cpy.WhileDo(original)(cond, body))
+          case _ => None
+      case "copy" if ownerName == "RepeatedModule" =>
+        args match
+          case (original: Tree) :: (elems: List[Tree @unchecked]) :: (elemtpt: Tree) :: Nil => Some(tpd.cpy.SeqLiteral(original)(elems, elemtpt))
+          case _ => None
+      case "copy" if ownerName == "CaseDefModule" =>
+        args match
+          case (original: Tree) :: (pat: Tree) :: (guardOpt: Option[Tree @unchecked]) :: (rhs: Tree) :: Nil =>
+            Some(tpd.cpy.CaseDef(original)(pat, guardOpt.getOrElse(tpd.EmptyTree), rhs))
+          case _ => None
+      case "copy" if ownerName == "ValDefModule" =>
+        args match
+          case (original: Tree) :: (name: String) :: (tpt: Tree) :: (rhsOpt: Option[Tree @unchecked]) :: Nil =>
+            Some(tpd.cpy.ValDef(original)(name.toTermName, tpt, rhsOpt.getOrElse(tpd.EmptyTree)))
+          case _ => None
+      case "copy" if ownerName == "ClassDefModule" =>
+        // As real `QuotesImpl`: keep the original `TypeDef`, swap the `Template`'s parts.
+        args match
+          case (original: Tree) :: (name: String) :: (constr: Tree) :: (parents: List[Tree @unchecked]) :: (selfOpt: Option[Tree @unchecked]) :: (body: List[Tree @unchecked]) :: Nil =>
+            original match
+              case dotty.tools.dotc.ast.Trees.TypeDef(_, originalImpl: tpd.Template) =>
+                Some(tpd.cpy.TypeDef(original)(name.toTypeName, tpd.cpy.Template(originalImpl)(constr.asInstanceOf[tpd.DefDef], parents, Nil, selfOpt.getOrElse(tpd.EmptyValDef).asInstanceOf[tpd.ValDef], body)))
+              case _ => None
+          case _ => None
+      case "copy" if ownerName == "DefDefModule" =>
+        args match
+          case (original: Tree) :: (name: String) :: (paramss: List[Tree @unchecked]) :: (tpt: Tree) :: (rhsOpt: Option[Tree @unchecked]) :: Nil =>
+            Some(tpd.cpy.DefDef(original)(name.toTermName, paramss.asInstanceOf[List[tpd.ParamClause]], tpt, rhsOpt.getOrElse(tpd.EmptyTree)))
+          case _ => None
+
+      case _ => quotesApiFallthrough(fn, args)
+  end interpretQuotesApi
+
+  /** An owner's name and its name without the module `$`, computed once per symbol: the guards of
+   *  `interpretQuotesApi` read them on every call, and `Name.toString` allocates.
+   */
+  private val ownerNameCache = mutable.HashMap.empty[Symbol, (String, String)]
+  private def ownerNames(owner: Symbol): (String, String) =
+    ownerNameCache.getOrElseUpdate(owner, { val n = owner.name.toString; (n, n.stripSuffix("$")) })
+
+  /** Every case of `moduleConstructor` is keyed by a `*Module` owner; the other calls have no
+   *  tuple tests to go through.
+   */
+  private def quotesApiFallthrough(fn: Symbol, args: List[Object]): Option[Object] =
+    val owner = fn.owner.name.toString
+    if owner.endsWith("Module") then moduleConstructor(owner, fn.name.toString, args) else None
+
+  /** The owners `interpretQuotesApi`'s cases that bind the method name (`case n if ...`) accept. */
+  private def quotesApiOwnerMayBind(ownerName: String): Boolean =
+    ownerName.endsWith("Methods") || ownerName.stripSuffix("$") == "Math" || ownerName == "PrinterModule" ||
+    ownerName == "reflectModule" || ownerName == "FlagsModule" || ownerName == "defnModule"
+
+  /** The method names `interpretQuotesApi`'s cases test as literals (generated from its source;
+   *  keep in step when adding a case).
+   */
+  private val quotesApiNames: Set[String] = Set(
+    "&", "<:<", "=:=", "annotations", "appliedTo", "appliedToArgs",
+    "appliedToArgss", "appliedToNone", "appliedToType", "appliedToTypes", "apply", "asExpr",
+    "asExprOf", "asTerm", "asType", "baseClasses", "baseType", "betaReduce",
+    "body", "byteWrapper", "caseFields", "changeOwner", "charWrapper", "children",
+    "classSymbol", "companionClass", "companionModule", "constructor", "copy", "current",
+    "dealias", "dealiasKeepOpaques", "declarations", "declaredMethod", "derivesFrom", "doubleWrapper",
+    "empty", "end", "endColumn", "endLine", "erasedArgs", "error",
+    "errorAndAbort", "exists", "explanation", "fieldMembers", "flags", "floatWrapper",
+    "forName", "fullName", "getAnnotation", "getBoolean", "getFileName", "getJPath",
+    "hasAnnotation", "hasErasedArgs", "hi", "info", "intWrapper", "is",
+    "isAliasType", "isClassConstructor", "isClassDef", "isContextFunctionType", "isDefDef", "isDependentFunctionType",
+    "isErased", "isErasedFunctionType", "isExprOf", "isFunctionType", "isGiven", "isImplicit",
+    "isNoSymbol", "isSingleton", "isTerm", "isTupleN", "isType", "isTypeDef",
+    "isTypeParam", "jpath", "leadingTypeParams", "longWrapper", "low", "lower",
+    "memberFields", "memberMethods", "memberType", "methodMember", "methodMembers", "moduleClass",
+    "name", "newBind", "newBuilder", "newMethod", "newVal", "noSymbol",
+    "of", "ofMacroExpansion", "overloaded", "param", "paramNames", "paramSymss",
+    "paramTypes", "paramVariance", "params", "paramss", "parents", "path",
+    "pos", "primaryConstructor", "reflect", "requiredClass", "requiredMethod", "requiredModule",
+    "resType", "returnTpt", "rhs", "seal", "search", "searchIgnoring",
+    "select", "shortWrapper", "show", "signature", "simplified", "sourceCode",
+    "sourceFile", "spliceOwner", "start", "startColumn", "startLine", "substituteTypes",
+    "symbol", "term", "termParamss", "termRef", "termSymbol", "toString",
+    "tpe", "tpt", "trailingParamss", "translucentSuperType", "tree", "typeArgs",
+    "typeConstructorOf", "typeRef", "typeSymbol", "underlying", "underlyingArgument", "unique",
+    "unpickleExprV2", "unpickleTypeV2", "upper", "value", "valueOrAbort", "warning",
+    "widen", "widenByName", "widenTermRefByName", "|"
