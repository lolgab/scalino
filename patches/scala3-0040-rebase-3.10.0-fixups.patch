+  /** Converts an interpreted list value to a real `List[Object]`, whether
+   *  it's already a real host `Seq` (e.g. built via `List(...)`, which goes
+   *  through `interpretCollectionFactory`) or a chain of `InterpretedInstance`
+   *  `::` cells (built via direct cons syntax, deliberately NOT a real host
+   *  object -- see `newStdlibCollection`, `ListBuffer` mutates a cell's
+   *  `next` field directly). Needed wherever downstream code (ours, e.g.
+   *  `ApplyModule.apply`, or interpreted library code) structurally expects
+   *  a real `List`.
+   */
+  /** A varargs/array argument value as a `List` (host `Array`, `Seq`). */
+  private def asArrayLike(v: Object): List[Object] = v match
+    case a: Array[Object] @unchecked => a.toList
+    case s: scala.collection.Seq[Object @unchecked] => s.toList
+    case other if other != null && other.getClass.isArray => (0 until java.lang.reflect.Array.getLength(other)).map(java.lang.reflect.Array.get(other, _)).toList
+    case _ => Nil
+
+  private def asObjectList(v: Object): List[Object] = v match
+    case s: scala.collection.Seq[Object @unchecked] => s.toList
+    case inst: InterpretedInstance if inst.cls.name.toString == "::" =>
+      inst.fields("head") :: asObjectList(inst.fields("next"))
+    case _ => Nil
+
+  /** Materializes anything that behaves like a collection into a real host
+   *  `Seq[Object]` -- needed wherever downstream code (ours, e.g.
+   *  `IterableFactory#from`, or interpreted library code) structurally
+   *  needs one. Real host `Seq`/`Option` and a `::`/`Nil` chain built by
+   *  interpretation (`asObjectList`'s own cases) are immediate; anything
+   *  else is assumed to be an `InterpretedInstance` for a lazy view built
+   *  by interpreting real stdlib source (e.g. `View.Collect`/`View.ZipAll`,
+   *  from `.collect`/`.zipAll` -- observed via upickle's own derivation
+   *  macro and porcupine's `sql"..."` respectively): drained via its own
+   *  real `iterator`/`hasNext`/`next` methods, called through this same
