+  /** Real JVM "zero value" for a var's own static type, for `var x: T = _`/
+   *  `compiletime.uninitialized` -- there's no real initializer tree to
+   *  interpret, so this has to be synthesized instead. `null` is only
+   *  correct for reference types; every primitive value type has its own
+   *  scalar default (`0`/`0L`/`false`/...), which a blanket `null` silently
+   *  violates the moment a primitive-typed var (not just a reference-typed
+   *  one, e.g. `Array[T] = _`) uses `compiletime.uninitialized` -- its main
+   *  use case, since it replaces `_` specifically to also cover value types
+   *  `_` alone couldn't (a bare `_` initializer is invalid for a value
+   *  type). Mirrors `matchesRuntimeType`'s own `cls ==` dispatch above.
+   */
+  private def defaultValueOf(tpe: Type)(using Context): Object =
+    val cls = tpe.classSymbol
+    if cls == defn.IntClass then Int.box(0)
+    else if cls == defn.LongClass then java.lang.Long.valueOf(0L)
+    else if cls == defn.BooleanClass then java.lang.Boolean.valueOf(false)
+    else if cls == defn.DoubleClass then java.lang.Double.valueOf(0.0)
+    else if cls == defn.FloatClass then java.lang.Float.valueOf(0.0f)
+    else if cls == defn.CharClass then Character.valueOf(0.toChar)
+    else if cls == defn.ByteClass then java.lang.Byte.valueOf(0.toByte)
+    else if cls == defn.ShortClass then java.lang.Short.valueOf(0.toShort)
+    else if cls == defn.UnitClass then interpretUnit()
+    else null
