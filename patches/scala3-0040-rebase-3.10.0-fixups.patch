+  private def hostClassTest(v: Object, cls: Symbol)(using Context): Option[Boolean] =
+    if v == null || !cls.exists || !cls.isClass || cls.is(Trait) || cls.is(JavaDefined) then None
+    else if v.isInstanceOf[InterpretedInstance] || v.isInstanceOf[ModuleValue] then None
