+            val params = readFromArray(env.paramsRaw)(using textDocumentPositionParamsCodec)
+            sendResult(env.idRaw, writeToArray(server.signatureHelp(params)))
+          case "textDocument/typeDefinition" =>
+            val params = readFromArray(env.paramsRaw)(using textDocumentPositionParamsCodec)
+            sendResult(env.idRaw, writeToArray(server.typeDefinition(params))(using locationListCodec))
+          case "textDocument/prepareRename" =>
+            val params = readFromArray(env.paramsRaw)(using textDocumentPositionParamsCodec)
+            server.prepareRename(params) match {
+              case Some(range) => sendResult(env.idRaw, writeToArray(range))
+              case None => sendResult(env.idRaw, "null".getBytes("UTF-8"))
+            }
+          case "textDocument/selectionRange" =>
+            val params = readFromArray(env.paramsRaw)(using selectionRangeParamsCodec)
+            sendResult(env.idRaw, writeToArray(server.selectionRange(params))(using selectionRangeListCodec))
+          case "textDocument/inlayHint" =>
+            val params = readFromArray(env.paramsRaw)(using inlayHintParamsCodec)
+            sendResult(env.idRaw, writeToArray(server.inlayHint(params))(using inlayHintListCodec))
+          case "textDocument/semanticTokens/full" =>
+            val params = readFromArray(env.paramsRaw)(using documentSymbolParamsCodec)
+            sendResult(env.idRaw, writeToArray(server.semanticTokens(params)))
+          case "textDocument/codeAction" =>
+            val params = readFromArray(env.paramsRaw)(using codeActionParamsCodec)
+            sendResult(env.idRaw, writeToArray(server.codeAction(params))(using codeActionListCodec))
+          case "$/cancelRequest" => () // no cancellation support -- see docs/findings.md
+          case other =>
+            Log(s"<- $other UNSUPPORTED")
+            if (isRequest) sendError(env.idRaw, s"Unsupported method: $other")
+        }
+        if (env.method != "shutdown") Log(s"<- ${env.method} ok")
+      } catch {
+        case t: Throwable =>
+          Log(s"<- ${env.method} FAILED: ${t.getClass.getName}: ${t.getMessage}")
+          t.printStackTrace()
+          if (isRequest) sendError(env.idRaw, s"${t.getClass.getName}: ${t.getMessage}")
+          else sendShowMessage(s"scalino-lsp: ${env.method} failed: ${t.getClass.getName}: ${t.getMessage}")
+      }
+    }
+
+    // -- Raw Content-Length-framed message reading ---------------------------
+    def readHeaderLine(): String = {
+      val sb = new StringBuilder
+      var c = in.read()
+      while (c != -1 && c != '\n') {
+        if (c != '\r') sb.append(c.toChar)
+        c = in.read()
+      }
+      if (c == -1 && sb.isEmpty) null else sb.toString
+    }
+    def readFramedBody(): Array[Byte] = {
+      var contentLength = -1
+      var line = readHeaderLine()
+      while (line != null && line.nonEmpty) {
+        val idx = line.indexOf(':')
+        if (idx >= 0 && line.substring(0, idx).trim.equalsIgnoreCase("Content-Length"))
+          contentLength = line.substring(idx + 1).trim.toInt
+        line = readHeaderLine()
+      }
+      if (line == null || contentLength < 0) null
+      else {
+        val buf = new Array[Byte](contentLength)
+        var off = 0
+        while (off < contentLength) {
+          val n = in.read(buf, off, contentLength - off)
+          if (n < 0) throw new java.io.EOFException("stdin closed mid-message")
+          off += n
+        }
+        buf
+      }
+    }
+
+    var running = true
+    while (running) {
+      val body =
+        try readFramedBody()
+        catch { case _: java.io.EOFException => null }
+      if (body == null) {
+        running = false
+      } else {
+        val env =
+          try readFromArray(body)(using incomingEnvelopeCodec)
+          catch {
+            case t: Throwable =>
+              Log(s"<- (unparseable message) FAILED: ${t.getClass.getName}: ${t.getMessage}")
+              null
+          }
+        if (env != null) {
+          lastActivityMillis = System.currentTimeMillis()
+          if (env.method == "exit") {
+            Log("-> exit")
+            System.exit(0)
+          } else {
+            queue.put(() => handle(env))
+          }
+        }
+      }
+    }
   }
 }
