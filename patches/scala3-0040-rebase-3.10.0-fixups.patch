+    else if sym.maybeOwner.exists && localClassTrees.contains(sym.owner) && findDefTree(localClassTrees(sym.owner), sym).isDefined then
+      findDefTree(localClassTrees(sym.owner), sym).get
+    else
+      val top = sym.topLevelClass
+      if top.exists && top.isClass then
+        val root = top.asClass.rootTreeContaining(rootTreeSearchName(sym.name))
+        if root.isEmpty then tpd.EmptyTree
+        else findDefTree(root, sym).getOrElse(tpd.EmptyTree)
