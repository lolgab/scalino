+  private def resolveExternalDefTree(sym: Symbol)(using Context): Tree =
+    if !sym.defTree.isEmpty then sym.defTree
+    else if javalibOverlay.exists(o => o.isShadow(sym) || (sym.is(JavaDefined) && !o.treeFor(sym).isEmpty)) then
+      val t = javalibOverlay.get.treeFor(sym)
