+        val reflectCls = defn.QuotesClass.info.member(typeName("reflectModule")).symbol
+        val owners = defn.QuotesClass :: (if reflectCls.exists then reflectCls :: reflectCls.info.decls.toList.filter(_.isClass) else Nil)
