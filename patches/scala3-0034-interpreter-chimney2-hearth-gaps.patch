   /** Interpret the code `new annot(..).transform(using <Quotes(ctx)>)(<tree>, <companion>)`
    *
-   *  Deliberately unsupported on this toolchain: real support needs either
-   *  reflectively invoking the annotation's own compiled `transform` method
-   *  (`scala.reflect.Selectable.reflectiveSelectable`, backed by
-   *  `java.lang.reflect.Method#invoke` -- unavailable in a closed-world AOT
-   *  target; see docs/findings.md "Blocker C") or extending this project's
-   *  own reflection-free tree interpreter (already used for ordinary
-   *  inline/quote macros) to cover macro-*annotation* invocation too, which
-   *  hasn't been done. Macro annotations remain an experimental, rarely-used
-   *  Scala 3 feature, so this reports a clear error instead of attempting
-   *  either.
+   *  The annotation class is run by this toolchain's own tree interpreter (no
+   *  reflection: `Method#invoke` doesn't exist in a closed-world AOT binary),
+   *  exactly like ordinary inline/quote macros.
    */
   private def callMacro(interpreter: Interpreter, tree: MemberDef, companion: Option[MemberDef], annot: Annotation)
                        (using Context): (List[MemberDef], Option[MemberDef]) =
-    report.error(
-      i"Macro annotation `$annot` cannot be expanded: macro annotations are not supported by this toolchain.",
-      annot.tree)
-    (List(tree), companion)
+    val quotes = QuotesImpl()(using SpliceScope.contextWithNewSpliceScope(tree.symbol.sourcePos)(using MacroExpansion.context(tree)).withOwner(tree.symbol.owner))
+    try
+      val result = Splicer.onBigStack(interpreter.callMacroAnnotation(annot.tree, tree, companion, quotes)).asInstanceOf[List[MemberDef]]
+      // Process the result based on if the companion was present or not
+      // The idea is that we try to find a transformation of the companion if we do provide one
+      companion.map(_.symbol) match
+        case None => (result, companion)
+        case Some(companionSym) => result.partition(_.symbol == companionSym) match
+          case (Nil, result) => (result, companion) // companion didn't change
+          case (newCompanion :: Nil, result) => (result, Some(newCompanion))
+          case (_, result) =>
+            report.error(i"Transformed companion for ${tree.symbol} was returned more than once by `(${annot.tree}).transform(..)` during macro expansion", annot.tree)
+            (result, companion)
+    catch
+      case ex: CompilationUnit.SuspendException =>
+        throw ex
+      case ex: scala.quoted.runtime.StopMacroExpansion =>
+        if !ctx.reporter.hasErrors then
+          report.error("Macro expansion was aborted by the macro without any errors reported. Macros should issue errors to end-users when aborting a macro expansion with StopMacroExpansion.", annot.tree)
+        (List(tree), companion)
+      case ex: Interpreter.StopInterpretation =>
+        report.error(ex.msg, ex.pos)
+        (List(tree), companion)
+      case NonFatal(ex) =>
+        report.error(
+          em"""Failed to evaluate macro annotation '$annot'.
+              |  Caused by ${ex.getClass}: ${if (ex.getMessage == null) "" else ex.getMessage}""",
+          annot.tree)
+        (List(tree), companion)
   end callMacro
 
