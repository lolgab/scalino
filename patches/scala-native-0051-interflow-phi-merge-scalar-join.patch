diff --git a/tools/src/test/scala/scala/scalanative/optimizer/MergePhiScalarJoinTest.scala b/tools/src/test/scala/scala/scalanative/optimizer/MergePhiScalarJoinTest.scala
new file mode 100644
index 0000000..63cef37
--- /dev/null
+++ b/tools/src/test/scala/scala/scalanative/optimizer/MergePhiScalarJoinTest.scala
@@ -0,0 +1,81 @@
+package scala.scalanative
+package optimizer
+
+import org.junit.Assert._
+import org.junit._
+
+import scala.scalanative.OptimizerSpec
+
+class MergePhiScalarJoinTest extends OptimizerSpec {
+
+  /** Two branches allocate distinct instances of the same shape
+   *  (`Point`), merged at a phi into a single local. Before the
+   *  MergeProcessor phi-merge scalar join, this forced both branches to
+   *  materialize a real `Op.Classalloc`, even though the merged value is
+   *  only ever used for scalar field reads (never escapes as a whole
+   *  reference). With the join in place, the merge keeps a single virtual
+   *  instance whose fields are themselves phi-merged, so no allocation is
+   *  ever emitted.
+   */
+  @Test def noAllocationForJoinableBranches(): Unit = {
+    optimize(
+      entry = "Test",
+      sources = Map(
+        "Test.scala" ->
+          """|final class Point(val x: Int, val y: Int)
+             |
+             |object Test {
+             |  def main(args: Array[String]): Unit = {
+             |    val cond = args.length == 0
+             |    val p = if (cond) new Point(1, 2) else new Point(3, 4)
+             |    println(p.x + p.y)
+             |  }
+             |}
+             |""".stripMargin
+      ),
+      setupConfig = _.withMode(scala.scalanative.build.Mode.releaseFast)
+    ) {
+      case (_, result) =>
+        findEntry(result.defns.toSeq).foreach { defn =>
+          val classallocs = defn.insts.collect {
+            case nir.Inst.Let(_, op: nir.Op.Classalloc, _)
+                if op.name.toString.contains("Point") =>
+              op
+          }
+          assertTrue(
+            "Expected no Op.Classalloc for Point - branches should have " +
+              s"been joined into a single virtual instance; got: $classallocs",
+            classallocs.isEmpty
+          )
+        }
+    }
+  }
+
+  /** Branches allocating arrays of different lengths must NOT be joined
+   *  (field count differs), so the existing materialize-based fallback
+   *  still applies and behavior is unchanged from before the join.
+   */
+  @Test def differentLengthArraysAreNotJoined(): Unit = {
+    optimize(
+      entry = "Test",
+      sources = Map(
+        "Test.scala" ->
+          """|object Test {
+             |  def main(args: Array[String]): Unit = {
+             |    val cond = args.length == 0
+             |    val a = if (cond) new Array[Int](2) else new Array[Int](3)
+             |    println(a.length)
+             |  }
+             |}
+             |""".stripMargin
+      ),
+      setupConfig = _.withMode(scala.scalanative.build.Mode.releaseFast)
+    ) {
+      case (_, result) =>
+        // Just confirming this compiles/optimizes without crashing the
+        // joinability check (arrays of differing length are a real fixture
+        // that must fall through to materialize, not a hypothetical).
+        assertTrue(findEntry(result.defns.toSeq).isDefined)
+    }
+  }
+}
