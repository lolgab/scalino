+
+#if defined(__aarch64__) && !defined(SN_UC_UNSUPPORTED)
+/* aarch64 resume: the trampoline cannot restore every register and then branch
+ * (there is no register-free indirect branch, and LLVM keeps live values in
+ * x16/x17/x30). Instead prepare_redirect copies the interrupted machine context
+ * onto the thread's own stack, below the red zone, and starts the trampoline
+ * with sp pointing at that copy. After Synchronizer_yield the trampoline executes
+ * `brk`; the SIGTRAP handler below overwrites its own signal context with the copy
+ * and returns, so sigreturn restores x0-x30, sp, pc, nzcv and the whole vector
+ * state exactly as they were at the poll. */
+#include <signal.h>
+#include <string.h>
+
+#if defined(__APPLE__)
+#define SN_MCTX_SIZE sizeof(*((ucontext_t *)0)->uc_mcontext)
+#define SN_UC_MCTX(uc) ((void *)(uc)->uc_mcontext)
+#define SN_UC_GET_SP(uc) ((uintptr_t)(uc)->uc_mcontext->__ss.__sp)
+#define SN_UC_SET_SP(uc, sp)                                                   \
+    ((uc)->uc_mcontext->__ss.__sp = (__uint64_t)(uintptr_t)(sp))
+#else
+#define SN_MCTX_SIZE sizeof(mcontext_t)
+#define SN_UC_MCTX(uc) ((void *)&(uc)->uc_mcontext)
+#define SN_UC_GET_SP(uc) ((uintptr_t)(uc)->uc_mcontext.sp)
+#define SN_UC_SET_SP(uc, val)                                                  \
+    ((uc)->uc_mcontext.sp = (uint64_t)(uintptr_t)(val))
+#endif
+#define SN_RED_ZONE 128
+#define SN_ALIGN16(x) (((x) + 15) & ~(uintptr_t)15)
+
+/* Address of the `brk` the trampoline ends with (defined in the .S). */
+extern char scalanative_gc_safepoint_poll_resume_brk[];
+
+static struct sigaction sn_previousSigtrap;
+
+static void sn_resumeTrapHandler(int sig, siginfo_t *info, void *uap) {
+    ucontext_t *uc = (ucontext_t *)uap;
+    if (uc != NULL &&
+        SN_UC_GET_PC(uc) == (uintptr_t)scalanative_gc_safepoint_poll_resume_brk) {
+        memcpy(SN_UC_MCTX(uc), (void *)SN_UC_GET_SP(uc), SN_MCTX_SIZE);
+        return;
+    }
+    /* A brk that is not ours (e.g. a compiler trap): hand it on. */
+    if ((sn_previousSigtrap.sa_flags & SA_SIGINFO) &&
+        sn_previousSigtrap.sa_sigaction != NULL) {
+        sn_previousSigtrap.sa_sigaction(sig, info, uap);
+    } else if (sn_previousSigtrap.sa_handler != SIG_DFL &&
+               sn_previousSigtrap.sa_handler != SIG_IGN) {
+        sn_previousSigtrap.sa_handler(sig);
+    } else {
+        signal(SIGTRAP, SIG_DFL); /* re-executing the brk kills us as usual */
+    }
+}
+
+__attribute__((constructor)) static void sn_installResumeTrapHandler(void) {
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sigemptyset(&sa.sa_mask);
+    sa.sa_sigaction = &sn_resumeTrapHandler;
+    sa.sa_flags = SA_SIGINFO | SA_NODEFER;
+    sigaction(SIGTRAP, &sa, &sn_previousSigtrap);
+}
