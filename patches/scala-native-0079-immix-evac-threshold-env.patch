            liveBytes > 0 &&
-           liveBytes < (uint32_t)(BLOCK_TOTAL_SIZE * EVAC_OCCUPANCY_THRESHOLD);
+           liveBytes < (uint32_t)(BLOCK_TOTAL_SIZE * Evac_OccupancyThreshold());
