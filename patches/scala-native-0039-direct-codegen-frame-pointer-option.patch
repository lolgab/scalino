+  // The `"frame-pointer"` attribute clang would set from the compile options:
+  // they reach clang for the C runtime and `.ll` partitions after its default
+  // `-fomit-frame-pointer` (LLVM.compileFile), so `--compile
+  // -fno-omit-frame-pointer` (scalino: `--native-compile`) keeps frame pointers
+  // in the whole program, e.g. for frame-pointer based profilers. The last
+  // flag wins, as in clang; without any, nothing is set (omitted).
+  private lazy val framePointerMode: Option[String] = {
+    var keep: Option[Boolean] = None
+    var omitLeaf = false
+    config.compilerConfig.compileOptions.foreach {
+      case "-fno-omit-frame-pointer"     => keep = Some(true)
+      case "-fomit-frame-pointer"        => keep = Some(false)
+      case "-momit-leaf-frame-pointer"   => omitLeaf = true
+      case "-mno-omit-leaf-frame-pointer" => omitLeaf = false
+      case _                             => ()
+    }
+    keep.collect { case true => if (omitLeaf) "non-leaf" else "all" }
+  }
+
+  private def markFunctionsFramePointer(mode: String): Unit = {
+    val ctx = C.LLVMGetModuleContext(module)
+    val attr = Zone.acquire { implicit z =>
+      val k = "frame-pointer"
+      C.LLVMCreateStringAttribute(ctx, toCString(k), k.length.toUInt, toCString(mode), mode.length.toUInt)
+    }
+    var fn = C.LLVMGetFirstFunction(module)
+    while (fn != null) {
+      if (C.LLVMIsDeclaration(fn) == 0)
+        C.LLVMAddAttributeAtIndex(fn, LLVMAttributeFunctionIndex, attr)
+      fn = C.LLVMGetNextFunction(fn)
+    }
+  }
+
