+  private def onBigStack[T](body: => T): T =
+    if Thread.currentThread().getName == "scalino-macro" then body
+    else
+      var result: Either[Throwable, T] | Null = null
+      val thread = new Thread(null, () => { result = try Right(body) catch { case e: Throwable => Left(e) } }, "scalino-macro", 512L * 1024 * 1024)
