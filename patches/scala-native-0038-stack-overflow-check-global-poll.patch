+/* Number of threads whose pendingStackOverflowException is set. Generated code
+ * polls this global at the entry of self-recursive methods (codegen/Lower.scala)
+ * and calls scalanative_StackOverflowGuards_check only when it is non-zero: the
+ * thread-local flag costs a call on Darwin (_tlv_get_addr). A thread observes
+ * its own update (it raises the flag in its own signal handler), so a non-zero
+ * count from another thread only sends this one through the slow path. */
+_Atomic int32_t scalanative_StackOverflowGuards_pendingCount = 0;
+
+static inline void setPendingStackOverflow(bool pending) {
+    if (currentThreadInfo.pendingStackOverflowException != pending) {
+        currentThreadInfo.pendingStackOverflowException = pending;
+        atomic_fetch_add_explicit(&scalanative_StackOverflowGuards_pendingCount,
+                                  pending ? 1 : -1, memory_order_relaxed);
+    }
+}
