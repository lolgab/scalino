     (comp, l, r) match {
+      // SMI-style tagged-pointer boxing (see nir.Type.Smi) makes two
+      // independently-boxed *same-valued* instances of an SMI-eligible
+      // type genuinely pointer-equal at runtime on 64-bit targets (same
+      // tag bits computed from the same payload), even though Interflow's
+      // abstract heap models them as two distinct virtual addresses. The
+      // address-identity rule below this case predates SMI and is still
+      // correct for ordinary heap-allocated objects (and for box types
+      // that stay real allocations, e.g. Long/Double, or on 32-bit), but
+      // it is wrong for these - handle them first.
+      case (
+            Ieq | Ine,
+            VirtualRef(BoxKind, lcls, Array(lval)),
+            VirtualRef(BoxKind, rcls, Array(rval))
