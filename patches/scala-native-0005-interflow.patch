+package scala.scalanative
+package interflow
+
+import scala.collection.mutable
+
+import scala.scalanative.linker._
+
+/** Interprocedural, unification-based (Steensgaard style) escape analysis.
+ *
+ *  Runs on optimized NIR. Per function it builds a points-to graph where every
+ *  SSA value is a node and every node has at most one "content" node (what is
+ *  reachable through its fields). Flow between values unifies their classes.
+ *  Classes carry flags describing how their members may outlive the frame.
+ *  Callee summaries (per parameter: escapes / returned / shares memory with
+ *  other params) let calls to analyzable targets avoid forcing escape.
+ *
+ *  Currently report-only: it finds allocation sites that could live on the
+ *  stack, it does not transform anything.
+ */
+private[scalanative] object EscapeAnalysis {
+
+  // Class flags
+  private final val Global = 1 // members stored into / reachable from globals
+  private final val Returned = 2 // reachable from return value
+  private final val Ext = 4 // members are contents of heap/caller memory
+  private final val ExtRoot = 8 // members are heap/caller objects: contents are Ext
+  private final val NonParam = 16
+  // members are global heap objects (modules, call results, ...): storing
+  // anything into their contents makes it escape
+  private final val HeapRoot = 32
+  // all contents of members are the member itself (coarse, after merging
+  // unrelated memory shapes)
+  private final val Collapsed = 64
+  // some member is a raw pointer view of an object (Ref -> Ptr bitcast)
+  private final val FromRef = 128
+  // ... and a tracked value is loaded/stored through a raw pointer
+  private final val RawAccessed = 256 // members may be something other than a param
+  // everything reachable through the fields of members (but not the members
+  // themselves) may be stored into global memory
+  private final val ContentsGlobal = 512
+  // members are the receiver of a virtual call
+  private final val Recv = 1024
+
+  /** Per-parameter facts, joined over all possible targets of a call. */
+  /** libc functions that never retain pointers passed to them. */
+  val NonCapturingExterns: Set[String] = Set(
+    "memcpy", "memmove", "memset", "memcmp", "strlen", "strcmp", "strncmp",
+    "strchr", "strrchr", "strstr", "strcpy", "strncpy", "strcat", "bcmp"
+  )
+
+  final class Summary(
+      // the parameter itself (and so everything reachable from it) may be
+      // stored into global memory / captured
+      val escapes: Array[Boolean],
+      // objects reachable through the parameter's fields may be, but the
+      // parameter object itself is not
+      val escDeep: Array[Boolean],
+      // the parameter is the receiver of a virtual call (directly, or by
+      // being passed on to a callee that does), so knowing its exact class
+      // lets the call be resolved
+      val recv: Array[Boolean],
+      val retSelf: Array[Boolean],
+      val retDeep: Array[Boolean],
+      val retFresh: Boolean,
+      // params with the same group id may share memory
+      val group: Array[Int]
+  )
+
+  /** A function analyzed under assumptions about its arguments: `hints` maps
+   *  a parameter index to the exact class the argument is known to have (the
+   *  caller passes a freshly allocated object), which lets the callee resolve
+   *  virtual calls on it precisely instead of assuming an unknown receiver.
+   */
+  final case class Key(name: nir.Global.Member, hints: List[(Int, nir.Global.Top)])
+
+  final case class Candidate(
+      kind: String,
+      escapes: Boolean,
+      inLoop: Boolean,
+      reason: String,
+      id: Long = -1L,
+      isClass: Boolean = false,
+      fn: String = "",
+      viaCallee: Key = null,
+      viaIdx: Int = -1
+  )
+
+  final class Result(
+      val candidates: Seq[Candidate]
+  )
+
+  private val StackExcludedPrefixes = Seq("java.lang.ref.")
+  private val StackExcludedNames = Set(
+    "java.lang.Thread",
+    "java.lang.String",
+    "java.lang.Class",
+    "java.lang.Throwable"
+  )
+  private val MaxStackFields = 24
+  private[interflow] val MaxTargets = 48
+  private val MaxStackArrayLength = 64
+  private val MaxStackBytesPerFunction = 1024
+
+  /** Rewrites non-escaping, non-loop `Classalloc`s to the stack-allocation
+   *  form understood by `Lower`: `Classalloc(cls, Some(Val.Null))`.
+   */
+  def transform(
+      config: build.Config,
+      analysis: ReachabilityAnalysis.Result,
+      defns: Seq[nir.Defn]
+  ): Seq[nir.Defn] = {
+    implicit val a: ReachabilityAnalysis.Result = analysis
+    val siteTable = sys.env.get("SCALANATIVE_SITE_PROFILE")
+    val ea = new EscapeAnalysis(analysis, defns, recordReasons = siteTable.isDefined)
+    ea.runAll()
+    var converted = 0
+    // debugging aids: restrict which classes get stack allocated
+    val include = sys.env.get("SCALANATIVE_STACK_INCLUDE").map(_.r)
+    val exclude = sys.env.get("SCALANATIVE_STACK_EXCLUDE").map(_.r)
+    def allowed(kind: String): Boolean =
+      include.forall(_.findFirstIn(kind).isDefined) &&
+        exclude.forall(_.findFirstIn(kind).isEmpty)
+    // bisecting aid: SCALANATIVE_STACK_HASH=lo:hi:mod keeps only the sites
+    // whose (function, site) hash falls in [lo, hi) modulo mod
+    val hashRange: Option[(Int, Int, Int)] = sys.env.get("SCALANATIVE_STACK_HASH").flatMap { v =>
+      v.split(":") match {
+        case Array(a, b, c) => Some((a.toInt, b.toInt, c.toInt))
+        case _              => None
+      }
+    }
+    def inHashRange(fn: String, id: Long): Boolean =
+      hashRange.forall {
+        case (lo, hi, mod) =>
+          val h = ((scala.util.hashing.MurmurHash3.stringHash(fn + "#" + id) % mod) + mod) % mod
+          h >= lo && h < hi
+      }
+    val out = defns.map {
+      case d: nir.Defn.Define =>
+        val sites = mutable.LongMap.empty[Boolean]
+        val arraySites = mutable.LongMap.empty[Boolean]
+        var budget = MaxStackBytesPerFunction
+        ea.resultOf(d.name).candidates.foreach { c =>
+          if (c.isClass && !c.escapes && !c.inLoop && allowed(c.kind) && inHashRange(d.name.show, c.id) &&
+              !StackExcludedNames.contains(c.kind) &&
+              !StackExcludedPrefixes.exists(c.kind.startsWith)) {
+            val name = nir.Global.Top(c.kind)
+            name match {
+              case ClassRef(cls)
+                  if cls.fields.size <= MaxStackFields &&
+                    !cls.attrs.isAbstract && !cls.isModule =>
+                val bytes = 16 + 8 * cls.fields.size
+                if (budget >= bytes) {
+                  budget -= bytes
+                  sites(c.id) = true
+                  if (sys.env.contains("SCALANATIVE_STACK_VERBOSE"))
+                    config.logger.info(s"[escape-site] ${c.kind} in ${d.name.show} #${c.id}")
+                }
+              case _ => ()
+            }
+          }
+        }
+        // constant-length arrays
+        d.insts.foreach {
+          case nir.Inst.Let(n, nir.Op.Arrayalloc(ty, init, None), _)
+              if ea.resultOf(d.name).candidates.exists(c => c.id == n.id && !c.escapes && !c.inLoop) &&
+                allowed("array:" + ty.show) && inHashRange(d.name.show, n.id) && ty != nir.Type.Byte =>
+            val len = init match {
+              case nir.Val.Int(l)            => l
+              case nir.Val.ArrayValue(_, vs) => vs.length
+              case _                         => -1
+            }
+            val bytes = 24 + len * (if (ty.isInstanceOf[nir.Type.RefKind] || ty == nir.Type.Long || ty == nir.Type.Double) 8 else 4)
+            if (len >= 0 && len <= MaxStackArrayLength && budget >= bytes) {
+              budget -= bytes
+              arraySites(n.id) = true
+              if (sys.env.contains("SCALANATIVE_STACK_VERBOSE"))
+                config.logger.info(s"[escape-site] array:${ty.show} len=$len in ${d.name.show} #${n.id}")
+            }
+          case _ => ()
+        }
+        if (sites.isEmpty && arraySites.isEmpty) d
+        else {
+          converted += sites.size + arraySites.size
+          val insts = d.insts.map {
+            case nir.Inst.Let(n, nir.Op.Arrayalloc(ty, init, None), unwind)
+                if arraySites.contains(n.id) =>
+              nir.Inst.Let(n, nir.Op.Arrayalloc(ty, init, Some(nir.Val.Null)), unwind)(d.pos, nir.ScopeId.TopLevel)
+            case nir.Inst.Let(n, nir.Op.Classalloc(name, None), unwind)
+                if sites.contains(n.id) =>
+              nir.Inst.Let(
+                n,
+                nir.Op.Classalloc(name, Some(nir.Val.Null)),
+                unwind
+              )(d.pos, nir.ScopeId.TopLevel)
+            case inst => inst
+          }
+          d.copy(insts = insts)(d.pos)
+        }
+      case d => d
+    }
+    config.logger.info(s"Allocated $converted objects on the stack")
+    siteTable.fold(out)(path => instrumentSites(path, ea, out))
+  }
+
+  /** Profiling aid: counts executions of every allocation site candidate.
+   *  Writes a site table to `path` and calls the extern `scalino_site_hit(id)`
+   *  (provided by a profiling build of the GC) before each site.
+   */
+  private def instrumentSites(
+      path: String,
+      ea: EscapeAnalysis,
+      defns: Seq[nir.Defn]
+  ): Seq[nir.Defn] = {
+    val hit = nir.Global.Member(nir.Global.Top("scala.scalanative.runtime.GC$"), nir.Sig.Extern("scalino_site_hit"))
+    val hitTy = nir.Type.Function(Seq(nir.Type.Int), nir.Type.Unit)
+    var nextId = 0
+    val table = new java.io.PrintWriter(path)
+    val out = defns.map {
+      case d: nir.Defn.Define =>
+        val cands = ea.resultOf(d.name).candidates.map(c => c.id -> c).toMap
+        val fresh = nir.Fresh(d.insts)
+        val insts = Seq.newBuilder[nir.Inst]
+        d.insts.foreach {
+          case inst @ nir.Inst.Let(n, op, _)
+              if cands.contains(n.id) &&
+                (op.isInstanceOf[nir.Op.Classalloc] || op.isInstanceOf[nir.Op.Arrayalloc] || op.isInstanceOf[nir.Op.Box]) =>
+            val c = cands(n.id)
+            val stack = op match {
+              case nir.Op.Classalloc(_, Some(nir.Val.Null))    => true
+              case nir.Op.Arrayalloc(_, _, Some(nir.Val.Null)) => true
+              case _                                           => false
+            }
+            val id = nextId
+            nextId += 1
+            table.println(
+              s"$id\t${c.kind}\t${c.escapes}\t${c.inLoop}\t$stack\t${c.reason}\t${d.name.show}"
+            )
+            insts += nir.Inst.Let(
+              fresh(),
+              nir.Op.Call(hitTy, nir.Val.Global(hit, nir.Type.Ptr), Seq(nir.Val.Int(id))),
+              nir.Next.None
+            )(d.pos, nir.ScopeId.TopLevel)
+            insts += inst
+          case inst => insts += inst
+        }
+        d.copy(insts = insts.result())(d.pos)
+      case other => other
+    }
+    table.close()
+    out :+ nir.Defn.Declare(nir.Attrs.None.withIsExtern(true), hit, hitTy)(nir.SourcePosition.NoPosition)
+  }
+
+  def report(
+      config: build.Config,
+      analysis: ReachabilityAnalysis.Result,
+      defns: Seq[nir.Defn]
+  ): Unit = {
+    val ea = new EscapeAnalysis(analysis, defns, recordReasons = true)
+    sys.env.get("SCALANATIVE_ESCAPE_DUMP").foreach { pats =>
+      val ps = pats.split(",").filter(_.nonEmpty)
+      ea.defines.valuesIterator
+        .filter(d => ps.exists(p => d.name.show.contains(p)))
+        .foreach { d => System.err.println("[escape-dump] " + d.show) }
+    }
+    val all = mutable.ArrayBuffer.empty[Candidate]
+    ea.runAll()
+    ea.defines.keysIterator.foreach { n => all ++= ea.resultOf(n).candidates }
+    val total = all.size
+    val noEsc = all.filter(!_.escapes)
+    val noEscNoLoop = noEsc.filter(!_.inLoop)
+    val log = config.logger
+    log.info(
+      s"[escape] alloc sites=$total non-escaping=${noEsc.size} " +
+        s"non-escaping-outside-loops=${noEscNoLoop.size}"
+    )
+    def top(title: String, cs: Seq[Candidate]): Unit = {
+      val byKind = cs.groupBy(_.kind).toSeq.map { case (k, v) => (k, v.size) }
+      byKind.sortBy(-_._2).take(40).foreach {
+        case (k, n) => log.info(s"[escape]   $title $n $k")
+      }
+    }
+    all.filter(_.escapes).groupBy(_.reason).toSeq.map { case (k, v) => (k, v.size) }
+      .sortBy(-_._2).take(60).foreach {
+        case (k, n) => log.info(s"[escape]   reason $n $k")
+      }
+    def shortM(m: nir.Global.Member): String =
+      m.owner.id.split('.').last + "." + (m.sig.unmangled match {
+        case nir.Sig.Method(id, _, _) => id
+        case other                    => other.show.take(30)
+      })
+    def short(k: Key): String =
+      shortM(k.name) + (if (k.hints.isEmpty) "" else k.hints.map { case (i, c) => s"$i=${c.id.split('.').last}" }.mkString("{", ",", "}"))
+    val explainVisited = mutable.HashSet.empty[(Key, Int)]
+    val explainLeaves = mutable.LinkedHashSet.empty[String]
+    def explain(name: Key, idx: Int, depth: Int, path: List[String]): Unit =
+      if (explainVisited.add((name, idx))) {
+        ea.why(name, idx).foreach {
+          case (reason, callee, ci) =>
+            if (callee == null)
+              explainLeaves += (path.reverse.mkString(" > ") + " :: " + reason.take(200))
+            else if (depth > 0) explain(callee, ci, depth - 1, short(callee) + "#" + ci :: path)
+        }
+      }
+    sys.env.get("SCALANATIVE_ESCAPE_KIND_REASONS").foreach { kinds =>
+      kinds.split(";").filter(_.nonEmpty).foreach { k =>
+        val cs = all.filter(c => c.kind == k)
+        log.info(s"[escape-kind] $k sites=${cs.size} eligible=${cs.count(!_.escapes)}")
+        cs.filter(_.escapes).groupBy(_.reason).toSeq
+          .sortBy(-_._2.size).take(10).foreach {
+            case (r, v) =>
+              log.info(s"[escape-kind]    ${v.size} ${r.take(160)}")
+              v.take(2).foreach(c => log.info(s"[escape-kind]         e.g. ${c.fn.take(150)}"))
+              v.find(_.viaCallee != null).foreach { c =>
+                explainVisited.clear(); explainLeaves.clear()
+                explain(c.viaCallee, c.viaIdx, 8, List(short(c.viaCallee) + "#" + c.viaIdx))
+                explainLeaves.take(4).foreach(l => log.info("[escape-kind]         why: " + l.take(400)))
+              }
+          }
+      }
+    }
+    sys.env.get("SCALANATIVE_ESCAPE_WHY").foreach { pats =>
+      val ps = pats.split(",").filter(_.nonEmpty)
+      ea.defines.keysIterator.filter(n => ps.exists(p => n.show.contains(p))).toList.foreach { n =>
+        (0 until ea.paramCount(n)).foreach { i =>
+          if (ea.summaryOf(n).exists(s => s.escapes(i) || s.escDeep(i))) {
+            explainVisited.clear(); explainLeaves.clear()
+            explain(Key(n, Nil), i, 8, List(shortM(n) + "#" + i))
+            log.info(s"[escape-why] ${shortM(n)} param#$i escapes (${explainLeaves.size} leaf reasons):")
+            explainLeaves.take(6).foreach(l => log.info("[escape-why]    " + l))
+          }
+        }
+      }
+    }
+    List[(String, String => Boolean)](
+      ("lambdas", k => k.contains("$Lambda$")),
+      ("anon/iterators", k => k.contains("$$anon$") || k.contains("Iterator")),
+      ("boxes", k => k.startsWith("box:")),
+      ("arrays", k => k.startsWith("array:")),
+      ("option/tuple", k => k == "scala.Some" || k.startsWith("scala.Tuple")),
+      ("cons", k => k.endsWith("$colon$colon"))
+    ).foreach {
+      case (n, f) =>
+        val cs = all.filter(c => f(c.kind))
+        log.info(s"[escape-group] $n sites=${cs.size} eligible=${cs.count(c => !c.escapes && !c.inLoop)}")
+    }
+    top("stack-eligible", noEscNoLoop.toSeq)
+    top("escaping", all.filter(_.escapes).toSeq)
+  }
+}
+
+private[scalanative] class EscapeAnalysis(
+    analysisResult: ReachabilityAnalysis.Result,
+    defns: Seq[nir.Defn],
+    recordReasons: Boolean = false
+) {
+  import EscapeAnalysis._
+  private implicit val analysis: ReachabilityAnalysis.Result = analysisResult
+
+  val defines: mutable.LinkedHashMap[nir.Global.Member, nir.Defn.Define] = {
+    val m = mutable.LinkedHashMap.empty[nir.Global.Member, nir.Defn.Define]
+    defns.foreach {
+      case d: nir.Defn.Define => m(d.name) = d
+      case _                  => ()
+    }
+    m
+  }
+
+  def resultOf(n: nir.Global.Member): Result = results(n)
+
+  /** Experiment knobs (unsound, for measuring what a precision gain would
+   *  be worth): SCALANATIVE_EA_X=monitor,matcherror,throwcap
+   */
+  private val exps: Set[String] =
+    sys.env.get("SCALANATIVE_EA_X").map(_.split(",").toSet).getOrElse(Set.empty)
+  private lazy val throwableCls: Option[Class] =
+    ClassRef.unapply(nir.Global.Top("java.lang.Throwable"))
+  private val throwableOwner = mutable.HashMap.empty[String, Boolean]
+  private def isThrowableOwner(owner: nir.Global.Top): Boolean =
+    throwableOwner.getOrElseUpdate(
+      owner.id,
+      ClassRef.unapply(owner).exists(c => throwableCls.exists(t => c.is(t)))
+    )
+  private def isMonitorOp(name: nir.Global.Member): Boolean =
+    name.owner.id == "scala.scalanative.runtime.package$" &&
+      (name.sig.unmangled match {
+        case nir.Sig.Method(id, _, _) => id == "enterMonitor" || id == "exitMonitor"
+        case _                        => false
+      })
+
+  private val results = mutable.HashMap.empty[nir.Global.Member, Result]
+  private val summaries = mutable.HashMap.empty[Key, Summary]
+  private val inProgress = mutable.HashSet.empty[Key]
+  private val analyzed = mutable.HashSet.empty[Key]
+
+  private def unknownSummary(n: Int): Summary =
+    new Summary(
+      Array.fill(n)(true),
+      Array.fill(n)(true),
+      Array.fill(n)(true),
+      Array.fill(n)(false),
+      Array.fill(n)(false),
+      retFresh = true,
+      Array.tabulate(n)(identity)
+    )
+
+  private def bottomSummary(n: Int): Summary =
+    new Summary(
+      Array.fill(n)(false),
+      Array.fill(n)(false),
+      Array.fill(n)(false),
+      Array.fill(n)(false),
+      Array.fill(n)(false),
+      retFresh = false,
+      Array.tabulate(n)(identity)
+    )
+
+  private def sameSummary(a: Summary, b: Summary): Boolean =
+    java.util.Arrays.equals(a.escapes, b.escapes) &&
+      java.util.Arrays.equals(a.escDeep, b.escDeep) &&
+      java.util.Arrays.equals(a.recv, b.recv) &&
+      java.util.Arrays.equals(a.retSelf, b.retSelf) &&
+      java.util.Arrays.equals(a.retDeep, b.retDeep) &&
+      a.retFresh == b.retFresh &&
+      java.util.Arrays.equals(a.group, b.group)
+
+  private val fieldKeys = mutable.HashMap.empty[nir.Global, Int]
+  private def fieldKey(n: nir.Global): Int =
+    fieldKeys.getOrElseUpdate(n, fieldKeys.size + 1)
+
+  private val callersOf = mutable.HashMap.empty[Key, mutable.Set[Key]]
+  private val queue = mutable.Queue.empty[Key]
+  private val queued = mutable.HashSet.empty[Key]
+  private var currentCaller: Key = null
+
+  private val specEnabled = !exps.contains("nospec")
+  // mutation testing aid: re-introduces a fixed soundness bug (see summarize)
+  private val mutateDeepFix = exps.contains("mutate-deepfix")
+  private val mutateCollapsedExt = exps.contains("mutate-collapsedext")
+  private val MaxSpecs = 150000
+  private val MaxSpecSize = 2500
+  private var specCount = 0
+  private var tSmash, tFinal, tLoops, tCands, tSummarize, tExclusive = 0L
+  private var nestedNanos = 0L
+
+  private def baseKey(n: nir.Global.Member): Key = Key(n, Nil)
+
+  def summaryOf(name: nir.Global.Member): Option[Summary] =
+    summaryOf(baseKey(name))
+
+  /** Current summary of callee; analyzes it on demand. Callees in progress
+   *  (recursion) are optimistic (bottom) until the fixpoint pass fixes them.
+   */
+  def summaryOf(key: Key): Option[Summary] =
+    defines.get(key.name).map { d =>
+      if (exps.contains("monitor") && isMonitorOp(key.name)) bottomSummary(d.ty.args.size)
+      else {
+        // Past MaxDepth, don't recurse (a long call chain overflows the thread's
+        // stack): answer optimistically (bottom) and let the worklist analyze
+        // the callee later -- its publish re-queues this caller via callersOf,
+        // exactly like a recursion cycle.
+        if (!analyzed.contains(key) && !inProgress.contains(key)) {
+          if (depth < MaxDepth) analyze(key, d)
+          else if (queued.add(key)) queue.enqueue(key)
+        }
+        // Register the caller only now: analyzing the callee just above
+        // publishes its summary, which would otherwise needlessly re-queue
+        // the caller that is about to use it.
+        if (currentCaller != null)
+          callersOf.getOrElseUpdate(key, mutable.Set.empty) += currentCaller
+        summaries.getOrElse(key, bottomSummary(d.ty.args.size))
+      }
+    }
+
+  /** The key to use for a call of `name` whose arguments have the exact
+   *  classes `hints`: a specialized one if that can matter (some hinted
+   *  parameter escapes in the base summary), else the base one.
+   */
+  private def specKeyFor(
+      name: nir.Global.Member,
+      hints: List[(Int, nir.Global.Top)]
+  ): Key = {
+    val base = baseKey(name)
+    val b = summaryOf(base).get
+    if (hints.isEmpty || !specEnabled) base
+    else {
+      val useful = hints
+        .filter { case (i, _) => i < b.escapes.length && b.recv(i) && (b.escapes(i) || b.escDeep(i)) }
+        .take(4)
+      if (useful.isEmpty || defines(name).insts.size > MaxSpecSize) base
+      else {
+        val key = Key(name, useful)
+        if (analyzed.contains(key) || inProgress.contains(key)) key
+        else if (specCount < MaxSpecs) { specCount += 1; key }
+        else base
+      }
+    }
+  }
+
+  private var whyTarget: Key = null
+  private var whyResult: Map[Int, Seq[(String, Key, Int)]] = Map.empty
+
+  /** Why does parameter `idx` of `key` escape? (debugging aid, needs
+   *  `recordReasons`; re-analyzes it once with explanation capture on).
+   */
+  def why(key: Key, idx: Int): Seq[(String, Key, Int)] = {
+    whyTarget = key
+    whyResult = Map.empty
+    try defines.get(key.name).foreach(d => analyze(key, d))
+    finally whyTarget = null
+    whyResult.getOrElse(idx, Nil)
+  }
+
+  def paramCount(name: nir.Global.Member): Int =
+    defines.get(name).map(_.ty.args.size).getOrElse(0)
+
+  private val MaxDepth = 64
+  private var depth = 0
+  private var analyses = 0
+  private val changeCount = mutable.HashMap.empty[Key, Int]
+  def analyze(key: Key, defn: nir.Defn.Define): Result = {
+    analyses += 1
+    val saved = currentCaller
+    currentCaller = key
+    inProgress += key
+    depth += 1
+    val t0 = System.nanoTime()
+    val savedNested = nestedNanos
+    nestedNanos = 0L
+    val r =
+      try new FunctionAnalysis(defn, key).run()
+      finally {
+        depth -= 1
+        inProgress -= key
+        currentCaller = saved
+        val total = System.nanoTime() - t0
+        tExclusive += total - nestedNanos
+        nestedNanos = savedNested + total
+      }
+    analyzed += key
+    if (key.hints.isEmpty) results(defn.name) = r
+    r
+  }
+
+  /** Least upper bound of two summaries (summaries only ever grow, which
+   *  makes the interprocedural fixpoint converge).
+   */
+  private def joinSummary(a: Summary, b: Summary): Summary = {
+    val n = a.escapes.length
+    val dsu = Array.tabulate(n)(identity)
+    def find(x: Int): Int = { var r = x; while (dsu(r) != r) r = dsu(r); r }
+    def link(x: Int, y: Int): Unit = { val rx = find(x); val ry = find(y); if (rx < ry) dsu(ry) = rx else if (ry < rx) dsu(rx) = ry }
+    var i = 0
+    while (i < n) {
+      link(i, a.group(i)); link(i, b.group(i)); i += 1
+    }
+    new Summary(
+      Array.tabulate(n)(i => a.escapes(i) || b.escapes(i)),
+      Array.tabulate(n)(i => a.escDeep(i) || b.escDeep(i)),
+      Array.tabulate(n)(i => a.recv(i) || b.recv(i)),
+      Array.tabulate(n)(i => a.retSelf(i) || b.retSelf(i)),
+      Array.tabulate(n)(i => a.retDeep(i) || b.retDeep(i)),
+      a.retFresh || b.retFresh,
+      Array.tabulate(n)(find)
+    )
+  }
+
+  /** Representative of every group = smallest member index. */
+  private def canonical(group: Array[Int]): Array[Int] = {
+    val rep = mutable.HashMap.empty[Int, Int]
+    group.indices.foreach(i => rep.getOrElseUpdate(group(i), i))
+    Array.tabulate(group.length)(i => rep(group(i)))
+  }
+
+  private def publish(name: Key, s0: Summary, n: Int): Unit = {
+    val old = summaries.getOrElse(name, bottomSummary(n))
+    val s = joinSummary(old, s0)
+    summaries(name) = s
+    if (!sameSummary(old, s) && sys.env.contains("SCALANATIVE_ESCAPE_OSC")) {
+      val c = changeCount.getOrElse(name, 0) + 1
+      changeCount(name) = c
+      if (c > 40 && c < 46)
+        System.err.println(
+          s"[escape-osc] ${name.name.show.take(100)} change#$c\n  old esc=${old.escapes.toSeq} deepesc=${old.escDeep.toSeq} self=${old.retSelf.toSeq} deep=${old.retDeep.toSeq} fresh=${old.retFresh} grp=${old.group.toSeq}\n  new esc=${s.escapes.toSeq} deepesc=${s.escDeep.toSeq} self=${s.retSelf.toSeq} deep=${s.retDeep.toSeq} fresh=${s.retFresh} grp=${s.group.toSeq}"
+        )
+    }
+    if (!sameSummary(old, s))
+      callersOf.getOrElse(name, Nil).foreach { c =>
+        if (queued.add(c)) queue.enqueue(c)
+      }
+  }
+
+  /** Analyze everything, then iterate until summaries stop changing. */
+  def runAll(): Unit = {
+    val t0 = System.nanoTime()
+    defines.valuesIterator.foreach { d =>
+      if (!analyzed.contains(baseKey(d.name))) analyze(baseKey(d.name), d)
+    }
+    val t1 = System.nanoTime()
+    val firstPass = analyses
+    var rounds = 0
+    while (queue.nonEmpty && rounds < 3000000) {
+      val k = queue.dequeue()
+      queued -= k
+      analyze(k, defines(k.name))
+      rounds += 1
+    }
+    if (sys.env.contains("SCALANATIVE_ESCAPE_STATS"))
+      System.err.println(
+        s"[escape-stats] smash=${tSmash / 1000000}ms final=${tFinal / 1000000}ms loops=${tLoops / 1000000}ms cands=${tCands / 1000000}ms summarize=${tSummarize / 1000000}ms exclusive=${tExclusive / 1000000}ms\n" +
+          s"[escape-stats] defines=${defines.size} specs=$specCount firstPass=${firstPass} analyses " +
+          s"in ${(t1 - t0) / 1000000}ms, reanalyses=$rounds in ${(System.nanoTime() - t1) / 1000000}ms"
+      )
+  }
+
+  private def isPrimitive(ty: nir.Type): Boolean = ty match {
+    case nir.Type.Float | nir.Type.Double | nir.Type.Bool | nir.Type.Unit |
+        nir.Type.Nothing | nir.Type.Null =>
+      true
+    case _: nir.Type.FixedSizeI => ty != nir.Type.Long // keep 64bit: may carry pointers
+    case _                      => false
+  }
+
+  private val scopeTargets =
+    mutable.HashMap.empty[(nir.Global, nir.Sig), Option[Seq[nir.Global.Member]]]
+
+  private def targetsOf(
+      objTy: nir.Type,
+      sig: nir.Sig
+  ): Option[Seq[nir.Global.Member]] = {
+    val r = objTy match {
+      case ExactClassRef(cls, _)                       => cls.resolve(sig).map(Seq(_))
+      case nir.Type.Ref(ClassRef(cls), _, _) if !sig.isVirtual =>
+        cls.resolve(sig).map(Seq(_))
+      case nir.Type.Ref(ScopeRef(scope), _, _) =>
+        // computing the targets walks every implementor: cache it, and
+        // remember megamorphic scopes as unknown right away
+        scopeTargets.getOrElseUpdate(
+          (scope.name, sig), {
+            val ts = scope.targets(sig)
+            if (ts.size > MaxTargets) None else Some(ts.toSeq)
+          }
+        )
+      case _ => None
+    }
+    r.filter(_.nonEmpty)
+  }
+
+  private val tracePat = sys.env.get("SCALANATIVE_ESCAPE_TRACE")
+  private def tracing(d: nir.Defn.Define): Boolean =
+    tracePat.exists(p => d.name.show.contains(p))
+
+  private class FunctionAnalysis(defn: nir.Defn.Define, key: Key) {
+    private val trace = tracing(defn)
+    private def tr(msg: => String): Unit =
+      if (trace) System.err.println("[escape-trace] " + defn.name.show.take(60) + ": " + msg)
+    // ---- union find ----
+    private var parent = new Array[Int](256)
+    private var flags = new Array[Int](256)
+    private var fmap = new Array[mutable.LongMap[Int]](256)
+    private var size = 0
+    private val localNode = mutable.LongMap.empty[Int]
+    // locals whose exact class is known beyond their declared type
+    private val refined = mutable.LongMap.empty[nir.Type]
+    private def tyOfVal(v: nir.Val): nir.Type = v match {
+      case nir.Val.Local(l, ty) => refined.getOrElse(l.id, ty)
+      case _                    => v.ty
+    }
+    private def exactClassOf(v: nir.Val): Option[nir.Global.Top] =
+      tyOfVal(v) match {
+        case nir.Type.Ref(name, true, _) =>
+          ClassRef.unapply(name) match {
+            case Some(c) if !c.attrs.isAbstract && !c.isModule => Some(name)
+            case _                                             => None
+          }
+        case _ => None
+      }
+
+    private def fresh(f: Int = 0): Int = {
+      if (size == parent.length) {
+        val n = size * 2
+        parent = java.util.Arrays.copyOf(parent, n)
+        flags = java.util.Arrays.copyOf(flags, n)
+        fmap = java.util.Arrays.copyOf(fmap, n)
+      }
+      val id = size
+      parent(id) = id
+      flags(id) = f
+      fmap(id) = null
+      size += 1
+      id
+    }
+
+    private def find(x: Int): Int = {
+      var r = x
+      while (parent(r) != r) r = parent(r)
+      var c = x
+      while (parent(c) != r) {
+        val next = parent(c)
+        parent(c) = r
+        c = next
+      }
+      r
+    }
+
+    // Pending (x, y) pairs of union(): two int arrays reused across calls
+    // instead of a mutable.Stack of Tuple2 per call (66M Tuple2$mcII$sp plus
+    // the Stack/ArrayDeque while linking dotc).
+    private var pendX = new Array[Int](64)
+    private var pendY = new Array[Int](64)
+    private var pendN = 0
+    private def pend(x: Int, y: Int): Unit = {
+      if (pendN == pendX.length) {
+        pendX = java.util.Arrays.copyOf(pendX, pendN * 2)
+        pendY = java.util.Arrays.copyOf(pendY, pendN * 2)
+      }
+      pendX(pendN) = x
+      pendY(pendN) = y
+      pendN += 1
+    }
+
+    private def union(a: Int, b: Int): Unit = {
+      if (find(a) == find(b)) return
+      pend(a, b)
+      while (pendN > 0) {
+        pendN -= 1
+        val x = pendX(pendN)
+        val y = pendY(pendN)
+        val rx = find(x)
+        val ry = find(y)
+        if (rx != ry) {
+          val mx = fmap(rx)
+          val my = fmap(ry)
+          parent(ry) = rx
+          flags(rx) |= flags(ry)
+          if (my != null) {
+            if (mx == null) fmap(rx) = my
+            else
+              my.foreachKey { k =>
+                val c2 = my(k)
+                if (mx.contains(k)) pend(mx(k), c2)
+                else mx(k) = c2
+              }
+          }
+          fmap(ry) = null
+          if ((flags(rx) & Collapsed) != 0) {
+            val m = fmap(rx)
+            if (m != null) m.foreachValue(c => pend(rx, c))
+          }
+        }
+      }
+    }
+
+    /** Make every content of `x` be `x` itself. */
+    private def collapse(x: Int): Unit = {
+      val r = find(x)
+      if ((flags(r) & Collapsed) == 0) {
+        flags(r) |= Collapsed
+        val m = fmap(r)
+        if (m != null) m.values.toList.foreach(c => union(r, c))
+      }
+    }
+
+    /** Content node of `x` under field key `k` (0 = array element / raw). */
+    private def contentOf(x: Int, k: Int = 0): Int = {
+      val r = find(x)
+      if ((flags(r) & Collapsed) != 0) r
+      else {
+        var m = fmap(r)
+        if (m == null) { m = mutable.LongMap.empty[Int]; fmap(r) = m }
+        if (m.contains(k)) m(k)
+        else {
+          val c = fresh()
+          m(k) = c
+          c
+        }
+      }
+    }
+
+    private def flag(x: Int, f: Int): Unit = flags(find(x)) |= f
+    private val events = mutable.ArrayBuffer.empty[(Int, () => String)]
+    private val evCalls = mutable.ArrayBuffer.empty[(Key, Int)]
+    private val heapEvents = mutable.ArrayBuffer.empty[(Int, String)]
+    private var curPos: nir.SourcePosition = nir.SourcePosition.NoPosition
+    private def flagG(
+        x: Int,
+        reason: => String,
+        callee: Key = null,
+        idx: Int = -1
+    ): Unit = {
+      flag(x, Global)
+      if (recordReasons) {
+        val p = curPos
+        events += ((x, () => reason + " @" + p.show))
+        evCalls += ((callee, idx))
+      }
+    }
+    /** Everything reachable through the fields of `x` escapes, `x` itself
+     *  does not.
+     */
+    private def flagD(
+        x: Int,
+        reason: => String,
+        callee: Key = null,
+        idx: Int = -1
+    ): Unit = {
+      flag(x, ContentsGlobal)
+      if (recordReasons) {
+        val p = curPos
+        events += ((x, () => "deep:" + reason + " @" + p.show))
+        evCalls += ((callee, idx))
+      }
+    }
+    /** `x` is a heap object (module, call result, ...). */
+    private def flagH(x: Int, reason: => String): Unit = {
+      flag(x, HeapRoot | NonParam)
+      if (recordReasons) heapEvents += ((x, reason + " @" + curPos.show))
+    }
+
+    // ---- value -> node ----
+    private def isTrackedTy(ty: nir.Type): Boolean = !isPrimitive(ty)
+
+    /** Node of a value, or -1 if the value is an untracked constant. */
+    private def nd(v: nir.Val): Int = v match {
+      case nir.Val.Local(id, ty) =>
+        if (!isTrackedTy(ty)) -1
+        else localNode.getOrElseUpdate(id.id, fresh())
+      case nir.Val.StructValue(vs) =>
+        val n = fresh()
+        vs.foreach { e => val m = nd(e); if (m >= 0) union(n, m) }
+        n
+      case nir.Val.ArrayValue(_, vs) =>
+        val n = fresh()
+        vs.foreach { e => val m = nd(e); if (m >= 0) union(n, m) }
+        n
+      case nir.Val.Const(inner) => nd(inner)
+      case _                    => -1
+    }
+
+    private def resultNode(id: nir.Local, ty: nir.Type): Int =
+      if (isTrackedTy(ty)) localNode.getOrElseUpdate(id.id, fresh()) else -1
+
+    private def globalize(v: nir.Val, reason: => String): Unit = {
+      val n = nd(v)
+      if (n >= 0) flagG(n, reason)
+    }
+
+    private def unifyVals(a: Int, b: Int): Unit =
+      if (a >= 0 && b >= 0) union(a, b)
+
+    /** value `v` is stored into memory pointed to by `p` */
+    private def store(p: nir.Val, v: nir.Val, k: Int = 0): Unit = {
+      val vn = nd(v)
+      if (vn >= 0) {
+        val pn = nd(p)
+        if (pn < 0) flagG(vn, "store-to-untracked")
+        else {
+          if (k == 0) flag(pn, RawAccessed)
+          union(contentOf(pn, k), vn)
+        }
+      }
+    }
+
+    /** result `r` is loaded from memory pointed to by `p` */
+    private def load(r: Int, p: nir.Val, k: Int = 0): Unit =
+      if (r >= 0) {
+        val pn = nd(p)
+        if (pn < 0) flagH(r, "load-from-untracked")
+        else {
+          if (k == 0) flag(pn, RawAccessed)
+          union(r, contentOf(pn, k))
+        }
+      }
+
+    // ---- control flow ----
+    private val labelParams = mutable.LongMap.empty[Seq[nir.Val.Local]]
+    private val blockOf = mutable.LongMap.empty[Int] // let id -> block idx
+    private val labelIdx = mutable.LongMap.empty[Int]
+    private val succs = mutable.ArrayBuffer.empty[mutable.ArrayBuffer[Int]]
+    private val retNode = fresh()
+    private val methodOf = mutable.LongMap.empty[(nir.Val, nir.Sig)]
+    private case class Cand(
+        id: Long,
+        kind: String,
+        node: Int,
+        block: Int,
+        isClass: Boolean
+    )
+    private val cands = mutable.ArrayBuffer.empty[Cand]
+
+    private def nextEdges(next: nir.Next, from: Int): Unit = next match {
+      case nir.Next.None => ()
+      case nir.Next.Unwind(exc, n) =>
+        val e = nd(exc)
+        if (e >= 0) { flagH(e, "unwind-exc"); flagG(e, "unwind-exc") }
+        nextEdges(n, from)
+      case nir.Next.Case(_, n) => nextEdges(n, from)
+      case nir.Next.Label(id, args) =>
+        labelParams.get(id.id).foreach { ps =>
+          ps.zip(args).foreach {
+            case (p, a) => unifyVals(nd(p), nd(a))
+          }
+        }
+        labelIdx.get(id.id).foreach { to => succs(from) += to }
+    }
+
+    def run(): Result = {
+      val insts = defn.insts
+      var blocks = 0
+      insts.foreach {
+        case nir.Inst.Label(id, ps) =>
+          labelParams(id.id) = ps
+          labelIdx(id.id) = blocks
+          succs += mutable.ArrayBuffer.empty[Int]
+          blocks += 1
+        case _ => ()
+      }
+      val params = insts.head match {
+        case nir.Inst.Label(_, ps) => ps
+        case _                     => Nil
+      }
+      params.zipWithIndex.foreach {
+        case (p, i) =>
+          val n = nd(p)
+          if (n >= 0) flag(n, ExtRoot)
+          key.hints.foreach {
+            case (hi, cls) if hi == i => refined(p.id.id) = nir.Type.Ref(cls, exact = true, nullable = true)
+            case _                    => ()
+          }
+      }
+
+      var cur = -1
+      insts.foreach { inst =>
+        curPos = inst.pos
+        inst match {
+        case nir.Inst.Label(_, _) =>
+          cur += 1
+        case nir.Inst.Let(id, op, unwind) =>
+          blockOf(id.id) = cur
+          nextEdges(unwind, cur)
+          letOp(id, op, cur)
+        case nir.Inst.Ret(v) =>
+          val n = nd(v)
+          if (n >= 0) union(retNode, n)
+        case nir.Inst.Jump(n) => nextEdges(n, cur)
+        case nir.Inst.If(_, a, b) =>
+          nextEdges(a, cur); nextEdges(b, cur)
+        case nir.Inst.Switch(_, d, cs) =>
+          nextEdges(d, cur); cs.foreach(nextEdges(_, cur))
+        case nir.Inst.Throw(v, u) =>
+          if (!exps.contains("throwcap")) globalize(v, "throw")
+          nextEdges(u, cur)
+        case nir.Inst.Unreachable(u) => nextEdges(u, cur)
+        case nir.Inst.LinktimeIf(_, a, b) =>
+          nextEdges(a, cur); nextEdges(b, cur)
+        }
+      }
+
+      val tA = System.nanoTime()
+      smashRawViews()
+      val tB = System.nanoTime()
+      finalizeFlags()
+      val tC = System.nanoTime()
+      val loopBlocks = blocksInCycles(blocks)
+      val tD = System.nanoTime()
+      tSmash += tB - tA; tFinal += tC - tB; tLoops += tD - tC
+      cands.foreach { c =>
+        tr(s"cand ${c.kind} id=${c.id} flags=${flags(find(c.node))} root=${find(c.node)}")
+      }
+      val byRoot = events.indices.groupBy(k => find(events(k)._1))
+      val heapByRoot = heapEvents.groupBy { case (n, _) => find(n) }
+      // child root -> parent roots, built lazily (reasons only)
+      lazy val rev: mutable.HashMap[Int, mutable.ArrayBuffer[Int]] = {
+        val m = mutable.HashMap.empty[Int, mutable.ArrayBuffer[Int]]
+        var i = 0
+        while (i < size) {
+          if (parent(i) == i && fmap(i) != null)
+            fmap(i).values.foreach { c =>
+              m.getOrElseUpdate(find(c), mutable.ArrayBuffer.empty[Int]) += i
+            }
+          i += 1
+        }
+        m
+      }
+      def ancestorReason(r: Int): (String, Key, Int) = {
+        val seen = mutable.HashSet[Int](r)
+        val q = mutable.Queue[Int](r)
+        var res: (String, Key, Int) = null
+        while (res == null && q.nonEmpty) {
+          val x = q.dequeue()
+          if (x != r) {
+            val ks = byRoot.getOrElse(x, Nil)
+            if (ks.nonEmpty) res = (events(ks.head)._2(), evCalls(ks.head)._1, evCalls(ks.head)._2)
+            else heapByRoot.get(x).foreach(hs => res = ("heap:" + hs.head._2, null, -1))
+          }
+          if (res == null) rev.getOrElse(x, Nil).foreach(pp => if (seen.add(pp)) q.enqueue(pp))
+        }
+        if (res == null) ("global-propagated", null, -1) else res
+      }
+      val candidates = cands.map { c =>
+        val r = find(c.node)
+        val f = flags(r)
+        val esc = (f & (Global | Returned | Ext)) != 0
+        var callee: Key = null
+        var cidx = -1
+        val reason =
+          if (!esc || !recordReasons) { if (esc) "escapes" else "" }
+          else if ((f & Global) != 0)
+            byRoot.get(r) match {
+              case Some(ks) =>
+                callee = evCalls(ks.head)._1; cidx = evCalls(ks.head)._2
+                events(ks.head)._2()
+              case None =>
+                val (rs, cm, ci) = ancestorReason(r)
+                callee = cm; cidx = ci
+                "anc:" + rs
+            }
+          else if ((f & Returned) != 0) "returned"
+          else "ext(stored into heap/param/call-result)"
+        Candidate(c.kind, esc, loopBlocks(c.block max 0), reason, c.id, c.isClass, if (recordReasons) defn.name.show else "", callee, cidx)
+      }
+      val tE = System.nanoTime()
+      summarize(params)
+      tSummarize += System.nanoTime() - tE
+      tCands += tE - tD
+      new Result(candidates.toSeq)
+    }
+
+    /** `id` is the same object as `v`: it has the same known exact class. */
+    private def carryRefined(id: nir.Local, v: nir.Val): Unit =
+      v match {
+        case nir.Val.Local(l, _) =>
+          refined.get(l.id).foreach(t => refined(id.id) = t)
+        case _ => ()
+      }
+
+    private def addCand(
+        id: nir.Local,
+        kind: String,
+        block: Int,
+        isClass: Boolean = false
+    ): Unit = {
+      val n = localNode.getOrElseUpdate(id.id, fresh())
+      flag(n, NonParam)
+      cands += Cand(id.id, kind, n, block, isClass)
+    }
+
+    private def letOp(id: nir.Local, op: nir.Op, block: Int): Unit = {
+      def res(ty: nir.Type) = resultNode(id, ty)
+      op match {
+        case nir.Op.Call(ty, ptr, args) =>
+          call(id, ty, ptr, args)
+        case nir.Op.Load(ty, ptr, _) =>
+          load(res(ty), ptr)
+        case nir.Op.Store(ty, ptr, v, _) =>
+          if (isTrackedTy(v.ty)) store(ptr, v)
+        case nir.Op.Elem(_, ptr, idxs) =>
+          unifyVals(res(nir.Type.Ptr), nd(ptr))
+        case nir.Op.Extract(aggr, _) =>
+          unifyVals(res(op.resty), nd(aggr))
+        case nir.Op.Insert(aggr, v, _) =>
+          val r = res(op.resty)
+          unifyVals(r, nd(aggr)); unifyVals(r, nd(v))
+        case nir.Op.Stackalloc(_, n) =>
+          res(nir.Type.Ptr)
+        case nir.Op.Bin(_, ty, l, r) =>
+          // pointers can hide in 64-bit ints
+          val rn = res(ty)
+          unifyVals(rn, nd(l)); unifyVals(rn, nd(r))
+        case _: nir.Op.Comp | _: nir.Op.Fence | _: nir.Op.SizeOf |
+            _: nir.Op.AlignmentOf | _: nir.Op.Is | _: nir.Op.Arraylength =>
+          ()
+        case nir.Op.Conv(conv, ty, v) =>
+          val r = res(ty)
+          unifyVals(r, nd(v))
+          if (r >= 0 && ty == nir.Type.Ptr && v.ty.isInstanceOf[nir.Type.RefKind])
+            flag(r, FromRef)
+        case nir.Op.Classalloc(ClassRef(cls), None) =>
+          addCand(id, cls.name.id, block, isClass = true)
+        case nir.Op.Classalloc(_, Some(_)) =>
+          val n = res(op.resty)
+          flagH(n, "zone/stack-classalloc")
+        case nir.Op.Classalloc(_, _) =>
+          flagH(res(op.resty), "heap-classalloc")
+        case nir.Op.Fieldload(ty, obj, fname) =>
+          if (isTrackedTy(ty)) load(res(ty), obj, fieldKey(fname))
+        case nir.Op.Fieldstore(ty, obj, fname, v) =>
+          val skip =
+            (exps.contains("matcherror") && fname.owner.id == "scala.MatchError") ||
+              (exps.contains("throwcap") && isThrowableOwner(fname.owner))
+          if (isTrackedTy(ty) && !skip) store(obj, v, fieldKey(fname))
+        case nir.Op.Field(obj, fname) =>
+          // pointer to a single field: its raw content is that field's content
+          val r = res(nir.Type.Ptr)
+          val on = nd(obj)
+          if (on >= 0) union(contentOf(r, 0), contentOf(on, fieldKey(fname)))
+          else flagH(r, "field-of-untracked")
+        case nir.Op.Method(obj, sig) =>
+          methodOf(id.id) = ((obj, sig))
+          val on = nd(obj)
+          if (on >= 0) flag(on, Recv)
+        case nir.Op.Dynmethod(obj, _) =>
+          globalize(obj, "dynmethod")
+        case nir.Op.Module(m) =>
+          flagH(res(op.resty), "module " + m.show)
+        case nir.Op.As(ty, obj) =>
+          unifyVals(res(ty), nd(obj))
+          carryRefined(id, obj)
+        case nir.Op.Copy(v) =>
+          unifyVals(res(v.ty), nd(v))
+          carryRefined(id, v)
+        case nir.Op.Box(ty, obj) =>
+          val kind = ty match {
+            case r: nir.Type.RefKind => "box:" + r.className.id
+            case _                   => "box"
+          }
+          addCand(id, kind, block)
+          if (isTrackedTy(obj.ty)) store(nir.Val.Local(id, op.resty), obj)
+        case nir.Op.Unbox(ty, obj) =>
+          val r = res(op.resty)
+          if (isTrackedTy(op.resty)) load(r, obj)
+        case nir.Op.Var(_) =>
+          res(nir.Type.Ptr)
+        case nir.Op.Varload(slot) =>
+          val r = res(op.resty)
+          load(r, slot)
+        case nir.Op.Varstore(slot, v) =>
+          if (isTrackedTy(v.ty)) store(slot, v)
+        case nir.Op.Arrayalloc(ty, init, None) =>
+          val constLen = init match {
+            case nir.Val.Int(_) | nir.Val.ArrayValue(_, _) => true
+            case _                                         => false
+          }
+          val r = res(op.resty)
+          if (constLen) {
+            addCand(id, "array:" + ty.show, block)
+            init match {
+              case nir.Val.ArrayValue(_, vs) =>
+                vs.foreach { e => if (isTrackedTy(e.ty)) store(nir.Val.Local(id, op.resty), e) }
+              case _ => ()
+            }
+          } else flagH(r, "array-nonconst-len")
+        case nir.Op.Arrayalloc(_, init, Some(_)) =>
+          flagH(res(op.resty), "zone-array")
+          globalize(init, "zone-array-init")
+        case nir.Op.Arrayload(ty, arr, _) =>
+          if (isTrackedTy(ty)) load(res(ty), arr)
+        case nir.Op.Arraystore(ty, arr, _, v) =>
+          if (isTrackedTy(ty)) store(arr, v)
+      }
+    }
+
+    private def call(
+        id: nir.Local,
+        ty: nir.Type.Function,
+        ptr: nir.Val,
+        args: Seq[nir.Val]
+    ): Unit = {
+      val resNode = resultNode(id, ty.ret)
+      val externId: Option[String] = ptr match {
+        case nir.Val.Global(m: nir.Global.Member, _) if m.sig.isExtern =>
+          m.sig.unmangled match {
+            case nir.Sig.Extern(eid) => Some(eid)
+            case _                   => None
+          }
+        case _ => None
+      }
+      if (externId.exists(id => id.startsWith("scalanative_atomic_")) &&
+          atomicCall(externId.get, args, resNode)) ()
+      else if (externId.exists(id => id.startsWith("llvm.") || NonCapturingExterns.contains(id))) {
+        if (resNode >= 0) {
+          if (args.nonEmpty && nd(args.head) >= 0) union(resNode, nd(args.head))
+          else flagH(resNode, "extern-result")
+        }
+      } else callResolved(id, ty, ptr, args, resNode)
+    }
+
+    /** Models the runtime's atomic externs as plain memory operations on the
+     *  pointed-to memory. Returns false for ones it does not know.
+     */
+    private def atomicCall(id: String, args: Seq[nir.Val], resNode: Int): Boolean = {
+      val op = id.stripPrefix("scalanative_atomic_")
+      if (op.contains("fence")) true
+      else if (op.startsWith("load") && args.nonEmpty) {
+        load(resNode, args(0)); true
+      } else if ((op.startsWith("store") || op.startsWith("init")) && args.size >= 2) {
+        store(args(0), args(1)); true
+      } else if (op.startsWith("compare_exchange") && args.size >= 3) {
+        store(args(0), args(2))
+        val e = nd(args(1)); val p = nd(args(0))
+        if (e >= 0 && p >= 0) union(contentOf(e), contentOf(p))
+        true
+      } else if ((op.startsWith("exchange") || op.startsWith("fetch_")) && args.size >= 2) {
+        store(args(0), args(1))
+        load(resNode, args(0))
+        true
+      } else false
+    }
+
+    private def callResolved(
+        id: nir.Local,
+        ty: nir.Type.Function,
+        ptr: nir.Val,
+        args: Seq[nir.Val],
+        resNode: Int
+    ): Unit = {
+      val targets: Option[Seq[nir.Global.Member]] = ptr match {
+        case nir.Val.Global(m: nir.Global.Member, _) => Some(Seq(m))
+        case nir.Val.Local(l, _) =>
+          methodOf.get(l.id).flatMap {
+            case (obj, sig) =>
+              val oty = tyOfVal(obj)
+              val realTy = nir.Type.Ref(
+                oty match {
+                  case r: nir.Type.RefKind => r.className
+                  case _                   => nir.Rt.Object.name
+                },
+                exact = oty match {
+                  case r: nir.Type.RefKind => r.isExact
+                  case _                   => false
+                },
+                nullable = true
+              )
+              if (oty.isInstanceOf[nir.Type.RefKind]) targetsOf(realTy, sig)
+              else None
+          }
+        case _ => None
+      }
+      val hints: List[(Int, nir.Global.Top)] =
+        if (!specEnabled) Nil
+        else args.zipWithIndex.flatMap { case (a, i) => exactClassOf(a).map(c => (i, c)) }.toList
+      val keys: Option[Seq[Key]] = targets.filter(_.size <= MaxTargets).flatMap { ts =>
+        val ks = ts.map { t =>
+          defines.get(t) match {
+            case Some(d) if d.ty.args.size == args.size && !d.attrs.isExtern =>
+              Some(specKeyFor(t, hints))
+            case _ => None
+          }
+        }
+        if (ks.forall(_.isDefined)) Some(ks.map(_.get)) else None
+      }
+      val sums: Option[Seq[Summary]] = keys.map(_.map(k => summaryOf(k).get))
+      tr(
+        s"call ${ptr.show.take(120)} args=${args.map(_.show.take(30))} targets=${targets
+          .map(_.map(_.show.take(80)))} sums=${sums.map(_.map(x => (x.escapes.toSeq, x.escDeep.toSeq, x.retSelf.toSeq, x.retDeep.toSeq, x.retFresh, x.group.toSeq)))}"
+      )
+      sums match {
+        case None =>
+          def why = "unknown-call:" + (ptr match {
+            case nir.Val.Global(m, _) => m.show
+            case nir.Val.Local(l, _) =>
+              methodOf.get(l.id) match {
+                case Some((o, sig)) => "virtual:" + o.ty.show + "::" + sig.show
+                case None           => "indirect"
+              }
+            case _ => "other"
+          })
+          args.foreach(globalize(_, why))
+          if (resNode >= 0) flagH(resNode, "unknown-call-result:" + why)
+        case Some(ss) =>
+          var fresh = resNode >= 0
+          val n = args.size
+          val argNodes = args.map(nd)
+          var i = 0
+          while (i < n) {
+            val an = argNodes(i)
+            if (an >= 0) {
+              if (ss.exists(_.recv(i))) flag(an, Recv)
+              val tsSeq = targets.getOrElse(Nil)
+              ss.zipWithIndex.foreach { case (s, k) =>
+                val ckey = keys.map(_(k)).orNull
+                if (s.escapes(i)) flagG(an, "callee-escapes:" + tsSeq(k).show + "#" + i, ckey, i)
+                else if (s.escDeep(i)) flagD(an, "callee-escapes-deep:" + tsSeq(k).show + "#" + i, ckey, i)
+                if (s.retSelf(i) && resNode >= 0) union(resNode, an)
+                if (s.retDeep(i) && resNode >= 0) {
+                  union(resNode, an)
+                  collapse(resNode)
+                }
+                var j = 0
+                while (j < n) {
+                  if (j != i && s.group(j) == s.group(i)) {
+                    val bn = argNodes(j)
+                    if (bn >= 0) {
+                      union(an, bn)
+                      collapse(an)
+                    }
+                  }
+                  j += 1
+                }
+              }
+            }
+            i += 1
+          }
+          if (resNode >= 0) {
+            val freshRes = ss.exists(_.retFresh)
+            if (freshRes) flagH(resNode, "fresh-call-result:" + targets.map(_.headOption.map(_.show).getOrElse("?")).getOrElse("?"))
+          }
+      }
+    }
+
+    // ---- flag propagation ----
+    /** Objects accessed through raw pointer views may have any field
+     *  read/written: merge all of their field contents.
+     */
+    private def smashRawViews(): Unit = {
+      var changed = true
+      var rounds = 0
+      while (changed && rounds < 8) {
+        changed = false
+        rounds += 1
+        var i = 0
+        while (i < size) {
+          if (parent(i) == i && fmap(i) != null &&
+              (flags(i) & (FromRef | RawAccessed)) == (FromRef | RawAccessed) &&
+              fmap(i).size > 1) {
+            val cs = fmap(i).values.toList
+            val first = find(cs.head)
+            if (cs.exists(c => find(c) != first)) {
+              cs.tail.foreach(c => union(cs.head, c))
+              changed = true
+            }
+          }
+          i += 1
+        }
+      }
+    }
+
+    private def finalizeFlags(): Unit = {
+      flag(retNode, Returned)
+      var changed = true
+      while (changed) {
+        changed = false
+        var i = 0
+        while (i < size) {
+          if (parent(i) == i) {
+            val f = flags(i)
+            // contents of a collapsed node are the node itself
+            if ((f & ContentsGlobal) != 0 && (f & Collapsed) != 0 && (f & Global) == 0) {
+              flags(i) |= Global
+              changed = true
+            }
+            // ... so a collapsed node that is (or aliases) caller memory is its
+            // own content, even when it has no content node to propagate to
+            // (a callee that stores one parameter into another is modelled as
+            // union + collapse): everything in it is reachable from the caller
+            if ((f & Collapsed) != 0 && (f & (ExtRoot | Ext)) != 0 && (f & Ext) == 0 && !mutateCollapsedExt) {
+              flags(i) |= Ext
+              changed = true
+            }
+            if (fmap(i) != null) {
+              var add = f & (Global | Returned | Ext)
+              if ((f & (ExtRoot | Ext)) != 0) add |= Ext
+              if ((f & ExtRoot) != 0) add |= ExtRoot
+              if ((f & HeapRoot) != 0) add |= Global | HeapRoot
+              if ((f & ContentsGlobal) != 0) add |= Global
+              fmap(i).values.toList.foreach { c =>
+                val rc = find(c)
+                if ((flags(rc) | add) != flags(rc)) {
+                  flags(rc) |= add
+                  changed = true
+                }
+              }
+            }
+          }
+          i += 1
+        }
+      }
+    }
+
+    private def blocksInCycles(n: Int): Array[Boolean] = {
+      // Tarjan SCC
+      val index = Array.fill(n)(-1)
+      val low = new Array[Int](n)
+      val onStack = new Array[Boolean](n)
+      val inCycle = new Array[Boolean](n)
+      val st = mutable.Stack[Int]()
+      var counter = 0
+      def strong(v: Int): Unit = {
+        index(v) = counter; low(v) = counter; counter += 1
+        st.push(v); onStack(v) = true
+        succs(v).foreach { w =>
+          if (index(w) == -1) { strong(w); low(v) = low(v) min low(w) }
+          else if (onStack(w)) low(v) = low(v) min index(w)
+        }
+        if (low(v) == index(v)) {
+          val comp = mutable.ArrayBuffer.empty[Int]
+          var w = st.pop()
+          onStack(w) = false
+          comp += w
+          while (w != v) {
+            w = st.pop(); onStack(w) = false; comp += w
+          }
+          if (comp.size > 1 || succs(v).contains(v)) comp.foreach(inCycle(_) = true)
+        }
+      }
+      var v = 0
+      while (v < n) { if (index(v) == -1) strong(v); v += 1 }
+      inCycle
+    }
+
+    // ---- summary ----
+    private def closure(root: Int): Set[Int] = {
+      val seen = mutable.HashSet.empty[Int]
+      val todo = mutable.Stack[Int](find(root))
+      seen += find(root)
+      while (todo.nonEmpty) {
+        val cur = todo.pop()
+        val m = fmap(cur)
+        if (m != null)
+          m.values.foreach { c =>
+            val rc = find(c)
+            if (seen.add(rc)) todo.push(rc)
+          }
+      }
+      seen.toSet
+    }
+
+    private def summarize(params: Seq[nir.Val.Local]): Unit = {
+      val n = params.size
+      val pn = params.map(nd)
+      val clos = pn.map(p => if (p >= 0) closure(p) else Set.empty[Int])
+      val retClos = closure(retNode)
+      val retRoot = find(retNode)
+      val escapes = new Array[Boolean](n)
+      val escDeep = new Array[Boolean](n)
+      val recvA = new Array[Boolean](n)
+      val retSelf = new Array[Boolean](n)
+      val retDeep = new Array[Boolean](n)
+      val group = Array.tabulate(n)(identity)
+      var i = 0
+      while (i < n) {
+        if (pn(i) >= 0) {
+          val c = clos(i)
+          val root = find(pn(i))
+          if ((flags(root) & Recv) != 0) recvA(i) = true
+          if ((flags(root) & Global) != 0) escapes(i) = true
+          // a node flagged ContentsGlobal may have no content nodes in this
+          // function at all (the callee that leaks them did the loading), so
+          // the flag itself counts, not only Global children
+          else if (c.exists(r => (!mutateDeepFix && (flags(r) & ContentsGlobal) != 0) || (r != root && (flags(r) & Global) != 0)))
+            escDeep(i) = true
+          if (root == retRoot) retSelf(i) = true
+          else if (c.exists(retClos.contains)) retDeep(i) = true
+          var j = 0
+          while (j < i) {
+            if (pn(j) >= 0 && clos(j).exists(c.contains)) {
+              val gj = group(j)
+              // merge groups
+              var k = 0
+              while (k < n) { if (group(k) == group(i)) group(k) = gj; k += 1 }
+            }
+            j += 1
+          }
+        }
+        i += 1
+      }
+      val retFresh = (flags(retRoot) & NonParam) != 0
+      if (whyTarget != null && whyTarget == key) {
+        val res = mutable.HashMap.empty[Int, Seq[(String, Key, Int)]]
+        var pi = 0
+        while (pi < n) {
+          if (escapes(pi) || escDeep(pi)) {
+            val out = mutable.LinkedHashSet.empty[(String, Key, Int)]
+            val proot = find(pn(pi))
+            clos(pi).filter(r => (flags(r) & Global) != 0 && (escapes(pi) || r != proot)).foreach { r =>
+              var found = false
+              events.indices.foreach { k =>
+                if (find(events(k)._1) == r && !events(k)._2().startsWith("deep:")) {
+                  out += ((events(k)._2(), evCalls(k)._1, evCalls(k)._2))
+                  found = true
+                }
+              }
+              if (!found) {
+                // Global arrived from an ancestor: heap root or a deep escape
+                var h = 0
+                while (h < size) {
+                  if (parent(h) == h && h != r && closure(h).contains(r)) {
+                    if ((flags(h) & HeapRoot) != 0)
+                      heapEvents.foreach { case (hn, why) =>
+                        if (find(hn) == h) { out += (("via-heap-root: " + why, null, -1)); found = true }
+                      }
+                    events.indices.foreach { k =>
+                      if (find(events(k)._1) == h) {
+                        out += ((events(k)._2(), evCalls(k)._1, evCalls(k)._2)); found = true
+                      }
+                    }
+                  }
+                  h += 1
+                }
+                if (!found) out += (("propagated(no-event)", null, -1))
+              }
+            }
+            res(pi) = out.toSeq.take(6)
+          }
+          pi += 1
+        }
+        whyResult = res.toMap
+      }
+      publish(
+        key,
+        new Summary(escapes, escDeep, recvA, retSelf, retDeep, retFresh, canonical(group)),
+        n
+      )
+    }
+  }
+}
