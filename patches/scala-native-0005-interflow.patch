+          // Different box classes (different discriminant) can never be
+          // pointer-equal, tagged or not.
+          nir.Val.Bool(comp == Ine)
+        } else if (lval.isCanonical && rval.isCanonical) {
+          // Both payloads are known at compile time: equal payloads mean
+          // identical tag bits (genuinely eq), different payloads mean
+          // different tag bits (genuinely not eq) - true regardless of
+          // whether either side ends up tagged or materialized as a real
+          // object, since the encoding is a deterministic function of the
+          // payload alone (see Lower.genSmiBoxOp).
+          nir.Val.Bool((lval == rval) == (comp == Ieq))
+        } else {
+          // Payload not known until runtime: can't fold either way.
+          // Materializing goes through `Op.Box` (State.materialize's
+          // BoxKind case), not `Op.Classalloc`, so both sides stay on the
+          // SMI-aware codegen path - the real comparison Lower emits is
+          // correct whether it ends up comparing tag bits or addresses.
+          emit(nir.Op.Comp(comp, ty, materialize(l), materialize(r)))
+        }
+
