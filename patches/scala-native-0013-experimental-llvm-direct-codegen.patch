+package scala.scalanative
+package codegen
+package llvm
+package direct
+
+import java.nio.file.Path
+
+import scala.scalanative.build
+
+// JVM-hosted `tools` build: the direct LLVM-C backend needs the toolchain
+// itself to be compiled Scala Native code (see NativeConfig.scala's doc
+// comment on useLLVMDirectCodeGen and DirectCodeGen.scala's header comment).
+// This is the no-op counterpart to tools/native's real implementation --
+// same relative path, same object name, picked by whichever platform this
+// "tools" module is cross-built for, exactly like Platform.scala.
+private[codegen] object DirectCodeGenDispatch {
+  private val warnedUnavailable = new java.util.concurrent.atomic.AtomicBoolean(false)
+
+  def plan(config: build.Config, defns: Seq[nir.Defn])(implicit
+      platform: PlatformInfo
+  ): DirectCodeGenPlan = {
+    if (config.compilerConfig.useLLVMDirectCodeGen &&
+        warnedUnavailable.compareAndSet(false, true)) {
+      config.logger.warn(
+        "useLLVMDirectCodeGen has no effect on a JVM-hosted toolchain " +
+          "(it requires the toolchain itself to run as compiled Scala " +
+          "Native code); falling back to .ll + clang for the whole build."
+      )
+    }
+    DirectCodeGenPlan.Unavailable
+  }
+
+  /** Never actually called (plan() above always returns Unavailable), but
+   *  needed so shared CodeGen.scala compiles against this JVM-hosted stub
+   *  too -- see Platform.scala for the same per-platform-object mechanism.
+   */
+  def emit(
+      config: build.Config,
+      env: Map[nir.Global, nir.Defn],
+      capableDefns: Seq[nir.Defn],
+      objPath: Path
+  )(implicit platform: PlatformInfo): Boolean = false
+}
