+  /** Info needed to bind against libLLVM's C API directly (experimental
+   *  direct codegen backend). See [[NativeConfig.useLLVMDirectCodeGen]].
+   */
+  private[scalanative] case class LLVMInfo(
+      libDir: Path,
+      majorVersion: Int
+  )
+
+  /** Minimum LLVM version whose C API surface the experimental direct codegen
+   *  backend is willing to call into. Chosen conservatively; widen only after
+   *  verifying the relevant `LLVMBuildXxx`/`LLVMCreateTargetMachine` etc.
+   *  signatures are stable back to a lower version.
+   */
+  private[scalanative] final val MinimumSupportedLLVMDirectCodeGenVersion = 13
+
+  /** Discover `libLLVM`'s lib directory and version via `llvm-config`, for
+   *  the experimental direct codegen backend. Returns `None` (rather than
+   *  throwing) when `llvm-config` isn't found or reports an unusable
+   *  version, so callers can decide whether that's fatal. Cached per
+   *  `NativeConfig`: CodeGen.scala's direct-codegen wiring calls this once
+   *  per partition (dozens, for a real program) to decide whether to even
+   *  attempt the direct path there, and re-shelling out to `llvm-config`
+   *  that often would eat into the very link-time savings the feature is
+   *  for.
+   */
+  private[scalanative] def discoverLibLLVM()(implicit
+      config: NativeConfig
+  ): Option[LLVMInfo] =
+    cache("discover-libllvm")(_ => discoverLibLLVMUncached())
+
+  private def discoverLibLLVMUncached(): Option[LLVMInfo] =
+    try {
+      val libDirLines = Process(s"$llvmConfigCLI --libdir")
+        .lineStream_!(silentLogger())
+        .toList
+      val versionLines = Process(s"$llvmConfigCLI --version")
+        .lineStream_!(silentLogger())
+        .toList
+      for {
+        libDirLine <- libDirLines.headOption
+        versionLine <- versionLines.headOption
+        major <- Try(versionLine.takeWhile(_.isDigit).toInt).toOption
+      } yield LLVMInfo(Paths.get(libDirLine), major)
+    } catch {
+      case _: Exception => None
+    }
+
