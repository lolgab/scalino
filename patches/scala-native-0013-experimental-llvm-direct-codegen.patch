+++ b/tools/native/src/main/scala/scala/scalanative/codegen/llvm/direct/DirectCodeGenDispatch.scala
@@ -0,0 +1,49 @@
+package scala.scalanative
+package codegen
+package llvm
+package direct
+
+import java.nio.file.Path
+
+import scala.scalanative.build
+
+// Native-hosted `tools` build: the real dispatch. See tools/jvm's
+// counterpart (same relative path/object name, picked per-platform exactly
+// like Platform.scala) for why a separate no-op version exists there.
+private[codegen] object DirectCodeGenDispatch {
+  private val warnedUnavailable = new java.util.concurrent.atomic.AtomicBoolean(false)
+
+  /** Cheap, synchronous classification -- see DirectCodeGen.plan's own doc
+   *  comment for why CodeGen.scala needs this decided before scheduling any
+   *  Future work.
+   */
+  def plan(config: build.Config, defns: Seq[nir.Defn])(implicit
+      platform: PlatformInfo
+  ): DirectCodeGenPlan = {
+    val minVersion = build.Discover.MinimumSupportedLLVMDirectCodeGenVersion
+    build.Discover.discoverLibLLVM()(config.compilerConfig) match {
+      case Some(info) if info.majorVersion >= minVersion =>
+        DirectCodeGen.plan(config, defns)
+      case _ =>
+        if (warnedUnavailable.compareAndSet(false, true)) {
+          config.logger.warn(
+            s"useLLVMDirectCodeGen requested but no compatible libLLVM " +
+              s"(via llvm-config, >= $minVersion) was discoverable; " +
+              "falling back to .ll + clang for the whole build."
+          )
+        }
+        DirectCodeGenPlan.Unavailable
+    }
+  }
+
+  /** The actual (expensive) LLVM-C work; only ever called for a partition
+   *  `plan` already classified as `Split`, with that same `capableDefns`.
+   */
+  def emit(
+      config: build.Config,
+      env: Map[nir.Global, nir.Defn],
+      capableDefns: Seq[nir.Defn],
+      objPath: Path
+  )(implicit platform: PlatformInfo): Boolean =
+    DirectCodeGen.emit(config, env, capableDefns, objPath)
+}
diff --git a/tools/native/src/main/scala/scala/scalanative/codegen/llvm/direct/LLVMCApi.scala b/tools/native/src/main/scala/scala/scalanative/codegen/llvm/direct/LLVMCApi.scala
new file mode 100644
index 0000000..01b480a
--- /dev/null
+++ b/tools/native/src/main/scala/scala/scalanative/codegen/llvm/direct/LLVMCApi.scala
@@ -0,0 +1,550 @@
+package scala.scalanative
+package codegen
+package llvm
+package direct
+
+// EXPERIMENTAL (NativeConfig.useLLVMDirectCodeGen). Thin @extern bindings for
+// the subset of LLVM-C (llvm-c/Core.h, llvm-c/Target.h, llvm-c/TargetMachine.h,
+// llvm-c/Analysis.h) needed by DirectCodeGen. Only compiles under the
+// Native-hosted `tools` build (this file lives in tools/native/, not
+// tools/src/main/, exactly like Platform.scala) -- see NativeConfig.scala's
+// doc comment on useLLVMDirectCodeGen for why.
+//
+// These symbols are resolved against libLLVM at the link time of whatever
+// native binary embeds this "tools" code (e.g. scalino-linkdriver) -- that
+// binary's own build/link step is responsible for passing `-L<libdir>
+// -lLLVM-<major>` (see build/04-build-scalino-linkdriver.sh), discovered via
+// Discover.discoverLibLLVM(). No `@link(...)` annotation here: the library
+// name depends on the runtime-discovered LLVM version, which isn't a
+// compile-time literal.
+import scala.scalanative.unsafe._
+
+private[direct] object LLVMCApi {
+  type LLVMContextRef = Ptr[Byte]
+  type LLVMModuleRef = Ptr[Byte]
+  type LLVMTypeRef = Ptr[Byte]
+  type LLVMValueRef = Ptr[Byte]
+  type LLVMBasicBlockRef = Ptr[Byte]
+  type LLVMBuilderRef = Ptr[Byte]
+  type LLVMTargetRef = Ptr[Byte]
+  type LLVMTargetMachineRef = Ptr[Byte]
+  type LLVMTargetDataRef = Ptr[Byte]
+  // llvm-c/Transforms/PassBuilder.h + llvm-c/Error.h: the new-pass-manager
+  // entry point used to actually run the middle-end optimization pipeline
+  // (mem2reg/SROA/GVN/redundant-load-elimination/...) on a module before
+  // codegen -- see emitObjectFile's doc comment for why this is required.
+  type LLVMPassBuilderOptionsRef = Ptr[Byte]
+  type LLVMErrorRef = Ptr[Byte]
+  // llvm-c/DebugInfo.h: opaque debug-info metadata handle and DIBuilder.
+  type LLVMMetadataRef = Ptr[Byte]
+  type LLVMDIBuilderRef = Ptr[Byte]
+  // LLVMBool is a plain C `int` (0/1), not a real Boolean ABI type.
+  type LLVMBool = CInt
+
+  // llvm-c/Core.h: LLVMIntPredicate
+  final val LLVMIntEQ = 32
+  final val LLVMIntNE = 33
+  final val LLVMIntUGT = 34
+  final val LLVMIntUGE = 35
+  final val LLVMIntULT = 36
+  final val LLVMIntULE = 37
+  final val LLVMIntSGT = 38
+  final val LLVMIntSGE = 39
+  final val LLVMIntSLT = 40
+  final val LLVMIntSLE = 41
+
+  // llvm-c/Core.h: LLVMRealPredicate (ordered variants only, matches
