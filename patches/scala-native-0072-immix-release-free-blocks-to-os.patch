+// Returning memory to the OS: after a collection, runs of completely free
+// blocks hold no data (every allocation path zeroes what it hands out, and
+// the free list lives in BlockMeta, not in the blocks), so their pages can
+// be released. Only worthwhile when evacuation is compacting the live set
+// into few blocks, so it defaults to on with $SCALANATIVE_EVAC_ENABLE /
+// scalanative_gc_set_evac_default; $SCALANATIVE_GC_RELEASE_MEMORY=0/1
+// overrides. Short runs are skipped: they would just fault straight back in.
+#define RELEASE_MIN_RUN_BLOCKS 16
+
+static void Heap_ReleaseFreeBlocks(Heap *heap) {
+    // -1 = unset (follow evacuation, which can be switched on after startup)
+    static int override = -2;
+    if (override == -2) {
+        const char *env = getenv("SCALANATIVE_GC_RELEASE_MEMORY");
+        override = env != NULL ? (env[0] != '0') : -1;
+    }
+    if (override == 0 || (override < 0 && !Marker_EvacEnabled()))
+        return;
+    uint32_t blockCount = heap->blockCount;
+    uint32_t i = 0;
+    while (i < blockCount) {
+        if (!BlockMeta_IsFree(BlockMeta_GetFromIndex(heap->blockMetaStart, i))) {
+            i++;
+            continue;
+        }
+        uint32_t j = i + 1;
+        while (j < blockCount &&
+               BlockMeta_IsFree(BlockMeta_GetFromIndex(heap->blockMetaStart, j)))
+            j++;
+        if (j - i >= RELEASE_MIN_RUN_BLOCKS)
+            memoryReleasePages(heap->heapStart + (size_t)i * WORDS_IN_BLOCK,
+                               (size_t)(j - i) * BLOCK_TOTAL_SIZE);
+        i = j;
+    }
+}
