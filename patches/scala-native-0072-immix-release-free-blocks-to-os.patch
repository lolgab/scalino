diff --git a/nativelib/src/main/resources/scala-native/gc/shared/MemoryMap.c b/nativelib/src/main/resources/scala-native/gc/shared/MemoryMap.c
--- a/nativelib/src/main/resources/scala-native/gc/shared/MemoryMap.c
+++ b/nativelib/src/main/resources/scala-native/gc/shared/MemoryMap.c
@@ -83,6 +83,25 @@
 #endif // !_WIN32
 }
 
+// Tells the OS the pages in [addr, addr+size) hold no live data, so their
+// physical memory can be reclaimed. Contents become undefined (zero on Linux);
+// callers must not rely on them. addr/size must be page aligned.
+void memoryReleasePages(void *addr, size_t memorySize) {
+#ifdef _WIN32
+    (void)addr;
+    (void)memorySize;
+#elif defined(__APPLE__)
+    // MADV_FREE_REUSABLE only lowers the footprint accounting; the pages stay
+    // in RSS (what ps/htop show) until memory pressure. Remapping the range
+    // as fresh zero pages drops them immediately.
+    if (mmap(addr, memorySize, HEAP_MEM_PROT, HEAP_MEM_FLAGS | MAP_FIXED,
+             HEAP_MEM_FD, HEAP_MEM_FD_OFFSET) == MAP_FAILED)
+        madvise(addr, memorySize, MADV_FREE_REUSABLE);
+#else
+    madvise(addr, memorySize, MADV_DONTNEED);
+#endif
+}
