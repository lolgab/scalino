@@ -7,6 +7,40 @@
 #include <memory.h>
 #include <assert.h>
 
+Allocator sharedRecycleAllocator;
+static atomic_flag sharedRecycleLock = ATOMIC_FLAG_INIT;
+#define RECYCLE_BATCH 16
+
+void Allocator_ResetSharedRecycle(Heap *heap) {
+    Allocator *shared = &sharedRecycleAllocator;
+    shared->bytemap = heap->bytemap;
+    shared->blockMetaStart = heap->blockMetaStart;
+    shared->heapStart = heap->heapStart;
+    shared->blockAllocator = &blockAllocator;
+    BlockList_Init(&shared->recycledBlocks, heap->blockMetaStart);
+    shared->recycledBlockCount = 0;
+}
+
+// Moves up to RECYCLE_BATCH blocks from the shared pool to the allocator's own
+// list. Returns false if the pool was empty.
+static bool Allocator_refillFromShared(Allocator *allocator) {
+    if (sharedRecycleAllocator.recycledBlocks.first == NULL)
+        return false;
+    while (atomic_flag_test_and_set_explicit(&sharedRecycleLock,
+                                             memory_order_acquire)) {
+    }
+    int taken = 0;
+    BlockMeta *block;
+    while (taken < RECYCLE_BATCH &&
+           (block = BlockList_Poll(&sharedRecycleAllocator.recycledBlocks)) !=
+               NULL) {
+        BlockList_AddLast(&allocator->recycledBlocks, block);
+        taken++;
+    }
+    atomic_flag_clear_explicit(&sharedRecycleLock, memory_order_release);
+    return taken > 0;
+}
