index 00000000..e0855fde
--- /dev/null
+++ b/compiler/src/dotty/tools/dotc/ScalinoInterpret.scala
@@ -0,0 +1,268 @@
+package dotty.tools
+package dotc
+
+import ast.tpd
+import core.Contexts.*
+import core.Decorators.*
+import core.Flags.*
+import core.Names.*
+import core.Phases.Phase
+import core.StdNames.nme
+import core.Symbols.*
+import core.Types.*
+import fromtasty.{ReadTasty, TASTYCompiler}
+import quoted.{Interpreter, InterpretedInstance, InterpretedThrow, ProgramExit}
+import reporting.{ConsoleReporter, Reporter}
+import transform.{Inlining, PostInlining}
+
+import java.io.{OutputStream, PrintStream}
+import java.nio.file.{Files, Path, Paths}
+import scala.collection.mutable
+
+/** `scalino-dotc --interpret`: runs a compiled program by interpreting its TASTy with the macro
+ *  interpreter (`quoted.Interpreter`) instead of linking a native binary (`scalino run --interpret`).
+ *
+ *  Usage: `scalino-dotc --interpret [--fallback-exit] <mainClass> <classesDir> <compiler options> [-- <program args>]`.
+ *  `classesDir` holds the program's `.tasty` (the CLI's normal compile output); the options are the
+ *  ones it was compiled with (classpath, `-Yretain-trees`, the javalib TASTy setting).
+ *
+ *  The program's own classes go through a `-from-tasty` run that stops after `postInlining`, so
+ *  inline calls and macros are expanded exactly as for a native build; every symbol's `defTree`
+ *  (and each top-level class's root tree) then points at that expanded tree, which is what the
+ *  interpreter runs. Library code is interpreted from its own TASTy, as for macros.
+ *
+ *  Exit status: the program's (0, `sys.exit(n)`, 1 for an uncaught exception), 2 for a usage or
+ *  compile error, and, with `--fallback-exit`, `FallbackExit` when the program can't be interpreted
+ *  and the caller should link it instead (without it: an error, exit 1): code that needs the native runtime (`@extern`, `scala.scalanative.unsafe`,
+ *  threads) found before running, or an interpreter gap hit before the program wrote any output.
+ *  A gap hit after output is reported as an error (exit 1): running it again would repeat side effects.
+ */
+object ScalinoInterpret:
+
+  val FallbackExit = 3
+
+  /** The trees `postInlining` left for each compilation unit's classes, installed as the symbols'
+   *  `defTree`s; also collects the units for `unsupportedFeature`. */
+  private final class InstallTrees(units: mutable.ListBuffer[tpd.Tree]) extends Phase:
+    def phaseName: String = "scalinoInstallTrees"
+    /** This phase's context: the interpreter runs in it, after `postInlining`'s denotations. */
+    var lastCtx: Context | Null = null
+    protected def run(using Context): Unit =
+      val tree = ctx.compilationUnit.tpdTree
+      units += tree
+      install(tree)
+      lastCtx = ctx
+
+  /** Points every definition in `tree` (a whole compilation unit) at its own subtree. */
+  def install(tree: tpd.Tree)(using Context): Unit =
+    val traverser = new tpd.TreeTraverser:
+      def traverse(t: tpd.Tree)(using Context): Unit =
+        t match
+          case t: tpd.MemberDef if t.symbol.exists =>
+            t.symbol.defTree = t
+            // A top-level class's root tree is what the interpreter searches for members
+            // without a `defTree` of their own (`Interpreter#resolveExternalDefTree`).
+            if t.symbol.isClass && t.symbol.owner.is(Package) then
+              t.symbol.asClass.rootTreeOrProvider = tree
+          case _ =>
+        traverseChildren(t)
+    traverser.traverse(tree)
+
+  private final class InterpretCompiler(units: mutable.ListBuffer[tpd.Tree]) extends TASTYCompiler:
+    val installTrees = new InstallTrees(units)
+    override def phases: List[List[Phase]] =
+      List(List(new ReadTasty), List(new Inlining), List(new PostInlining), List(installTrees))
+
+  private object driver extends Driver:
+    def setupFor(args: Array[String], rootCtx: Context): Option[(List[io.AbstractFile], Context)] = setup(args, rootCtx)
+    def compileWith(compiler: Compiler, files: List[io.AbstractFile])(using Context): Reporter = doCompile(compiler, files)
+
+  /** Packages whose code only runs natively: anything reaching them falls back to linking. */
+  private val nativeOnlyPrefixes = List(
+    "scala.scalanative.unsafe", "scala.scalanative.unsigned", "scala.scalanative.runtime",
+    "scala.scalanative.posix", "scala.scalanative.libc", "scala.scalanative.windows",
+    "scala.scalanative.meta", "scala.scalanative.libc",
+  )
+  /** Concurrency the interpreter can't model (it is single-threaded, with no scheduler). */
+  private val threadPrefixes = List(
+    "java.lang.Thread", "java.util.concurrent.", "java.util.Timer",
+    "scala.concurrent.Future", "scala.concurrent.Promise", "scala.concurrent.Await",
+    "scala.concurrent.ExecutionContext", "scala.concurrent.blocking", "scala.concurrent.impl.",
+  )
+
+  /** A reason the program's own code can't be interpreted, or None. Checked before running so the
+   *  caller can fall back to linking without the program having started. */
+  def unsupportedFeature(units: List[tpd.Tree])(using Context): Option[String] =
+    var found: Option[String] = None
+    val externAnnot = getClassIfDefined("scala.scalanative.unsafe.extern")
+    def check(sym: Symbol, pos: util.SrcPos): Unit =
+      if found.isEmpty && sym.exists then
+        val name = sym.fullName.toString.replace("$.", ".").stripSuffix("$")
+        def at = s"${pos.sourcePos.source.name}:${pos.sourcePos.line + 1}"
+        if nativeOnlyPrefixes.exists(p => name == p || name.startsWith(p + ".")) then
+          found = Some(s"uses native-only `$name` ($at)")
+        else if threadPrefixes.exists(name.startsWith) then
+          found = Some(s"uses threads/concurrency (`$name`, $at)")
+        else if externAnnot.exists && sym.hasAnnotation(externAnnot) then
+          found = Some(s"calls an @extern definition `$name` ($at)")
+    val traverser = new tpd.TreeTraverser:
+      def traverse(t: tpd.Tree)(using Context): Unit =
+        if found.isEmpty then
+          t match
+            case _: tpd.Import => // names only: what the program does with them is checked where it does it
+            case t: (tpd.RefTree | tpd.New) => check(t.symbol, t.srcPos)
+              t match
+                case t: tpd.New => check(t.tpe.typeSymbol, t.srcPos)
+                case _ =>
+            case t: tpd.MemberDef if t.symbol.exists && externAnnot.exists && t.symbol.owner.hasAnnotation(externAnnot) =>
+              found = Some(s"defines @extern `${t.symbol.owner.fullName}`")
+            case _ =>
+          if !t.isInstanceOf[tpd.Import] then traverseChildren(t)
+    units.foreach(traverser.traverse)
+    found
+
+  /** `--fallback-exit` given: the caller links the program when this exits with `FallbackExit`. */
+  private var canFallBack = false
+
+  /** Status for "can't interpret this": `FallbackExit` when the caller falls back, else an error. */
+  private def cannotInterpret(err: PrintStream): Int =
+    if canFallBack then FallbackExit
+    else
+      err.println("scalino: run it without --interpret")
+      1
+
+  def run(args0: Array[String]): Unit =
+    canFallBack = args0.headOption.contains("--fallback-exit")
+    val args = if canFallBack then args0.drop(1) else args0
+    val (head, progArgs) = args.span(_ != "--")
+    if head.length < 2 then
+      System.err.println("usage: scalino-dotc --interpret [--fallback-exit] <mainClass> <classesDir> <compiler options> [-- <program args>]")
+      sys.exit(2)
+    val mainClass = head(0)
+    val classesDir = Paths.get(head(1))
+    val options = head.drop(2).toList
+    val tastyFiles = mutable.ListBuffer.empty[String]
+    Files.walk(classesDir).forEach(p => if p.toString.endsWith(".tasty") then tastyFiles += p.toString)
+    if tastyFiles.isEmpty then
+      System.err.println(s"scalino-dotc --interpret: no .tasty files in $classesDir")
+      sys.exit(2)
+    // -color:never: our own messages print symbols with `show`
+    sys.exit(interpret(mainClass, options ++ List("-from-tasty", "-Yretain-trees", "-color:never"), tastyFiles.toList, progArgs.drop(1)))
+
+  /** The run itself; returns the exit status. */
+  def interpret(mainClass: String, options: List[String], tastyFiles: List[String], progArgs: Array[String]): Int =
+    val rootCtx = (new ContextBase).initialCtx
+    driver.setupFor((options ++ tastyFiles).toArray, rootCtx) match
+      case None => 2
+      case Some((files, ctx0)) =>
+        val units = mutable.ListBuffer.empty[tpd.Tree]
+        val compiler = new InterpretCompiler(units)
+        given Context = ctx0
+        val reporter = driver.compileWith(compiler, files)
+        if reporter.hasErrors || compiler.installTrees.lastCtx == null then 2
+        else
+          given Context = compiler.installTrees.lastCtx.nn.fresh.setCompilationUnit(NoCompilationUnit)
+          unsupportedFeature(units.toList) match
+            case Some(reason) =>
+              System.err.println(s"scalino: can't interpret this program: it $reason")
+              cannotInterpret(System.err)
+            case None => runMain(mainClass, progArgs)
+
+  /** Finds `mainClass`'s `main(Array[String])` and interprets it. */
+  def runMain(mainClass: String, progArgs: Array[String])(using Context): Int =
+    // Classes of the empty package aren't reachable through `staticRef` from the root.
+    val dot = mainClass.lastIndexOf('.')
+    val owner =
+      if dot < 0 then defn.EmptyPackageClass
+      else getPackageClassIfDefined(mainClass.substring(0, dot))
+    val simple = mainClass.substring(dot + 1)
+    def member(name: Name): Symbol = if owner.exists then owner.info.decl(name).symbol else NoSymbol
+    val moduleCls = member(simple.toTermName).moduleClass
+    def mainIn(cls: Symbol): Symbol =
+      if !cls.exists then NoSymbol
+      else cls.info.decl(nme.main).alternatives.map(_.symbol).find(isMainMethod).getOrElse(NoSymbol)
+    // `@main def f` generates a class `f` with a static `main`; an object's `main` is in its module class.
+    val cls = member(simple.toTypeName)
+    val mainSym = mainIn(cls).orElse(mainIn(moduleCls))
+    if !mainSym.exists then
+      System.err.println(s"scalino-dotc --interpret: no main(Array[String]) method in $mainClass")
+      return 2
+    val out = new OutputTracker(System.out)
+    val err = new OutputTracker(System.err)
+    val interpreter = new Interpreter(mainSym.srcPos, null)
+    val savedOut = System.out
+    val savedErr = System.err
+    System.setOut(out.stream)
+    System.setErr(err.stream)
+    try
+      Console.withOut(out.stream) {
+        Console.withErr(err.stream) {
+          interpreter.runMain(mainSym, progArgs)
+        }
+      }
+      0
+    catch
+      case ProgramExit(status) => status
+      case e: Interpreter.StopInterpretation =>
+        val wrote = out.wrote || err.wrote
+        out.stream.flush()
+        val pos = e.pos.sourcePos
+        val where = if pos.exists then s" (${pos.source.name}:${pos.line + 1})" else ""
+        savedErr.println(s"scalino: can't interpret this program$where: ${e.msg.message}")
+        for sym <- interpreter.stopStack.take(if sys.env.contains("SCALINO_INTERP_TRACE") then 60 else 8) do
+          savedErr.println(s"  in ${sym.showLocated}")
+        if wrote then
+          savedErr.println("scalino: it already wrote output, so it is not rerun natively -- run it without --interpret")
+          1
+        else cannotInterpret(savedErr)
+      case e @ InterpretedThrow(value) =>
+        out.stream.flush()
+        savedErr.println(s"Exception in thread \"main\" ${describeException(value)}")
+        printStack(interpreter, e, savedErr)
+        1
+      case e: StackOverflowError =>
+        out.stream.flush()
+        savedErr.println("Exception in thread \"main\" java.lang.StackOverflowError (interpreted)")
+        1
+      case e: Throwable if !e.isInstanceOf[scala.util.control.ControlThrowable] =>
+        out.stream.flush()
+        savedErr.println(s"Exception in thread \"main\" $e")
+        printStack(interpreter, e, savedErr)
+        if sys.env.contains("SCALINO_INTERP_TRACE") then e.printStackTrace(savedErr)
+        1
+    finally
+      InterpretedInstance.render = null
+      out.stream.flush()
+      err.stream.flush()
+      System.setOut(savedOut)
+      System.setErr(savedErr)
+
+  /** The interpreted frames `e` unwound, JVM-trace style (no line numbers: the interpreter keeps
+   *  only the methods). */
+  private def printStack(interpreter: Interpreter, e: Throwable, err: PrintStream)(using Context): Unit =
+    if interpreter.lastThrown eq e then
+      for sym <- interpreter.lastThrowStack do
+        err.println(s"\tat ${sym.owner.fullName.toString.stripSuffix("$")}.${sym.name} (${sym.source.name})")
+
+  private def isMainMethod(sym: Symbol)(using Context): Boolean =
+    sym.info.stripPoly match
+      case mt: MethodType =>
+        mt.paramInfos match
+          case List(p) => p.derivesFrom(defn.ArrayClass) && mt.resultType.isRef(defn.UnitClass)
+          case _ => false
+      case _ => false
+
+  /** `java.lang.RuntimeException: msg`-style text for an exception value (an interpreted one's
+   *  `toString` runs through `InterpretedInstance.render`). */
+  def describeException(value: Object): String = String.valueOf(value)
+
+  /** Wraps a stream and remembers whether anything was written to it. */
+  private final class OutputTracker(underlying: PrintStream):
+    var wrote = false
+    val stream: PrintStream = new PrintStream(new OutputStream:
+      override def write(b: Int): Unit = { wrote = true; underlying.write(b) }
+      override def write(b: Array[Byte], off: Int, len: Int): Unit =
+        if len > 0 then wrote = true
+        underlying.write(b, off, len)
+      override def flush(): Unit = underlying.flush()
+    , true)
diff --git a/compiler/src/dotty/tools/dotc/ScalinoRepl.scala b/compiler/src/dotty/tools/dotc/ScalinoRepl.scala
new file mode 100644
index 00000000..abfd4d1c
--- /dev/null
+++ b/compiler/src/dotty/tools/dotc/ScalinoRepl.scala
@@ -0,0 +1,361 @@
+package dotty.tools
+package dotc
+
+import ast.{tpd, untpd}
+import core.Contexts.*
+import core.Decorators.*
+import core.NameOps.*
+import core.Flags.*
+import core.Phases.Phase
+import core.StdNames.nme
+import core.Symbols.*
+import core.Types.*
+import parsing.Parsers
+import quoted.{Interpreter, InterpretedThrow, ProgramExit}
+import reporting.{ConsoleReporter, Diagnostic, Reporter, StoreReporter}
+import transform.{Inlining, PostInlining, PostTyper}
+import typer.TyperPhase
+import util.SourceFile
+
+import java.io.{BufferedReader, InputStreamReader, PrintStream, PrintWriter}
+import java.nio.charset.StandardCharsets.UTF_8
+import java.nio.file.{Files, Paths}
+import scala.collection.mutable
+
+/** `scalino-dotc --repl`: a Scala 3 REPL whose inputs run on the tree interpreter
+ *  (`quoted.Interpreter`), so no JVM and no linking (`scalino repl`).
+ *
+ *  Usage: `scalino-dotc --repl [--interactive] [--init-script <code>] [--quit-after-init] <compiler options>`.
+ *  `--interactive` (stdin is a terminal) prints the welcome banner. The options carry the
+ *  classpath (the project's classes and dependencies) and the javalib TASTy setting.
+ *
+ *  Each input is compiled in one long-lived context (one `Run` per input, so the symbols of
+ *  earlier inputs stay entered, as in `ScalinoDaemon`) as
+ *
+ *  {{{
+ *  import rs$line1.{*, given}; ...; object rs$lineN {
+ *  <input, each expression statement `e` as `val resK = e`>
+ *  }
+ *  }}}
+ *
+ *  through the frontend, `postTyper`, `inlining` and `postInlining`; then the wrapper's statements
+ *  are interpreted in order, sharing one `Interpreter.Session` (the state of every object) with all
+ *  earlier inputs, and its new definitions are printed like the stock REPL does.
+ */
+object ScalinoRepl:
+
+  private final class InstallTrees extends Phase:
+    def phaseName: String = "scalinoInstallTrees"
+    var units: List[tpd.Tree] = Nil
+    var lastCtx: Context | Null = null
+    protected def run(using Context): Unit =
+      val tree = ctx.compilationUnit.tpdTree
+      ScalinoInterpret.install(tree)
+      units = units :+ tree
+      lastCtx = ctx
+
+  private final class ReplCompiler extends Compiler:
+    /** The last run's (a phase instance serves one run only). */
+    var installTrees = new InstallTrees
+    override def phases: List[List[Phase]] =
+      installTrees = new InstallTrees
+      List(List(new parsing.Parser), List(new TyperPhase), List(new PostTyper), List(new Inlining), List(new PostInlining), List(installTrees))
+
+  private object driver extends Driver:
+    override protected def sourcesRequired: Boolean = false
+    def setupFor(args: Array[String], rootCtx: Context): Option[(List[io.AbstractFile], Context)] = setup(args, rootCtx)
+
+  /** Everything that `:reset` drops. */
+  private final class State(val rootCtx: Context):
+    val compiler = new ReplCompiler
+    val session = new Interpreter.Session
+    /** Top-level imports every later input starts with: the earlier wrappers' members and the
+     *  user's own imports, in input order (a later one shadows an earlier one). */
+    val preamble = mutable.ArrayBuffer.empty[String]
+    var line = 0
+    var resCount = 0
+
+  private val Prompt = "scala> "
+  private val Continue = "     | "
+  /** Longest rendered value, as in the stock REPL. */
+  private val MaxValueLength = 1000
+
+  def run(args: Array[String]): Unit =
+    var initScript: String | Null = null
+    var quitAfterInit = false
+    var interactive = false
+    var rest = args.toList
+    var more = true
+    while more do
+      rest match
+        case "--init-script" :: code :: tail => initScript = code; rest = tail
+        case "--quit-after-init" :: tail => quitAfterInit = true; rest = tail
+        // stdin is a terminal (the caller knows: this javalib has no `System.console`)
+        case "--interactive" :: tail => interactive = true; rest = tail
+        case _ => more = false
+    // E230: the wrappers' `$` names, which are ours
+    val options = rest ++ List("-Yretain-trees", "-color:never", "-Wconf:id=E230:s")
+    def newState(): State =
+      driver.setupFor(options.toArray, (new ContextBase).initialCtx) match
+        case Some((_, ctx)) => State(ctx)
+        case None => sys.exit(2)
+    var state = newState()
+    val in = new BufferedReader(new InputStreamReader(System.in, UTF_8))
+    val out = System.out
+    if interactive then
+      out.println(s"Welcome to Scala ${config.Properties.simpleVersionString} (scalino, interpreted: no JVM, no linking).")
+      out.println("Type in expressions for evaluation. Or try :help.")
+      out.println()
+    if initScript != null then evalInput(state, initScript.nn, out)
+    var done = quitAfterInit
+    while !done do
+      readInput(state, in, out, interactive) match
+        case None => done = true
+        case Some(input) =>
+          val trimmed = input.trim
+          if trimmed.isEmpty then ()
+          else if trimmed.startsWith(":") then
+            val (cmd, arg) = trimmed.span(!_.isWhitespace) match { case (c, a) => (c, a.trim) }
+            cmd match
+              case ":quit" | ":q" | ":exit" => done = true
+              case ":help" | ":h" => printHelp(out)
+              case ":reset" =>
+                state = newState()
+                out.println("Resetting REPL state.")
+              case ":imports" =>
+                state.preamble.filterNot(_.startsWith("import rs$line")).foreach(out.println)
+              case ":type" | ":t" =>
+                if arg.isEmpty then out.println(":type <expression>") else typeOf(state, arg, out)
+              case ":load" =>
+                val p = Paths.get(arg)
+                if arg.isEmpty || !Files.isRegularFile(p) then out.println(s"File '$arg' does not exist.")
+                else evalInput(state, new String(Files.readAllBytes(p), UTF_8), out)
+              case _ => out.println(s"Unknown command: \"$cmd\", run \":help\" for a list of commands")
+          else
+            try evalInput(state, input, out)
+            catch case ProgramExit(status) =>
+              out.flush()
+              sys.exit(status)
+    if interactive then out.println()
+    sys.exit(0)
+
+  private def printHelp(out: PrintStream): Unit =
+    out.println(
+      """The REPL has several commands available:
+        |
+        |:help                    print this summary
+        |:load <path>             interpret lines in a file
+        |:quit                    exit the REPL
+        |:type <expression>       evaluate the type of the given expression
+        |:imports                 show import history
+        |:reset                   reset the REPL to its initial state, forgetting all session entries
+        |
+        |Inputs are interpreted (scalino-dotc's tree interpreter), not linked: code that needs the
+        |native runtime (@extern, scala.scalanative.unsafe, threads) is not supported here.""".stripMargin)
+
+  /** One complete input, reading continuation lines while the parser reports it unfinished;
+   *  None at end of input. */
+  private def readInput(state: State, in: BufferedReader, out: PrintStream, interactive: Boolean): Option[String] =
+    // Prompts only for a terminal: piped input gets just the results.
+    def prompt(p: String): Unit = if interactive then { out.print(p); out.flush() }
+    prompt(Prompt)
+    val first = in.readLine()
+    if first == null then None
+    else if first.trim.startsWith(":") then Some(first)
+    else
+      val buf = new StringBuilder(first)
+      var more = isIncomplete(state, buf.toString)
+      var eof = false
+      while more && !eof do
+        prompt(Continue)
+        val next = in.readLine()
+        if next == null then eof = true
+        else
+          buf.append('\n').append(next)
+          // an empty line ends an unfinishable input too, as in the stock REPL after two of them
+          more = next.trim.nonEmpty && isIncomplete(state, buf.toString)
+      Some(buf.toString)
+
+  /** Does `code` end inside an unfinished construct (an open brace, a dangling operator)? */
+  private def isIncomplete(state: State, code: String): Boolean =
+    given Context = state.rootCtx.fresh.setReporter(new StoreReporter(null))
+    val source = SourceFile.virtual("<console>", code, maybeIncomplete = true)
+    val parser = new Parsers.Parser(source)
+    parser.blockStatSeq()
+    ctx.reporter.allErrors.exists(_.pos.span.end >= code.length) || code.trim.endsWith("=")
+
+  /** Parses `code` into its top-level statements (None on a syntax error, reported). */
+  private def parseStats(state: State, code: String, out: PrintStream): Option[List[untpd.Tree]] =
+    val reporter = newReporter(out)
+    given Context = state.rootCtx.fresh.setReporter(reporter)
+    val source = SourceFile.virtual("<console>", code)
+    val stats = new Parsers.Parser(source).blockStatSeq()
+    if reporter.hasErrors then None else Some(stats)
+
+  private def newReporter(out: PrintStream): ConsoleReporter =
+    val w = new PrintWriter(out, true)
+    new ConsoleReporter(null, w, w)
+
+  private def isExpression(t: untpd.Tree)(using Context): Boolean = t match
+    case _: untpd.MemberDef | _: untpd.Import | _: untpd.Export | _: untpd.PackageDef => false
+    case _: untpd.PatDef => false
+    case _ => t.isTerm
+
+  /** Compiles one wrapper object; its typed body statements and the context to interpret them
+   *  in, or None after reporting compile errors. */
+  private def compileWrapper(state: State, wrapperName: String, body: String, out: PrintStream): Option[(Symbol, List[tpd.Tree], Context)] =
