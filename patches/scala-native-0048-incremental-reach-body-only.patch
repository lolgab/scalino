+        // mutated here -- a single disqualifying Top must be able to bail
+        // out to a fresh Reach with this instance's state untouched, since
+        // the caller's fallback path (`new Reach(...)`) doesn't know or
+        // care whether we got partway through mutating the old one.
+        case class TopPatch(freshDefns: Seq[nir.Defn], changed: Seq[nir.Defn.Define])
+        val bodyPatches = mutable.Map.empty[nir.Global.Top, TopPatch]
+        var safe = true
+        val tops = rawLoaded.keysIterator
+        while (safe && tops.hasNext) {
+          val top = tops.next()
+          val oldDefns = rawLoaded(top)
+          newLoader.load(top) match {
+            case None =>
+              safe = false // the file backing this Top disappeared
+            case Some(freshDefns) if freshDefns eq oldDefns =>
+              () // definitely unchanged (ClassPath's own mtime cache hit)
+            case Some(freshDefns) =>
+              val oldByName = loaded(top)
+              if (freshDefns.size != oldByName.size) safe = false
+              else {
+                val freshByName = freshDefns.iterator.map(d => d.name -> d).toMap
+                if (freshByName.keySet != oldByName.keySet) safe = false
