+      newEntries: collection.Seq[nir.Global],
+      newLoader: ClassLoader
+  ): Option[ReachabilityAnalysis] = {
+    if (unreachable.nonEmpty || unsupported.nonEmpty) None
+    else if (newConfig != config) None
+    else if (newEntries != entries) None
+    else {
+      val newEntryPointClasses = newLoader.classesWithEntryPoints.toSet
+      val newServiceProviders = newLoader.definedServicesProviders
+      if (newEntryPointClasses != lastEntryPointClasses) None
+      else if (newServiceProviders != lastServiceProviders) None
+      else {
