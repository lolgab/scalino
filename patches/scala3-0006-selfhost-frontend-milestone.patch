+package dotty.tools.dotc.sbt.interfaces
+
+import dotty.tools.dotc.sbt.{DependencyContext, UseScope}
+import dotty.tools.dotc.util.SourceFile
+
+import java.nio.file.Path
+
+/** Ported from the original `IncrementalCallback.java` (Scala Native's own
+ *  dotc can't compile `.java` sources into itself -- there is no
+ *  Java-to-NIR path, only a Scala-source-to-NIR one -- so every `.java`
+ *  file that would otherwise be part of this reduced source set needs a
+ *  Scala port). User code should not implement this trait; it was intended
+ *  to be a wrapper around `xsbti.AnalysisCallback`.
+ *
+ *  Trimmed to the methods `sbt/ExtractDependencies.scala`/`sbt/package.scala`/
+ *  `core/Contexts.scala` actually call: this toolchain never wires in a real
+ *  zinc `xsbti.AnalysisCallback` (see docs/findings.md's "frontend-only
+ *  smoke test" scoping), and the dropped methods (`api`, `startSource`,
+ *  `mainClass`, `generatedLocalClass`, `generatedNonLocalClass`) were only
+ *  ever called from `sbt/ExtractAPI.scala`/`sbt/APIUtils.scala`,
+ *  both excluded entirely -- their real `xsbti.api.ClassLike` parameter type
+ *  has no Scala Native cross-build either, same as `xsbti.api.DependencyContext`/
+ *  `xsbti.UseScope` below (replaced with this project's own
+ *  `dotty.tools.dotc.sbt.{DependencyContext,UseScope}`).
+ */
+trait IncrementalCallback {
+
+  // `scala.collection.Set`, not `immutable.Set` specifically -- must match
+  // `ExtractDependencies.scala`'s own `import scala.collection.{Set, mutable}`
+  // exactly, since `DefaultScopes`/`PatMatScopes` there are typed against
+  // that same general (mutability-agnostic) `Set`.
+  def usedName(className: String, name: String, useScopes: scala.collection.Set[UseScope]): Unit = ()
+
+  def binaryDependency(onBinaryEntry: Path, onBinaryClassName: String, fromClassName: String,
+      fromSourceFile: SourceFile, context: DependencyContext): Unit = ()
+
+  def classDependency(onClassName: String, sourceClassName: String, context: DependencyContext): Unit = ()
+
+  def apiPhaseCompleted(): Unit = ()
+
+  def dependencyPhaseCompleted(): Unit = ()
+
+  def enabled: Boolean = false
+}
