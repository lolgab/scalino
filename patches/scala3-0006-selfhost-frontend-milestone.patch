+package dotty.tools.dotc.sbt.interfaces
+
+import dotty.tools.dotc.CompilationUnit
+
+/** Ported from the original `ProgressCallback.java` (Scala Native's own dotc
+ *  can't compile `.java` sources into itself -- there is no Java-to-NIR
+ *  path, only a Scala-source-to-NIR one -- so every `.java` file that would
+ *  otherwise be part of this reduced source set needs a Scala port. This
+ *  one carries no `xsbti` dependency either way; see docs/findings.md's
+ *  "frontend-only smoke test" scoping.
+ */
+trait ProgressCallback {
+  /** Record that the cancellation signal has been received during the Zinc run. */
+  def cancel(): Unit = ()
+
+  /** Report on if there was a cancellation signal for the current Zinc run. */
+  def isCancelled(): Boolean = false
+
+  /** Record that a unit has started compiling in the given phase. */
+  def informUnitStarting(phase: String, unit: CompilationUnit): Unit = ()
+
+  /** Record the current compilation progress.
+   *  @param current `completedPhaseCount * totalUnits + completedUnitsInCurrPhase + completedLate`
+   *  @param total `totalPhases * totalUnits + totalLate`
+   *  @return true if the compilation should continue (callers are expected to cancel if this returns false)
+   */
+  def progress(current: Int, total: Int, currPhase: String, nextPhase: String): Boolean = true
+}
