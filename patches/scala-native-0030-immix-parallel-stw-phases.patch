+    if (maxBatches > sweep.batchesCapacity) {
+        SweepBatch *grown = (SweepBatch *)realloc(
+            sweep.batches, (size_t)maxBatches * sizeof(SweepBatch));
+        if (grown == NULL)
+            Heap_exitWithOutOfMemory("allocate sweep batches");
+        sweep.batches = grown;
+        sweep.batchesCapacity = maxBatches;
+    }
+    uint32_t n = 0;
+    sweep.batchStart[0] = 0;
+    for (uint32_t next = batchSize; next < blockCount; next += batchSize) {
+        uint32_t i = next;
