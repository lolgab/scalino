+static void Sweep_prepareBatches(Heap *heap, uint32_t batchSize) {
+    uint32_t blockCount = heap->blockCount;
+    uint32_t maxBatches = blockCount / batchSize + 2;
+    if (maxBatches + 1 > sweep.batchStartCapacity) {
+        uint32_t *grown = (uint32_t *)realloc(
+            sweep.batchStart, (size_t)(maxBatches + 1) * sizeof(uint32_t));
+        if (grown == NULL)
+            Heap_exitWithOutOfMemory("allocate sweep batches");
+        sweep.batchStart = grown;
+        sweep.batchStartCapacity = maxBatches + 1;
