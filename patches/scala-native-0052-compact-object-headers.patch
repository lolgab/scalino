--- /dev/null
+++ b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/MonitorTable.scala
@@ -0,0 +1,85 @@
+package scala.scalanative.runtime
+package monitor
+
+import java.lang.ref.WeakReference
+
+import scala.scalanative.annotation.alwaysinline
+import scala.scalanative.meta.LinktimeInfo.{
+  isCompactHeaders,
+  isMultithreadingEnabled
+}
+import scala.scalanative.runtime.Intrinsics._
+import scala.scalanative.runtime.ffi.stdatomic._
+import scala.scalanative.runtime.ffi.stdatomic.memory_order._
+import scala.scalanative.unsafe.{stackalloc => _, _}
+
+/** Table of inflated monitors, used only with compact object headers.
+ *
+ *  The header of an object has no room for a reference to its ObjectMonitor, so
+ *  an inflated lock word stores an index in this table. The table keeps the
+ *  monitors alive, objects are referenced only weakly: a slot of a collected
+ *  object is reused by later inflations. The monitor itself never references
+ *  its owner object, so it can't keep it alive.
+ */
+private[runtime] object MonitorTable {
+  // Indexes need to fit in the 15 bits of the inflated lock word
+  @alwaysinline def Capacity = 1 << 15
+
+  private var monitors: scala.Array[ObjectMonitor] = _
+  private var owners: scala.Array[WeakReference[AnyRef]] = _
+  private var cursor = 0
+  // Spin lock guarding the allocation of the slots, stored off-heap
+  private var lockCell: RawPtr = _
+
+  /** Needs to be called before any monitor is inflated, from the single
+   *  threaded part of the runtime initialization.
+   */
+  private[runtime] def init(): Unit =
+    if (isCompactHeaders && isMultithreadingEnabled) {
+      if (monitors == null) {
+        lockCell = ffi.malloc(castIntToRawSize(4))
+        storeInt(lockCell, 0)
+        owners = new scala.Array[WeakReference[AnyRef]](Capacity)
+        monitors = new scala.Array[ObjectMonitor](Capacity)
+      }
+    }
+
+  @alwaysinline def get(index: Int): ObjectMonitor = monitors(index)
+
+  private def lock(): Unit = {
+    val expected = stackalloc[Int]()
+    var acquired = false
+    while (!acquired) {
+      storeInt(expected, 0)
+      acquired = atomic_compare_exchange_int(lockCell, expected, 1)
+      if (!acquired) NativeThread.onSpinWait()
+    }
+  }
+
+  private def unlock(): Unit =
+    atomic_store_int(lockCell, 0, memory_order_release)
+
+  /** Registers the monitor of `owner` and returns its index */
+  private[monitor] def register(owner: AnyRef, monitor: ObjectMonitor): Int = {
+    // Allocate outside of the lock, GC can't suspend threads waiting for it
+    val ref = new WeakReference[AnyRef](owner)
+    lock()
+    try {
+      var tries = 0
+      var idx = cursor
+      while (tries < Capacity) {
+        if (monitors(idx) == null || owners(idx).get() == null) {
+          monitors(idx) = monitor
+          owners(idx) = ref
+          cursor = (idx + 1) & (Capacity - 1)
+          return idx
+        }
+        idx = (idx + 1) & (Capacity - 1)
+        tries += 1
+      }
+    } finally unlock()
+    throw new OutOfMemoryError(
+      "Too many inflated monitors, limit with compact object headers is " + Capacity
+    )
+  }
+}
