+      case name if fn.owner.name.toString == "defnModule" =>
+        defnConstant(name)
+
+      case "ofMacroExpansion" if fn.owner.name.toString == "PositionModule" =>
+        Some(pos.sourcePos)
+
+      // `scala.StringContext` (real Java/Scala library, not part of Quotes
+      // at all) -- macros build interpolated diagnostic strings (like
+      // `report.info(s"...")`) via its ordinary, cross-module (no retained
+      // body) `apply` method (`.s(...)` is an instance call, handled in
+      // `interpretStdlibIntrinsic` instead).
+      case "apply" if fn.owner.name.toString.stripSuffix("$") == "StringContext" =>
+        val parts = args match { case (s: scala.collection.Seq[Object] @unchecked) :: Nil => s; case other => other }
