+      case ddef: DefDef if !ddef.rhs.isEmpty =>
+        val params = ddef.termParamss.flatten.map(_.symbol)
+        val withParams = params.zip(args).foldLeft(emptyEnv)((e, pv) => e.updated(pv._1, pv._2)).updated(inst.cls, inst)
+        interpretTree(ddef.rhs)(using withParams)
+      case _ => throw new StopInterpretation(em"Interpreter (own implementation): cannot call $methodName directly on ${inst.toString}", pos)
