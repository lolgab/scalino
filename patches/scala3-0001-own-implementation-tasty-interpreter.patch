+      case "newBuilder" if fn.owner.name.toString.stripSuffix("$") == "Set" =>
+        Some(scala.collection.immutable.Set.newBuilder[Object])
+      case "newBuilder" if fn.owner.name.toString.stripSuffix("$") == "List" =>
+        Some(List.newBuilder[Object])
+      // `newBuilder` dispatched via the genuinely ABSTRACT `IterableFactory`
+      // trait itself, not a concrete companion -- e.g. `Map#collect`'s real
+      // default falls back to `Iterable`'s own generic factory for a
+      // transformation that doesn't preserve Map shape, and our own
+      // `"iterableFactory"` resolution (see `interpretStdlibIntrinsic`)
+      // doesn't special-case every possible receiver shape that can lead
+      // here. Nothing downstream cares which concrete sequence a builder
+      // like this produces, only that it collects elements in order -- a
+      // plain `List` builder is a safe, general default (same choice the
+      // concrete `List`/`Set` cases just above already hardcode).
+      case "newBuilder" if fn.owner.name.toString == "IterableFactory" =>
+        Some(List.newBuilder[Object])
+      case "apply" if fn.owner.name.toString.stripSuffix("$") == "List" =>
+        val elems = args match { case (s: scala.collection.Seq[Object] @unchecked) :: Nil => s; case other => other }
+        Some(elems.toList)
+      case "empty" if fn.owner.name.toString.stripSuffix("$") == "List" =>
+        Some(Nil)
+      // `java.lang.Boolean.getBoolean`/etc: real JDK-native methods with no
+      // Scala/dotc-compiled source at all (unlike everything else this
+      // dispatcher handles) -- there's no tree of any kind to interpret, so
+      // just run the real JDK method directly, the same way `Math` below does.
+      case "getBoolean" if fn.owner == defn.BoxedBooleanModule.moduleClass =>
+        args match
+          case List(s: String) => Some(Boolean.box(java.lang.Boolean.getBoolean(s)))
+          case _ => None
+      case name if fn.owner.name.toString.stripSuffix("$") == "Math" =>
+        args.map {
+          case i: Integer => i.intValue
+          case l: java.lang.Long => l.longValue
+          case d: java.lang.Double => d.doubleValue
+          case f: java.lang.Float => f.floatValue
+        } match
+          case List(a: Int, b: Int) if name == "max" => Some(Int.box(math.max(a, b)))
+          case List(a: Int, b: Int) if name == "min" => Some(Int.box(math.min(a, b)))
+          case List(a: Long, b: Long) if name == "max" => Some(java.lang.Long.valueOf(math.max(a, b)))
+          case List(a: Long, b: Long) if name == "min" => Some(java.lang.Long.valueOf(math.min(a, b)))
+          case List(a: Double) if name == "abs" => Some(java.lang.Double.valueOf(math.abs(a)))
+          case List(a: Int) if name == "abs" => Some(Int.box(math.abs(a)))
+          case _ => None
+
+      // `Predef`'s implicit `RichInt`/`RichLong`/etc wrapper conversions
+      // (`0.until(n)` desugars to `intWrapper(0).until(n)`): identity is
+      // enough since our `Int`/`Long` values are already boxed and the
+      // actual range-building ops are separate intrinsics on that same
+      // boxed value (see `interpretStdlibIntrinsic`).
+      case ("intWrapper" | "longWrapper" | "byteWrapper" | "shortWrapper" | "charWrapper" | "doubleWrapper" | "floatWrapper") =>
+        args.headOption
+
+      case "apply" if fn.owner.name.toString == "TypeBoundsModule" =>
+        args match
+          case (lo: Type) :: (hi: Type) :: Nil => Some(TypeBounds(lo, hi))
+          case _ => None
+      case "empty" if fn.owner.name.toString == "TypeBoundsModule" =>
+        Some(TypeBounds.empty)
+      case "upper" if fn.owner.name.toString == "TypeBoundsModule" =>
+        args.headOption.collect { case hi: Type => TypeBounds.upper(hi) }
+      case "lower" if fn.owner.name.toString == "TypeBoundsModule" =>
+        args.headOption.collect { case lo: Type => TypeBounds.lower(lo) }
+      case "low" if fn.owner.name.toString == "TypeBoundsMethods" =>
+        args.headOption.collect { case b: TypeBounds => b.lo.stripLazyRef }
+      case "hi" if fn.owner.name.toString == "TypeBoundsMethods" =>
+        args.headOption.collect { case b: TypeBounds => b.hi.stripLazyRef }
+
+      case "apply" if fn.owner.name.toString == "MethodTypeModule" =>
+        args match
+          case (paramNames: List[String @unchecked]) :: (paramInfosExp: Function1[Object, Object] @unchecked) :: (resultTypeExp: Function1[Object, Object] @unchecked) :: Nil =>
+            Some(MethodType(paramNames.map(_.toTermName))(
+              mt => paramInfosExp(mt.asInstanceOf[Object]).asInstanceOf[List[Type]],
+              mt => resultTypeExp(mt.asInstanceOf[Object]).asInstanceOf[Type]))
+          case _ => None
+
+      case _ => None
+  end interpretQuotesApi
