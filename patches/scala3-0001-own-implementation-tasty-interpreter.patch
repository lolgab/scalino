+          case (tpe: Type) :: Nil => Some(tpd.TypeTree(tpe).withSpan(pos.span))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "WildcardModule" =>
+        Some(dotty.tools.dotc.ast.untpd.Ident(nme.WILDCARD).withType(defn.AnyType).withSpan(pos.span))
+      case "apply" if fn.owner.name.toString == "IntConstantModule" =>
+        args match { case (v: Integer) :: Nil => Some(Constant(v.intValue)); case _ => None }
+      case "apply" if fn.owner.name.toString == "BooleanConstantModule" =>
+        args match { case (v: java.lang.Boolean) :: Nil => Some(Constant(v.booleanValue)); case _ => None }
+      case "apply" if fn.owner.name.toString == "StringConstantModule" =>
+        args match { case (v: String) :: Nil => Some(Constant(v)); case _ => None }
+      case "apply" if fn.owner.name.toString == "NullConstantModule" =>
+        Some(Constant(null))
+      case "apply" if fn.owner.name.toString == "DefDefModule" =>
+        args match
+          case (sym: Symbol) :: rhsFn :: Nil =>
+            val f = rhsFn.asInstanceOf[Object => Object]
