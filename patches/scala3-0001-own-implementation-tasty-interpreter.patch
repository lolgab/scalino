+  private def isExprMethodsOwner(sym: Symbol): Boolean =
+    sym.exists && sym.owner.name.toString == "Quotes"
+
+  private def summonCtx(q: scala.quoted.runtime.impl.QuotesImpl): Context = q.ctx
+
+  /** An Expr's underlying tree for a compile-time-known value is rarely a
+   *  bare `Literal` -- inline captures/ascriptions wrap it in `Inlined`,
+   *  `Typed`, or a trivial `Block`. Unwrap those before giving up.
+   */
+  private def stripToLiteral(t: tpd.Tree): Option[Object] =
+    import dotty.tools.dotc.ast.tpd.{Literal => TpdLiteral, Inlined, Typed, Block}
+    t match
+      case TpdLiteral(Constant(v)) => Some(v.asInstanceOf[Object])
+      case Inlined(_, Nil, expansion) => stripToLiteral(expansion)
+      case Typed(expr, _) => stripToLiteral(expr)
+      case Block(Nil, expr) => stripToLiteral(expr)
+      case _ =>
+        // Not a bare literal (or a trivial wrapper around one) -- but
+        // `.valueOrAbort`'s real contract is broader than that: "reduce to
+        // SOME concrete compile-time value or abort", and the value asked
+        // for isn't always primitive-shaped -- e.g. `org.typelevel
+        // .literally.Literally#apply` (the framework behind ip4s's own
+        // `port"8080"`/`host"127.0.0.1"` interpolators) calls
+        // `strCtxExpr.valueOrAbort.parts`, i.e. wants the real
+        // `StringContext` OBJECT itself (to read its `.parts` field), not
+        // a String. Since `t` is a closed sub-expression of the macro
+        // CALLER's own literal source (not arbitrary runtime code), and
+        // this interpreter can already evaluate arbitrary closed
+        // expressions, genuinely interpreting it and using whatever real
+        // value comes back is equivalent to constant-folding it: success
+        // here already means every sub-part was itself constant-derivable
+        // (interpretation has no other way to produce a value).
+        try Some(interpretTree(t)(using emptyEnv))
+        catch case scala.util.control.NonFatal(_) => None
+
+  private def literalConstant(v: Object): Option[Constant] = v match
+    case v: java.lang.Boolean => Some(Constant(v.booleanValue))
+    case v: java.lang.Byte => Some(Constant(v.byteValue))
+    case v: java.lang.Short => Some(Constant(v.shortValue))
+    case v: Integer => Some(Constant(v.intValue))
+    case v: java.lang.Long => Some(Constant(v.longValue))
+    case v: java.lang.Float => Some(Constant(v.floatValue))
+    case v: java.lang.Double => Some(Constant(v.doubleValue))
+    case v: java.lang.Character => Some(Constant(v.charValue))
+    case v: String => Some(Constant(v))
+    case _ => None
+
+  // ---------------------------------------------------------------------
+  // A curated, explicitly-not-exhaustive set of stdlib intrinsics: enough
+  // for the test fixtures under interpreter/test-fixtures. Extend as more
+  // macro patterns are added, following the same shape.
+  // ---------------------------------------------------------------------
+
+  /** Calls a named, no-tree-available method directly on an
+   *  `InterpretedInstance` with already-evaluated argument values (unlike
+   *  `callUserDefDef`, which needs raw arg trees to interpret) -- for
+   *  reimplementing a stdlib trait's *default* method (no retained body of
+   *  its own) in terms of the *other* methods a concrete subclass (an
+   *  interpreted anonymous class, e.g. a `PartialFunction` literal) does
+   *  override, like `PartialFunction#lift` calling `isDefinedAt`/`apply`.
+   */
+  /** Calls a single-argument "function-shaped" value with `arg`, whichever
+   *  of the two shapes an interpreted closure can come back as: a real host
+   *  `Function1` (the common `closureDef` case), or one of our own
+   *  `InterpretedInstance`s (a closure hoisted out of a loop as a reusable
+   *  singleton -- e.g. `StrictOptimizedIterableOps#strictOptimizedCollect`'s
+   *  own `default` callback -- retains as `new AnonFun$N(){...}`, not a
+   *  `closureDef` match). Needed anywhere a callback parameter (like
+   *  `applyOrElse`'s `default`) might be either.
+   */
+  private def applyFn1(f: Object, arg: Object)(using Env): Object = f match
+    case f: Function1[Object, Object] @unchecked => f(arg)
+    case inst: InterpretedInstance => callInstanceMethodDirect(inst, "apply", List(arg))
+    case _ => throw new StopInterpretation(em"Interpreter (own implementation): not a callable single-argument function: ${f.toString}", pos)
+
+  private def callInstanceMethodDirect(inst: InterpretedInstance, methodName: String, args: List[Object])(using Env): Object =
+    inst.cls.info.member(methodName.toTermName).suchThat(_.is(Method)).symbol.defTree match
+      case ddef: DefDef if !ddef.rhs.isEmpty =>
+        val params = ddef.termParamss.flatten.map(_.symbol)
