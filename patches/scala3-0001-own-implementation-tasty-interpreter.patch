+  private def matchQuoteBody(pat: Tree, scrutinee: Object, bindingSyms: Set[Symbol])(using env: Env): Option[Env] =
+    scrutinee match
+      case e: scala.quoted.runtime.impl.ExprImpl => matchQuoteBodyTree(pat, stripInlined(e.tree), e.scope, bindingSyms)
+      case _ => None
