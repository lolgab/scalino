+        case _ => None
+    case Select(patQual, patName) =>
+      scrutTree match
+        case Select(scrutQual, scrutName) if patName == scrutName => matchQuoteBodyTree(patQual, scrutQual, scope, bindingSyms)
+        // The scrutinee isn't ALSO a `Select` of the same shape (e.g. a
+        // plain `Ident` instead, printed WITH a qualifier prefix purely for
+        // disambiguation, not because it's really a multi-hop `Select`
+        // tree) -- same underlying reference can gain or lose qualifier
+        // hops (a package vs. its synthetic package-OBJECT accessor,
+        // `import`-shortened idents, ...) independent of anything the
+        // ORIGINAL source actually wrote differently on either side. Fall
+        // back to whole-reference symbol identity (same as the leaf case
+        // below) rather than failing outright on a structural mismatch
