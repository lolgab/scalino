+  // Maps every member of the public `scala.quoted.Quotes#FlagsModule` API
+  // (`quotes.reflect.Flags.X`) to its real dotc `FlagSet` constant -- was
+  // curated on demand as specific macro shapes got exercised (only the
+  // dozen or so a handful of test-fixture macros needed), which left this
+  // gap-prone for any other macro (e.g. upickle's enum/case-class
+  // `derives ReadWriter`, which alone needed `Lazy`/`AbsOverride`/`Local`/
+  // `NoInits`/`Param`/`ParamAccessor`/`Private`/`Synthetic` on top of
+  // `Implicit`). Filled out exhaustively against the real public API
+  // surface (`scala.quoted.Quotes`'s own `FlagsModule` trait) instead of
+  // continuing to add one at a time per crash.
+  private def flagConstant(name: String): FlagSet = name match
+    case "EmptyFlags" => EmptyFlags
+    case "Abstract" => Abstract
+    case "AbsOverride" => AbsOverride
+    case "Artifact" => Artifact
+    case "Case" => Case
+    case "CaseAccessor" => CaseAccessor
+    case "Contravariant" => Contravariant
+    case "Covariant" => Covariant
+    case "Deferred" => Deferred
+    case "Enum" => Enum
+    case "Erased" => Erased
+    case "Exported" => Exported
+    case "ExtensionMethod" => ExtensionMethod
+    case "FieldAccessor" => Accessor
+    case "Final" => Final
+    case "Given" => Given
+    case "HasDefault" => HasDefault
+    case "Implicit" => Implicit
+    case "Infix" => Infix
+    case "Inline" => Inline
+    case "Invisible" => Invisible
+    case "JavaDefined" => JavaDefined
+    case "JavaStatic" | "Static" => JavaStatic
+    case "JavaAnnotation" => JavaAnnotation
+    case "Lazy" => Lazy
+    case "Local" => Local
+    case "Macro" => Macro
+    case "Method" => Method
+    case "Module" => Module
+    case "Mutable" => Mutable
+    case "NoInits" => NoInits
+    case "Opaque" => Opaque
+    case "Open" => Open
+    case "Override" => Override
+    case "Package" => Package
+    case "Param" => Param
+    case "ParamAccessor" => ParamAccessor
+    case "Private" => Private
+    case "PrivateLocal" => PrivateLocal
+    case "Protected" => Protected
+    case "Sealed" => Sealed
+    case "StableRealizable" => StableRealizable
+    case "Synthetic" => Synthetic
+    case "Trait" => Trait
+    case "Transparent" => Transparent
+    case _ => throw new StopInterpretation(em"Interpreter (own implementation): unsupported Flags.$name", pos)
+
+  private def defnConstant(name: String): Option[Object] = name match
+    case "AnyClass" => Some(defn.AnyClass)
+    case "AnyValClass" => Some(defn.AnyValClass)
+    case "ObjectClass" => Some(defn.ObjectClass)
+    case "AnyRefClass" => Some(defn.AnyRefAlias)
+    case "NullClass" => Some(defn.NullClass)
+    case "NothingClass" => Some(defn.NothingClass)
+    case "UnitClass" => Some(defn.UnitClass)
+    case "ByteClass" => Some(defn.ByteClass)
+    case "ShortClass" => Some(defn.ShortClass)
+    case "CharClass" => Some(defn.CharClass)
+    case "IntClass" => Some(defn.IntClass)
+    case "LongClass" => Some(defn.LongClass)
+    case "FloatClass" => Some(defn.FloatClass)
+    case "DoubleClass" => Some(defn.DoubleClass)
+    case "BooleanClass" => Some(defn.BooleanClass)
+    case "StringClass" => Some(defn.StringClass)
+    case "ClassClass" => Some(defn.ClassClass)
+    case "ArrayClass" => Some(defn.ArrayClass)
+    case "OptionClass" => Some(defn.OptionClass)
+    case "NoneModule" => Some(defn.NoneModule)
+    case "SomeModule" => Some(defn.SomeClass.companionModule)
