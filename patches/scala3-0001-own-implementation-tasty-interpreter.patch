+  private def matchQuoteBodyTree(pat: Tree, scrutTree: Tree, scope: scala.quoted.runtime.impl.Scope, bindingSyms: Set[Symbol])(using env: Env): Option[Env] = pat match
+    case sp @ SplicePattern(subPat, _, _) =>
+      // A splice pattern's own type ascription (e.g. the `Encoder[h]` in
+      // `'{ $head: Encoder[h] }`) is NOT a separate `Typed` node anywhere in
+      // this tree -- it surfaces purely as `sp.tpe` itself (already
+      // "unwrapped" from `Expr[_]`, e.g. `Encoder[h]`/`Encoder[EmptyTuple]`/
+      // `Encoder[ht *: t]` for porcupine's `sql"..."` macro), confirmed by
+      // dumping the real retained tree (`SplicePattern` with no nested
+      // `Typed`, just `Bind(head, Ident(WILDCARD))`, but `sp.tpe` carrying
+      // the ascribed type). The previous implementation ignored `sp.tpe`
+      // entirely, so every case in a multi-case typed-splice match always
+      // took the FIRST alternative regardless of the scrutinee's real type
+      // (and never bound `h`) -- exactly why porcupine's `sql"..."` fold
+      // always took its base case and got stuck at a single-element tuple
+      // type no matter how many `?` placeholders the query actually had.
+      // Real macros use this to both type-test the scrutinee AND bind
+      // pattern type variables (`h`) to whatever concrete type made the
+      // test succeed -- `unifyPatternType` does that structurally, and `h`'s
+      // binding is later read back via `quotedTypeGivenValue`.
+      unifyPatternType(sp.tpe, scrutTree.tpe, bindingSyms).flatMap { solved =>
+        matchPattern(subPat, new scala.quoted.runtime.impl.ExprImpl(scrutTree, scope), bindingSyms)(using solved.foldLeft(env)((e, kv) => e.updated(kv._1, kv._2)))
+      }
+    case Typed(patExpr, _) =>
+      val scrutExpr = scrutTree match { case Typed(e, _) => e; case _ => scrutTree }
+      matchQuoteBodyTree(patExpr, scrutExpr, scope, bindingSyms)
+    case New(patTpt) =>
+      // `case '{ new StringContext(...) } =>` (real scala-library
+      // `FromExpr[StringContext]`'s own pattern, `FromExpr.scala:143` --
+      // used by essentially any macro accepting a `StringContext`-based
+      // literal, e.g. http4s's own `uri"..."` via the `literally` library):
+      // `New`'s OWN `.symbol` is always `NoSymbol` (only its `tpt` child
+      // actually names a class), so falling through to the generic leaf
+      // case below would compare two `NoSymbol`s and always fail --
+      // recurse into `tpt` instead, whose real class symbol IS meaningful.
+      scrutTree match
+        case New(scrutTpt) => matchQuoteBodyTree(patTpt, scrutTpt, scope, bindingSyms)
+        case _ => None
+    case Apply(patFn, patArgs) =>
+      scrutTree match
+        case Apply(scrutFn, scrutArgs) if patArgs.size == scrutArgs.size =>
