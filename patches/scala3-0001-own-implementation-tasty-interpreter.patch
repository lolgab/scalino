+      // dist/lib/scalalib-retained.jar on the classpath, `Option.scala`'s
+      // own compiler-generated `Some.apply` has a real retained body
+      // `resolveExternalDefTree` can run directly.
+      case "apply" if fn.owner.name.toString == "ApplyModule" =>
+        args match
+          case (fun: Tree) :: as :: Nil => Some(tpd.Apply(fun, asObjectList(as).asInstanceOf[List[Tree]]))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "TypeApplyModule" =>
+        args match
+          case (fun: Tree) :: as :: Nil => Some(tpd.TypeApply(fun, asObjectList(as).asInstanceOf[List[Tree]]))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "TypedModule" =>
+        args match
+          case (expr: Tree) :: (tpt: Tree) :: Nil => Some(tpd.Typed(expr, tpt))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "LiteralModule" =>
+        args match
+          // A bare `tpd.Literal` has no children to derive a span from
+          // (unlike `Apply`/`If`/etc, whose smart constructors union their
+          // sub-trees' spans) -- `NoSpan` by default, which later fails a
+          // "position not set" assertion once this literal ends up spliced
+          // somewhere inside the macro's final result (`pos`, this whole
+          // expansion's call site, is the best span available here).
+          case (const: Constant) :: Nil => Some(tpd.Literal(const).withSpan(pos.span))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "IfModule" =>
+        args match
+          case (cond: Tree) :: (thenp: Tree) :: (elsep: Tree) :: Nil => Some(tpd.If(cond, thenp, elsep))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "MatchModule" =>
+        args match
+          case (selector: Tree) :: (cases: List[CaseDef @unchecked]) :: Nil => Some(tpd.Match(selector, cases))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "CaseDefModule" =>
+        args match
+          case (pattern: Tree) :: guard :: (rhs: Tree) :: Nil =>
+            val g = guard match { case Some(t: Tree) => t; case _ => tpd.EmptyTree }
+            Some(tpd.CaseDef(pattern, g, rhs))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "BindModule" =>
+        args match
+          case (sym: Symbol) :: (pattern: Tree) :: Nil => Some(tpd.Bind(sym, pattern))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "AssignModule" =>
+        args match
+          case (lhs: Tree) :: (rhs: Tree) :: Nil => Some(tpd.Assign(lhs, rhs))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "InferredModule" =>
