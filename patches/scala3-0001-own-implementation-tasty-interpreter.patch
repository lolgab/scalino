+      td.rhs match
+        case t: Template => Some(t)
+        case _ => None
+    case td: TypeDef =>
+      td.rhs match
+        case t: Template => findTemplate(t, target)
+        case _ => None
+    case t: Template =>
+      t.body.iterator.map(findTemplate(_, target)).collectFirst { case Some(x) => x }
