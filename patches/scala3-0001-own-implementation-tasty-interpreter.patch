+          case _ => None
+      case "tpe" if fn.owner.name.toString == "TermMethods" =>
+        args.headOption.collect { case t: Tree => t.tpe.widenSkolem }
+
+      case "asTerm" if fn.owner.name.toString == "reflectModule" =>
+        args.headOption.collect { case e: ExprImpl => e.tree }
+
+      case "search" if fn.owner.name.toString == "ImplicitsModule" =>
+        args match
+          case (t: Type) :: Nil => Some(ctx.typer.inferImplicitArg(t, pos.span))
+          case _ => None
+      case "tree" if fn.owner.name.toString == "ImplicitSearchSuccessMethods" =>
+        args.headOption.collect { case t: Tree => t }
+      case "explanation" if fn.owner.name.toString == "ImplicitSearchFailureMethods" =>
+        args.headOption.collect { case t: Tree => t.tpe.asInstanceOf[dotty.tools.dotc.typer.Implicits.SearchFailureType].explanation }
