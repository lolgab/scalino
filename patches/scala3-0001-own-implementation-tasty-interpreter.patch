+      // -----------------------------------------------------------------
+      // Generic `Tree`/`Term` accessors (TreeMethods/TermMethods): reading
+      // back or further building on trees the macro just constructed.
+      // -----------------------------------------------------------------
+
+      case "symbol" if fn.owner.name.toString == "TreeMethods" =>
+        args.headOption.collect { case t: Tree => t.symbol }
+      case "asExpr" if fn.owner.name.toString == "TreeMethods" =>
+        args.headOption.collect { case t: Tree => new ExprImpl(t, SpliceScope.getCurrent) }
+      case "asExprOf" if fn.owner.name.toString == "TreeMethods" =>
+        args.headOption.collect { case t: Tree => new ExprImpl(t, SpliceScope.getCurrent) }
+      case "changeOwner" if fn.owner.name.toString == "TreeMethods" =>
