+      // straight off that `Template`, same as the real implementation does.
+      case "body" if fn.owner.name.toString == "ClassDefMethods" =>
+        args.headOption.collect { case t: TypeDef => t.rhs.asInstanceOf[Template].body }
+      case "constructor" if fn.owner.name.toString == "ClassDefMethods" =>
+        args.headOption.collect { case t: TypeDef => t.rhs.asInstanceOf[Template].constr }
+      case "parents" if fn.owner.name.toString == "ClassDefMethods" =>
+        args.headOption.collect { case t: TypeDef => t.rhs.asInstanceOf[Template].parents }
+      case "select" if fn.owner.name.toString == "TermMethods" =>
+        args match
+          case (self: Tree) :: (sym: Symbol) :: Nil => Some(tpd.Select(self, TermRef(self.tpe, sym)))
+          case _ => None
+      case "appliedTo" if fn.owner.name.toString == "TermMethods" =>
+        args match
+          case (self: Tree) :: (arg: Tree) :: Nil => Some(tpd.Apply(self, List(arg)))
+          case _ => None
+      case "appliedToArgs" if fn.owner.name.toString == "TermMethods" =>
+        args match
+          case (self: Tree) :: as :: Nil => Some(tpd.Apply(self, asObjectList(as).asInstanceOf[List[Tree]]))
+          case _ => None
+      case "appliedToType" if fn.owner.name.toString == "TermMethods" =>
+        args match
+          case (self: Tree) :: (targ: Type) :: Nil => Some(tpd.TypeApply(self, List(tpd.TypeTree(targ))))
+          case _ => None
+      case "appliedToTypes" if fn.owner.name.toString == "TermMethods" =>
+        args match
+          case (self: Tree) :: (targs: List[Type @unchecked]) :: Nil =>
