+          case (qual: Tree) :: (name: String) :: Nil => Some(tpd.Select(qual, name.toTermName))
+          case _ => None
+      // `Select.overloaded(qualifier, name, targs, args[, returnType])`:
+      // real `QuotesImpl` just forwards to dotc's own `tpd.applyOverloaded`
+      // (real overload resolution), so do the same here instead of
+      // reimplementing it.
+      case "overloaded" if fn.owner.name.toString == "SelectModule" =>
+        args match
+          case (qual: Tree) :: (name: String) :: (targs: List[Type @unchecked]) :: (as: List[Tree @unchecked]) :: Nil =>
+            Some(tpd.applyOverloaded(qual, name.toTermName, as, targs, WildcardType))
+          case (qual: Tree) :: (name: String) :: (targs: List[Type @unchecked]) :: (as: List[Tree @unchecked]) :: (retTpe: Type @unchecked) :: Nil =>
+            Some(tpd.applyOverloaded(qual, name.toTermName, as, targs, retTpe))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "BlockModule" =>
+        args match
+          case (stats: List[Tree @unchecked]) :: (expr: Tree) :: Nil => Some(tpd.Block(stats, expr))
+          case _ => None
+      // `Repeated.apply(elems, elemtpt)`: real `QuotesImpl` just constructs
+      // a `tpd.SeqLiteral` directly (`type Repeated = tpd.SeqLiteral`).
+      case "apply" if fn.owner.name.toString == "RepeatedModule" =>
+        args match
+          case (elems: List[Tree @unchecked]) :: (elemtpt: Tree) :: Nil => Some(tpd.SeqLiteral(elems, elemtpt))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "NewModule" =>
+        args match
+          case (tpt: Tree) :: Nil => Some(tpd.New(tpt))
+          case _ => None
+      case "apply" if fn.owner.name.toString == "RefModule" =>
+        args.headOption.collect { case s: Symbol => tpd.ref(s) }
+      case "apply" if fn.owner.name.toString == "IdentModule" =>
+        // `quotes.reflect.Ident.apply(tmref: TermRef): Term` -- takes the
+        // already-built `TermRef`, not a bare `Symbol` (that's `Ref.apply`,
+        // which also picks Ident-or-package-qualified-Select automatically;
+        // this always builds a bare `Ident`).
+        args.headOption.collect { case t: NamedType => tpd.Ident(t) }
+      case "term" if fn.owner.name.toString == "RefModule" =>
+        args.headOption.collect { case t: NamedType => tpd.ref(t) }
