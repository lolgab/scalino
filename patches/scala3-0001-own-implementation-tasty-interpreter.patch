+        case _ => if pat.symbol.exists && pat.symbol == scrutTree.symbol then Some(env) else None
+    case _ =>
+      // A leaf reference (e.g. `StringContext`'s own `Ident`/module select):
+      // match by symbol identity, not structurally.
+      if pat.symbol.exists && pat.symbol == scrutTree.symbol then Some(env) else None
+
+  /** Structurally unifies a splice pattern's type ascription (e.g. `Encoder[h]`,
+   *  `Encoder[EmptyTuple]`, `Encoder[ht *: t]`) against the scrutinee
