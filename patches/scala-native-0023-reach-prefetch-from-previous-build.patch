index 0000000..b7ef9b1
--- /dev/null
+++ b/tools/src/main/scala/scala/scalanative/linker/ReachHint.scala
@@ -0,0 +1,47 @@
+package scala.scalanative
+package linker
+
+import java.nio.file.Files
+
+import scala.util.control.NonFatal
+
+/** The classes the previous build of this work directory loaded, kept in
+ *  `reachset` next to its other caches. A build starts by parsing them in
+ *  parallel (`ClassLoader.prefetch`) instead of one at a time as the
+ *  reachability analysis asks for them: that is ~110ms of serial NIR
+ *  parsing in a one-shot build of hello world, which is a new process every
+ *  time and so has nothing parsed. It is only a hint: a class the new build
+ *  does not need is parsed for nothing, one it needs and is not listed is
+ *  parsed when asked for, and a missing or damaged file is ignored.
+ *  `SCALINO_REACH_PREFETCH=0` turns it off.
+ */
+private[linker] object ReachHint {
+  private val enabled = !sys.env.get("SCALINO_REACH_PREFETCH").contains("0")
+  private def file(config: build.Config) = config.workDir.resolve("reachset")
+
+  def prefetch(config: build.Config, loader: ClassLoader): Unit =
+    if (enabled)
+      try {
+        val path = file(config)
+        if (Files.exists(path)) {
+          val tops = new String(Files.readAllBytes(path), "UTF-8")
+            .split('\n')
+            .iterator
+            .filter(_.nonEmpty)
+            .map(nir.Global.Top(_))
+            .toSeq
+          loader.prefetch(tops)
+        }
+      } catch { case NonFatal(_) => () }
+
+  def save(config: build.Config, tops: Iterable[nir.Global.Top]): Unit =
+    if (enabled)
+      try {
+        val text = tops.iterator.map(_.id).toSeq.sorted.mkString("", "\n", "\n")
+        val path = file(config)
+        val unchanged =
+          Files.exists(path) &&
+            new String(Files.readAllBytes(path), "UTF-8") == text
+        if (!unchanged) build.IO.write(path, text)
+      } catch { case NonFatal(_) => () }
+}
