+  /** `Tuple\d+`, without `String#matches` compiling a regex on every call. */
+  private def isTupleName(n: String): Boolean =
+    n.length > 5 && n.startsWith("Tuple") && allDigits(n, 5)
+
+  /** `_\d+`. */
+  private def isProductAccessorName(n: String): Boolean =
+    n.length > 1 && n.charAt(0) == '_' && allDigits(n, 1)
+
+  private def allDigits(n: String, from: Int): Boolean =
+    var i = from
+    while i < n.length && n.charAt(i) >= '0' && n.charAt(i) <= '9' do i += 1
+    i == n.length
+
+  /** Marker returned by `InterpretedFn1#applyIfMatched` for an unmatched input. */
+  private val NoMatch: Object = new Object
+
+  /** A 1-arg interpreted closure. When it is a `{ case ... }` partial-function
+   *  literal (body is a top-level `Match`) `applyIfMatched` reports "no case
+   *  matched" by returning `NoMatch` instead of throwing a `MatchError` --
+   *  capturing a stack trace and unwinding per probed element made
+   *  `lift`/`isDefinedAt`/`collect`/`applyOrElse` over interpreted partial
+   *  functions a hot spot.
+   */
+  private final class InterpretedFn1(ddef: DefDef, arg: Symbol, env: Env) extends Function1[Object, Object]:
+    def apply(x: Object): Object = interpretTree(ddef.rhs)(using env.updated(arg, x))
+    def applyIfMatched(x: Object): Object =
+      ddef.rhs match
+        case Match(selector, cases) =>
+          given Env = env.updated(arg, x)
+          try
+            interpretCases(cases, interpretTree(selector)) match
+              case Some(v) => v
+              case None => NoMatch
+          catch case _: MatchError => NoMatch
+        case _ =>
+          try apply(x) catch case _: MatchError => NoMatch
+
+  private def applyIfMatched(f: Function1[Object, Object], x: Object): Object = f match
+    case f: InterpretedFn1 => f.applyIfMatched(x)
+    case _ => try f(x) catch case _: MatchError => NoMatch
+
   private def interpretCases(cases: List[CaseDef], scrutinee: Object)(using Env): Option[Object] =
     cases.iterator.map(c => matchCase(c, scrutinee)).find(_.isDefined).flatten
 
