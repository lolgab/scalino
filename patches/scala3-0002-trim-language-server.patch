+  }
+
+  given markupContentCodec: JsonValueCodec[MarkupContent] = new JsonValueCodec[MarkupContent] {
+    def nullValue: MarkupContent = null
+    def decodeValue(in: JsonReader, default: MarkupContent): MarkupContent = ??? // never decoded, only encoded
+    def encodeValue(x: MarkupContent, out: JsonWriter): Unit = {
+      out.writeObjectStart()
+      out.writeNonEscapedAsciiKey("kind"); out.writeVal(x.kind)
+      out.writeNonEscapedAsciiKey("value"); out.writeVal(x.value)
+      out.writeObjectEnd()
+    }
+  }
+
+  private def encodeOptionalMarkupContent(x: Option[MarkupContent], out: JsonWriter): Unit = x match {
