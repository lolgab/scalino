+
+  /** Mirrors `AnnotationUtil`'s (package-private, so not directly reusable)
+   *  method-naming logic: `@JsonSegment` on the interface prefixes
+   *  `@JsonRequest`/`@JsonNotification` methods unless `useSegment = false`. */
+  private def rpcName(interf: Class[?], m: java.lang.reflect.Method): Option[String] = {
+    val segment = {
+      val s = interf.getAnnotation(classOf[lsp4j.jsonrpc.services.JsonSegment])
+      if (s != null) s.value + "/" else ""
+    }
+    val req = m.getAnnotation(classOf[lsp4j.jsonrpc.services.JsonRequest])
+    if (req != null)
+      Some(if (req.useSegment) segment + (if (req.value.nonEmpty) req.value else m.getName) else req.value)
+    else {
+      val notif = m.getAnnotation(classOf[lsp4j.jsonrpc.services.JsonNotification])
+      if (notif != null)
+        Some(if (notif.useSegment) segment + (if (notif.value.nonEmpty) notif.value else m.getName) else notif.value)
+      else None
+    }
+  }
