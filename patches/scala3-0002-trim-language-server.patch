+      m <- interf.getDeclaredMethods.toList
+      name <- rpcName(interf, m)
+    yield name -> m).toMap
+
+  /** The wire-protocol method table lsp4j needs, built the same safe way. */
+  val rpcMethods: java.util.Map[String, lsp4j.jsonrpc.json.JsonRpcMethod] = {
+    val merged = new java.util.LinkedHashMap[String, lsp4j.jsonrpc.json.JsonRpcMethod]
