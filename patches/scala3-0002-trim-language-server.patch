+    case None => out.writeNull()
+  }
+
+  given initializeParamsCodec: JsonValueCodec[InitializeParams] = new JsonValueCodec[InitializeParams] {
+    def nullValue: InitializeParams = null
+    def decodeValue(in: JsonReader, default: InitializeParams): InitializeParams =
