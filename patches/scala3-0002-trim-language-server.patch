+  // -- JSON-RPC envelopes ---------------------------------------------------
+
+  /** A decoded incoming message. `idRaw == null` means it's a notification
+   *  (no response expected); otherwise it's a request and `idRaw` holds the
+   *  exact raw JSON bytes of `id`, echoed back verbatim in the response --
+   *  we never need to know if it's a number or a string. */
+  final case class IncomingEnvelope(method: String, idRaw: Array[Byte], paramsRaw: Array[Byte])
+
+  // ==========================================================================
+  // Codecs -- one hand-written JsonValueCodec per type above, no macros.
+  // ==========================================================================
+
+  /** Skips whatever key/value pairs remain in the current JSON object --
+   *  every decode loop below falls back to this for keys it doesn't model,
+   *  which is how a rich real-editor payload with dozens of extra fields
+   *  (capabilities, clientInfo, workspaceFolders, ...) is safely ignored
+   *  without ever being parsed into a type at all. */
+  private def skipVal(in: JsonReader): Unit = in.skip()
+
+  given positionCodec: JsonValueCodec[Position] = new JsonValueCodec[Position] {
+    def nullValue: Position = null
+    def decodeValue(in: JsonReader, default: Position): Position =
+      if (in.isNextToken('{')) {
+        var line = 0
+        var character = 0
+        if (!in.isNextToken('}')) {
+          in.rollbackToken()
+          var continue = true
+          while (continue) {
+            in.readKeyAsString() match {
+              case "line" => line = in.readInt()
+              case "character" => character = in.readInt()
+              case _ => skipVal(in)
+            }
+            continue = in.isNextToken(',')
+          }
+          if (!in.isCurrentToken('}')) in.objectEndOrCommaError()
+        }
+        Position(line, character)
+      } else in.readNullOrTokenError(default, '{')
+    def encodeValue(x: Position, out: JsonWriter): Unit = {
+      out.writeObjectStart()
+      out.writeNonEscapedAsciiKey("line"); out.writeVal(x.line)
+      out.writeNonEscapedAsciiKey("character"); out.writeVal(x.character)
+      out.writeObjectEnd()
+    }
+  }
+
+  given rangeCodec: JsonValueCodec[Range] = new JsonValueCodec[Range] {
+    def nullValue: Range = null
+    def decodeValue(in: JsonReader, default: Range): Range =
+      if (in.isNextToken('{')) {
+        var start: Position = null
+        var end: Position = null
+        if (!in.isNextToken('}')) {
+          in.rollbackToken()
+          var continue = true
+          while (continue) {
+            in.readKeyAsString() match {
+              case "start" => start = positionCodec.decodeValue(in, null)
+              case "end" => end = positionCodec.decodeValue(in, null)
+              case _ => skipVal(in)
+            }
+            continue = in.isNextToken(',')
+          }
+          if (!in.isCurrentToken('}')) in.objectEndOrCommaError()
+        }
+        Range(start, end)
+      } else in.readNullOrTokenError(default, '{')
+    def encodeValue(x: Range, out: JsonWriter): Unit = {
+      out.writeObjectStart()
+      out.writeNonEscapedAsciiKey("start"); positionCodec.encodeValue(x.start, out)
+      out.writeNonEscapedAsciiKey("end"); positionCodec.encodeValue(x.end, out)
+      out.writeObjectEnd()
+    }
+  }
+
+  given locationCodec: JsonValueCodec[Location] = new JsonValueCodec[Location] {
+    def nullValue: Location = null
+    def decodeValue(in: JsonReader, default: Location): Location =
+      if (in.isNextToken('{')) {
