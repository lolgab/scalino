+  private def decodeList[T](in: JsonReader, elemCodec: JsonValueCodec[T]): List[T] =
+    if (in.isNextToken('[')) {
+      if (in.isNextToken(']')) Nil
+      else {
+        in.rollbackToken()
+        val buf = List.newBuilder[T]
+        var continue = true
+        while (continue) {
+          buf += elemCodec.decodeValue(in, null.asInstanceOf[T])
+          continue = in.isNextToken(',')
+        }
+        if (!in.isCurrentToken(']')) in.arrayEndOrCommaError()
+        buf.result()
+      }
+    } else in.readNullOrTokenError(Nil, '[')
