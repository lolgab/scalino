+package dotty.tools
+package languageserver
+
+import com.github.plokhotnyuk.jsoniter_scala.core._
+
+/** Hand-rolled LSP/JSON-RPC wire model + jsoniter-scala codecs -- no lsp4j,
+ *  no Gson, no reflection anywhere (not even jsoniter-scala's own
+ *  `JsonCodecMaker` macro derivation, which would need this project's own
+ *  macro interpreter -- patches/scala3-0001 -- to expand a third-party
+ *  compile-time macro it was never built to handle). Every codec below is
+ *  a plain method calling jsoniter-scala-core's low-level `JsonReader`/
+ *  `JsonWriter` API directly, compiled like any other Scala code.
+ *
+ *  Deliberately minimal: each params type only has the fields
+ *  `DottyLanguageServer` actually reads; unknown JSON object keys are
+ *  always skipped (see `skipRestOfObject`), so a real editor's much richer
+ *  `initialize` capabilities (the payload that silently broke Gson in
+ *  this project's own AOT-compiled binary, see docs/findings.md) never
+ *  gets modeled or parsed at all -- there is no reflection path left for
+ *  it to break.
+ */
+object Lsp {
+
+  // -- Common shapes -------------------------------------------------------
+
+  final case class Position(line: Int, character: Int)
+  final case class Range(start: Position, end: Position)
+  final case class Location(uri: String, range: Range)
+  final case class TextDocumentIdentifier(uri: String)
+  final case class TextDocumentItem(uri: String, text: String)
+  final case class TextDocumentPositionParams(textDocument: TextDocumentIdentifier, position: Position)
+  final case class MarkupContent(kind: String, value: String)
+
+  // -- Incoming (client -> server) request/notification params ------------
+
+  final case class InitializeParams(rootUri: String)
+  final case class DidOpenTextDocumentParams(textDocument: TextDocumentItem)
+  final case class TextDocumentContentChangeEvent(range: Option[Range], text: String)
+  final case class DidChangeTextDocumentParams(textDocument: TextDocumentIdentifier, contentChanges: List[TextDocumentContentChangeEvent])
+  final case class DidCloseTextDocumentParams(textDocument: TextDocumentIdentifier)
+  final case class ReferenceContext(includeDeclaration: Boolean)
+  final case class ReferenceParams(textDocument: TextDocumentIdentifier, position: Position, context: ReferenceContext)
+  final case class RenameParams(textDocument: TextDocumentIdentifier, position: Position, newName: String)
+  final case class DocumentSymbolParams(textDocument: TextDocumentIdentifier)
+  final case class WorkspaceSymbolParams(query: String)
+
+  // -- Outgoing (server -> client) result/notification payloads -----------
+
+  final case class CompletionOptions(triggerCharacters: List[String])
+  final case class SignatureHelpOptions(triggerCharacters: List[String])
+  final case class ServerCapabilities(
+    textDocumentSync: Int,
+    documentHighlightProvider: Boolean,
+    documentSymbolProvider: Boolean,
+    definitionProvider: Boolean,
+    renameProvider: Boolean,
+    hoverProvider: Boolean,
+    workspaceSymbolProvider: Boolean,
+    referencesProvider: Boolean,
+    implementationProvider: Boolean,
+    completionProvider: CompletionOptions,
+    signatureHelpProvider: SignatureHelpOptions)
+  final case class InitializeResult(capabilities: ServerCapabilities)
+
+  final case class CompletionItem(
+    label: String,
+    kind: Option[Int],
+    detail: Option[String],
+    documentation: Option[MarkupContent],
+    deprecated: Boolean,
+    sortText: Option[String] = None,
+    filterText: Option[String] = None,
+    insertText: Option[String] = None,
+    insertTextFormat: Option[Int] = None,
+    textEdit: Option[TextEdit] = None,
+    additionalTextEdits: List[TextEdit] = Nil
+  )
+  final case class CompletionList(isIncomplete: Boolean, items: List[CompletionItem])
+  final case class TextEdit(range: Range, newText: String)
+  final case class WorkspaceEdit(changes: Map[String, List[TextEdit]])
+  final case class DocumentHighlight(range: Range, kind: Int)
+  final case class Hover(contents: MarkupContent)
+  final case class SymbolInformation(name: String, kind: Int, location: Location, containerName: Option[String])
+  final case class ParameterInformation(label: String, documentation: Option[MarkupContent])
+  final case class SignatureInformation(label: String, documentation: Option[MarkupContent], parameters: List[ParameterInformation])
+  final case class SignatureHelp(signatures: List[SignatureInformation], activeParameter: Int, activeSignature: Int)
+  final case class Diagnostic(range: Range, message: String, severity: Int, source: String, code: String)
+  final case class PublishDiagnosticsParams(uri: String, diagnostics: List[Diagnostic])
+  /** `window/showMessage`'s `type`: 1 = Error, 2 = Warning, 3 = Info, 4 = Log. */
