+  }
+
+  final case class ErrorEnvelope(idRaw: Array[Byte], code: Int, message: String)
+  given errorEnvelopeCodec: JsonValueCodec[ErrorEnvelope] = new JsonValueCodec[ErrorEnvelope] {
+    def nullValue: ErrorEnvelope = null
+    def decodeValue(in: JsonReader, default: ErrorEnvelope): ErrorEnvelope = ???
+    def encodeValue(x: ErrorEnvelope, out: JsonWriter): Unit = {
+      out.writeObjectStart()
+      out.writeNonEscapedAsciiKey("jsonrpc"); out.writeVal("2.0")
+      out.writeNonEscapedAsciiKey("id"); out.writeRawVal(x.idRaw)
+      out.writeNonEscapedAsciiKey("error")
+      out.writeObjectStart()
+      out.writeNonEscapedAsciiKey("code"); out.writeVal(x.code)
+      out.writeNonEscapedAsciiKey("message"); out.writeVal(x.message)
