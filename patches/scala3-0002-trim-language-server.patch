+    }
+  }
+
+  final case class NotificationEnvelope(method: String, paramsRaw: Array[Byte])
+  given notificationEnvelopeCodec: JsonValueCodec[NotificationEnvelope] = new JsonValueCodec[NotificationEnvelope] {
+    def nullValue: NotificationEnvelope = null
+    def decodeValue(in: JsonReader, default: NotificationEnvelope): NotificationEnvelope = ???
+    def encodeValue(x: NotificationEnvelope, out: JsonWriter): Unit = {
+      out.writeObjectStart()
+      out.writeNonEscapedAsciiKey("jsonrpc"); out.writeVal("2.0")
+      out.writeNonEscapedAsciiKey("method"); out.writeVal(x.method)
+      out.writeNonEscapedAsciiKey("params"); out.writeRawVal(x.paramsRaw)
+      out.writeObjectEnd()
+    }
+  }
