new file mode 100644
index 000000000..ea048381c
--- /dev/null
+++ b/nativelib/src/main/resources/scala-native/gc/immix/GCWorkers.h
@@ -0,0 +1,46 @@
+#ifndef IMMIX_GCWORKERS_H
+#define IMMIX_GCWORKERS_H
+
+#include <stdbool.h>
+
+// Threads that help the collecting mutator with the stop-the-world phases
+// (marking, sweeping, evacuation). They are plain OS threads, not mutators:
+// they never run Scala code or allocate from the heap, so the synchronizer
+// does not know about them. Between collections they sleep on a condition
+// variable; a phase wakes the ones it uses and returns once all are done.
+//
+// Only multithreaded builds have the pool. Elsewhere, and with GC_NPROCS=1,
+// every phase runs on the collecting thread alone, as before.
+
+// task(worker, workers, arg): worker 0 is the collecting thread
+typedef void (*GCWorkers_Task)(int worker, int workers, void *arg);
+
+// Threads a phase may use, the collecting thread included: $GC_NPROCS, else
+// the processor count capped at GCWORKERS_DEFAULT_MAX. At least 1.
+int GCWorkers_MaxCount(void);
+
+// Makes sure `count` threads (the caller included) can run a phase and
+// returns how many can: fewer if the pool cannot grow.
+int GCWorkers_Prepare(int count);
+
+// Runs task on `count` threads (the caller as worker 0, after
+// GCWorkers_Prepare(count)) and returns when all of them finished.
+void GCWorkers_Run(int count, GCWorkers_Task task, void *arg);
+
+// Blocks a thread of the current phase that has nothing to do until ready(arg)
+// holds; ready is evaluated under the pool lock, with seq_cst loads of what
+// the wakers publish. Use after a short spin: idle threads that spin or
+// sched_yield take the CPU from the ones still working, which hurts most when
+// the machine has more runnable threads than cores.
+void GCWorkers_IdleWait(bool (*ready)(void *), void *arg);
+
+// Wakes one (or all) GCWorkers_IdleWait callers so they re-check ready(); a
+// single atomic load when nobody waits. Call after a seq_cst store of what
+// ready() reads.
+void GCWorkers_IdleWake(bool all);
+
+#define GCWORKERS_DEFAULT_MAX 8
+// Upper bound of $GC_NPROCS
+#define GCWORKERS_MAX_THREADS 256
+
+#endif // IMMIX_GCWORKERS_H
