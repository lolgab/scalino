+#include <stdbool.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+#ifdef SCALANATIVE_MULTITHREADING_ENABLED
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <string.h>
+#include <unistd.h>
+#endif
+
+static struct {
+    int maxCount; // 0 = not read yet
+    int started;  // pool threads created (worker ids 1..started)
+    // The current dispatch, read by the pool threads under the lock
+    GCWorkers_Task task;
+    void *arg;
+    int runCount;
+    uint64_t generation;
+    // Pool threads of the current dispatch that have not finished yet
+    atomic_int remaining;
+    // Threads blocked in GCWorkers_IdleWait
+    atomic_int idleWaiters;
+#ifdef _WIN32
+    SRWLOCK lock;
+    CONDITION_VARIABLE wake;
+    CONDITION_VARIABLE done;
+    CONDITION_VARIABLE idle;
+#else
+    pthread_mutex_t lock;
+    pthread_cond_t wake;
+    pthread_cond_t done;
+    pthread_cond_t idle;
+#endif
+} pool;
+
+// The generation each pool thread starts from, written before its creation
+static uint64_t poolStartGeneration[GCWORKERS_MAX_THREADS + 1];
+
+static inline void pool_lock(void) {
+#ifdef _WIN32
+    AcquireSRWLockExclusive(&pool.lock);
+#else
+    pthread_mutex_lock(&pool.lock);
+#endif
+}
+static inline void pool_unlock(void) {
+#ifdef _WIN32
+    ReleaseSRWLockExclusive(&pool.lock);
+#else
+    pthread_mutex_unlock(&pool.lock);
+#endif
+}
+static inline void pool_waitWake(void) {
+#ifdef _WIN32
+    SleepConditionVariableSRW(&pool.wake, &pool.lock, INFINITE, 0);
+#else
+    pthread_cond_wait(&pool.wake, &pool.lock);
+#endif
+}
+static inline void pool_waitDone(void) {
+#ifdef _WIN32
+    SleepConditionVariableSRW(&pool.done, &pool.lock, INFINITE, 0);
+#else
+    pthread_cond_wait(&pool.done, &pool.lock);
+#endif
+}
+static inline void pool_waitIdle(void) {
+#ifdef _WIN32
+    SleepConditionVariableSRW(&pool.idle, &pool.lock, INFINITE, 0);
+#else
+    pthread_cond_wait(&pool.idle, &pool.lock);
+#endif
+}
+static inline void pool_wakeIdle(bool all) {
+#ifdef _WIN32
+    if (all)
+        WakeAllConditionVariable(&pool.idle);
+    else
+        WakeConditionVariable(&pool.idle);
+#else
+    if (all)
+        pthread_cond_broadcast(&pool.idle);
+    else
+        pthread_cond_signal(&pool.idle);
+#endif
+}
+static inline void pool_broadcastWake(void) {
+#ifdef _WIN32
+    WakeAllConditionVariable(&pool.wake);
+#else
+    pthread_cond_broadcast(&pool.wake);
+#endif
+}
+static inline void pool_signalDone(void) {
+#ifdef _WIN32
+    WakeConditionVariable(&pool.done);
+#else
+    pthread_cond_signal(&pool.done);
+#endif
+}
+
+static void pool_initSync(void) {
+#ifdef _WIN32
+    InitializeSRWLock(&pool.lock);
+    InitializeConditionVariable(&pool.wake);
+    InitializeConditionVariable(&pool.done);
+    InitializeConditionVariable(&pool.idle);
+#else
+    pthread_mutex_init(&pool.lock, NULL);
+    pthread_cond_init(&pool.wake, NULL);
+    pthread_cond_init(&pool.done, NULL);
+    pthread_cond_init(&pool.idle, NULL);
+#endif
+}
+
+static int GCWorkers_processorCount(void) {
+#ifdef _WIN32
+    SYSTEM_INFO sysInfo;
+    GetSystemInfo(&sysInfo);
+    return (int)sysInfo.dwNumberOfProcessors;
+#else
+    long n = sysconf(_SC_NPROCESSORS_ONLN);
+    return n > 0 ? (int)n : 1;
+#endif
+}
+
+int GCWorkers_MaxCount(void) {
+    if (pool.maxCount == 0) {
+        int processors = GCWorkers_processorCount();
+        int count = processors < GCWORKERS_DEFAULT_MAX ? processors
+                                                       : GCWORKERS_DEFAULT_MAX;
+        const char *env = getenv("GC_NPROCS");
+        if (env != NULL) {
+            long parsed = strtol(env, NULL, 10);
+            if (parsed >= 1 && parsed <= GCWORKERS_MAX_THREADS)
+                count = (int)parsed;
+            else
+                GC_LOG_WARN("Ignoring GC_NPROCS=%s, using %d GC threads", env,
+                            count);
+        }
+        if (count < 1)
+            count = 1;
+        pool.maxCount = count;
+        GC_LOG_INFO("Using %d GC threads (GC_NPROCS)", count);
+    }
+    return pool.maxCount;
+}
+
+static void *GCWorkers_loop(void *arg) {
+    int id = (int)(intptr_t)arg;
+#ifndef _WIN32
+    // Signals (SIGINT/SIGTERM handlers run Scala code; the GC's own wakeup
+    // signal is for mutators) must never land on a GC thread. Synchronous
+    // faults stay deliverable so a crash still reports.
+    sigset_t blocked;
+    sigfillset(&blocked);
+    sigdelset(&blocked, SIGSEGV);
+    sigdelset(&blocked, SIGBUS);
+    sigdelset(&blocked, SIGILL);
+    sigdelset(&blocked, SIGFPE);
+    sigdelset(&blocked, SIGTRAP);
+    sigdelset(&blocked, SIGABRT);
+    pthread_sigmask(SIG_BLOCK, &blocked, NULL);
+#if defined(__APPLE__)
+    char name[32];
+    snprintf(name, sizeof(name), "GC worker %d", id);
+    pthread_setname_np(name);
+#elif defined(__linux__)
+    char name[16];
+    snprintf(name, sizeof(name), "GC worker %d", id);
+    pthread_setname_np(pthread_self(), name);
+#endif
+#endif
+    // The generation when the leader created this thread, between runs: that
+    // dispatch is complete (after fork the child's pool still holds the
+    // parent's last one) and the next is not. Reading pool.generation here
+    // instead would race with a dispatch made before this thread first runs.
+    uint64_t seen = poolStartGeneration[id];
+    for (;;) {
+        pool_lock();
+        while (pool.generation == seen)
+            pool_waitWake();
+        seen = pool.generation;
+        GCWorkers_Task task = pool.task;
+        void *taskArg = pool.arg;
+        int count = pool.runCount;
+        pool_unlock();
+        if (id < count) {
+            task(id, count, taskArg);
+            if (atomic_fetch_sub_explicit(&pool.remaining, 1,
+                                          memory_order_acq_rel) == 1) {
+                // Under the lock, so the leader cannot miss it between its
+                // check and its wait.
+                pool_lock();
+                pool_signalDone();
+                pool_unlock();
+            }
+        }
+    }
+    return NULL;
+}
+
+#ifndef _WIN32
+static void GCWorkers_afterForkChild(void) {
+    // The pool threads do not exist in the child: recreate on demand, with no
+    // dispatch pending.
+    pool.started = 0;
+    pool.task = NULL;
+    pool.arg = NULL;
+    pool.runCount = 0;
+    atomic_store_explicit(&pool.remaining, 0, memory_order_relaxed);
+    atomic_store_explicit(&pool.idleWaiters, 0, memory_order_relaxed);
+    pool_initSync();
+}
+#endif
+
+// Makes sure `wanted` pool threads exist; returns how many do.
+static int GCWorkers_ensureStarted(int wanted) {
+    static bool initialized = false;
+    if (!initialized) {
+        pool_initSync();
+        atomic_init(&pool.remaining, 0);
+        atomic_init(&pool.idleWaiters, 0);
+#ifndef _WIN32
+        pthread_atfork(NULL, NULL, GCWorkers_afterForkChild);
+#endif
+        initialized = true;
+    }
+    while (pool.started < wanted) {
+        int id = pool.started + 1;
+        // Written before the thread exists, so it sees the value
+        poolStartGeneration[id] = pool.generation;
+        thread_t handle;
+        if (!thread_create(&handle, GCWorkers_loop, (void *)(intptr_t)id)) {
+            GC_LOG_WARN("Could not create GC thread %d, using %d GC threads",
+                        id, pool.started + 1);
+            // Do not retry on every collection
+            pool.maxCount = pool.started + 1;
+            break;
+        }
+#ifdef _WIN32
+        CloseHandle(handle);
+#else
+        pthread_detach(handle);
+#endif
+        pool.started = id;
+    }
+    return pool.started;
+}
+
+int GCWorkers_Prepare(int count) {
+    if (count > GCWorkers_MaxCount())
+        count = GCWorkers_MaxCount();
+    if (count > 1) {
+        int available = GCWorkers_ensureStarted(count - 1) + 1;
+        if (count > available)
+            count = available;
+    }
+    return count < 1 ? 1 : count;
+}
+
+void GCWorkers_Run(int count, GCWorkers_Task task, void *arg) {
+    assert(count <= pool.started + 1);
+    if (count <= 1) {
+        task(0, 1, arg);
+        return;
+    }
+    pool_lock();
+    pool.task = task;
+    pool.arg = arg;
+    pool.runCount = count;
+    atomic_store_explicit(&pool.remaining, count - 1, memory_order_release);
+    pool.generation++;
+    pool_broadcastWake();
+    pool_unlock();
+
+    task(0, count, arg);
+
+    // The helpers usually finish within microseconds of the leader; a short
+    // spin avoids the condition variable's wakeup latency in that case.
+    for (int i = 0; i < 2000 && atomic_load_explicit(&pool.remaining,
+                                                     memory_order_acquire) > 0;
+         i++)
+        thread_yield();
+    pool_lock();
+    while (atomic_load_explicit(&pool.remaining, memory_order_acquire) > 0)
+        pool_waitDone();
+    pool_unlock();
+}
+
+void GCWorkers_IdleWait(bool (*ready)(void *), void *arg) {
+    pool_lock();
+    // seq_cst, paired with GCWorkers_IdleWake: either the waker sees this
+    // waiter, or ready() below sees what the waker published.
+    atomic_fetch_add_explicit(&pool.idleWaiters, 1, memory_order_seq_cst);
+    while (!ready(arg))
+        pool_waitIdle();
+    atomic_fetch_sub_explicit(&pool.idleWaiters, 1, memory_order_relaxed);
+    pool_unlock();
+}
+
+void GCWorkers_IdleWake(bool all) {
+    if (atomic_load_explicit(&pool.idleWaiters, memory_order_seq_cst) == 0)
+        return;
+    pool_lock();
+    pool_wakeIdle(all);
+    pool_unlock();
+}
+
+#else // !SCALANATIVE_MULTITHREADING_ENABLED
+
+int GCWorkers_MaxCount(void) { return 1; }
+
+int GCWorkers_Prepare(int count) {
+    (void)count;
+    return 1;
+}
+
+void GCWorkers_Run(int count, GCWorkers_Task task, void *arg) {
+    (void)count;
+    task(0, 1, arg);
+}
+
+void GCWorkers_IdleWait(bool (*ready)(void *), void *arg) {
+    // One thread: nobody else can make ready() true
+    (void)ready;
+    (void)arg;
+}
+
+void GCWorkers_IdleWake(bool all) { (void)all; }
+
+#endif // SCALANATIVE_MULTITHREADING_ENABLED
+
+#endif // SCALANATIVE_GC_IMMIX
