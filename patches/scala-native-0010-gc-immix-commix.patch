+    graphDumpTotalObjects++;
+    graphDumpTotalBytes += size;
+    int isArray = Object_IsArray(object) ? 1 : 0;
+    char name[HISTOGRAM_NAME_MAX];
+    name[0] = 0;
+    wchar_t *wname = Object_nameWString(object);
+    if (wname != NULL) {
+        size_t i = 0;
+        for (; i < HISTOGRAM_NAME_MAX - 1 && wname[i] != 0; i++) {
+            wint_t c = (wint_t)wname[i];
+            name[i] = (c >= 32 && c < 127) ? (char)c : '?';
+        }
+        name[i] = 0;
+        free(wname);
+    }
+    fprintf(graphDumpFile, "O,%p,%llu,%d,%s\n", (void *)object,
+            (unsigned long long)size, isArray, name);
+}
+
+// Called from the single choke point (Marker_markObject) every time a
+// live object is discovered, whether newly marked or already marked --
+// duplicate edges are harmless (the offline dominator computation is
+// unaffected by repeated/multi-edges) and cheaper to allow than to filter
+// here.
+static inline void GraphDump_recordDiscovery(Object *object) {
+    if (graphDumpFile == NULL)
+        return;
+    if (graphDumpCurrentParent == NULL) {
+        fprintf(graphDumpFile, "R,%p\n", (void *)object);
+    } else {
+        fprintf(graphDumpFile, "E,%p,%p\n", (void *)graphDumpCurrentParent,
+                (void *)object);
+    }
+}
+
+// Conservative-scan counterpart of GraphDump's field-edge widening below:
+// `Object_GetUnmarkedObject` (Object.c) deliberately returns NULL once an
+// object is already marked (om_marked, not om_allocated -- see
+// ObjectMeta.h) because the real marker has nothing left to do with it.
+// That's correct for marking but wrong for the graph dump: a second
+// conservative root pointing at an already-marked object is still a real
+// edge (or a real second root) that must be recorded. This is a
+// deliberately trimmed copy of that function's address resolution with
+// the "already marked -> NULL" early-out removed; unlike the original it
+// does NOT fall back to `Object_getInnerPointer` for a mid-object
+// conservative hit (that helper is private to Object.c) -- an accepted
+// gap for a debug visualizer: a conservative pointer into the middle of
+// an object (not its header) is rare and simply won't be recorded here.
+static inline Object *GraphDump_resolveConservative(Heap *heap,
+                                                     word_t *word) {
+    BlockMeta *blockMeta =
+        Block_GetBlockMeta(heap->blockMetaStart, heap->heapStart, word);
+    word_t *aligned = BlockMeta_ContainsLargeObjects(blockMeta)
+                          ? (word_t *)((word_t)word & LARGE_BLOCK_MASK)
+                          : (word_t *)((word_t)word &
+                                       ALLOCATION_ALIGNMENT_INVERSE_MASK);
+    ObjectMeta *wordMeta = Bytemap_Get(heap->bytemap, aligned);
+    if (ObjectMeta_IsAllocated(wordMeta) || ObjectMeta_IsMarked(wordMeta))
+        return (Object *)aligned;
+    return NULL;
+}
+
+static void GraphDump_end(void) {
+    if (graphDumpFile == NULL)
+        return;
+    fprintf(graphDumpFile,
+            "--- end cycle=%llu total_objects=%llu total_bytes=%llu ---\n",
+            (unsigned long long)graphDumpCycle,
+            (unsigned long long)graphDumpTotalObjects,
+            (unsigned long long)graphDumpTotalBytes);
+    fclose(graphDumpFile);
+    graphDumpFile = NULL;
+    graphDumpCycle++;
+}
+/* ---------------------------------------------------------------------- */
+
+/* ---- Debug-only evacuation-candidate scoring (stage 1: measurement only,
+ * NO objects are moved by this code -- it only tallies real live bytes per
+ * block during marking and logs how many blocks are sparsely-occupied
+ * ("unavailable" to the line-granularity sweep in Block_Recycle -- every
+ * line in the block has at least one survivor -- but with real live-byte
+ * occupancy far below capacity), and how many bytes evacuating those blocks
+ * *would* reclaim. This validates whether real evacuation is worth building
+ * (stage 2) before writing any code that actually moves objects and rewrites
+ * pointers, which is a correctness-critical change this project is treating
+ * with real caution -- see the investigation in project memory /
+ * docs/findings.md before extending this into a real evacuating collector.
+ * Gated behind $SCALANATIVE_EVAC_LOG_FILE, zero-cost (one getenv check,
+ * cached) when unset. */
+static int evacLogEnabledChecked = 0;
+static const char *evacLogFilePath = NULL;
+static uint32_t *blockLiveBytes = NULL;
+static uint32_t blockLiveBytesCapacity = 0;
+// Set once per cycle by Marker_Mark (whether logging OR real evacuation is
+// on), read from Marker_markConservative -- see the pinning section below.
+static int g_evacTrackingOn = 0;
+// Per-block "at least one object in this block was reached only via a
+// conservative scan this cycle" flag. See the pinning explanation in the
+// Stage 2 section below (search "PINNING") for why this exists -- it's the
+// fix for a real, reproduced memory-corruption bug, not speculative
+// hardening.
+static uint8_t *blockPinned = NULL;
+static uint32_t blockPinnedCapacity = 0;
+
+static void EvacPin_ensureCapacity(uint32_t blockCount) {
+    if (blockCount > blockPinnedCapacity) {
+        blockPinned = (uint8_t *)realloc(blockPinned, (size_t)blockCount);
+        blockPinnedCapacity = blockCount;
+    }
+}
+
+static void EvacPin_reset(uint32_t blockCount) {
+    EvacPin_ensureCapacity(blockCount);
+    memset(blockPinned, 0, (size_t)blockCount);
+}
+
+static inline void EvacPin_record(Heap *heap, Object *object) {
+    uint32_t blockIndex =
+        Block_GetBlockIndexForWord(heap->heapStart, (word_t *)object);
+    if (blockIndex < blockPinnedCapacity) {
+        blockPinned[blockIndex] = 1;
+    }
+}
+
+static inline bool EvacPin_isBlockPinned(uint32_t blockIndex) {
+    return blockIndex < blockPinnedCapacity && blockPinned[blockIndex] != 0;
+}
+
+// One byte per block, filled by Marker_Evacuate's scoring pass: 1 = evacuation
+// source block. Only an object inside such a block can ever be forwarded, so
+// the fixup passes test this (a table that fits in cache) before touching the
+// bytemap or the target object, which for a multi-GB heap are cache misses on
+// nearly every slot -- that made the fixup walk as slow as marking, even for
+// a cycle that moved a handful of blocks.
+static uint8_t *evacCandidateBlocks = NULL;
+static uint32_t evacCandidateBlocksCapacity = 0;
+static uint32_t evacCandidateBlocksCount = 0;
+
+static inline bool Evac_PointsIntoCandidateBlock(Heap *heap, word_t *value) {
+    uint32_t blockIndex = Block_GetBlockIndexForWord(heap->heapStart, value);
+    return blockIndex < evacCandidateBlocksCount &&
+           evacCandidateBlocks[blockIndex] != 0;
+}
+
+static inline int EvacLog_enabled(void) {
+    if (!evacLogEnabledChecked) {
+        evacLogFilePath = getenv("SCALANATIVE_EVAC_LOG_FILE");
+        evacLogEnabledChecked = 1;
+    }
+    return evacLogFilePath != NULL;
+}
+
+static void EvacLog_ensureCapacity(uint32_t blockCount) {
+    if (blockCount > blockLiveBytesCapacity) {
+        size_t bytes = (size_t)blockCount * sizeof(uint32_t);
+        blockLiveBytes = (uint32_t *)realloc(blockLiveBytes, bytes);
+        blockLiveBytesCapacity = blockCount;
+    }
+}
+
+static void EvacLog_reset(uint32_t blockCount) {
+    EvacLog_ensureCapacity(blockCount);
+    memset(blockLiveBytes, 0, (size_t)blockCount * sizeof(uint32_t));
+}
+
+static inline void EvacLog_recordLiveObject(Heap *heap, Object *object) {
+    uint32_t blockIndex =
+        Block_GetBlockIndexForWord(heap->heapStart, (word_t *)object);
+    size_t size = Object_Size(object);
+    if (blockIndex < blockLiveBytesCapacity) {
+        blockLiveBytes[blockIndex] += (uint32_t)size;
+    }
+    if (!Evac_CanForward(size)) {
+        EvacPin_record(heap, object);
+    }
+}
+
+static void EvacLog_dump(Heap *heap, uint64_t cycle) {
+    if (!EvacLog_enabled())
+        return;
+    FILE *f = fopen(evacLogFilePath, "a");
+    if (f == NULL)
+        return;
+    uint32_t blockCount = heap->blockCount;
+    uint32_t candidateBlocks = 0;
+    uint64_t candidateReclaimableBytes = 0;
+    uint64_t candidateLiveBytes = 0;
+    // Blocks under this real live-byte occupancy fraction are candidates --
+    // matches the classic Immix opportunistic-defrag threshold range.
+    const double kOccupancyThreshold = 0.35;
+    uint32_t limit = blockCount < blockLiveBytesCapacity ? blockCount
+                                                         : blockLiveBytesCapacity;
+    for (uint32_t i = 0; i < limit; i++) {
+        BlockMeta *meta =
+            BlockMeta_GetFromIndex(heap->blockMetaStart, i);
+        // Skip fully-free blocks (nothing to reclaim), large-object
+        // superblocks (out of scope here), and pinned blocks (contain an
+        // object reachable only via a conservative scan -- see PINNING in
+        // the Stage 2 section; real evacuation skips these too, so this
+        // logging matches what evacuation would actually do).
+        if (BlockMeta_IsFree(meta) || BlockMeta_ContainsLargeObjects(meta) ||
+            EvacPin_isBlockPinned(i))
+            continue;
+        uint32_t liveBytes = blockLiveBytes[i];
+        if (liveBytes > 0 &&
+            liveBytes < (uint32_t)(BLOCK_TOTAL_SIZE * kOccupancyThreshold)) {
+            candidateBlocks++;
+            candidateLiveBytes += liveBytes;
+            candidateReclaimableBytes += (BLOCK_TOTAL_SIZE - liveBytes);
+        }
+    }
+    fprintf(f,
+            "cycle=%llu blockCount=%u candidateBlocks=%u "
+            "candidateLiveBytes=%llu candidateReclaimableBytes=%llu\n",
+            (unsigned long long)cycle, blockCount, candidateBlocks,
+            (unsigned long long)candidateLiveBytes,
+            (unsigned long long)candidateReclaimableBytes);
+    fclose(f);
+}
+/* ---------------------------------------------------------------------- */
+
 #define LAST_FIELD_OFFSET -1
 
+/* ---- Stage 2: real opportunistic evacuation (MOVES OBJECTS) --------------
+ * Not part of upstream scala-native. This is a correctness-critical change
+ * -- see project memory / docs/findings.md for the full investigation and
+ * staging rationale before touching this. Strictly opt-in via
+ * $SCALANATIVE_EVAC_ENABLE (unset = zero behavior change, same as every
+ * other flag in this file). Validated first via the measurement-only
+ * candidate scoring above (stage 1): on the real workload this exists for,
+ * 95%+ of committed blocks were evacuation candidates holding <35% real
+ * live-byte occupancy, so real evacuation was judged worth the risk.
+ *
+ * KNOWN, DELIBERATELY UNADDRESSED GAP: `java.lang.System.identityHashCode`
+ * is the raw object address (javalib System.scala), and `IdentityHashMap`
+ * buckets keys by it. Moving an object after it's been used as a key
+ * silently produces wrong lookups (not a crash). Not fixed here -- would
+ * need a stable hash assigned independent of address, real separate work.
+ * Do not enable this for any workload that populates an IdentityHashMap (or
+ * relies on identityHashCode) over long-lived GC objects before a
+ * collection can run.
+ *
+ * KNOWN, DELIBERATELY UNADDRESSED EDGE CASE: the conservative "boxed
+ * pointer" scan (`__boxed_ptr_id`, `Marker_markConservative`) is not
+ * fixed up by the rewrite pass below. A raw native pointer that happens to
+ * alias a forwarded object's old address will not be corrected. This is an
+ * FFI/native-interop path, not expected to matter for this project's own
+ * compiler/linker workload, but is a real gap if this were ever used more
+ * broadly.
+ *
+ * Sequencing (see Heap_Collect in Heap.c): Marker_MarkRoots -> mark phase
+ * (incl. the live-byte tally above) -> WeakReferences_Nullify -> *this* ->
+ * Heap_Recycle. Running after WeakReferences_Nullify means weak-reference
+ * fields are already resolved to either null or a real surviving referent
+ * by the time this runs, so they're just another field to fix up, not a
+ * liveness decision -- unlike normal marking, the rewrite pass below does
+ * NOT skip the weak-referent field (Object_IsReferantOfWeakReference),
+ * since skipping it here would leave it silently pointing at stale memory.
+ */
+#ifdef SCALANATIVE_COMPACT_HEADERS
+// Reserved class id, never a valid index in __rtti_table
+#define EVAC_FORWARDED_ID HEADER_FORWARDED_ID
+#else
+static Rtti EvacForwardedRtti; // sentinel; address compared, never dereferenced
+#endif
+
+static inline bool Evac_IsForwarded(Object *object) {
+#ifdef SCALANATIVE_COMPACT_HEADERS
+    return (*(uint32_t *)object & HEADER_CLASS_ID_MASK) == EVAC_FORWARDED_ID;
+#else
+    return object->rtti == &EvacForwardedRtti;
+#endif
+}
+
+static inline word_t *Evac_ForwardedAddress(Object *object) {
+    return *(word_t **)((uint8_t *)object + EVAC_FORWARD_OFFSET);
+}
+
+static inline void Evac_SetForwarded(Object *object, word_t *newAddr) {
+#ifdef SCALANATIVE_COMPACT_HEADERS
+    *(uint32_t *)object = EVAC_FORWARDED_ID;
+#else
+    object->rtti = &EvacForwardedRtti;
+#endif
+    *(word_t **)((uint8_t *)object + EVAC_FORWARD_OFFSET) = newAddr;
+}
+
+static int evacEnabledChecked = 0;
+static int evacEnabledValue = 0;
+
+static inline int Evac_enabled(void) {
+    if (!evacEnabledChecked) {
+        // Unset keeps the embedder default (scalanative_gc_set_evac_default);
+        // "0" disables, anything else enables.
+        const char *env = getenv("SCALANATIVE_EVAC_ENABLE");
+        if (env != NULL)
+            evacEnabledValue = env[0] != '0';
+        evacEnabledChecked = 1;
+    }
+    return evacEnabledValue;
+}
+
+// Lets an embedder (scalino-lsp) opt in programmatically, without requiring
+// the user to export $SCALANATIVE_EVAC_ENABLE. An explicit
+// $SCALANATIVE_EVAC_ENABLE (1 or 0) always wins over this default. Overrides
+// the cached result, so it works even if a collection already ran.
+void scalanative_gc_set_evac_default(int enabled) {
+    const char *env = getenv("SCALANATIVE_EVAC_ENABLE");
+    if (env != NULL)
+        return; // explicit user setting always wins
+    evacEnabledValue = enabled != 0;
+    evacEnabledChecked = 1;
+}
+
+int Marker_EvacEnabled(void) { return Evac_enabled(); }
+
+// Real live bytes from this cycle's mark tally, or 0 if the tally wasn't
+// collected (evacuation off) -- callers treat 0 as "unknown".
+//
+// The tally is sized when marking starts, but evacuation can grow the heap
+// mid-cycle for its destination blocks, so heap->blockCount may exceed the
+// tally's capacity by the time Heap_shouldGrow asks. Returning 0 ("unknown")
+// then made every evacuating cycle fall back to the free-block-only growth
+// policy, which grew the heap by ~10% per cycle (to the maximum) although
+// live data stayed a few percent of it. Blocks past the capacity were added
+// after marking, so they have no tally entries: sum what was tallied.
+uint64_t Marker_LiveBytes(Heap *heap) {
+    if (!Evac_enabled() || blockLiveBytes == NULL)
+        return 0;
+    uint32_t limit = heap->blockCount < blockLiveBytesCapacity
+                         ? heap->blockCount
+                         : blockLiveBytesCapacity;
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < limit; i++)
+        total += blockLiveBytes[i];
+    return total;
+}
+
+// Blocks under this real live-byte occupancy fraction are evacuated.
+// Matches the threshold already validated via the stage-1 candidate log.
+// Default 70%: self-hosted dotc link measured 971s vs 1092s at 35%, same peak
+// footprint. $SCALANATIVE_EVAC_THRESHOLD (percent, 1-95) overrides it; read
+// once so every phase of a cycle (copy, fixup) agrees on the candidate set.
+static inline double Evac_OccupancyThreshold(void) {
+    static double threshold = -1.0;
+    if (threshold < 0) {
+        threshold = 0.70;
+        const char *env = getenv("SCALANATIVE_EVAC_THRESHOLD");
+        if (env != NULL) {
+            int pct = atoi(env);
+            if (pct >= 1 && pct <= 95)
+                threshold = pct / 100.0;
+        }
+    }
+    return threshold;
+}
+
+static inline bool Evac_IsCandidateBlock(BlockMeta *meta, uint32_t liveBytes,
+                                         uint32_t blockIndex) {
+    // PINNING: a block containing any object reached only via a
+    // conservative scan is never a candidate, regardless of occupancy --
+    // see the comment in Marker_markConservative for why. blockPinned is
+    // populated (or left all-zero, if EvacPin_reset was never called
+    // because tracking was off) before this is ever consulted.
+    return !BlockMeta_IsFree(meta) && !BlockMeta_ContainsLargeObjects(meta) &&
+           !EvacPin_isBlockPinned(blockIndex) &&
+           !(heap.hashedBlocks != NULL && heap.hashedBlocks[blockIndex]) &&
+           liveBytes > 0 &&
+           liveBytes < (uint32_t)(BLOCK_TOTAL_SIZE * Evac_OccupancyThreshold());
+}
+
+// Debug-only targeted tracing for evacuation fixup, gated by two env vars
+// (zero-cost when unset, checked once, same style as every other debug
+// hook in this file): $SCALANATIVE_EVAC_TRACE_FILE (append-only log path)
+// and $SCALANATIVE_EVAC_TRACE_VALUE (hex address of a SPECIFIC stale
+// pointer VALUE to watch for -- not an object to watch being visited, a
+// VALUE to watch for appearing in any slot anywhere: object fields, array
+// elements, stack/root slots). Logs every slot Evac_FixupSlot inspects
+// whose current value matches, whether or not it turns out to be
+// forwarded -- lets you directly observe whether a specific known-stale
+// pointer's slot is ever inspected at all by any fixup pass, instead of
+// only ever seeing the crash site after the fact.
+static int evacTraceEnabledChecked = 0;
+static const char *evacTraceFilePath = NULL;
+static word_t *evacTraceValue = NULL;
+
+static inline bool EvacTrace_enabled(void) {
+    if (!evacTraceEnabledChecked) {
+        evacTraceFilePath = getenv("SCALANATIVE_EVAC_TRACE_FILE");
+        const char *valueStr = getenv("SCALANATIVE_EVAC_TRACE_VALUE");
+        // $SCALANATIVE_EVAC_TRACE_OFFSET (hex, bytes from the heap start)
+        // instead of an absolute address: the heap base moves between runs
+        // (ASLR), but everything else about a single-threaded repro is
+        // deterministic, so an offset seen in one crash can be traced in the
+        // next run.
+        const char *offsetStr = getenv("SCALANATIVE_EVAC_TRACE_OFFSET");
+        if (evacTraceFilePath != NULL && offsetStr != NULL) {
+            evacTraceValue =
+                (word_t *)((uint8_t *)heap.heapStart +
+                           strtoull(offsetStr, NULL, 16));
+        } else if (evacTraceFilePath != NULL && valueStr != NULL) {
+            evacTraceValue = (word_t *)strtoull(valueStr, NULL, 16);
+        } else {
+            evacTraceFilePath = NULL;
+        }
+        evacTraceEnabledChecked = 1;
+    }
+    return evacTraceFilePath != NULL;
+}
+
+static void EvacTrace_log(const char *tag, word_t **slot, word_t *value) {
+    if (!EvacTrace_enabled() || value != evacTraceValue)
+        return;
+    FILE *f = fopen(evacTraceFilePath, "a");
+    if (f == NULL)
+        return;
+    fprintf(f, "%s slot=%p value=%p\n", tag, (void *)slot, (void *)value);
+    fclose(f);
+}
+
+// One field slot, wherever it came from (object field, array element, root):
+// if it currently holds the OLD address of an object we just evacuated,
+// rewrite it to that object's new address. Leaves every other value (null,
+// non-heap pointer, pointer to a non-forwarded live object) untouched.
+static inline void Evac_FixupSlot(Heap *heap, word_t **slot) {
+    word_t *value = *slot;
+    if (EvacTrace_enabled())
+        EvacTrace_log("FixupSlot-seen", slot, value);
+    if (value != NULL && Heap_IsWordInHeap(heap, value) &&
+        Evac_PointsIntoCandidateBlock(heap, value) &&
+        Bytemap_isPtrAligned(value)) {
+        ObjectMeta *meta = Bytemap_Get(heap->bytemap, value);
+        // Forwarded objects are marked (they were live, real objects before
+        // being evacuated) -- IsAllocated/IsMarked both fine, just needs to
+        // not be free/placeholder before it's safe to read ->rtti.
+        if (!ObjectMeta_IsFree(meta) && !ObjectMeta_IsPlaceholder(meta)) {
+            Object *object = (Object *)value;
+            if (Evac_IsForwarded(object)) {
+                word_t *newAddr = Evac_ForwardedAddress(object);
+                *slot = newAddr;
+                if (EvacTrace_enabled())
+                    EvacTrace_log("FixupSlot-rewrote", slot, newAddr);
+            }
+        } else if (EvacTrace_enabled() && value == evacTraceValue) {
+            FILE *f = fopen(evacTraceFilePath, "a");
+            if (f != NULL) {
+                fprintf(f,
+                        "FixupSlot-rejected-by-bytemap slot=%p value=%p "
+                        "free=%d placeholder=%d\n",
+                        (void *)slot, (void *)value, ObjectMeta_IsFree(meta),
+                        ObjectMeta_IsPlaceholder(meta));
+                fclose(f);
+            }
+        }
+    }
+}
+
+// An inflated lock word is a tagged pointer (low bit set, see
+// Field_isInflatedLock/Field_allignedLockRef in ObjectHeader.h), not a plain
+// pointer slot -- Evac_FixupSlot can't be reused directly on it. Handled
+// entirely separately from Evac_FixupHeapObjects' refFieldOffsets walk below
+// because it isn't one of an object's typed fields at all: every object
+// (and every Rtti) carries its own lockWord header slot unconditionally
+// under USES_LOCKWORD, invisible to refFieldOffsets, and the real pointer
+// inside it (when inflated) is exactly as real a reference to a live heap
+// object (a Monitor) as any typed field -- just as subject to being moved
+// by evacuation, and just as silently left stale if nothing rewrites it.
+// Missing this was a real, reproduced bug: a contended `synchronized`
+// (e.g. PrintStream.println's monitor, inflated once threads actually
+// contend on it) crashed on the next enterMonitor after the Monitor object
+// it pointed at got evacuated out from under it.
+#ifdef USES_LOCKWORD
+static inline void Evac_FixupLockWord(Heap *heap, word_t **lockWordSlot) {
+    word_t *value = *lockWordSlot;
+    if (!Field_isInflatedLock((Field_t)value))
+        return;
+    word_t *monitor = (word_t *)Field_allignedLockRef((Field_t)value);
+    if (monitor == NULL || !Heap_IsWordInHeap(heap, monitor) ||
+        !Evac_PointsIntoCandidateBlock(heap, monitor) ||
+        !Bytemap_isPtrAligned(monitor))
+        return;
+    ObjectMeta *meta = Bytemap_Get(heap->bytemap, monitor);
+    if (ObjectMeta_IsFree(meta) || ObjectMeta_IsPlaceholder(meta))
+        return;
+    Object *object = (Object *)monitor;
+    if (Evac_IsForwarded(object)) {
+        word_t *newMonitor = Evac_ForwardedAddress(object);
+        *lockWordSlot =
+            (word_t *)((word_t)newMonitor | MONITOR_INFLATION_MARK_MASK);
+    }
+}
+#endif
+
+static void Evac_FixupRange(Heap *heap, word_t **from, word_t **to,
+                            size_t stride) {
+    if (from > to) {
+        word_t **tmp = from;
+        from = to;
+        to = tmp;
+    }
+    const intptr_t alignmentMask = ~(sizeof(word_t) - 1);
+    ubyte_t *alignedFrom = (ubyte_t *)((intptr_t)from & alignmentMask);
+    ubyte_t *alignedTo = (ubyte_t *)((intptr_t)to & alignmentMask);
+    for (ubyte_t *current = alignedFrom; current < alignedTo;
+         current += stride) {
+        Evac_FixupSlot(heap, (word_t **)current);
+    }
+}
+
+static void Evac_FixupProgramStack(MutatorThread *thread, Heap *heap) {
+    word_t **stackBottom = MutatorThread_getStackBottom(thread);
+    word_t **stackTop = NULL;
+    do {
+        stackTop = MutatorThread_getStackTop(thread, false);
+    } while (stackTop == NULL);
+    if (EvacTrace_enabled()) {
+        FILE *f = fopen(evacTraceFilePath, "a");
+        if (f != NULL) {
+            fprintf(f, "EVAC-range thread=%p stackTop=%p stackBottom=%p\n",
+                    (void *)thread, (void *)stackTop, (void *)stackBottom);
+            fclose(f);
+        }
+    }
+#ifdef SCALANATIVE_THREAD_ALT_STACK
+    if (thread->threadInfo != NULL &&
+        !isInRange(stackTop, thread->threadInfo->stackTop,
+                   thread->threadInfo->stackBottom)) {
+        void *stackScanLimit = threadStackScanableLimit(thread->threadInfo);
+        stackTop = (stackScanLimit != NULL)
+                       ? (word_t **)stackScanLimit
+                       : stackBottom - 64 * 1024;
+        if (thread->threadInfo->signalHandlerStack != NULL) {
+            word_t **signalHandlerStack =
+                (word_t **)thread->threadInfo->signalHandlerStack;
+            Evac_FixupRange(
+                heap, signalHandlerStack,
+                (word_t **)((char *)signalHandlerStack +
+                            thread->threadInfo->signalHandlerStackSize),
+                sizeof(word_t));
+        }
+    }
+#endif
+    Evac_FixupRange(heap, stackTop, stackBottom, sizeof(word_t));
+    size_t registerBufferStride =
+#if defined(CAPTURE_SETJMP)
+        sizeof(uint32_t);
+#else
+        sizeof(word_t);
+#endif
+    Evac_FixupRange(heap, (word_t **)&thread->registersBuffer,
+                    (word_t **)(&thread->registersBuffer + 1),
+                    registerBufferStride);
+}
+
+static void Evac_FixupModules(Heap *heap) {
+    word_t **modules = &__modules;
+    int nb_modules = __modules_size;
+    for (int i = 0; i < nb_modules; i++) {
+        Evac_FixupSlot(heap, (word_t **)&modules[i]);
+    }
+}
+
+static void Evac_FixupCustomRoots(Heap *heap, GC_Roots *roots) {
+    mutex_lock(&roots->modificationLock);
+    for (GC_Root *it = roots->head; it != NULL; it = it->next) {
+        Evac_FixupRange(heap, (word_t **)it->range.address_low,
+                        (word_t **)it->range.address_high, sizeof(word_t));
+    }
+    mutex_unlock(&roots->modificationLock);
+}
+
+// Rewrites every field of every currently-marked object in currently-marked
+// simple blocks. Runs AFTER copying, so this naturally covers both (a)
+// survivors that stayed in place (non-candidate blocks, still marked) and
+// (b) freshly-copied objects in the destination blocks (marked via
+// Object_Mark during the copy loop below) -- and must explicitly skip
+// evacuated SOURCE blocks via the same Evac_IsCandidateBlock test the copy
+// loop used, NOT BlockMeta_IsMarked alone: unmarking/clearing a source
+// block's metadata is deliberately DEFERRED until after every fixup pass
+// (see Marker_Evacuate's final loop) so THIS function's own Evac_FixupSlot
+// calls -- run via program-stack/module/custom-root fixup too, not just
+// here -- can still recognize a pointer into a source block as "points at a
+// forwarded object" while its bytemap still reads allocated/marked. Source
+// blocks are therefore still block-level marked when this runs; walking
+// their contents here would misinterpret every forwarded (tombstoned)
+// object as a live survivor and read its corrupted rtti, so they must be
+// skipped explicitly instead of relying on the unmark to exclude them.
+// Rewrites a raw pointer into the MIDDLE of another heap object (see
+// FieldLayout.isInteriorPointer in the compiler: e.g. java.nio.Buffer's cached
+// address of its backing array's data) after the object it points into was
+// moved. Not a reference, so it is invisible to refFieldOffsets and to
+// marking (the real reference keeping the target alive is another field).
+static inline void Evac_FixupInteriorSlot(Heap *heap, word_t **slot) {
+    word_t *value = *slot;
+    if (value == NULL || !Heap_IsWordInHeap(heap, value) ||
+        !Evac_PointsIntoCandidateBlock(heap, value))
+        return;
+    BlockMeta *blockMeta =
+        Block_GetBlockMeta(heap->blockMetaStart, heap->heapStart, value);
+    if (BlockMeta_ContainsLargeObjects(blockMeta))
+        return; // large objects never move
+    // Walk back to the start of the object containing `value`. Can't use
+    // Object_getInnerPointer: it asks Object_Size, which a tombstone (forwarded
+    // header, no rtti) can't answer.
+    word_t *blockStart = Block_GetBlockStartForWord(value);
+    word_t *cursor =
+        (word_t *)((word_t)value & ALLOCATION_ALIGNMENT_INVERSE_MASK);
+    ObjectMeta *meta = Bytemap_Get(heap->bytemap, cursor);
+    while (cursor >= blockStart && ObjectMeta_IsFree(meta)) {
+        cursor -= ALLOCATION_ALIGNMENT_WORDS;
+        meta--;
+    }
+    if (cursor < blockStart || !ObjectMeta_IsMarked(meta))
+        return;
+    Object *target = (Object *)cursor;
+    if (!Evac_IsForwarded(target))
+        return;
+    word_t *newBase = Evac_ForwardedAddress(target);
+    size_t offset = (size_t)((uint8_t *)value - (uint8_t *)target);
+    // One-past-the-end of the previous object looks like the start of this
+    // one: only a zero-length view, never dereferenced, leave it alone.
+    if (offset >= Object_Size((Object *)newBase))
+        return;
+    *slot = (word_t *)((uint8_t *)newBase + offset);
+}
+
+static inline void Evac_FixupOneObject(Heap *heap, Object *object) {
+    const int objectId = Object_Rtti(object)->rt.id;
+#ifdef USES_LOCKWORD
+    // Every object (array or not) carries its own lockWord slot
+    // unconditionally -- see the big comment on Evac_FixupLockWord for why
+    // this needs separate handling from the refFieldOffsets walk below.
+    Evac_FixupLockWord(heap, &object->lockWord);
+#endif
+    if (Object_IsArray(object)) {
+        ArrayHeader *arrayHeader = (ArrayHeader *)object;
+        if (objectId == __object_array_id) {
+            const size_t length = arrayHeader->length;
+            word_t **fields = (word_t **)Array_Values(arrayHeader);
+            for (size_t k = 0; k < length; k++) {
+                Evac_FixupSlot(heap, &fields[k]);
+            }
+        }
+        // blob arrays hold no pointers -- nothing to fix up
+    } else {
+        int32_t *refFieldOffsets = Object_Rtti(object)->refFieldOffsets;
+        for (int k = 0; refFieldOffsets[k] != LAST_FIELD_OFFSET; k++) {
+            size_t fieldOffset = (size_t)refFieldOffsets[k];
+            word_t **fieldRef = (word_t **)((int8_t *)object + fieldOffset);
+            // Deliberately NOT skipping the weak-referent field here
+            // (unlike marking) -- see file header comment.
+            Evac_FixupSlot(heap, fieldRef);
+        }
+        // The compiler appends a second -1 terminated list after the
+        // reference offsets: raw pointers into the middle of heap objects.
+        {
+            int32_t *interiorOffsets = refFieldOffsets;
+            while (*interiorOffsets != LAST_FIELD_OFFSET)
+                interiorOffsets++;
+            for (interiorOffsets++; *interiorOffsets != LAST_FIELD_OFFSET;
+                 interiorOffsets++) {
+                Evac_FixupInteriorSlot(
+                    heap, (word_t **)((int8_t *)object + *interiorOffsets));
+            }
+        }
+        if (objectId == __boxed_ptr_id) {
+            // No longer "deliberately not fixed up" (see the old file
+            // header comment on this gap) -- a real, reproduced bug: a
+            // boxed Ptr[T]'s single field is a plain untagged raw address
+            // (unlike an inline PtrTag value or a lockWord, it carries no
+            // tag bits at all), not listed in refFieldOffsets precisely
+            // because it isn't a normal typed reference -- but it is
+            // exactly as real a pointer to a movable heap object as any
+            // typed field when it happens to alias one (e.g. an interior
+            // Ptr into an Array's data, the case Marker_Mark's own
+            // boxed_ptr_id branch conservatively marks+pins via
+            // Marker_markConservative). Pinning protects it from being
+            // evacuated FROM, but a boxed Ptr pointing at some OTHER,
+            // non-pinned object that legitimately got evacuated still
+            // needs this rewrite, same as any other field would.
+            Evac_FixupSlot(heap, &object->fields[0]);
+        }
+    }
+}
+
+// scoredBlockCount is Marker_Evacuate's OWN snapshot of heap->blockCount
+// taken at the start of this cycle, BEFORE any Heap_Grow call it makes
+// (upfront destination-space reservation, or growing on demand mid-copy --
+// see the comment where that happens). blockLiveBytes/blockPinned were
+// sized to that snapshot (EvacLog_ensureCapacity/EvacPin_ensureCapacity,
+// both called once per cycle from Marker_MarkRoots, before this function
+// ever runs). Reading heap->blockCount directly here instead would include
+// blocks added by a mid-cycle Heap_Grow -- genuinely new blocks the
+// scoring pass never saw, so indexing blockLiveBytes[i] for one is a
+// flat-out out-of-bounds read on a malloc'd array. That was a real,
+// reproduced bug: non-deterministic SIGBUS/SIGSEGV at garbage (not
+// null/sentinel) addresses under heavy concurrent allocation + a small
+// heap, where Heap_Grow during evacuation is common. A block index at or
+// past scoredBlockCount can never have been a candidate (it didn't exist
+// when candidacy was scored), so it's never skipped here -- which is
+// exactly right: on-demand-grown blocks are destination blocks for this
+// very cycle's copies, and their freshly-copied, marked contents still
+// need the same field fixups as any other block's.
+static void Evac_FixupHeapObjects(Heap *heap, uint32_t scoredBlockCount) {
+    Bytemap *bytemap = heap->bytemap;
+    // See EvacTrace_enabled's comment -- $SCALANATIVE_EVAC_TRACE_OBJ (hex),
+    // if set alongside $SCALANATIVE_EVAC_TRACE_FILE, additionally logs
+    // whether a SPECIFIC object address is ever visited by this loop (and
+    // which block-skip branch it would have hit, if any), complementing
+    // EvacTrace_log's per-slot VALUE tracing.
+    word_t *traceObj = NULL;
+    if (EvacTrace_enabled()) {
+        const char *traceObjStr = getenv("SCALANATIVE_EVAC_TRACE_OBJ");
+        if (traceObjStr != NULL)
+            traceObj = (word_t *)strtoull(traceObjStr, NULL, 16);
+    }
+    for (uint32_t i = 0; i < heap->blockCount; i++) {
+        BlockMeta *meta = BlockMeta_GetFromIndex(heap->blockMetaStart, i);
+        word_t *blockStart = heap->heapStart + (size_t)i * WORDS_IN_BLOCK;
+        word_t *blockEnd = blockStart + WORDS_IN_BLOCK;
+        bool blockContainsTraceObj =
+            traceObj != NULL && (word_t *)traceObj >= blockStart &&
+            (word_t *)traceObj < blockEnd;
+        // Large objects (superblocks) are handled by the separate loop
+        // below, NOT skipped outright -- see its own comment for why they
+        // can't just be ignored like evacuated source blocks can.
+        if (BlockMeta_ContainsLargeObjects(meta)) {
+            if (blockContainsTraceObj) {
+                FILE *f = fopen(evacTraceFilePath, "a");
+                if (f != NULL) {
+                    fprintf(f, "FixupHeapObjects-skip-large block=%u\n", i);
+                    fclose(f);
+                }
+            }
+            continue;
+        }
+        if (!BlockMeta_IsMarked(meta)) {
+            if (blockContainsTraceObj) {
+                FILE *f = fopen(evacTraceFilePath, "a");
+                if (f != NULL) {
+                    fprintf(f, "FixupHeapObjects-skip-unmarked block=%u\n", i);
+                    fclose(f);
+                }
+            }
+            continue;
+        }
+        if (i < scoredBlockCount &&
+            Evac_IsCandidateBlock(meta, blockLiveBytes[i], i)) {
+            if (blockContainsTraceObj) {
+                FILE *f = fopen(evacTraceFilePath, "a");
+                if (f != NULL) {
+                    fprintf(f, "FixupHeapObjects-skip-candidate block=%u\n",
+                            i);
+                    fclose(f);
+                }
+            }
+            continue; // evacuated source block -- skip, see comment above
+        }
+        if (blockContainsTraceObj) {
+            FILE *f = fopen(evacTraceFilePath, "a");
+            if (f != NULL) {
+                fprintf(f, "FixupHeapObjects-scanning block=%u\n", i);
+                fclose(f);
+            }
+        }
+        for (word_t *addr = blockStart; addr < blockEnd;) {
+            ObjectMeta *objMeta = Bytemap_Get(bytemap, addr);
+            if (ObjectMeta_IsMarked(objMeta)) {
+                Object *object = (Object *)addr;
+                if (traceObj != NULL && addr == traceObj) {
+                    FILE *f = fopen(evacTraceFilePath, "a");
+                    if (f != NULL) {
+                        fprintf(f, "FixupHeapObjects-visit obj=%p\n",
+                                (void *)addr);
+                        fclose(f);
+                    }
+                }
+                Evac_FixupOneObject(heap, object);
+                addr += Object_Size(object) / sizeof(word_t);
+            } else {
+                if (traceObj != NULL && addr == traceObj) {
+                    FILE *f = fopen(evacTraceFilePath, "a");
+                    if (f != NULL) {
+                        fprintf(f,
+                                "FixupHeapObjects-NOT-marked-at-addr obj=%p\n",
+                                (void *)addr);
+                        fclose(f);
+                    }
+                }
+                addr += ALLOCATION_ALIGNMENT_WORDS;
+            }
+        }
+    }
+
+    // Large objects (superblocks) are never evacuation candidates
+    // themselves (Evac_IsCandidateBlock already excludes
+    // BlockMeta_ContainsLargeObjects), but a large live ObjectArray's own
+    // ELEMENTS can still reference smaller, normally-evacuated objects --
+    // this was a real, reproduced bug: the loop above's own
+    // BlockMeta_ContainsLargeObjects skip meant a large object's contents
+    // were never visited at all, so references inside e.g. a compiler's
+    // large symbol-table array were silently left stale (surfaced as
+    // ClassCastExceptions reading the wrong object through a corrupted
+    // slot). A superblock's mark state lives on its first object's
+    // ObjectMeta entry (see LargeAllocator_Sweep), not on BlockMeta (whose
+    // own flags field instead encodes superblock-start/middle), so it must
+    // be checked separately from the simple-block loop above.
+    // A superblock holds MORE than just the object at its first block (see the
+    // layout comment in LargeAllocator_Sweep): a large object can start at
+    // the very beginning of the first block, or at any MIN_BLOCK_SIZE step of
+    // the LAST block except its first one (that is the first object's tail).
+    // Missing the latter was a real, reproduced bug: a plain 1024-element
+    // object array (8208 bytes) was allocated mid-superblock, was never
+    // visited here, and kept pointing at objects evacuation had moved.
+    for (uint32_t i = 0; i < heap->blockCount; i++) {
+        BlockMeta *meta = BlockMeta_GetFromIndex(heap->blockMetaStart, i);
+        if (!BlockMeta_IsSuperblockStart(meta))
+            continue;
+        const uint32_t superblockSize = BlockMeta_SuperblockSize(meta);
+        word_t *blockStart = heap->heapStart + (size_t)i * WORDS_IN_BLOCK;
+        word_t *blockEnd = blockStart + WORDS_IN_BLOCK * superblockSize;
+        word_t *lastBlockStart = blockEnd - WORDS_IN_BLOCK;
+        if (ObjectMeta_IsMarked(Bytemap_Get(bytemap, blockStart))) {
+            Evac_FixupOneObject(heap, (Object *)blockStart);
+        }
+        for (word_t *current = lastBlockStart + (MIN_BLOCK_SIZE / WORD_SIZE);
+             current < blockEnd; current += MIN_BLOCK_SIZE / WORD_SIZE) {
+            if (ObjectMeta_IsMarked(Bytemap_Get(bytemap, current))) {
+                Evac_FixupOneObject(heap, (Object *)current);
+            }
+        }
+    }
+}
+
+static uint32_t validateScoredBlocks = 0;
+
+// Debug-only helper for $SCALANATIVE_EVAC_VALIDATE_FILE: reports every
+// reference field of `object` that still points at a forwarded (evacuated)
+// object after the fixup passes ran.
+static void Evac_ValidateObject(Heap *heap, Object *object,
+                                const char *validateFilePath, uint32_t block) {
+    Bytemap *bytemap = heap->bytemap;
+    // Raw-word scan: no word of a survivor may still point into an evacuated
+    // source block. Expect false positives: two packed Int fields read as one
+    // word can look like a heap address (e.g. BitmapIndexedMapNode's
+    // nodeMap + size, high word 3 = 0x3_xxxxxxxx). A real hit has isRef=0 and
+    // a value that is not block-aligned noise; check the class's field layout. Catches what refFieldOffsets can't describe: raw pointers
+    // (Ptr fields, data pointers into arrays, ...) held inside heap objects.
+    if (!(Object_IsArray(object) &&
+          Object_Rtti(object)->rt.id != __object_array_id)) {
+        size_t words = Object_Size(object) / sizeof(word_t);
+        // Arrays of primitives hold arbitrary data, skip them.
+        for (size_t w = 0; w < words; w++) {
+            word_t *v = ((word_t **)object)[w];
+            if (v == NULL || !Heap_IsWordInHeap(heap, v))
+                continue;
+            uint32_t vb = Block_GetBlockIndexForWord(heap->heapStart, v);
+            if (vb >= validateScoredBlocks || vb == block)
+                continue;
+            BlockMeta *vm = BlockMeta_GetFromIndex(heap->blockMetaStart, vb);
+            if (!Evac_IsCandidateBlock(vm, blockLiveBytes[vb], vb))
+                continue;
+            FILE *f = fopen(validateFilePath, "a");
+            if (f != NULL) {
+                // Is this slot a declared reference field?
+                int isRef = 0;
+                if (!Object_IsArray(object)) {
+                    int32_t *offs = Object_Rtti(object)->refFieldOffsets;
+                    for (int k = 0; offs[k] != LAST_FIELD_OFFSET; k++)
+                        if ((size_t)offs[k] == w * sizeof(word_t))
+                            isRef = 1;
+                }
+                // State of the target's own metadata and block.
+                word_t *aligned = (word_t *)((word_t)v & ALLOCATION_ALIGNMENT_INVERSE_MASK);
+                ObjectMeta *tm = Bytemap_Get(bytemap, aligned);
+                BlockMeta *tb = BlockMeta_GetFromIndex(heap->blockMetaStart, vb);
+                fprintf(f,
+                        "RAW-STALE obj=%p rttiId=%d wordOffset=%zu isRef=%d value=%p "
+                        "aligned=%d tFree=%d tMarked=%d tAlloc=%d tPlaceholder=%d "
+                        "tBlockMarked=%d tLive=%u tPinned=%d tHashed=%d tForwarded=%d",
+                        (void *)object, Object_Rtti(object)->rt.id,
+                        w * sizeof(word_t), isRef, (void *)v,
+                        (int)(((word_t)v & ~ALLOCATION_ALIGNMENT_INVERSE_MASK) == 0),
+                        ObjectMeta_IsFree(tm), ObjectMeta_IsMarked(tm),
+                        ObjectMeta_IsAllocated(tm), ObjectMeta_IsPlaceholder(tm),
+                        BlockMeta_IsMarked(tb), blockLiveBytes[vb],
+                        EvacPin_isBlockPinned(vb),
+                        heap->hashedBlocks != NULL && heap->hashedBlocks[vb],
+                        ObjectMeta_IsMarked(tm) ? (int)Evac_IsForwarded((Object *)aligned) : -1);
+                fprintf(f, "\n");
+                fclose(f);
+            }
+        }
+    }
+    if (Object_IsArray(object)) {
+        if (Object_Rtti(object)->rt.id != __object_array_id)
+            return;
+        ArrayHeader *ah = (ArrayHeader *)object;
+        word_t **fields = (word_t **)Array_Values(ah);
+        for (size_t k = 0; k < (size_t)ah->length; k++) {
+            word_t *v = fields[k];
+            if (v != NULL && Heap_IsWordInHeap(heap, v) &&
+                Bytemap_isPtrAligned(v)) {
+                ObjectMeta *vm = Bytemap_Get(bytemap, v);
+                if (!ObjectMeta_IsFree(vm) && !ObjectMeta_IsPlaceholder(vm) &&
+                    Evac_IsForwarded((Object *)v)) {
+                    FILE *f = fopen(validateFilePath, "a");
+                    if (f != NULL) {
+                        fprintf(f,
+                                "STALE array obj=%p rttiId=%d elem=%zu "
+                                "value=%p block=%u\n",
+                                (void *)object, Object_Rtti(object)->rt.id, k,
+                                (void *)v, block);
+                        fclose(f);
+                    }
+                }
+            }
+        }
+        return;
+    }
+    int32_t *offs = Object_Rtti(object)->refFieldOffsets;
+    for (int k = 0; offs[k] != LAST_FIELD_OFFSET; k++) {
+        word_t *v = *(word_t **)((int8_t *)object + offs[k]);
+        if (v != NULL && Heap_IsWordInHeap(heap, v) &&
+            Bytemap_isPtrAligned(v)) {
+            ObjectMeta *vm = Bytemap_Get(bytemap, v);
+            if (!ObjectMeta_IsFree(vm) && !ObjectMeta_IsPlaceholder(vm) &&
+                Evac_IsForwarded((Object *)v)) {
+                FILE *f = fopen(validateFilePath, "a");
+                if (f != NULL) {
+                    fprintf(f,
+                            "STALE field obj=%p rttiId=%d fieldOffset=%d "
+                            "value=%p block=%u\n",
+                            (void *)object, Object_Rtti(object)->rt.id, offs[k],
+                            (void *)v, block);
+                    fclose(f);
+                }
+            }
+        }
+    }
+}
+
+void Marker_Evacuate(Heap *heap, Stack *stack) {
+    (void)stack; // no new marking happens here, kept for call-site symmetry
+    if (!Evac_enabled())
+        return;
+    if (blockLiveBytes == NULL || blockLiveBytesCapacity < heap->blockCount)
+        return; // live-byte tally wasn't collected this cycle -- nothing to do
+
+    uint32_t blockCount = heap->blockCount;
+    uint64_t totalLiveBytes = 0;
+    uint32_t candidateBlockCount = 0;
+    evacCandidateBlocksCount = 0;
+    if (blockCount > evacCandidateBlocksCapacity) {
+        evacCandidateBlocks =
+            (uint8_t *)realloc(evacCandidateBlocks, (size_t)blockCount);
+        evacCandidateBlocksCapacity = blockCount;
+    }
+    for (uint32_t i = 0; i < blockCount; i++) {
+        BlockMeta *meta = BlockMeta_GetFromIndex(heap->blockMetaStart, i);
+        bool isCandidate = Evac_IsCandidateBlock(meta, blockLiveBytes[i], i);
+        evacCandidateBlocks[i] = isCandidate ? 1 : 0;
+        if (isCandidate) {
+            totalLiveBytes += blockLiveBytes[i];
+            candidateBlockCount++;
+        }
+        if (EvacTrace_enabled() && evacTraceValue != NULL) {
+            word_t *blockStart = heap->heapStart + (size_t)i * WORDS_IN_BLOCK;
+            word_t *blockEnd = blockStart + WORDS_IN_BLOCK;
+            if (evacTraceValue >= blockStart && evacTraceValue < blockEnd) {
+                FILE *f = fopen(evacTraceFilePath, "a");
+                if (f != NULL) {
+                    fprintf(f,
+                            "Scoring: traceValue=%p block=%u candidate=%d "
+                            "liveBytes=%u pinned=%d\n",
+                            (void *)evacTraceValue, i, isCandidate,
+                            blockLiveBytes[i], EvacPin_isBlockPinned(i));
+                    fclose(f);
+                }
+            }
+        }
+    }
+    if (candidateBlockCount == 0)
+        return;
+
+    // Reserve destination space upfront so the copy loop below never needs
+    // to trigger growth or (far worse) a recursive Heap_Collect mid-cycle.
+    // Small safety margin for block-boundary rounding (objects here are a
+    // handful of words each, per the stage-1 histogram -- waste is
+    // negligible relative to the space being reclaimed).
+    uint32_t neededBlocks =
+        (uint32_t)(totalLiveBytes / BLOCK_TOTAL_SIZE) + 2;
+
+    // Evacuation is not free: besides the copy, the fixup pass revisits every
+    // live object in the heap, which costs about as much as marking it (~0.5s
+    // per cycle on a 500MB live set, however few blocks moved). Skip the cycle
+    // when it would free less than ~1.5% of the heap: the sweep still
+    // recycles those blocks' free lines, and fragmentation that small is not
+    // what compaction is for.
+    uint32_t reclaimedBlocks =
+        candidateBlockCount > neededBlocks ? candidateBlockCount - neededBlocks
+                                           : 0;
+    uint32_t minReclaimedBlocks = blockCount / 64 > 64 ? blockCount / 64 : 64;
+    if (reclaimedBlocks < minReclaimedBlocks) {
+        GC_LOG_INFO("Evacuation skipped: %u candidate blocks would free only "
+                   "%u blocks (< %u)",
+                   candidateBlockCount, reclaimedBlocks, minReclaimedBlocks);
+        return;
+    }
+    evacCandidateBlocksCount = blockCount;
+
+    GC_LOG_INFO("Evacuating %u candidate blocks (%llu live bytes)",
+               candidateBlockCount, (unsigned long long)totalLiveBytes);
+
+    // Only grow if the CURRENT free supply can't already cover the
+    // destination space -- growing unconditionally here defeats much of
+    // the point (a real, measured anomaly from the first test: heap size
+    // grew on every single cycle regardless of whether evacuation actually
+    // needed more room, compounding rather than reducing growth pressure).
+    // If there's already enough free supply, just use it -- exactly like
+    // any other allocation competing for the same pool; the existing
+    // Heap_shouldGrow check in Heap_Recycle (right after this function
+    // returns) remains the one real decision point for whether the heap
+    // needs to grow overall.
+    uint32_t currentFreeBlocks = (uint32_t)blockAllocator.freeBlockCount;
+    if (currentFreeBlocks < neededBlocks) {
+        uint32_t growBy = neededBlocks - currentFreeBlocks;
+        if (!Heap_isGrowingPossible(heap, growBy)) {
+            GC_LOG_INFO("Evacuation skipped: not enough headroom to grow by "
+                       "%u blocks for destination space",
+                       growBy);
+            return;
+        }
+        Heap_Grow(heap, growBy);
+    }
+    // Heap_Grow (when it ran) adds the new blocks to blockAllocator's free
+    // list. Claiming them properly via BlockAllocator_GetFreeBlock (the
+    // SAME function every normal allocation uses to get a fresh block) is
+    // essential here, not
+    // optional -- writing directly into heap->heapEnd's raw address range
+    // without this would leave those blocks double-booked: still marked
+    // "free" in the allocator's own bookkeeping even though we've filled
+    // them with live objects, so a later ordinary allocation could
+    // overwrite them. Verified real free count covers what we asked for
+    // before copying anything (defense in depth against a bug in the
+    // needed-block-count math above -- see the hard-stop below for what
+    // happens if a claim still fails mid-copy, which this check exists to
+    // make unreachable).
+    if ((uint32_t)blockAllocator.freeBlockCount < neededBlocks) {
+        GC_LOG_INFO("Evacuation skipped: grew heap but free count still "
