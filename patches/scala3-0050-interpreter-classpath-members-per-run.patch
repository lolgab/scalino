   def unapply(ex: Throwable): Option[Throwable] = scala.util.control.NonFatal.unapply(ex)
 
 object Interpreter:
+  /** `allMembers` symbols of classpath (not current-run) symbols, for the run in `membersRun`. */
+  private var membersRun: AnyRef | Null = null
+  private val membersOfRun = new java.util.HashMap[Symbol, List[Symbol]]()
+  private def classpathMembers(s: Symbol, compute: => List[Symbol])(using Context): List[Symbol] = synchronized {
+    if membersRun ne ctx.run then
+      membersOfRun.clear()
+      membersRun = ctx.run
+    val cached = membersOfRun.get(s)
+    if cached != null then cached
+    else
+      val r = compute
+      membersOfRun.put(s, r)
+      r
+  }
