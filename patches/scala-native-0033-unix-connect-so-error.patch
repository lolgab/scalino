+  /** The pending error of the non-blocking connect: 0 when it succeeded. */
+  private def connectResult(): CInt = {
+    val soError = stackalloc[CInt]()
+    val len = stackalloc[socket.socklen_t]()
+    !soError = 0
+    !len = sizeof[CInt].toUInt
+
+    if (
+      socket.getsockopt(
+        fd.fd,
+        socket.SOL_SOCKET,
+        socket.SO_ERROR,
+        soError.asInstanceOf[Ptr[Byte]],
+        len
+      ) != 0
+    ) {
+      throw new ConnectException(
+        s"connect failed, getsockopt SO_ERROR errno: $errno"
+      )
+    }
+    !soError
+  }
