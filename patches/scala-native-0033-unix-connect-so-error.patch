+  // A server that writes right after accept makes the client's socket readable
+  // by the time its non-blocking connect is polled: that is still a success.
+  @Test def connectWithTimeoutWhenServerWritesImmediately(): Unit = {
+    val server = new ServerSocket(0, 50, InetAddress.getLoopbackAddress())
+    val serverThread = new Thread(() => {
+      val peer = server.accept()
+      try {
+        peer.getOutputStream().write("hello".getBytes("UTF-8"))
+        peer.getOutputStream().flush()
+        // keep the connection open until the client has read
+        peer.getInputStream().read()
+      } finally peer.close()
+    })
+    serverThread.setDaemon(true)
+    serverThread.start()
+
+    val s = new Socket()
+    try {
+      s.connect(
+        new InetSocketAddress(
+          InetAddress.getLoopbackAddress(),
+          server.getLocalPort()
+        ),
+        5000
+      )
+      assertTrue("connected", s.isConnected())
+      val buf = new Array[Byte](5)
+      var n = 0
+      while (n < buf.length) {
+        val r = s.getInputStream().read(buf, n, buf.length - n)
+        assertTrue("unexpected end of stream", r > 0)
+        n += r
+      }
+      assertEquals("hello", new String(buf, "UTF-8"))
+    } finally {
+      s.close()
+      server.close()
+    }
+    serverThread.join(5000)
+  }
+
+  @Test def connectWithTimeoutToClosedPort(): Unit = {
+    // bind then close: the port is almost certainly unused afterwards
+    val probe = new ServerSocket(0, 50, InetAddress.getLoopbackAddress())
+    val port = probe.getLocalPort()
+    probe.close()
+
+    val s = new Socket()
+    try {
+      assertThrows(
+        classOf[ConnectException],
+        s.connect(
+          new InetSocketAddress(InetAddress.getLoopbackAddress(), port),
+          5000
+        )
+      )
+    } finally {
+      s.close()
+    }
+  }
