+package scala.scalanative.runtime
+package monitor
+
+import scala.scalanative.unsafe._
+
+/** Leases of the owner ids of thin locks, see thread_slots.c. Extern, so the
+ *  lock path never needs a module to be loaded.
+ */
+@extern
+private[runtime] object ThreadSlots {
+  @name("scalanative_monitor_thread_slot")
+  def current(): CInt = extern
+
+  @name("scalanative_monitor_release_thread_slot")
+  def releaseCurrent(): Unit = extern
+}
