diff --git a/nativelib/src/main/scala/scala/scalanative/runtime/monitor/CompactMonitor.scala b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/CompactMonitor.scala
new file mode 100644
index 000000000..e854247dc
--- /dev/null
+++ b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/CompactMonitor.scala
@@ -0,0 +1,275 @@
+package scala.scalanative.runtime
+package monitor
+
+import scala.annotation.tailrec
+
+import scala.scalanative.annotation.alwaysinline
+import scala.scalanative.runtime.Intrinsics._
+import scala.scalanative.runtime.VirtualThread
+import scala.scalanative.runtime.ffi.stdatomic._
+import scala.scalanative.runtime.ffi.stdatomic.memory_order._
+import scala.scalanative.unsafe.{stackalloc => _, _}
+
+/** Lightweight locking, used with compact object headers.
+ *
+ *  The header has no room for a lock word: the lock state takes its 2 lowest
+ *  bits (the offset of an RTTI is always aligned):
+ *
+ *    - 00 unlocked
+ *    - 01 fast-locked, the owner has the object on its lock stack
+ *    - 11 fast-locked, another thread waits for it: the owner inflates the lock
+ *      when exiting it, the waiter then queues on the ObjectMonitor
+ *    - 10 inflated, the ObjectMonitor is found in the MonitorTable
+ *
+ *  As in HotSpot's lightweight locking, the owner of a fast lock isn't stored in
+ *  the object: a thread owns it iff the object is on its lock stack, which also
+ *  holds one entry per recursive entry. A full lock stack, wait/notify and
+ *  virtual threads (their carrier's lock stack isn't theirs) inflate the lock.
+ *
+ *  @param obj
+ *    the locked object, its header is the first word
+ */
+private[runtime] final class CompactMonitor(val obj: RawPtr) extends AnyVal {
+
+  // The header is a 32 bit word: the offset of the RTTI in the RTTI space,
+  // with the lock state in its 2 lowest bits
+  @alwaysinline private def Unlocked = 0
+  @alwaysinline private def FastLocked = 1
+  @alwaysinline private def Inflated = 2
+  @alwaysinline private def InflationRequested = 3
+  @alwaysinline private def StateMask = 3
+
+  @alwaysinline private def loadHeader(): Int =
+    atomic_load_int(obj, memory_order_acquire)
+
+  // Fast paths only: a stale value makes the CAS that follows fail
+  @alwaysinline private def peekHeader(): Int = loadInt(obj)
+
+  @alwaysinline private def state(header: Int): Int = header & StateMask
+
+  @alwaysinline private def isFastLocked(header: Int): Boolean =
+    (header & FastLocked) != 0
+
+  @alwaysinline private def withState(header: Int, state: Int): Int =
+    (header & ~StateMask) | state
+
+  @alwaysinline private def compareAndSetHeader(
+      expected: Int,
+      value: Int
+  ): Boolean = {
+    val expectedPtr = stackalloc[Int]()
+    storeInt(expectedPtr, expected)
+    atomic_compare_exchange_int(obj, expectedPtr, value)
+  }
+
+  // Not for virtual threads, see LockStack.current
+  @alwaysinline private def lockStack = new LockStackRef(LockStack.current())
+
+  @alwaysinline private def monitor: ObjectMonitor = MonitorTable.get(obj)
+
+  @alwaysinline private def isVirtual(thread: Thread): Boolean =
+    thread.isInstanceOf[VirtualThread]
+
+  /** Does the current platform thread hold the fast lock? */
+  @alwaysinline private def ownsFastLock(thread: Thread, header: Int) =
+    isFastLocked(header) && !isVirtual(thread) && lockStack.contains(obj)
+
+  @inline def enter(): Unit = {
+    val ptr = LockStack.current()
+    if (castRawPtrToLong(ptr) != 0L) {
+      val stack = new LockStackRef(ptr)
+      if (!stack.isFull) {
+        val header = peekHeader()
+        val s = state(header)
+        if (s == Unlocked) {
+          if (compareAndSetHeader(header, header | FastLocked)) {
+            stack.push(obj)
+            return
+          }
+        } else if (s != Inflated && stack.contains(obj)) {
+          // Recursive entry, nobody else can change the owner
+          stack.push(obj)
+          return
+        }
+      }
+    }
+    enterSlowPath()
+  }
+
+  @noinline private def enterSlowPath(): Unit = {
+    val thread = Thread.currentThread()
+    if (thread == null) return // Not yet initialized
+    val header = loadHeader()
+    if (state(header) == Inflated) monitor.enter(thread)
+    else if (ownsFastLock(thread, header))
+      // Recursive entry with a full lock stack
+      inflate(thread).enter(thread)
+    else waitingOnMonitorEnter(lockAndInflate(thread))
+  }
+
+  @inline def exit(): Unit = {
+    val ptr = LockStack.current()
+    if (castRawPtrToLong(ptr) != 0L) {
+      val stack = new LockStackRef(ptr)
+      if (stack.isTop(obj)) {
+        val header = peekHeader()
+        if (state(header) == FastLocked) {
+          stack.size = stack.size - 1
+          if (stack.contains(obj)) return // recursive exit
+          if (compareAndSetHeader(header, withState(header, Unlocked))) return
+          // A waiter asked to inflate meanwhile
+          stack.push(obj)
+        }
+      }
+    }
+    exitSlowPath()
+  }
+
+  // Kept out of line so every synchronized exit site only carries the fast path.
+  @noinline private def exitSlowPath(): Unit = {
+    val thread = Thread.currentThread()
+    if (thread == null) return // Not yet initialized
+    val header = loadHeader()
+    state(header) match {
+      case 2 /* Inflated */ => monitor.exit(thread)
+      case 0 /* Unlocked */ => () // can happen only on the main thread
+      case _ =>
+        if (!ownsFastLock(thread, header))
+          throw new IllegalMonitorStateException(
+            "Thread is not an owner of this object"
+          )
+        val stack = lockStack
+        if (stack.count(obj) > 1) stack.removeLast(obj)
+        else {
+          // The last entry with a waiter, or a lock not on top of the stack
+          val m = inflate(thread)
+          m.exit(thread)
+        }
+    }
+  }
+
+  @alwaysinline def isLockedBy(thread: Thread): Boolean = {
+    val header = loadHeader()
+    if (state(header) == Inflated) monitor.isLockedBy(thread)
+    else (thread eq Thread.currentThread()) && ownsFastLock(thread, header)
+  }
+
+  @alwaysinline def _notify(): Unit = {
+    val header = loadHeader()
+    if (state(header) == Inflated) monitor._notify()
+    else ensureOwnsFastLock(header)
+    // A fast lock has no wait queue, notify is a no-op once ownership is verified
+  }
+
+  @alwaysinline def _notifyAll(): Unit = {
+    val header = loadHeader()
+    if (state(header) == Inflated) monitor._notifyAll()
+    else ensureOwnsFastLock(header)
+  }
+
+  @alwaysinline def _wait(): Unit = monitorForWait()._wait()
+
+  @alwaysinline def _wait(timeout: Long): Unit =
+    monitorForWait()._wait(timeout)
+
+  @alwaysinline def _wait(timeout: Long, nanos: Int): Unit =
+    monitorForWait()._wait(timeout, nanos)
+
+  @noinline private def ensureOwnsFastLock(header: Int): Unit = {
+    val thread = Thread.currentThread()
+    if (thread != null && !ownsFastLock(thread, header))
+      throw new IllegalMonitorStateException(
+        "Thread is not an owner of this object"
+      )
+  }
+
+  @noinline private def monitorForWait(): ObjectMonitor = {
+    val header = loadHeader()
+    if (state(header) == Inflated) monitor
+    else {
+      ensureOwnsFastLock(header)
+      inflate(Thread.currentThread())
+    }
+  }
+
+  // Ask the owner of the fast lock to inflate it on exit
+  @alwaysinline private def requestInflation(): Unit = {
+    val header = loadHeader()
+    if (state(header) == FastLocked)
+      compareAndSetHeader(header, withState(header, InflationRequested))
+  }
+
+  /** Takes the lock of an object owned by another thread (or by nobody, for a
+   *  virtual thread) and inflates it, or enters its inflated monitor.
+   */
+  @inline private def lockAndInflate(thread: Thread): Unit = {
+    // Fetched once, see BasicMonitor.lockAndInflate
+    lazy val nativeThread = NativeThread.currentNativeThread
+
+    // Takes the fast lock for inflating it, the object is never pushed on the
+    // lock stack. false once inflated by its owner.
+    @tailrec def acquire(yields: Int, backoffNanos: Int): Boolean = {
+      def MaxSleepNanos = 128000
+      val header = loadHeader()
+      val s = state(header)
+      if (s == Inflated) false
+      else if (s == Unlocked &&
+          compareAndSetHeader(header, withState(header, FastLocked))) true
+      else if (yields > 8) {
+        requestInflation()
+        thread match {
+          case _: VirtualThread =>
+            // Avoid pinning a carrier while contending on a fast lock
+            Thread.`yield`()
+            acquire(yields, backoffNanos)
+          case _ =>
+            val native = nativeThread
+            if (native != null) native.sleepNanos(backoffNanos)
+            else Thread.`yield`()
+            acquire(yields, (backoffNanos * 3 / 2).min(MaxSleepNanos))
+        }
+      } else {
+        NativeThread.onSpinWait()
+        acquire(yields + 1, backoffNanos)
+      }
+    }
+
+    if (acquire(yields = 0, backoffNanos = 1000)) inflate(thread)
+    else monitor.enter(thread)
+  }
+
+  /** Inflates the fast lock owned by `thread`: its entries move from the lock
+   *  stack to a new ObjectMonitor, owned by `thread`.
+   */
+  private def inflate(thread: Thread): ObjectMonitor = {
+    val entries =
+      if (isVirtual(thread)) 1
+      else {
+        val stack = lockStack
+        val n = stack.count(obj)
+        stack.removeAll(obj)
+        n.max(1)
+      }
+    val objectMonitor = new ObjectMonitor()
+    objectMonitor.enter(thread)
+    objectMonitor.recursion += entries - 1
+    MonitorTable.register(obj, objectMonitor)
+
+    // Only the state changes, a waiter may still turn 01 into 11 meanwhile
+    var done = false
+    while (!done) {
+      val header = loadHeader()
+      done = compareAndSetHeader(header, withState(header, Inflated))
+    }
+    atomic_thread_fence(memory_order_seq_cst)
+    objectMonitor
+  }
+
+  def show: String = {
+    val header = loadHeader()
+    state(header) match {
+      case 2 => monitor.toString
+      case s  => s"CompactMonitor(state=$s)"
+    }
+  }
+}
diff --git a/nativelib/src/main/scala/scala/scalanative/runtime/monitor/LockStack.scala b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/LockStack.scala
