--- /dev/null
+++ b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/LockStack.scala
@@ -0,0 +1,93 @@
+package scala.scalanative.runtime
+package monitor
+
+import scala.scalanative.annotation.alwaysinline
+import scala.scalanative.runtime.Intrinsics._
+import scala.scalanative.unsafe._
+
+/** The objects fast-locked by the current thread, see lock_stack.c. Extern, so
+ *  the lock path never needs a module to be loaded.
+ */
+@extern
+private[runtime] object LockStack {
+  /** null while a virtual thread is mounted, its carrier owns the stack */
+  @name("scalanative_monitor_lock_stack")
+  def current(): RawPtr = extern
+
+  @name("scalanative_monitor_set_virtual_mounted")
+  def setVirtualMounted(mounted: Boolean): Unit = extern
+}
+
+/** Operations on the lock stack of the current thread, layout:
+ *  `{ intptr_t size; void *objects[Capacity]; }`.
+ */
+private[monitor] final class LockStackRef(val ptr: RawPtr) extends AnyVal {
+  @alwaysinline def size: Int = loadLong(ptr).toInt
+  @alwaysinline def size_=(value: Int): Unit = storeLong(ptr, value.toLong)
+
+  @alwaysinline private def slot(index: Int): RawPtr =
+    elemRawPtr(ptr, castIntToRawSize((index + 1) * 8))
+
+  @alwaysinline def apply(index: Int): RawPtr = loadRawPtr(slot(index))
+
+  // Must match LOCK_STACK_CAPACITY in lock_stack.c
+  @alwaysinline def isFull: Boolean = size == 8
+
+  @alwaysinline private def same(a: RawPtr, b: RawPtr): Boolean =
+    castRawPtrToLong(a) == castRawPtrToLong(b)
+
+  /** Needs `!isFull` */
+  @alwaysinline def push(obj: RawPtr): Unit = {
+    val n = size
+    storeRawPtr(slot(n), obj)
+    size = n + 1
+  }
+
+  @alwaysinline def isTop(obj: RawPtr): Boolean = {
+    val n = size
+    n > 0 && same(apply(n - 1), obj)
+  }
+
+  /** Occurrences of `obj`, how many times the current thread entered it */
+  def count(obj: RawPtr): Int = {
+    var n = 0
+    var i = size - 1
+    while (i >= 0) {
+      if (same(apply(i), obj)) n += 1
+      i -= 1
+    }
+    n
+  }
+
+  @alwaysinline def contains(obj: RawPtr): Boolean = {
+    var i = size - 1
+    while (i >= 0 && !same(apply(i), obj)) i -= 1
+    i >= 0
+  }
+
+  /** Removes the most recent occurrence of `obj` */
+  def removeLast(obj: RawPtr): Unit = {
+    var i = size - 1
+    while (i >= 0 && !same(apply(i), obj)) i -= 1
+    if (i >= 0) removeAt(i)
+  }
+
+  /** Removes every occurrence of `obj` */
+  def removeAll(obj: RawPtr): Unit = {
+    var i = size - 1
+    while (i >= 0) {
+      if (same(apply(i), obj)) removeAt(i)
+      i -= 1
+    }
+  }
+
+  private def removeAt(index: Int): Unit = {
+    val n = size
+    var i = index
+    while (i < n - 1) {
+      storeRawPtr(slot(i), apply(i + 1))
+      i += 1
+    }
+    size = n - 1
+  }
+}
diff --git a/nativelib/src/main/scala/scala/scalanative/runtime/monitor/MonitorTable.scala b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/MonitorTable.scala
new file mode 100644
index 000000000..ba5bdfd54
--- /dev/null
+++ b/nativelib/src/main/scala/scala/scalanative/runtime/monitor/MonitorTable.scala
@@ -0,0 +1,156 @@
+package scala.scalanative.runtime
+package monitor
+
+import java.lang.ref.WeakReference
+
+import scala.scalanative.annotation.alwaysinline
+import scala.scalanative.meta.LinktimeInfo.{
+  isCompactHeaders,
+  isMultithreadingEnabled
+}
+import scala.scalanative.runtime.Intrinsics._
+import scala.scalanative.runtime.ffi.stdatomic._
+import scala.scalanative.runtime.ffi.stdatomic.memory_order._
+import scala.scalanative.unsafe.{stackalloc => _, _}
+
+/** Inflated monitors by object, used only with compact object headers.
+ *
+ *  The header of an object keeps only the state of its lock (see
+ *  CompactMonitor), so an inflated monitor is found by the address of its
+ *  object. The object's block is pinned when the monitor is registered, a
+ *  moving collector never changes that address. The table keeps the monitors
+ *  alive, objects are referenced only weakly: the entry of a collected object
+ *  is reused by a later object at the same address, or dropped when the table
+ *  is rebuilt. Monitors are never deflated.
+ *
+ *  Lookups don't lock: an object's entry is complete before its header says
+ *  that it is inflated, and lookups only happen after reading that header.
+ */
+private[runtime] object MonitorTable {
+  private final class Table(val capacity: Int) {
+    // Object addresses, 0 for an empty slot
+    val keys = new scala.Array[Long](capacity)
+    val owners = new scala.Array[WeakReference[AnyRef]](capacity)
+    val monitors = new scala.Array[ObjectMonitor](capacity)
+    var used = 0
+    // Bumped by every update, see register
+    var version = 0
+  }
+
+  @alwaysinline private def InitialCapacity = 1024
+
+  @volatile private var table: Table = _
+  // Spin lock guarding the updates, stored off-heap
+  private var lockCell: RawPtr = _
+
+  /** Needs to be called before any monitor is inflated, from the single
+   *  threaded part of the runtime initialization.
+   */
+  private[runtime] def init(): Unit =
+    if (isCompactHeaders && isMultithreadingEnabled) {
+      if (table == null) {
+        lockCell = ffi.malloc(castIntToRawSize(4))
+        storeInt(lockCell, 0)
+        table = new Table(InitialCapacity)
+      }
+    }
+
+  @alwaysinline private def indexOf(addr: Long, capacity: Int): Int = {
+    // Fibonacci hashing of the address without its always-zero low bits
+    val h = (addr >>> 3) * 0x9e3779b97f4a7c15L
+    (h >>> 32).toInt & (capacity - 1)
+  }
+
+  /** The monitor of an object whose header says it is inflated */
+  def get(obj: RawPtr): ObjectMonitor = {
+    val addr = castRawPtrToLong(obj)
+    val t = table
+    val mask = t.capacity - 1
+    var i = indexOf(addr, t.capacity)
+    while (true) {
+      val key = t.keys(i)
+      if (key == addr) return t.monitors(i)
+      if (key == 0L)
+        throw new IllegalStateException("Inflated monitor not found")
+      i = (i + 1) & mask
+    }
+    null
+  }
+
+  /** Registers the monitor of `obj`, before its header is marked inflated */
+  private[monitor] def register(obj: RawPtr, monitor: ObjectMonitor): Unit = {
+    // The address is the key, the object must never move
+    GC.noteIdentityHash(obj)
+    // Allocate outside of the lock, GC can't suspend threads waiting for it
