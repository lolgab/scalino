index 000000000..a3fdcc22c
--- /dev/null
+++ b/nativelib/src/main/scala/scala/scalanative/runtime/SmiBox.scala
@@ -0,0 +1,135 @@
+package scala.scalanative.runtime
+
+import scala.scalanative.runtime.Intrinsics._
+
+/** Runtime-side counterpart of the compiler's SMI-style tagged-pointer
+ *  boxing scheme (see `nir.Type.Smi` in the `nir` module for the bit-layout
+ *  single source of truth; it can't be shared by reference with this module
+ *  since `nir`/`tools` are compiler-side Scala/JVM code and this module is
+ *  compiled *into* the target program - the encoding is mirrored here by
+ *  value instead).
+ *
+ *  Word layout (64-bit, MSB-first):
+ *  {{{
+ *  bit 63      : tag           1 = tagged immediate, 0 = real pointer
+ *  bits 58-62  : discriminant  5 bits, 9 of 32 values used currently
+ *  bits 0-57   : payload       stored unshifted/right-justified
+ *  }}}
+ */
+object SmiBox {
+  private final val TagBit = 63
+  private final val DiscriminantShift = TagBit - 5 // 58
+  private final val DiscriminantMask = 0x1FL
+  private final val TagMask = 1L << TagBit
+
+  // Mirrors nir.Type.Smi's discriminant assignment - compiler-side and
+  // runtime-side can't share the constant by reference (see class doc), so
+  // this ordering must be kept in sync with nir.Type.Smi by hand.
+  private final val BooleanDiscriminant = 0
+  private final val ByteDiscriminant = 1
+  private final val ShortDiscriminant = 2
+  private final val CharDiscriminant = 3
+  private final val IntDiscriminant = 4
+  private final val FloatDiscriminant = 5
+  private final val UByteDiscriminant = 6
+  private final val UShortDiscriminant = 7
+  private final val UIntDiscriminant = 8
+
+  @inline def isTagged(obj: RawPtr): Boolean =
+    (castRawPtrToLong(obj) & TagMask) != 0L
+
+  @inline def discriminant(obj: RawPtr): Int =
+    ((castRawPtrToLong(obj) >>> DiscriminantShift) & DiscriminantMask).toInt
+
+  // Per-type payload decoders. Used directly by the 6 box classes' own
+  // `_value` accessors (java.lang.{Boolean,Byte,Short,Character,Integer,
+  // Float}), so that a method resolved via *static* (non-virtual) dispatch
+  // in `codegen.Lower` - which doesn't inspect the receiver at all - still
+  // works correctly when handed a tagged `this`: the field access inside
+  // the method body decodes the tag itself instead of assuming a real,
+  // allocated object. The payload sits unshifted in the low bits, so
+  // decoding a fixed-width primitive is just a truncating cast - no shift.
+  @inline def decodeBoolean(obj: RawPtr): scala.Boolean =
+    (castRawPtrToLong(obj) & 0x1L) != 0L
+  @inline def decodeByte(obj: RawPtr): scala.Byte = castRawPtrToLong(obj).toByte
+  @inline def decodeShort(obj: RawPtr): scala.Short = castRawPtrToLong(obj).toShort
+  @inline def decodeChar(obj: RawPtr): scala.Char =
+    (castRawPtrToLong(obj) & 0xFFFFL).toChar
+  @inline def decodeInt(obj: RawPtr): scala.Int = castRawPtrToLong(obj).toInt
+  @inline def decodeFloat(obj: RawPtr): scala.Float =
+    java.lang.Float.intBitsToFloat(castRawPtrToLong(obj).toInt)
+  // Unsigned types: the payload holds the raw bit pattern (produced by a
+  // zero-extend-then-mask on encode, see nir.Type.Smi/
+  // codegen.Lower.genSmiBoxOp) - mask to the field's own bit width instead
+  // of relying on sign, matching decodeChar's shape (a plain `.toByte`/
+  // `.toShort` truncation alone would sign-extend on the *next* read, since
+  // these decode to scala.Byte/scala.Short which are themselves signed).
+  @inline def decodeUByte(obj: RawPtr): scala.Byte =
+    (castRawPtrToLong(obj) & 0xFFL).toByte
+  @inline def decodeUShort(obj: RawPtr): scala.Short =
+    (castRawPtrToLong(obj) & 0xFFFFL).toShort
+  @inline def decodeUInt(obj: RawPtr): scala.Int =
+    (castRawPtrToLong(obj) & 0xFFFFFFFFL).toInt
+
+  // Encode direction: given a primitive value, construct the tagged AnyRef
+  // bit pattern directly - the mirror image of `codegen.Lower`'s
+  // `genSmiBoxOp` (see that method for the compiler-side version of this
+  // exact formula). Used by the 5 cache-backed `valueOf` methods
+  // (java.lang.{Boolean,Byte,Short,Character,Integer} - Float has no JLS-
+  // mandated cache, Long is out of scope for SMI entirely) on 64-bit, so an
+  // *explicit* `Integer.valueOf(x)`-style call gets the same zero-allocation,
+  // tagged-identity treatment as implicit autoboxing already does.
+  //
+  // `payloadMask` clears any bits the widened payload has above its own
+  // type width (in particular, sign-extension from a negative Byte/Short/
+  // Int) - those bits would otherwise collide with the discriminant/tag
+  // bits living above the payload region now that the payload isn't
+  // shifted out of their way.
+  @inline private def encode(discriminant: Int, payload: Long, payloadMask: Long): AnyRef = {
+    val encoded =
+      (payload & payloadMask) | (discriminant.toLong << DiscriminantShift) | TagMask
+    castRawPtrToObject(castLongToRawPtr(encoded))
+  }
+
+  @inline def encodeBoolean(value: scala.Boolean): AnyRef =
+    encode(BooleanDiscriminant, if (value) 1L else 0L, 0x1L)
+  @inline def encodeByte(value: scala.Byte): AnyRef =
+    encode(ByteDiscriminant, value.toLong, 0xFFL) // toLong sign-extends, mask strips it
+  @inline def encodeShort(value: scala.Short): AnyRef =
+    encode(ShortDiscriminant, value.toLong, 0xFFFFL)
+  @inline def encodeChar(value: scala.Char): AnyRef =
+    encode(CharDiscriminant, value.toLong & 0xFFFFL, 0xFFFFL) // zero-extend: Char is unsigned
+  @inline def encodeInt(value: scala.Int): AnyRef =
+    encode(IntDiscriminant, value.toLong, 0xFFFFFFFFL)
+  // UByte/UShort/UInt: no JLS-style valueOf cache exists for these (they're
+  // Scala Native's own types, not java.lang wrappers), so these encoders
+  // aren't currently called from a valueOf-style entry point the way the 5
+  // java.lang.X ones above are - added for symmetry with `decodeUX` and in
+  // case a future caching/construction path wants them.
+  @inline def encodeUByte(value: scala.Byte): AnyRef =
+    encode(UByteDiscriminant, value.toLong & 0xFFL, 0xFFL)
+  @inline def encodeUShort(value: scala.Short): AnyRef =
+    encode(UShortDiscriminant, value.toLong & 0xFFFFL, 0xFFFFL)
+  @inline def encodeUInt(value: scala.Int): AnyRef =
+    encode(UIntDiscriminant, value.toLong & 0xFFFFFFFFL, 0xFFFFFFFFL)
+}
+
+/** Runtime-side counterpart of the compiler's `PtrTag` low-3-bit pointer
+ *  tagging (see `nir.Type.PtrTag` for the bit-layout single source of
+ *  truth; mirrored here by value, same reasoning as `SmiBox`). Orthogonal
+ *  to `SmiBox` above - see `nir.Type.PtrTag`'s doc comment for why the two
+ *  schemes never collide.
+ */
+object PtrBox {
+  private final val Mask = 0x7L
+  private final val PtrDiscriminant = 1L
+
+  @inline def isTagged(obj: RawPtr): Boolean =
+    (castRawPtrToLong(obj) & Mask) == PtrDiscriminant
+
+  @inline def decodeRawPtr(obj: RawPtr): RawPtr =
+    castLongToRawPtr(castRawPtrToLong(obj) & ~Mask)
+
+  @inline def encode(rawptr: RawPtr): AnyRef =
+    castRawPtrToObject(castLongToRawPtr(castRawPtrToLong(rawptr) | PtrDiscriminant))
+}
