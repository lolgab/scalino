+    // Conversions
+    def LLVMBuildTrunc(b: LLVMBuilderRef, v: LLVMValueRef, destTy: LLVMTypeRef, n: CString): LLVMValueRef = extern
+    def LLVMBuildZExt(b: LLVMBuilderRef, v: LLVMValueRef, destTy: LLVMTypeRef, n: CString): LLVMValueRef = extern
+    def LLVMBuildSExt(b: LLVMBuilderRef, v: LLVMValueRef, destTy: LLVMTypeRef, n: CString): LLVMValueRef = extern
