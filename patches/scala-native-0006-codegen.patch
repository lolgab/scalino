+    def LLVMBuildAdd(b: LLVMBuilderRef, l: LLVMValueRef, r: LLVMValueRef, n: CString): LLVMValueRef = extern
+    def LLVMBuildSub(b: LLVMBuilderRef, l: LLVMValueRef, r: LLVMValueRef, n: CString): LLVMValueRef = extern
