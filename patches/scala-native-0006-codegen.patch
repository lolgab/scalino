diff --git a/tools/jvm/src/main/scala/scala/scalanative/codegen/llvm/direct/DirectCodeGenDispatch.scala b/tools/jvm/src/main/scala/scala/scalanative/codegen/llvm/direct/DirectCodeGenDispatch.scala
