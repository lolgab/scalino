new file mode 100644
index 000000000..48c50a05d
--- /dev/null
+++ b/tools/src/main/scala/scala/scalanative/codegen/RttiSpace.scala
@@ -0,0 +1,100 @@
+package scala.scalanative.codegen
+
+import scala.scalanative.nir
+
+/** With compact object headers every RTTI is placed in one global, the RTTI
+ *  space, at an offset known to codegen: an object header can then hold the
+ *  offset of its RTTI (a narrow pointer, like HotSpot's compressed class
+ *  pointers) instead of its address.
+ *
+ *  The RTTI itself is unchanged, it still depends only on its type and its
+ *  ancestors: only where it is stored is decided for the whole program. Each
+ *  RTTI keeps its symbol, an alias of its place in the space, so it is
+ *  referenced by name as before (NIR, other object files, the C runtime).
+ */
+private[codegen] object RttiSpace {
+
+  /** Name of the global holding every RTTI */
+  val Name: nir.Global.Member =
+    nir.Global.Top("scala.scalanative.runtime.RttiSpace")
+      .member(nir.Sig.Generated("space"))
+
+  /** Symbol of the start of the space for the C runtime, see rtti_space.c */
+  final val CName = "scalanative_rtti_space"
+
+  /** The offsets computed here aren't where LLVM puts the RTTI */
+  final class LayoutMismatch(msg: String) extends RuntimeException(msg)
+
+  /** Offsets of the RTTI in the space, by name */
+  final class Layout(val entries: Seq[(nir.Global.Member, Long)]) {
+    private val offsets = entries.toMap
+    def offsetOf(rtti: nir.Global): Option[Long] = rtti match {
+      case m: nir.Global.Member => offsets.get(m)
+      case _                    => None
+    }
+    def size: Long = entries.size
+
+    /** Hash of the offsets `defns` refer to (`Metadata.headerRtti` values).
+     *
+     *  Incremental codegen reuses the object file of a group of definitions
+     *  whose NIR hasn't changed, but an offset isn't part of the NIR: adding
+     *  or removing a class moves the RTTI after it. Mixing this into the
+     *  group's key recompiles only the groups that use a moved offset.
+     */
+    def offsetsKey(defns: Seq[nir.Defn]): Long = {
+      object traverse extends nir.Traverse {
+        var key = 0L
+        override def onVal(value: nir.Val): Unit = value match {
+          case nir.Val.Global(name, nir.Type.Int) =>
+            offsetOf(name).foreach { offset =>
+              key = key + name.hashCode().toLong * 31 + offset
+            }
+          case _ => super.onVal(value)
+        }
+      }
+      traverse.onDefns(defns)
+      traverse.key
+    }
+  }
+
+  def isEnabled(implicit meta: Metadata): Boolean = meta.useCompactHeaders
+
+  /** Replaces the RTTI definitions of `assembly` by the RTTI space */
+  def apply(
+      assembly: Seq[nir.Defn]
+  )(implicit meta: Metadata): (Seq[nir.Defn], Option[Layout]) =
+    if (!isEnabled) (assembly, None)
+    else if (!meta.platform.useOpaquePointers)
+      throw new scala.scalanative.build.BuildException(
+        "Compact object headers need LLVM 15 or newer, disable them with compactHeaders = false"
+      )
+    else {
+      def isRtti(defn: nir.Defn): Boolean = defn match {
+        case v: nir.Defn.Var =>
+          !v.attrs.isExtern &&
+            meta.globalSections.forGlobal(v.name).contains(GlobalSections.ClassInfo)
+        case _ => false
+      }
+      val (rttis, rest) = assembly.partition(isRtti)
+      if (rttis.isEmpty) (assembly, None)
+      else {
+        // Sorted by name: the same program always gets the same offsets
+        val sorted = rttis.sortBy(_.name).map(_.asInstanceOf[nir.Defn.Var])
+        val values = sorted.map(_.rhs)
+        val value = nir.Val.StructValue(values)
+        // Same layout as LLVM gives the struct
+        val layout = MemoryLayout(values.map(_.ty))(meta.platform)
+        val entries = sorted.zip(layout.tys).map {
+          case (defn, positioned) =>
+            defn.name.asInstanceOf[nir.Global.Member] -> positioned.offset
+        }
+        val space = meta.globalSections.define(
+          GlobalSections.ClassInfo,
+          nir.Defn.Var(nir.Attrs.None, Name, value.ty, value)(
+            nir.SourcePosition.NoPosition
+          )
+        )
+        (rest :+ space, Some(new Layout(entries)))
+      }
+    }
+}
