--- /dev/null
+++ b/tools/native/src/main/scala/scala/scalanative/codegen/llvm/direct/LLVMCApi.scala
@@ -0,0 +1,588 @@
+package scala.scalanative
+package codegen
+package llvm
+package direct
+
+// EXPERIMENTAL (NativeConfig.useLLVMDirectCodeGen). Thin @extern bindings for
+// the subset of LLVM-C (llvm-c/Core.h, llvm-c/Target.h, llvm-c/TargetMachine.h,
+// llvm-c/Analysis.h) needed by DirectCodeGen. Only compiles under the
+// Native-hosted `tools` build (this file lives in tools/native/, not
+// tools/src/main/, exactly like Platform.scala) -- see NativeConfig.scala's
+// doc comment on useLLVMDirectCodeGen for why.
+//
+// These symbols are resolved against libLLVM at the link time of whatever
+// native binary embeds this "tools" code (e.g. scalino-linkdriver) -- that
+// binary's own build/link step is responsible for passing `-L<libdir>
+// -lLLVM-<major>` (see build/04-build-scalino-linkdriver.sh), discovered via
+// Discover.discoverLibLLVM(). No `@link(...)` annotation here: the library
+// name depends on the runtime-discovered LLVM version, which isn't a
+// compile-time literal.
+import scala.scalanative.unsafe._
+import scala.scalanative.unsigned._
+
+private[direct] object LLVMCApi {
+  type LLVMContextRef = Ptr[Byte]
+  type LLVMModuleRef = Ptr[Byte]
+  type LLVMTypeRef = Ptr[Byte]
+  type LLVMValueRef = Ptr[Byte]
+  type LLVMBasicBlockRef = Ptr[Byte]
+  type LLVMBuilderRef = Ptr[Byte]
+  type LLVMTargetRef = Ptr[Byte]
+  type LLVMTargetMachineRef = Ptr[Byte]
+  type LLVMTargetDataRef = Ptr[Byte]
+  // llvm-c/Transforms/PassBuilder.h + llvm-c/Error.h: the new-pass-manager
+  // entry point used to actually run the middle-end optimization pipeline
+  // (mem2reg/SROA/GVN/redundant-load-elimination/...) on a module before
+  // codegen -- see emitObjectFile's doc comment for why this is required.
+  type LLVMPassBuilderOptionsRef = Ptr[Byte]
+  type LLVMErrorRef = Ptr[Byte]
+  // llvm-c/Core.h: function attributes (LLVMAttributeFunctionIndex == ~0U)
+  type LLVMAttributeRef = Ptr[Byte]
+  final val LLVMAttributeFunctionIndex: CUnsignedInt = 0xffffffffL.toUInt
+  // llvm-c/DebugInfo.h: opaque debug-info metadata handle and DIBuilder.
+  type LLVMMetadataRef = Ptr[Byte]
+  type LLVMDIBuilderRef = Ptr[Byte]
+  // LLVMBool is a plain C `int` (0/1), not a real Boolean ABI type.
+  type LLVMBool = CInt
+
+  // llvm-c/Core.h: LLVMIntPredicate
+  final val LLVMIntEQ = 32
+  final val LLVMIntNE = 33
+  final val LLVMIntUGT = 34
+  final val LLVMIntUGE = 35
+  final val LLVMIntULT = 36
+  final val LLVMIntULE = 37
+  final val LLVMIntSGT = 38
+  final val LLVMIntSGE = 39
+  final val LLVMIntSLT = 40
+  final val LLVMIntSLE = 41
+
+  // llvm-c/Core.h: LLVMRealPredicate (ordered variants only, matches
+  // AbstractCodeGen.genOp's "fcmp o.."/"fcmp u.." mapping)
+  final val LLVMRealOEQ = 1
+  final val LLVMRealOGT = 2
+  final val LLVMRealOGE = 3
+  final val LLVMRealOLT = 4
+  final val LLVMRealOLE = 5
+  final val LLVMRealUNE = 14
+
+  // llvm-c/Core.h: LLVMLinkage (only the ones DirectCodeGen needs)
+  // llvm-c/Core.h's LLVMLinkage enum, in declaration order: External=0,
+  // AvailableExternally=1, LinkOnceAny=2, LinkOnceODR=3,
+  // LinkOnceODRAutoHide=4, WeakAny=5, WeakODR=6, Appending=7, Internal=8,
+  // Private=9, ... -- Private is NOT 7 (that's Appending; got this wrong
+  // the first time, and LLVM's verifier caught it immediately: "Only global
+  // arrays can have appending linkage!" on every hoisted __const global).
+  final val LLVMExternalLinkage = 0
+  final val LLVMPrivateLinkage = 9
+
+  // llvm-c/Core.h: LLVMVisibility
+  final val LLVMDefaultVisibility = 0
+  final val LLVMHiddenVisibility = 1
+
+  // llvm-c/TargetMachine.h: LLVMCodeGenOptLevel / LLVMRelocMode / LLVMCodeModel
+  final val LLVMCodeGenLevelNone = 0
+  final val LLVMCodeGenLevelDefault = 2
+  final val LLVMRelocPIC = 2
+  final val LLVMCodeModelDefault = 0
+  // llvm-c/TargetMachine.h: LLVMCodeGenFileType
+  final val LLVMObjectFile = 1
+
+  // llvm-c/DebugInfo.h: LLVMDWARFEmissionKind (Full=1) and LLVMDWARFSourceLanguage
+  // (no dedicated Scala Native code, matching AbstractCodeGen/MetadataCodeGen's own
+  // "language": "DW_LANG_C_plus_plus" placeholder, DWARF constant 0x0004).
+  final val LLVMDWARFEmissionFull = 1
+  final val LLVMDWARFSourceLanguageC_plus_plus = 0x0004
+  // llvm-c/DebugInfo.h: LLVMDWARFTypeEncoding (DW_ATE_* constants), only the
+  // ones DIBasicTypes (MetadataCodeGen.scala) actually needs.
+  final val DW_ATE_address = 0x01
+  final val DW_ATE_boolean = 0x02
+  final val DW_ATE_float = 0x04
+  final val DW_ATE_signed = 0x05
+  final val DW_ATE_UTF = 0x10
+  // llvm-c/DebugInfo.h: LLVMDIFlags -- LLVMDIFlagZero is 0.
+  final val LLVMDIFlagZero = 0
+  // llvm-c/Core.h: LLVMModuleFlagBehavior. Error=0, Warning=1, Require=2, ...
+  // -- matches AbstractCodeGen's own "Debug Info Version" module flag
+  // (AbstractCodeGen.scala:100). Got this wrong the first time (used 2,
+  // Require, not Warning): LLVM's verifier caught it immediately ("invalid
+  // value for 'require' module flag (expected metadata pair)").
+  final val LLVMModuleFlagBehaviorWarning = 1
+
+  // llvm-c/Analysis.h: LLVMVerifierFailureAction. AbortProcessAction=0,
+  // PrintMessageAction=1, ReturnStatusAction=2 -- want the last one (return
+  // status silently, we do our own reporting); wrongly had 1 (PrintMessage)
+  // the first time, which made LLVM print its own diagnostics straight to
+  // stderr on top of our own debug log for the same failure.
+  final val LLVMReturnStatusAction = 2
+
+  // llvm-c/Core.h: LLVMAtomicOrdering (value 3 intentionally unused upstream)
+  final val LLVMAtomicOrderingNotAtomic = 0
+  final val LLVMAtomicOrderingUnordered = 1
+  final val LLVMAtomicOrderingMonotonic = 2
+  final val LLVMAtomicOrderingAcquire = 4
+  final val LLVMAtomicOrderingRelease = 5
+  final val LLVMAtomicOrderingAcquireRelease = 6
+  final val LLVMAtomicOrderingSequentiallyConsistent = 7
