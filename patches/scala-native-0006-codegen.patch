+        packed: LLVMBool
+    ): LLVMTypeRef = extern
+    def LLVMFunctionType(
+        returnType: LLVMTypeRef,
+        paramTypes: Ptr[LLVMTypeRef],
+        paramCount: CUnsignedInt,
+        isVarArg: LLVMBool
+    ): LLVMTypeRef = extern
+
+    // Constants
+    def LLVMConstInt(
+        ty: LLVMTypeRef,
+        n: CUnsignedLongLong,
+        signExtend: LLVMBool
+    ): LLVMValueRef = extern
+    def LLVMConstReal(ty: LLVMTypeRef, n: CDouble): LLVMValueRef = extern
+    def LLVMConstNull(ty: LLVMTypeRef): LLVMValueRef = extern
+    def LLVMConstAllOnes(ty: LLVMTypeRef): LLVMValueRef = extern
+    def LLVMConstArray2(
+        elementType: LLVMTypeRef,
