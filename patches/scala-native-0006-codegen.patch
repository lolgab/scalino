@@ -0,0 +1,31 @@
+package scala.scalanative
+package codegen
+package llvm
+package direct
+
+// EXPERIMENTAL (NativeConfig.useLLVMDirectCodeGen). Shared (not tools/jvm-
+// or tools/native-only) so both DirectCodeGenDispatch variants -- and the
+// shared CodeGen.scala caller -- can all refer to the same nominal type;
+// the actual DirectCodeGen implementation is tools/native-only (it needs
+// @extern), but classifying a partition doesn't need any native-only
+// capability, and CodeGen.scala needs the classification *before* deciding
+// how many Futures (1 or 2) a partition's codegen work turns into -- see
+// its own comment on why that split has to happen synchronously.
+private[codegen] sealed trait DirectCodeGenPlan
+private[codegen] object DirectCodeGenPlan {
+
+  /** The whole partition must go through the regular `.ll` + clang path:
+   *  either a build-wide gate failed (debug info is on, no compatible
+   *  libLLVM discoverable, JVM-hosted tools, ...), or every definition in
+   *  the partition was individually incapable.
+   */
+  case object Unavailable extends DirectCodeGenPlan
+
+  /** `capable` should be compiled directly (via `DirectCodeGenDispatch.emit`)
+   *  into one object file; `incapable` (may be empty) still needs the
+   *  regular `.ll` + clang path, as a second, separate object file for the
+   *  same partition.
+   */
+  final case class Split(capable: Seq[nir.Defn], incapable: Seq[nir.Defn])
+      extends DirectCodeGenPlan
+}
