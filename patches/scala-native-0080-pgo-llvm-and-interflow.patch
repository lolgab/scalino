diff --git a/tools/src/main/scala/scala/scalanative/interflow/PgoProfile.scala b/tools/src/main/scala/scala/scalanative/interflow/PgoProfile.scala
new file mode 100644
index 0000000..e5e3a0e
--- /dev/null
+++ b/tools/src/main/scala/scala/scalanative/interflow/PgoProfile.scala
@@ -0,0 +1,141 @@
+package scala.scalanative
+package interflow
+
+import java.io.{BufferedReader, FileReader}
+import java.util.concurrent.ConcurrentHashMap
+
+/** Function-level execution profile consumed by the Interflow inliner.
+ *
+ *  The profile is the LLVM IR-PGO data of an earlier, instrumented link of
+ *  the same program (`SCALANATIVE_PGO_GEN`), rendered with
+ *
+ *  {{{
+ *  llvm-profdata show --all-functions --counts merged.profdata > profile.txt
+ *  }}}
+ *
+ *  (or the compact `<entry count>\t<symbol>` lines build/pgo/ keeps in the
+ *  repo) and pointed to by `SCALANATIVE_PGO_PROFILE`. The instrumented build uses
+ *  entry-first instrumentation, so the first block count of every function
+ *  is its entry count. LLVM function names are the mangled NIR names, so a
+ *  count is looked up as `"_S" + name.mangle` (the symbol codegen emits).
+ *
+ *  A function that is missing from the profile is *unknown*, not cold: it
+ *  may have been inlined away by the instrumented build, or may not have
+ *  existed there. Only a function that is present with an entry count of 0
+ *  is cold.
+ */
+private[scalanative] final class PgoProfile private (
+    counts: java.util.HashMap[String, java.lang.Long],
+    val hotCut: Long,
+    val veryHotCut: Long
+) {
+  private val cache = new ConcurrentHashMap[nir.Global, java.lang.Long]()
+
+  /** Entry count of `name`, or -1 when the profile has no data for it. */
+  def count(name: nir.Global): Long = {
+    var c = cache.get(name)
+    if (c == null) {
+      val found = counts.get("_S" + name.mangle)
+      c = if (found == null) java.lang.Long.valueOf(-1L) else found
+      cache.put(name, c)
+    }
+    c.longValue
+  }
+
+  /** Covers the functions that account for 99% of all entry counts
+   *  (cheap boosts: larger inlining size limits).
+   */
+  def isHot(count: Long): Boolean = count >= 0 && count >= hotCut
+
+  /** Only the few functions covering 90% of the entry counts (expensive
+   *  ReleaseFull-only features: wide polymorphic inlining, specialization).
+   */
+  def isVeryHot(count: Long): Boolean = count >= 0 && count >= veryHotCut
+  def isCold(count: Long): Boolean = count == 0
+
+  def size: Int = counts.size
+}
+
+private[scalanative] object PgoProfile {
+  val EnvVar = "SCALANATIVE_PGO_PROFILE"
+
+  /** Fraction of all recorded entry counts that the hot functions have to
+   *  cover (LLVM's `ProfileSummary` uses 0.99 for its hot cutoff too), and
+   *  the same for the very hot tier. `SCALANATIVE_PGO_HOT_COVERAGE` and
+   *  `SCALANATIVE_PGO_VERY_HOT_COVERAGE` override them.
+   */
+  private def coverage(env: String, default: Double): Double =
+    sys.env.get(env).flatMap(s => scala.util.Try(s.toDouble).toOption).filter(d => d > 0 && d <= 1).getOrElse(default)
+  private val HotCoverage = coverage("SCALANATIVE_PGO_HOT_COVERAGE", 0.99)
+  private val VeryHotCoverage = coverage("SCALANATIVE_PGO_VERY_HOT_COVERAGE", 0.90)
+
+  private def log(msg: String): Unit = System.err.println(s"[pgo] $msg")
+
+  lazy val current: PgoProfile = sys.env.get(EnvVar).filter(_.nonEmpty) match {
+    case None => null
+    case Some(path) =>
+      try {
+        val p = load(path)
+        log(s"loaded ${p.size} functions from $path, hot entry count >= ${p.hotCut}, very hot >= ${p.veryHotCut}")
+        p
+      } catch {
+        case e: Exception =>
+          log(s"cannot read $path: $e -- continuing without a profile")
+          null
+      }
+  }
+
+  def load(path: String): PgoProfile = {
+    val counts = new java.util.HashMap[String, java.lang.Long]()
+    val reader = new BufferedReader(new FileReader(path))
+    try {
+      var name: String = null
+      var line = reader.readLine()
+      while (line != null) {
+        val tab = line.indexOf('\t')
+        if (tab > 0) {
+          // compact form: `<entry count>\t<symbol>`
+          counts.put(line.substring(tab + 1), java.lang.Long.valueOf(line.substring(0, tab).toLong))
+        } else if (line.startsWith("  ") && !line.startsWith("   ") && line.endsWith(":")) {
+          name = line.substring(2, line.length - 1)
+        } else if (name != null) {
+          val i = line.indexOf("Block counts: [")
+          if (i >= 0) {
+            val start = i + "Block counts: [".length
+            var end = start
+            while (end < line.length && Character.isDigit(line.charAt(end))) end += 1
+            if (end > start)
+              counts.put(name, java.lang.Long.valueOf(line.substring(start, end).toLong))
+            name = null
+          }
+        }
+        line = reader.readLine()
+      }
+    } finally reader.close()
+
+    val nonZero = {
+      val buf = new java.util.ArrayList[java.lang.Long]()
+      val it = counts.values().iterator()
+      while (it.hasNext) { val v = it.next(); if (v.longValue > 0) buf.add(v) }
+      val arr = new Array[Long](buf.size)
+      var i = 0
+      while (i < arr.length) { arr(i) = buf.get(i).longValue; i += 1 }
+      java.util.Arrays.sort(arr)
+      arr
+    }
+    val total = nonZero.foldLeft(0.0)(_ + _)
+    // smallest count such that the functions at or above it cover `fraction`
+    def cutFor(fraction: Double): Long = {
+      var cut = Long.MaxValue
+      var acc = 0.0
+      var i = nonZero.length - 1
+      while (i >= 0 && acc < total * fraction) {
+        acc += nonZero(i)
+        cut = nonZero(i)
+        i -= 1
+      }
+      cut
+    }
+    new PgoProfile(counts, cutFor(HotCoverage), cutFor(VeryHotCoverage))
+  }
+}
