+    config.compilerConfig.linktimeProperties
+      .get(PruneProperty)
+      .collect { case s: String => s }
+      .map(_.split(';').iterator.map(_.trim).filter(_.nonEmpty).map { p =>
+        p.indexOf('#') match {
+          case -1 => (p, None)
+          case i  => (p.substring(0, i), Some(p.substring(i + 1)))
