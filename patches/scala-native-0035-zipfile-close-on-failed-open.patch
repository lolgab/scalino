   private val mEntries = new ju.LinkedHashMap[String, ZipEntry](64)
 
-  readCentralDir()
+  /* A constructor that throws gives the caller no ZipFile to close(), so the
+   * RandomAccessFile opened above would stay open until (if ever) finalize()
+   * runs. Opening a directory or a non-zip file once per class looked up on a
+   * classpath used to exhaust the process's file descriptors.
+   */
+  try readCentralDir()
+  catch {
+    case t: Throwable =>
+      try mRaf.close()
+      catch { case _: Throwable => () }
+      mRaf = null
+      throw t
+  }
 
   override protected def finalize(): Unit =
     close()
