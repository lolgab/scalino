+  // Dependency jars do not change under a running process short of being
+  // rebuilt, so a (mtime, size) stamp is enough to reuse, across the relinks of
+  // scalino's `--long-running` linkdriver, what only depends on a jar's
+  // contents: whether it carries native sources, its SHA-1 and the list of
+  // sources found once unpacked. Without this every link re-scanned the zip
+  // entries of every classpath jar, re-hashed the native-lib jars and re-globbed
+  // their unpacked directories: ~150ms with no compiler running.
+  private final case class Stamp(mtime: Long, size: Long)
+  private def stampOf(path: Path): Stamp = {
+    val file = path.toFile()
+    Stamp(file.lastModified(), file.length())
+  }
+  private val jarHasNativeCache =
+    new java.util.concurrent.ConcurrentHashMap[Path, (Stamp, Boolean)]()
+  private val jarSha1Cache =
+    new java.util.concurrent.ConcurrentHashMap[Path, (Stamp, Array[Byte])]()
+  private val nativePathsCache =
+    new java.util.concurrent.ConcurrentHashMap[Path, (Stamp, Seq[Path])]()
+
