# Pinned versions. Bump deliberately, re-run build/*.sh, re-verify agent-config/*.
# scalino's OWN version is NOT pinned here -- it's derived from the repo's git
# tag at build time (see build/00-env.sh's SCALINO_VERSION), so it can never
# drift out of sync with the release tag the way a hand-maintained copy did.
SCALA_VERSION=3.9.0
SCALA_NATIVE_VERSION=0.5.12

# Combined coordinate scala-native uses for its Scala-version-specific artifacts
# (scalalib_native0.5_3 is a decoy/empty jar for this version line -- the real
# stdlib port is scala3lib_native0.5_3. See docs/findings.md.)
SN_COMBINED_VERSION="${SCALA_VERSION}+${SCALA_NATIVE_VERSION}"

# Cross-compilation sysroots (`scalino sysroot build`, cli/SysrootBuild.scala), assembled
# from upstream packages checked against the sha256s below. Debian files come from
# snapshot.debian.org at this timestamp, so they stay available after Debian drops them.
DEBIAN_SNAPSHOT=20261004T000000Z
# musl sysroots: Debian 13's musl-dev (unmodified musl 1.2.5).
MUSL_DEB_VERSION=1.2.5-3.1~deb13u1
MUSL_DEV_AMD64_SHA256=a3f7d47e452129bb65aae201d6c115abf4d5d3efb136b38b7c6b4fa03ec065e9
MUSL_DEV_ARM64_SHA256=384ea029e3694baac696d3993d93246f9a4b3741c493697e1ceb7256d8820748
# macOS sysroot data (libSystem.tbd + Darwin libc headers) from Zig's lib/libc;
# sha256 is the one ziglang.org publishes for the source tarball.
ZIG_VERSION=0.16.0
ZIG_SHA256=43186959edc87d5c7a1be7b7d2a25efffd22ce5807c7af99067f86f99641bfdf

# glibc sysroots (<arch>-unknown-linux-gnu): Debian 11's
# glibc 2.31 packages from archive.debian.org, so binaries run on anything newer
# (Ubuntu 20.04+, Debian 11+, RHEL 8+). 
GLIBC_DEB_VERSION=2.31-13+deb11u11
LINUX_LIBC_DEV_VERSION=5.10.223-1
GLIBC_LIBC6_AMD64_SHA256=05f7264da867b37f4c5ce49266b558ea1e81e05a9464f623152fca70f3550282
GLIBC_LIBC6_DEV_AMD64_SHA256=e7f7b45d9c5cfcf37609f0b6efd3c645272c812144703af89dfd32218fcb0fd3
LINUX_LIBC_DEV_AMD64_SHA256=e3be603bd12377bb90fcfb0f2048ca3a81c886e49d6f09945b82159d1c54f7b2
GLIBC_LIBC6_ARM64_SHA256=baaa9aa184e2f21738c5819055e6740cc5b22f198e3f416e33f82b40ff6933d8
GLIBC_LIBC6_DEV_ARM64_SHA256=28d478134722dcd4b0bd2045a199301d18713bf95947b9fce66634e7aeacab2e
LINUX_LIBC_DEV_ARM64_SHA256=8b6374a64412d33eac61d74f77b8f932da4b8a707ea8a614791e2a35b8917618
# compiler-rt builtins + crtbegin/crtend for the gnu and musl sysroots: Debian 12's prebuilt
# libclang-rt-14-dev, so no compiler is needed to get them.
LIBCLANG_RT_DEB_VERSION=14.0.6-12
LIBCLANG_RT_AMD64_SHA256=180c4d27fdc912e2e5de21f383aff07d27e1745c34591a41e4d12ff70be54764
LIBCLANG_RT_ARM64_SHA256=26044ab85590cce84cefb45462d33c95d716a60ea7a14b5bf35bede61ee1e9ec

# Windows sysroots (<arch>-pc-windows-gnu): mingw-w64 headers and
# libs, libc++, libunwind and compiler-rt builtins from the llvm-mingw project's release
# (any host's tarball works, only its data dirs are used).
LLVM_MINGW_VERSION=20260922
LLVM_MINGW_SHA256=bb7bb7654b33d5aa8712acb837c963b2e0c56352560c76105270a3268c665c21
# Licence texts shipped in the windows sysroots, fetched from mingw-w64's repository at this tag.
MINGW_W64_LICENSE_TAG=v13.0.0
MINGW_W64_RUNTIME_LICENSE_SHA256=e9b2dc02451ea29092a1f25fa0f3c07207ed421f1807dffb0c4e6dce69dee7bd
MINGW_W64_LICENSE_SHA256=f38e6194bd3bfa1b654f118e5acefe0aead437bbe669eee43957ccc65a7127f1

# Static OpenSSL 3 addons (`scalino sysroot build`'s extra libraries, cli/SysrootBuild.scala), installed
# on first use when a classpath dependency needs libcrypto. Each target family gets the build made for
# its own libc, from prebuilt packages:
#   musl:    Alpine's openssl-libs-static + openssl-dev. Alpine keeps one version per branch, so a newer
#            one means bumping these. Its packages have no licence text: OpenSSL's own, from its git tag.
#   gnu:     Debian 12's libssl-dev (snapshot.debian.org), built against a glibc old enough to link
#            into the glibc 2.31 sysroot.
#   windows: MSYS2's clang64/clangarm64 openssl (UCRT, like llvm-mingw). Needs zstd support in tar.
#   macOS:   Homebrew's openssl@3 bottle, the only static build around (conda-forge's has none). Its
#            Intel bottles stopped after 3.6.2, so both architectures use that version.
OPENSSL_ALPINE_BRANCH=v3.24
OPENSSL_ALPINE_VERSION=3.5.9-r0
OPENSSL_ALPINE_LICENSE_VERSION=3.5.9
OPENSSL_ALPINE_LICENSE_SHA256=7d5450cb2d142651b8afa315b5f238efc805dad827d91ba367d8516bc9d49e7a
OPENSSL_ALPINE_STATIC_X86_64_SHA256=1ff255d219f15604deb5b37d8bc55eacd3f722aa406ea036f241ed49bd586060
OPENSSL_ALPINE_DEV_X86_64_SHA256=2479885dfc1414b44cf0f2578b014b70a3ce671d7607db62c8366e46f5b77ca6
OPENSSL_ALPINE_STATIC_AARCH64_SHA256=e7719f2ca54762e53884493eb0e5b129102e2cabb6c30c7d59bcf0c11f666946
OPENSSL_ALPINE_DEV_AARCH64_SHA256=9d9c83f93181eb781f76ee451a5f096d7faecd5bec1187dc00ed39453cc2cc09
OPENSSL_DEBIAN_VERSION=3.0.20-1~deb12u2
OPENSSL_DEBIAN_AMD64_SHA256=43ef5c109056b1507a0972631ee8292e727029aeda1516b4672cb041730ae3af
OPENSSL_DEBIAN_ARM64_SHA256=c6941a83bebd83d2a1cd2db56418062d8f48b3200786aacafa194b75a93a3702
OPENSSL_MSYS2_VERSION=3.6.5-1
OPENSSL_MSYS2_X86_64_SHA256=c6be6a00e4c5672306d3abefa195d8341d57f6d9c52a066bc6145d50038e4c62
OPENSSL_MSYS2_AARCH64_SHA256=40978ba522b2e2d663029d6a5df7ad6e0e408d334a3590930229167bbc5a5edb
OPENSSL_BREW_VERSION=3.6.2
OPENSSL_BREW_X86_64_SHA256=a49cb0d2f17fc2866ca7a5a212e2e0d2721718e1c3d4f7c3817d9afbb64142e9
OPENSSL_BREW_ARM64_SHA256=aaa5f4f3d87868ecd5f5fd6967da0c305eb335a58171faba193e9c7e39fbf35c

# libidn2 (+ libunistring, libiconv/libintl where the platform needs them): what sttp-model links
# (`idn2`) for internationalised domain names. Same sources as OpenSSL above; Windows/macOS also
# need the libraries libunistring calls into (see SysrootBuild.installIdn2).
#   musl:    Alpine libidn2-static + libidn2-dev + libunistring-static.
#   gnu:     Debian 12 libidn2-dev + libunistring-dev.
#   windows: MSYS2 clang64/clangarm64 libidn2, libunistring, libiconv.
#   macOS:   Homebrew sonoma bottles libidn2, libunistring, gettext (libintl), pinned to the last
#            versions that still have an Intel bottle.
IDN2_ALPINE_VERSION=2.3.8-r0
IDN2_ALPINE_STATIC_X86_64_SHA256=77b1d45b93a28e67b90cb280031c5f0d6e300ea8258ba8c6921f35365ed71cbe
