# s2n-tls (fs2-io's TLS on Scala Native, so also skunk and ember): no distribution ships a static
# build, so scalino compiles it (clang for the target, against the OpenSSL addon's headers).
# GitHub's tag archive; no Windows support upstream.
S2N_VERSION=1.7.11
S2N_SHA256=c3894e86bc09c1923f9ed42edc310d8dd1ca4d0461f037acc56762a274ebe2b1

# libcurl for Linux/macOS: compiled like s2n-tls (curl 8.x configure can't run for a cross target; the
# curl_config.h files in build/ come from a configure run). Windows uses MSYS2's static libcurl and the
# libraries it needs.
CURL_VERSION=8.22.0
CURL_SHA256=f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7
# zlib, compiled into the curl addon (sttp's curl backend asks for compressed responses; the sysroots ship
# no zlib headers). Built with Z_PREFIX so it can't clash with the sysroot's -lz.
ZLIB_VERSION=1.3.2
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

# libcurl on Windows: MSYS2's clang64/clangarm64 static libcurl and the static libraries it needs (OpenSSL
# and libidn2 come from their addons). Built with HTTP/2, HTTP/3, SSH, brotli, zstd, zlib and PSL.
CURL_MSYS2_VERSION=8.22.0-1
